/* =========================================================================
 * PASS #KITCHEN-INDENT-LIVE -- unified Kitchen -> Inventory workflow
 *
 * The Inventory/Kitchen HTML clients already call:
 *   SAVE_KITCHEN_INDENT
 *   GET_PENDING_INDENTS
 *   APPROVE_ISSUE_INDENT
 * but the production router must expose the same actions in the deployed
 * multi-client Code.gs. These handlers are tenant-scoped through the
 * authenticated session and the existing KITCHEN_INDENT / STOCK_* tabs.
 * One KITCHEN_INDENT row is stored per requested item with its own IND_ID.
 * ========================================================================= */
function bnxKitchenIndentHeaders_(clientId) {
  const sh = bnxClientSheet(clientId, SHEETS.KITCHEN_INDENT);
  const lastCol = Math.max(1, sh.getLastColumn());
  const headers = sh.getRange(1, 1, 1, lastCol).getValues()[0].map(function(h){ return String(h || '').trim(); });
  if (!headers.length || !headers.some(Boolean)) throw new Error('KITCHEN_INDENT sheet has no header row');
  return { sheet: sh, headers: headers };
}

function bnxGetIndentItemCatalog(session,payload){
  const clientId=session.CLIENT_ID;
  try{
    const p=payload||{}, catMap=bnxCachedCategoryNameMap_(clientId), unitMap=bnxCachedUnitNameMap_(clientId);
    const locationId=String(p.locationId||p.LOCATION_ID||'').trim();
    const sheet=bnxClientSheet(clientId,SHEETS.ITEM_MASTER), values=sheet.getDataRange().getValues(), headers=values[0]||[], items=[];
    for(let r=1;r<values.length;r++){
      const it=bnxRowToObject(values[r],headers);
      if(it.CLIENT_ID&&String(it.CLIENT_ID)!==String(clientId))continue;
      if(it.IS_ACTIVE===false||String(it.IS_ACTIVE).toUpperCase()==='FALSE')continue;
      const itemId=String(it.ITEM_ID||'').trim();
      if(!itemId)continue;
      const stock=bnxGetAvailableStockQty_(clientId,itemId,locationId);
      items.push({ITEM_ID:itemId,NAME:it.ITEM_NAME||'',CATEGORY:catMap.byId[it.CATEGORY_ID]||'Other',UNIT:unitMap.byId[it.UNIT_ID]||'',STOCK:stock!==null?stock:0,MIN_STOCK:Number(it.REORDER_LEVEL)||0,RATE:Number(it.PURCHASE_RATE)||0});
    }
    items.sort(function(a,b){return String(a.NAME).localeCompare(String(b.NAME));});
    return {success:true,data:{items:items},items:items,count:items.length};
  }catch(e){
    bnxLogError(clientId,'bnxGetIndentItemCatalog failed: '+e.message,payload||{});
    return {success:false,message:e.message,error:e.message,data:{items:[]},items:[]};
  }
}

function bnxGetPendingIndents(session, payload) {
  const clientId = session.CLIENT_ID;
  try {
    const ref = bnxKitchenIndentHeaders_(clientId);
    const values = ref.sheet.getDataRange().getValues();
    const headers = ref.headers;
    const rows = [];
    for (let r = 1; r < values.length; r++) {
      const o = bnxRowToObject(values[r], headers);
      if (String(o.CLIENT_ID || clientId) !== String(clientId)) continue;
      if (!o.IND_ID && !o.ITEM_ID && !o.ITEM_NAME) continue;
      if (payload && payload.pendingOnly && String(o.STATUS||'PENDING').toUpperCase() !== 'PENDING') continue;
      rows.push(o);
    }
    return { success:true, data:{indents:rows}, indents:rows };
  } catch (e) {
    bnxLogError(clientId, 'bnxGetPendingIndents failed: ' + e.message, payload || {});
    return { success:false, message:e.message, error:e.message };
  }
}

function bnxSaveKitchenIndent(session, payload) {
  const clientId = session.CLIENT_ID;
  const p = payload || {};
  const items = Array.isArray(p.items) ? p.items : [];
  if (!items.length) return {success:false,message:'At least one kitchen indent item is required'};

  const lock = bnxAcquireScriptLockWithRetry_(3, 10000);
  try {
    const ref = bnxKitchenIndentHeaders_(clientId);
    const now = bnxNowParts_();
    const businessDate = String(p.date || p.indentDate || now.businessDate).slice(0,10);
    bnxAssertBusinessDayOpen_(clientId, businessDate);

    // IMPORTANT: CL00010's confirmed KITCHEN_INDENT schema is 14 columns:
    // IND_ID, CLIENT_ID, DATE, ITEM_ID, ITEM_NAME, UNIT, REQUIRED_QTY,
    // ISSUED_QTY, ISSUED_BY, STATUS, REMARKS, DEPARTMENT, SHIFT, PRIORITY.
    // Do not add RATE/ESTIMATED_COST/CATEGORY just because another client
    // may have them; bnxAppendRow writes only real headers.
    const base = String(p.indentId || p.indId || p.indentNo || '').trim() || ('IND-' + Date.now());
    const saved = [];

    items.forEach(function(item, idx) {
      const qty = Number(item.requiredQty != null ? item.requiredQty : item.REQUIRED_QTY) || 0;
      if (qty <= 0) return;

      const itemId = String(item.itemId || item.itemID || item.ITEM_ID || '').trim();
      const itemName = String(item.itemName || item.ITEM_NAME || '').trim();

      // Never create a phantom inventory key. If an itemId is supplied,
      // verify it against ITEM_MASTER; otherwise resolve the unique name.
      const resolved = bnxResolveInventoryItem_(clientId, itemId, itemName);
      if (!resolved) throw new Error('Item is not a unique active ITEM_MASTER item: ' + (itemName || itemId || ('line ' + (idx+1))));
      const indId = generateShortId_(clientId, 'KITCHEN_INDENT_ID');

      bnxAppendRow(clientId, SHEETS.KITCHEN_INDENT, {
        IND_ID: indId,
        CLIENT_ID: clientId,
        DATE: businessDate,
        ITEM_ID: resolved.itemId,
        ITEM_NAME: resolved.itemName,
        UNIT: String(item.unit || item.UNIT || '').trim(),
        REQUIRED_QTY: qty,
        ISSUED_QTY: 0,
        ISSUED_BY: '',
        STATUS: 'PENDING',
        REMARKS: String(item.remarks || p.remarks || p.notes || '').trim(),
        DEPARTMENT: String(p.department || p.dept || 'Main Kitchen').trim(),
        SHIFT: String(p.shift || 'All Day').trim(),
        PRIORITY: String(p.priority || 'Normal').trim()
      });
      saved.push({IND_ID:indId,itemId:resolved.itemId,itemName:resolved.itemName,requiredQty:qty,batchId:base,line:idx+1});
    });

    if (!saved.length) return {success:false,message:'No positive required quantities were supplied'};
    try { bnxCreateAuditLog(clientId,{CLIENT_ID:clientId,USER_ID:session.USER_ID||'',ACTION:'CREATE',MODULE:'KITCHEN_INDENT',RECORD_TYPE:'KITCHEN_INDENT',RECORD_ID:base,OLD_VALUE:'{}',NEW_VALUE:JSON.stringify({batchId:base,items:saved}),TIMESTAMP:now.iso}); } catch(e) {}
    return {success:true,indentId:base,indents:saved,savedCount:saved.length};
  } catch(e) {
    bnxLogError(clientId,'bnxSaveKitchenIndent failed: '+e.message,p || {});
    return {success:false,message:e.message,error:e.message};
  } finally { try { lock.releaseLock(); } catch(e) {} }
}


function bnxFindKitchenIndentRow_(clientId, indId) {
  const ref = bnxKitchenIndentHeaders_(clientId);
  const sh = ref.sheet, headers = ref.headers;
  const idCol = headers.indexOf('IND_ID'), ciCol = headers.indexOf('CLIENT_ID');
  if (idCol === -1) throw new Error('KITCHEN_INDENT is missing IND_ID column');
  const lastRow = sh.getLastRow();
  if (lastRow < 2) return null;
  const matches = sh.getRange(2, idCol + 1, lastRow - 1, 1)
    .createTextFinder(String(indId).trim()).matchEntireCell(true).findAll();
  for (let i = matches.length - 1; i >= 0; i--) {
    const rowNo = matches[i].getRow();
    const vals = sh.getRange(rowNo, 1, 1, headers.length).getValues()[0];
    const o = bnxRowToObject(vals, headers);
    if (ciCol !== -1 && String(o.CLIENT_ID || '') !== String(clientId)) continue;
    return {sheet:sh, headers:headers, rowNo:rowNo, values:vals, object:o};
  }
  return null;
}

function bnxGetItemPurchaseRate_(clientId, itemId) {
  if (!itemId) return 0;
  const sources=[
    {sheet:SHEETS.ITEM_MASTER, ids:['ITEM_ID','ITEM_CODE'], rates:['PURCHASE_RATE','PURCHASE_PRICE','COST_PRICE','LAST_PURCHASE_RATE']},
    {sheet:SHEETS.RAW_MATERIAL_MASTER, ids:['ITEM_CODE','RAW_MATERIAL_ID','ITEM_ID'], rates:['COST_PRICE','PURCHASE_RATE','PURCHASE_PRICE','LAST_PURCHASE_RATE']}
  ];
  for(const src of sources){
    try{
      const sh=bnxClientSheet(clientId,src.sheet), vals=sh.getDataRange().getValues(), h=vals[0]||[];
      const idCols=src.ids.map(n=>h.indexOf(n)).filter(i=>i!==-1);
      const rateCols=src.rates.map(n=>h.indexOf(n)).filter(i=>i!==-1);
      for(let r=1;r<vals.length;r++){
        if(!idCols.some(c=>String(vals[r][c]||'')===String(itemId))) continue;
        for(const rc of rateCols){
          const n=Number(vals[r][rc]);
          if(isFinite(n)&&n>=0)return n;
        }
        return 0;
      }
    }catch(e){}
  }
  return 0;
}



function bnxGetAvailableStockQty_(clientId, itemId, locationId) {
  // Primary: tenant STOCK_BALANCE. If no row exists, fallback to the
  // authoritative RAW_MATERIAL_MASTER current stock for kitchen ingredients.
  try {
    const sh=bnxClientSheet(clientId,SHEETS.STOCK_BALANCE);
    const vals=sh.getDataRange().getValues(), headers=vals[0]||[];
    const idCol=headers.indexOf('ITEM_ID'), ciCol=headers.indexOf('CLIENT_ID');
    const locCol=headers.indexOf('LOCATION_ID'), qtyCol=headers.indexOf('CURRENT_QUANTITY');
    const availCol=headers.indexOf('AVAILABLE_QUANTITY');
    if(idCol!==-1){
      let total=0,found=false;
      for(let r=1;r<vals.length;r++){
        if(ciCol!==-1&&String(vals[r][ciCol])!==String(clientId))continue;
        if(String(vals[r][idCol])!==String(itemId))continue;
        if(locationId&&locCol!==-1&&String(vals[r][locCol]||'')!==String(locationId))continue;
        const q=Number(availCol!==-1?vals[r][availCol]:vals[r][qtyCol]);
        if(isFinite(q)){total+=q;found=true;}
      }
      if(found)return total;
    }
  }catch(e){}

  // Fallback only when STOCK_BALANCE has no matching row.
  try{
    const sh=bnxClientSheet(clientId,SHEETS.RAW_MATERIAL_MASTER);
    const vals=sh.getDataRange().getValues(), h=vals[0]||[];
    const idCols=['ITEM_CODE','RAW_MATERIAL_ID','ITEM_ID'].map(n=>h.indexOf(n)).filter(i=>i>=0);
    const stockCols=['CURRENT_STOCK','CURRENT_QUANTITY','AVAILABLE_STOCK','STOCK'].map(n=>h.indexOf(n)).filter(i=>i>=0);
    if(!idCols.length||!stockCols.length)return null;
    for(let r=1;r<vals.length;r++){
      if(!idCols.some(c=>String(vals[r][c]||'').trim()===String(itemId)))continue;
      for(const sc of stockCols){
        const q=Number(vals[r][sc]);
        if(isFinite(q))return q;
      }
      return null;
    }
  }catch(e){}
  return null;
}



function bnxUpdateStockBalanceAfterMovement_(clientId, itemId, locationId, qtyOut, qtyIn, movementAt) {
  const sh=bnxClientSheet(clientId,SHEETS.STOCK_BALANCE);
  const headers=sh.getRange(1,1,1,Math.max(1,sh.getLastColumn())).getValues()[0].map(String);
  const idCol=headers.indexOf('ITEM_ID'), ciCol=headers.indexOf('CLIENT_ID'), locCol=headers.indexOf('LOCATION_ID');
  const curCol=headers.indexOf('CURRENT_QUANTITY'), availCol=headers.indexOf('AVAILABLE_QUANTITY');
  if(idCol<0 || curCol<0) return false;
  const last=sh.getLastRow();
  let rowNo=0;
  if(last>=2){
    const vals=sh.getRange(2,1,last-1,headers.length).getValues();
    for(let i=0;i<vals.length;i++){
      if(ciCol>=0 && String(vals[i][ciCol])!==String(clientId)) continue;
      if(String(vals[i][idCol])!==String(itemId)) continue;
      if(locCol>=0 && String(vals[i][locCol]||'')!==String(locationId||'')) continue;
      rowNo=i+2; break;
    }
  }
  const now=new Date().toISOString();
  if(!rowNo){
    const seed=bnxGetAvailableStockQty_(clientId,itemId,locationId);
    const opening=(seed===null?0:Number(seed)||0);
    const next=+(opening+Number(qtyIn||0)-Number(qtyOut||0)).toFixed(4);
    const obj={STOCK_BALANCE_ID:generateShortId_(clientId,'STOCK_BALANCE_ID'),CLIENT_ID:clientId,LOCATION_ID:locationId||'',ITEM_ID:itemId,
      CURRENT_QUANTITY:next,RESERVED_QUANTITY:0,AVAILABLE_QUANTITY:next,
      REORDER_LEVEL:bnxGetItemReorderLevel_(clientId,itemId),LAST_MOVEMENT_AT:movementAt||now,UPDATED_AT:now};
    bnxAppendRow(clientId,SHEETS.STOCK_BALANCE,obj); return true;
  }
  const current=Number(sh.getRange(rowNo,curCol+1).getValue())||0;
  const next=+(current+Number(qtyIn||0)-Number(qtyOut||0)).toFixed(4);
  sh.getRange(rowNo,curCol+1).setValue(next);
  if(availCol>=0){
    const resCol=headers.indexOf('RESERVED_QUANTITY');
    const reserved=resCol>=0?(Number(sh.getRange(rowNo,resCol+1).getValue())||0):0;
    sh.getRange(rowNo,availCol+1).setValue(+(next-reserved).toFixed(4));
  }
  const lm=headers.indexOf('LAST_MOVEMENT_AT'); if(lm>=0)sh.getRange(rowNo,lm+1).setValue(movementAt||now);
  const up=headers.indexOf('UPDATED_AT'); if(up>=0)sh.getRange(rowNo,up+1).setValue(now);
  return true;
}
function bnxGetItemReorderLevel_(clientId,itemId){
  const sources=[
    {sheet:SHEETS.ITEM_MASTER,ids:['ITEM_ID','ITEM_CODE']},
    {sheet:SHEETS.RAW_MATERIAL_MASTER,ids:['ITEM_CODE','RAW_MATERIAL_ID','ITEM_ID']}
  ];
  for(const src of sources){
    try{
      const sh=bnxClientSheet(clientId,src.sheet), vals=sh.getDataRange().getValues(), h=vals[0]||[], rc=h.indexOf('REORDER_LEVEL');
      const idCols=src.ids.map(n=>h.indexOf(n)).filter(i=>i>=0);
      if(rc<0||!idCols.length)continue;
      for(let r=1;r<vals.length;r++)if(idCols.some(c=>String(vals[r][c])===String(itemId)))return Number(vals[r][rc])||0;
    }catch(e){}
  }
  return 0;
}

function bnxApproveIssueIndent(session, payload) {
  const clientId = session.CLIENT_ID;
  const indId = String(payload.indId || payload.IND_ID || '').trim();
  if (!indId) return { success:false, message:'indId is required' };
  const requestedQty = Number(payload.issuedQty != null ? payload.issuedQty : payload.REQUIRED_QTY);
  if (!(requestedQty > 0)) return { success:false, message:'issuedQty must be greater than zero' };

  const lock = bnxTenantLock_();
  try {
    lock.waitLock(10000);
    const found = bnxFindKitchenIndentRow_(clientId, indId);
    if (!found) return { success:false, message:'Kitchen indent not found: ' + indId };

    const o=found.object;
    const status=String(o.STATUS||'PENDING').toUpperCase();
    if (status === 'ISSUED') return { success:true, alreadyIssued:true, indId:indId, issuedQty:Number(o.ISSUED_QTY)||0 };
    if (status !== 'PENDING' && status !== 'PARTIALLY_ISSUED') {
      return { success:false, message:'Indent is not issuable in status ' + status };
    }

    const required=Math.max(0,Number(o.REQUIRED_QTY)||0);
    const already=Math.max(0,Number(o.ISSUED_QTY)||0);
    const remaining=Math.max(0,required-already);
    const qty=Math.min(requestedQty,remaining);
    if (!(qty>0)) return { success:true, alreadyIssued:true, indId:indId, issuedQty:already };

    const locationId=String(payload.locationId || payload.LOCATION_ID || '').trim();
    const available=bnxGetAvailableStockQty_(clientId,String(o.ITEM_ID||''),locationId);
    if (available !== null && available + 1e-9 < qty) {
      return { success:false, message:'Insufficient available stock for ' + (o.ITEM_NAME || o.ITEM_ID) + '. Available: ' + available + ', requested: ' + qty };
    }

    const rate=bnxGetItemPurchaseRate_(clientId,String(o.ITEM_ID||''));
    const now=new Date().toISOString();
    const movementId=generateShortId_(clientId,'STOCK_MOVEMENT_ID');
    bnxAppendRow(clientId,SHEETS.STOCK_MOVEMENT,{
      STOCK_MOVEMENT_ID:movementId,
      CLIENT_ID:clientId,
      LOCATION_ID:locationId,
      ITEM_ID:String(o.ITEM_ID||''),
      MOVEMENT_TYPE:'ISSUE',
      MOVEMENT_DATE:bnxBusinessDateKey_(new Date()),
      QUANTITY_IN:0,
      QUANTITY_OUT:qty,
      RATE:rate,
      SOURCE_TYPE:'KITCHEN_INDENT',
      SOURCE_ID:indId,
      CREATED_BY:String(payload.issuedBy || session.USER_ID || 'Store Manager'),
      CREATED_AT:now,
      REFERENCE_NUMBER:indId
    });
    // Keep STOCK_BALANCE in sync immediately. Previously the movement was
    // appended but the balance stayed stale until a manual rebuild, allowing
    // the next issue to see the old available quantity.
    bnxUpdateStockBalanceAfterMovement_(clientId,String(o.ITEM_ID||''),locationId,qty,0,now);

    const newIssued=+(already+qty).toFixed(4);
    const newStatus=newIssued+1e-9>=required?'ISSUED':'PARTIALLY_ISSUED';
    const h=found.headers;
    const set=function(name,val){const c=h.indexOf(name);if(c!==-1)found.sheet.getRange(found.rowNo,c+1).setValue(val);};
    set('ISSUED_QTY',newIssued);
    set('STATUS',newStatus);
    set('ISSUED_BY',String(payload.issuedBy || session.USER_ID || 'Store Manager'));
    if(h.indexOf('REMARKS')!==-1){
      const old=String(o.REMARKS||'');
      const note='Issued '+qty+' '+String(o.UNIT||'')+' on '+now;
      set('REMARKS',old ? old+' | '+note : note);
    }
    try { bnxInvalidateTodayReportCaches_(clientId); } catch(e) {}
    return { success:true, indId:indId, issuedQty:newIssued, status:newStatus, stockMovementId:movementId, rate:rate };
  } catch(e) {
    bnxLogError(clientId,'bnxApproveIssueIndent failed: '+e.message,payload||{});
    return { success:false, message:e.message, error:e.message };
  } finally {
    try { lock.releaseLock(); } catch(e) {}
  }
}



/* =========================================================================
 * LIVE BAR INDENT — server-authoritative requisition persistence.
 * BAR_INDENT is independent from Kitchen Indent and never uses demo rows.
 * ========================================================================= */
function bnxResolveBarIndentItem_(clientId, itemId, itemName) {
  const id=String(itemId||'').trim(), name=String(itemName||'').trim().toLowerCase(), matches=[];
  const sources=[
    {sheet:SHEETS.BAR_ITEM_MASTER, ids:['BAR_ITEM_ID','ITEM_ID','ITEM_CODE'], names:['ITEM_NAME','MENU_ITEM_NAME']},
    {sheet:SHEETS.ITEM_MASTER, ids:['ITEM_ID','ITEM_CODE'], names:['ITEM_NAME']},
    {sheet:SHEETS.RAW_MATERIAL_MASTER, ids:['ITEM_CODE','RAW_MATERIAL_ID','ITEM_ID'], names:['ITEM_NAME','MATERIAL_NAME']}
  ];
  for(const src of sources){
    try{
      const sh=bnxClientSheet(clientId,src.sheet), v=sh.getDataRange().getValues(), h=v[0]||[];
      const ii=src.ids.map(c=>h.indexOf(c)).filter(i=>i>=0), ni=src.names.map(c=>h.indexOf(c)).filter(i=>i>=0), ai=h.indexOf('IS_ACTIVE');
      for(let r=1;r<v.length;r++){
        const o=bnxRowToObject(v[r],h); if(o.CLIENT_ID&&String(o.CLIENT_ID)!==String(clientId))continue;
        if(ai>=0&&(v[r][ai]===false||String(v[r][ai]).toUpperCase()==='FALSE'))continue;
        const ids=ii.map(i=>String(v[r][i]||'').trim()).filter(Boolean), names=ni.map(i=>String(v[r][i]||'').trim()).filter(Boolean);
        if(id && ids.includes(id)) return {itemId:id,itemName:names[0]||String(itemName||id).trim(),source:src.sheet};
        if(name && names.some(x=>x.toLowerCase()===name)) matches.push({itemId:ids[0]||'',itemName:names[0]||String(itemName||'').trim(),source:src.sheet});
      }
    }catch(e){}
  }
  return matches.length===1?matches[0]:null;
}
function bnxGetBarIndentCatalog(session,payload){
  const clientId=session.CLIENT_ID, p=payload||{}, locationId=String(p.locationId||p.LOCATION_ID||'').trim();
  const out=[], byId=new Map(), byName=new Map();
  const norm=v=>String(v==null?'':v).trim();
  const upper=v=>norm(v).toUpperCase();
  function add(item){
    if(!item || !item.ITEM_ID || !item.ITEM_NAME) return;
    const id=norm(item.ITEM_ID), name=norm(item.ITEM_NAME), nk=name.toLowerCase();
    const existing=byId.get(id) || byName.get(nk);
    if(existing){
      // Prefer the authoritative bar item for liquor and raw-material master
      // for grocery/beverage. Never create duplicate UI rows for the same item.
      const rank={BAR_ITEM_MASTER:3,RAW_MATERIAL_MASTER:2,ITEM_MASTER:1};
      if((rank[item.SOURCE]||0)>(rank[existing.SOURCE]||0)){
        const ix=out.indexOf(existing); if(ix>=0) out[ix]=item;
        byId.set(id,item); byName.set(nk,item);
      }
      return;
    }
    out.push(item); byId.set(id,item); byName.set(nk,item);
  }
  function classify(o,source){
    const text=upper([o.CATEGORY,o.RAW_CATEGORY,o.BAR_CATEGORY,o.MENU_CATEGORY,o.MENU_SECTION,o.ITEM_GROUP_NAME,o.GROUP_NAME,o.ITEM_GROUP,o.GROUP,o.ITEM_NAME,o.MATERIAL_NAME].join(' '));
    if(source==='BAR_ITEM_MASTER' || /LIQUOR|SPIRIT|WHISK|WHISKY|VODKA|RUM|GIN|BEER|WINE|TEQUILA|COGNAC|BRANDY|CHAMPAGNE|APERITIF|ALCOHOL/.test(text)) return 'LIQUOR';
    if(/BEVERAGE|DRINK|JUICE|SOFT DRINK|SOFT_DRINK|WATER|SODA|MOCKTAIL|COFFEE|TEA|ICE CUBE/.test(text)) return 'BEVERAGE';
    return 'GROCERY';
  }
  function readSource(sheetName, idKeys, nameKeys, unitKeys){
    try{
      const sh=bnxClientSheet(clientId,sheetName), vals=sh.getDataRange().getValues(), h=vals[0]||[];
      for(let r=1;r<vals.length;r++){
        const o=bnxRowToObject(vals[r],h);
        if(o.CLIENT_ID && String(o.CLIENT_ID)!==String(clientId)) continue;
        if(o.IS_ACTIVE===false || upper(o.IS_ACTIVE)==='FALSE') continue;
        const id=norm(idKeys.map(k=>o[k]).find(v=>norm(v))||'');
        const name=norm(nameKeys.map(k=>o[k]).find(v=>norm(v))||'');
        if(!id||!name) continue;
        const cat=classify(o,sheetName);
        const unit=norm(unitKeys.map(k=>o[k]).find(v=>norm(v))||'PC').toUpperCase();
        add({ITEM_ID:id,ITEM_NAME:name,CATEGORY:cat,UNIT:unit,GROUP_NAME:norm(o.ITEM_GROUP_NAME||o.GROUP_NAME||o.ITEM_GROUP||cat),SOURCE:sheetName,LOCATION_ID:locationId});
      }
    }catch(e){ bnxLogError(clientId,'bnxGetBarIndentCatalog source '+sheetName+' failed: '+e.message,p); }
  }
  /* 2026-11-16 ROOT FIX ("bar indent shows menu items, PC, stock —"): an indent is a requisition from the STORE, so the
     list is the store master (RAW_MATERIAL_MASTER: bottles B700/B750, cases, KG …) with its real category as the group and
     its live stock. BAR_ITEM_MASTER (menu pours) + ITEM_MASTER (1,303 menu dishes) used to outrank it, so the screen listed
     menu items with unit PC and no stock. Those two stay only as a fallback when the store master is empty. */
  try{
    const sh=bnxClientSheet(clientId,SHEETS.RAW_MATERIAL_MASTER), vals=sh.getDataRange().getValues(), h=vals[0]||[];
    const rank={LIQUOR:0,BEVERAGE:1,GROCERY:2};
    for(let r=1;r<vals.length;r++){
      const o=bnxRowToObject(vals[r],h);
      if(o.CLIENT_ID && String(o.CLIENT_ID)!==String(clientId)) continue;
      if(upper(o.STATUS)==='INACTIVE' || o.IS_ACTIVE===false || upper(o.IS_ACTIVE)==='FALSE') continue;
      const id=norm(o.ITEM_CODE||o.RAW_MATERIAL_ID||o.ITEM_ID), name=norm(o.ITEM_NAME||o.MATERIAL_NAME||o.NAME); if(!id||!name) continue;
      const rc=upper(o.CATEGORY), cat=/LIQU|BREWPUB/.test(rc)||/^(OS|IF|OI)[- ]|^BEER\b/.test(upper(name))?'LIQUOR':(/BEVERAGE/.test(rc)?'BEVERAGE':'GROCERY');
      add({ITEM_ID:id,ITEM_NAME:name,CATEGORY:cat,UNIT:norm(o.UOM||o.UNIT||'PC').toUpperCase(),GROUP_NAME:rc||cat,SOURCE:'RAW_MATERIAL_MASTER',LOCATION_ID:locationId,
        CURRENT_STOCK:Number(o.CURRENT_STOCK)||0,COST_PRICE:Number(o.COST_PRICE)||0,_r:rank[cat]});
    }
  }catch(e){ bnxLogError(clientId,'bnxGetBarIndentCatalog store master failed: '+e.message,p); }
  if(out.length){
    out.sort((a,b)=>(a._r-b._r)||String(a.GROUP_NAME).localeCompare(String(b.GROUP_NAME))||String(a.ITEM_NAME).localeCompare(String(b.ITEM_NAME)));
    out.forEach(x=>{ delete x._r; });
    return {success:true,data:{items:out,count:out.length,locationId,source:'RAW_MATERIAL_MASTER'},items:out,count:out.length};
  }
  readSource(SHEETS.BAR_ITEM_MASTER,['BAR_ITEM_ID','ITEM_ID','ITEM_CODE'],['ITEM_NAME','MENU_ITEM_NAME'],['UOM','UNIT','UNIT_ID']);
  readSource(SHEETS.ITEM_MASTER,['ITEM_ID','ITEM_CODE'],['ITEM_NAME','NAME'],['UOM','UNIT','UNIT_NAME','UNIT_ID']);
  out.sort((a,b)=>String(a.CATEGORY).localeCompare(String(b.CATEGORY))||String(a.ITEM_NAME).localeCompare(String(b.ITEM_NAME)));
  return {success:true,data:{items:out,count:out.length,locationId},items:out,count:out.length};
}

function bnxGetBarIndentStock_(session,payload){
  const clientId=String(session&&session.CLIENT_ID||'').trim();
  const p=payload||{}, locationId=String(p.locationId||p.LOCATION_ID||'').trim();
  if(!clientId)return {success:false,error:'Client session is required',items:[]};
  try{
    const out=new Map();
    const put=(id,obj)=>{
      id=String(id||'').trim().toUpperCase();
      if(!id)return;
      const q=Number(obj.qty);
      if(!isFinite(q))return;
      // When multiple locations are returned, aggregate unless a location was
      // explicitly requested. This matches bnxGetAvailableStockQty_ semantics.
      if(out.has(id)) out.get(id).qty=+(out.get(id).qty+q).toFixed(4);
      else out.set(id,{ITEM_ID:String(obj.itemId||id),ITEM_CODE:String(obj.itemCode||''),AVAILABLE_QUANTITY:q,CURRENT_QUANTITY:q,CURRENT_STOCK:q,STOCK:q});
    };

    // Primary live balance: AVAILABLE_QUANTITY is what a requisition screen
    // should show because reserved stock is not available to issue.
    try{
      const sh=bnxClientSheet(clientId,SHEETS.STOCK_BALANCE);
      const vals=sh.getDataRange().getValues(), h=vals[0]||[];
      const idCols=['ITEM_ID','ITEM_CODE'].map(n=>h.indexOf(n)).filter(i=>i>=0);
      const ci=h.indexOf('CLIENT_ID'), loc=h.indexOf('LOCATION_ID');
      const aq=h.indexOf('AVAILABLE_QUANTITY'), cq=h.indexOf('CURRENT_QUANTITY');
      for(let r=1;r<vals.length;r++){
        if(ci>=0&&String(vals[r][ci])!==clientId)continue;
        if(locationId&&loc>=0&&String(vals[r][loc]||'')!==locationId)continue;
        const id=idCols.map(c=>String(vals[r][c]||'').trim()).find(Boolean);
        if(!id)continue;
        const q=Number(aq>=0?vals[r][aq]:(cq>=0?vals[r][cq]:''));
        if(isFinite(q))put(id,{itemId:id,qty:q});
      }
    }catch(e){}

    // Fallback for raw-material items whose stock is still maintained in the
    // live master. Only fill missing IDs so STOCK_BALANCE remains authoritative.
    try{
      const sh=bnxClientSheet(clientId,SHEETS.RAW_MATERIAL_MASTER);
      const vals=sh.getDataRange().getValues(), h=vals[0]||[];
      const idCols=['ITEM_CODE','RAW_MATERIAL_ID','ITEM_ID'].map(n=>h.indexOf(n)).filter(i=>i>=0);
      const stockCols=['CURRENT_STOCK','CURRENT_QUANTITY','AVAILABLE_STOCK','STOCK'].map(n=>h.indexOf(n)).filter(i=>i>=0);
      for(let r=1;r<vals.length;r++){
        const id=idCols.map(c=>String(vals[r][c]||'').trim()).find(Boolean);
        if(!id||out.has(id.toUpperCase()))continue;
        let q=null;
        for(const c of stockCols){const n=Number(vals[r][c]);if(isFinite(n)){q=n;break;}}
        if(q!==null)put(id,{itemId:id,qty:q});
      }
    }catch(e){}

    // Bridge master aliases so BAR_ITEM_MASTER.BAR_ITEM_ID can display the
    // same live stock that is stored under ITEM_MASTER/RAW_MATERIAL_MASTER
    // ITEM_ID or ITEM_CODE.
    try{
      const sources=[
        {sheet:SHEETS.BAR_ITEM_MASTER,ids:['BAR_ITEM_ID','ITEM_ID','ITEM_CODE']},
        {sheet:SHEETS.ITEM_MASTER,ids:['ITEM_ID','ITEM_CODE']},
        {sheet:SHEETS.RAW_MATERIAL_MASTER,ids:['ITEM_CODE','RAW_MATERIAL_ID','ITEM_ID']}
      ];
      sources.forEach(src=>{
        try{
          const sh=bnxClientSheet(clientId,src.sheet),vals=sh.getDataRange().getValues(),h=vals[0]||[];
          const cols=src.ids.map(n=>h.indexOf(n)).filter(i=>i>=0);
          for(let r=1;r<vals.length;r++){
            const ids=cols.map(c=>String(vals[r][c]||'').trim()).filter(Boolean);
            if(ids.length<2)continue;
            let sourceObj=null;
            for(const id of ids){sourceObj=out.get(id.toUpperCase());if(sourceObj)break;}
            if(!sourceObj)continue;
            ids.forEach(id=>{
              const k=id.toUpperCase();
              if(!out.has(k)) out.set(k,{ITEM_ID:id,ITEM_CODE:id,AVAILABLE_QUANTITY:sourceObj.qty,CURRENT_QUANTITY:sourceObj.qty,CURRENT_STOCK:sourceObj.qty,STOCK:sourceObj.qty});
            });
          }
        }catch(e){}
      });
    }catch(e){}

    const items=Array.from(out.values());
    return {success:true,items,data:{items,locationId},count:items.length,locationId};
  }catch(e){
    bnxLogError(clientId,'bnxGetBarIndentStock failed: '+e.message,payload||{});
    return {success:false,error:e.message,message:e.message,items:[],data:{items:[]}};
  }
}

function bnxSaveBarIndent(session,payload){
  const clientId=session.CLIENT_ID,p=payload||{},items=Array.isArray(p.items)?p.items:[];
  if(!items.length)return {success:false,message:'At least one bar indent item is required'};
  const requestId=String(p.requestId||p.REQUEST_ID||'').trim();
  const claim=bnxClaimRequest(clientId,requestId,'BAR_INDENT');
  if(!claim.claimed) return {success:true,transactionId:claim.existing.transactionId||'',cached:true,savedCount:0};
  const lock=bnxAcquireScriptLockWithRetry_(3,10000);
  try{
    const sh=bnxClientSheet(clientId,SHEETS.BAR_INDENT);
    bnxEnsureColumns_(sh,['IND_ID','CLIENT_ID','DATE','ITEM_ID','ITEM_NAME','UNIT','REQUIRED_QTY','ISSUED_QTY','ISSUED_BY','STATUS','REMARKS','CATEGORY','DEPARTMENT','SHIFT','PRIORITY']);
    const now=bnxNowParts_(),date=String(p.date||p.indentDate||now.businessDate).slice(0,10); bnxAssertBusinessDayOpen_(clientId,date);
    const batch=String(p.indentId||p.indId||p.indentNo||'').trim()||('BAR-IND-'+Date.now()),saved=[];
    for(let i=0;i<items.length;i++){
      const e=items[i]||{},qty=Number(e.requiredQty!=null?e.requiredQty:e.REQUIRED_QTY)||0;if(!(qty>0))continue;
      const resolved=bnxResolveBarIndentItem_(clientId,e.itemId||e.ITEM_ID||e.itemCode||e.ITEM_CODE,e.itemName||e.ITEM_NAME||e.name);
      if(!resolved)throw new Error('Bar indent item is not a unique live master item: '+String(e.itemName||e.ITEM_NAME||e.itemId||e.ITEM_ID||('line '+(i+1))));
      const indId=generateShortId_(clientId,'BAR_INDENT_ID');
      bnxAppendRow(clientId,SHEETS.BAR_INDENT,{IND_ID:indId,CLIENT_ID:clientId,DATE:date,ITEM_ID:resolved.itemId,ITEM_NAME:resolved.itemName,UNIT:String(e.unit||e.UOM||'').trim(),REQUIRED_QTY:qty,ISSUED_QTY:0,ISSUED_BY:'',STATUS:'PENDING',REMARKS:String(e.note||e.notes||e.remarks||p.remarks||'').trim(),CATEGORY:String(e.category||e.CATEGORY||'').trim(),DEPARTMENT:String(e.department||p.department||'BAR').trim(),SHIFT:String(e.shift||p.shift||'All Day').trim(),PRIORITY:String(e.priority||p.priority||'Normal').trim()});
      saved.push({IND_ID:indId,itemId:resolved.itemId,itemName:resolved.itemName,requiredQty:qty,line:i+1});
    }
    if(!saved.length)return {success:false,message:'No positive requested quantities were supplied'};
    try{bnxCreateAuditLog(clientId,{CLIENT_ID:clientId,USER_ID:session.USER_ID||'',ACTION:'CREATE',MODULE:'BAR_INDENT',RECORD_TYPE:'BAR_INDENT',RECORD_ID:batch,OLD_VALUE:'{}',NEW_VALUE:JSON.stringify({batchId:batch,items:saved}),TIMESTAMP:now.iso});}catch(e){}
    bnxMarkSynced(clientId,requestId,batch,'BAR_INDENT');
    try{bnxInvalidateTodayReportCaches_(clientId);}catch(e){}
    return {success:true,indentId:batch,indents:saved,savedCount:saved.length,date:date};
  }catch(e){bnxLogError(clientId,'bnxSaveBarIndent failed: '+e.message,p);return {success:false,message:e.message,error:e.message};}
  finally{try{lock.releaseLock();}catch(e){}}
}
function bnxGetBarIndent(session,payload){
  const clientId=session.CLIENT_ID,p=payload||{},rows=[];
  try{
    const sh=bnxClientSheet(clientId,SHEETS.BAR_INDENT),v=sh.getDataRange().getValues(),h=v[0]||[],range=bnxResolveDateRange_(p);
    for(let r=1;r<v.length;r++){const o=bnxRowToObject(v[r],h);if(o.CLIENT_ID&&String(o.CLIENT_ID)!==String(clientId))continue;const d=bnxNormalizeDateKey_(o.DATE);if(d&&(d<range.from||d>range.to))continue;rows.push(o);}
    rows.sort((a,b)=>String(b.DATE).localeCompare(String(a.DATE))||String(b.IND_ID).localeCompare(String(a.IND_ID)));
    return {success:true,data:{rows,from:range.from,to:range.to},rows};
  }catch(e){bnxLogError(clientId,'bnxGetBarIndent failed: '+e.message,p);return {success:false,message:e.message,error:e.message,data:{rows:[]}};}
}


// PASS #68 — LIVE KITCHEN CONSUMPTION / WASTAGE POSTING
// These actions are intentionally transactional: every accepted entry writes
// the source sheet AND one STOCK_MOVEMENT row, then updates STOCK_BALANCE.
// No local-only consumption/wastage records are treated as stock.
function bnxResolveInventoryItem_(clientId, itemId, itemName) {
  const id = String(itemId || '').trim();
  const suppliedName = String(itemName || '').trim();

  // Kitchen consumption/wastage is allowed to use either:
  // 1) ITEM_MASTER (legacy/finished inventory items), or
  // 2) RAW_MATERIAL_MASTER (authoritative kitchen ingredient master).
  // Never create a phantom item and never accept an ambiguous name.
  const sources = [
    {sheet:SHEETS.ITEM_MASTER, ids:['ITEM_ID','ITEM_CODE'], names:['ITEM_NAME','NAME']},
    {sheet:SHEETS.RAW_MATERIAL_MASTER, ids:['ITEM_CODE','RAW_MATERIAL_ID','ITEM_ID'], names:['ITEM_NAME','MATERIAL_NAME','NAME']}
  ];
  const activeOK = (row,h) => {
    const ai=h.indexOf('IS_ACTIVE'), st=h.indexOf('STATUS');
    if(ai>=0 && (row[ai]===false || String(row[ai]).toUpperCase()==='FALSE')) return false;
    if(st>=0 && String(row[st]||'').trim().toUpperCase()==='INACTIVE') return false;
    return true;
  };

  // Exact ID first. ITEM_MASTER remains first for backward compatibility.
  if(id){
    for(const src of sources){
      try{
        const sh=bnxClientSheet(clientId,src.sheet), v=sh.getDataRange().getValues(), h=v[0]||[];
        const idCols=src.ids.map(x=>h.indexOf(x)).filter(x=>x>=0);
        const nameCols=src.names.map(x=>h.indexOf(x)).filter(x=>x>=0);
        for(let r=1;r<v.length;r++){
          if(!activeOK(v[r],h)) continue;
          if(!idCols.some(c=>String(v[r][c]||'').trim()===id)) continue;
          const nm=suppliedName || (nameCols.length?String(v[r][nameCols[0]]||'').trim():'');
          if(!nm) continue;
          return {itemId:id,itemName:nm,source:src.sheet};
        }
      }catch(e){}
    }
  }

  // Unique exact name fallback across both masters.
  const name=suppliedName.toLowerCase();
  if(!name) return null;
  const hits=[];
  for(const src of sources){
    try{
      const sh=bnxClientSheet(clientId,src.sheet), v=sh.getDataRange().getValues(), h=v[0]||[];
      const idCols=src.ids.map(x=>h.indexOf(x)).filter(x=>x>=0);
      const nameCols=src.names.map(x=>h.indexOf(x)).filter(x=>x>=0);
      for(let r=1;r<v.length;r++){
        if(!activeOK(v[r],h)||!nameCols.length) continue;
        const rowName=String(v[r][nameCols[0]]||'').trim();
        if(rowName.toLowerCase()!==name) continue;
        const rid=idCols.length?String(v[r][idCols[0]]||'').trim():'';
        if(rid) hits.push({itemId:rid,itemName:rowName,source:src.sheet});
      }
    }catch(e){}
  }
  // Same ID can appear in both sources; collapse exact-ID duplicates.
  const byId={}; hits.forEach(x=>{byId[x.itemId]=x;});
  const unique=Object.keys(byId).map(k=>byId[k]);
  return unique.length===1 ? unique[0] : null;
}



function bnxSaveKitchenConsumption(session,payload){
  const clientId=session.CLIENT_ID, p=payload||{};
  const entries=Array.isArray(p.entries)?p.entries:[p];
  if(!entries.length)return {success:false,message:'Consumption entries required'};
  const results=[],lock=bnxAcquireScriptLockWithRetry_(3,10000);
  try{
    bnxEnsureColumns_(bnxClientSheet(clientId,SHEETS.KITCHEN_CONSUMPTION),
      ['CON_ID','CLIENT_ID','DATE','TIME','ITEM_ID','ITEM_NAME','CATEGORY','UNIT','OPENING','RECEIVED','ISSUED','CLOSING','WASTAGE','RATE','PURPOSE','SHIFT','DEPARTMENT','INDENT_ID','ENTERED_BY','CREATED_AT']);
    for(const e of entries){
      const item=bnxResolveInventoryItem_(clientId,e.itemId||e.ITEM_ID,e.itemName||e.ITEM_NAME);
      if(!item)return {success:false,message:'A valid unique ITEM_MASTER item is required; item name was not uniquely matched'};
      const qty=Number(e.issued!=null?e.issued:(e.issuedQty!=null?e.issuedQty:e.QTY));
      if(!(qty>0))return {success:false,message:'Consumption quantity must be greater than zero'};
      const date=String(e.date||e.DATE||p.date||p.DATE||bnxBusinessDateKey_(new Date())).slice(0,10);
      bnxAssertBusinessDayOpen_(clientId,date);
      const locationId=String(e.locationId||e.LOCATION_ID||'').trim();
      const available=bnxGetAvailableStockQty_(clientId,item.itemId,locationId);
      if(available===null)return {success:false,message:'Live stock is unavailable for '+item.itemName+'. Update STOCK_BALANCE or RAW_MATERIAL_MASTER.CURRENT_STOCK before posting consumption.'};
      if(available+1e-9<qty)return {success:false,message:'Insufficient available stock for '+item.itemName+'. Available: '+available+', requested: '+qty};
      const nowParts=bnxNowParts_(), now=nowParts.iso;
      const time=String(e.time||e.TIME||p.time||p.TIME||nowParts.time);
      const rate=bnxGetItemPurchaseRate_(clientId,item.itemId),conId=generateShortId_(clientId,'CON_ID');
      const opening=available===null?0:available;
      bnxAppendRow(clientId,SHEETS.KITCHEN_CONSUMPTION,{CON_ID:conId,CLIENT_ID:clientId,DATE:date,TIME:time,ITEM_ID:item.itemId,ITEM_NAME:item.itemName,CATEGORY:String(e.category||e.CATEGORY||''),UNIT:String(e.unit||e.UNIT||''),OPENING:opening,RECEIVED:0,ISSUED:qty,CLOSING:+(opening-qty).toFixed(4),WASTAGE:0,RATE:rate,PURPOSE:String(e.purpose||e.PURPOSE||''),SHIFT:String(e.shift||e.SHIFT||p.shift||p.SHIFT||''),DEPARTMENT:String(e.department||e.DEPARTMENT||'Main Kitchen'),INDENT_ID:String(e.indentId||e.INDENT_ID||''),ENTERED_BY:String(e.enteredBy||session.USER_ID||'Kitchen'),CREATED_AT:now});
      const movementId=generateShortId_(clientId,'STOCK_MOVEMENT_ID');
      bnxAppendRow(clientId,SHEETS.STOCK_MOVEMENT,{STOCK_MOVEMENT_ID:movementId,CLIENT_ID:clientId,LOCATION_ID:locationId,ITEM_ID:item.itemId,MOVEMENT_TYPE:'CONSUMPTION',MOVEMENT_DATE:date,MOVEMENT_TIME:time,QUANTITY_IN:0,QUANTITY_OUT:qty,RATE:rate,SOURCE_TYPE:'KITCHEN_CONSUMPTION',SOURCE_ID:conId,REFERENCE_NUMBER:conId,NOTES:'Kitchen consumption — '+item.itemName+(e.purpose?' — '+String(e.purpose):''),CREATED_BY:String(e.enteredBy||session.USER_ID||'Kitchen'),CREATED_AT:now});
      bnxUpdateStockBalanceAfterMovement_(clientId,item.itemId,locationId,qty,0,now);
      try{bnxCreateAuditLog(clientId,{CLIENT_ID:clientId,USER_ID:session.USER_ID||'',ACTION:'CREATE',MODULE:'KITCHEN_CONSUMPTION',RECORD_TYPE:'CONSUMPTION',RECORD_ID:conId,OLD_VALUE:'{}',NEW_VALUE:JSON.stringify({itemId:item.itemId,qty,rate,date}),TIMESTAMP:now});}catch(ae){}
      results.push({conId,movementId,itemId:item.itemId,itemName:item.itemName,qty,rate});
    }
    try{bnxInvalidateTodayReportCaches_(clientId);}catch(e){}
    return {success:true,entries:results};
