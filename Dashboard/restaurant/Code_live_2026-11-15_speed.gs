function bnxIgcSlot_(name, ovr) {
  var n = bnxIgcName_(name);
  if (ovr && ovr[n]) { var v = ovr[n]; return BNX_IGC_SLOTS[v] || ''; }
  if (!n || n === 'UNGROUPED') return '';
  if (/HUKKA|HOOKAH|HOOKA|HUKA|SHISHA|TOBACCO|HASH ?FREEZ/.test(n)) return 'hf';
  if (/LIQUOR|ALCOHOL|\bBAR\b|WINE|BEER|SPIRIT|WHISK|VODKA|\bRUM\b|\bGIN\b|COCKTAIL/.test(n)) return /\bMRP\b|\bBTL\b|BOTTLE/.test(n) ? 'mrp' : 'liquor';
  if (/BEVERAGE|BEV\b|DRINK|MOCKTAIL|JUICE|SOFT|SHAKE|COFFEE|\bTEA\b|WATER/.test(n)) return 'bev';
  if (/^FOOD|\bFOOD\b|KITCHEN|ADD-?ONS?\b|DESSERT|STARTER|MAIN COURSE|SNACK/.test(n)) return 'food';
