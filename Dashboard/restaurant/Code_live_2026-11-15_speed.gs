      if (!/^\d{4}-\d{2}-\d{2}$/.test(dk)) continue;
      var o = {};
      for (var c2 = 0; c2 < h.length; c2++) {
        var name = h[c2]; if (!name) continue;
        var x = v[r][c2];
        o[name] = x instanceof Date ? x.toISOString() : (x === '' ? null : x);
      }
      o.BUSINESS_DATE = dk;
      byDay[dk] = o;                                            // a later row for the same day wins (rebuilt row)
    }
    var rows = Object.keys(byDay).sort().map(function (k) { return byDay[k]; });
    try { bnxBigCachePut_(key, JSON.stringify(rows), 600); } catch (e) {}
    return { success: true, data: rows, count: rows.length };
  } catch (error) {
    try { bnxLogError(clientId, 'bnxReadDsrItemGroupCalc_ failed: ' + error.message, payload || {}); } catch (e) {}
    return { success: false, error: error.message };
  }
}

/* =====================================================================================================
 * PATCH 2026-10-23 (C) — a billed / closed order can no longer be re-opened by a status update.
 *  ROOT CAUSE ("12 tables still had an order from an earlier day (F17, F18, F19, F20, OD3, OD7, OD8, OD9 …)"):
 *    bnxUpdateOrderStatus (UPDATE_ORDER_STATUS — steward app / KDS) wrote ANY status on ANY order. On 23-10 17:03-17:05 the
 *    steward app (user 3) pushed the 12 orders of 22-10 — all COMPLETED, "Billed as HT/2627/00008067…8078" — back through
 *    PROGRESS → READY → SERVED, so they counted as open again and the floor flagged their tables.
 *  FIX: an order that is closed (COMPLETED / BILLED / CANCELLED / VOID / SETTLED / PAID / CLOSED) or already carries
 *    "Billed as <bill no>" keeps its status when an update tries to move it back to an open status. The reply is
 *    success:true with the order's real status + locked:true, so the app drops it instead of retrying.
 *    Closing moves (→ COMPLETED / CANCELLED …) still pass. ADMIN / OWNER / MANAGER can still re-open with payload.reopen = true.
 * ===================================================================================================== */
