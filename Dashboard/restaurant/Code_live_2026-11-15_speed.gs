}

function bnxIgcGroupLog_(cid, groups) {
  var name = { liquor: 'Liquor', mrp: 'Liquor MRP', food: 'Food', bev: 'Beverage', hf: 'Hukka', OWN: 'OWN ROW' };
  return Object.keys(groups).sort().map(function (k) {
    var x = groups[k];
    return '     • ' + k + '  →  ' + (name[x.slot] || x.slot) + '   (' + x.rows + ' item rows, ₹' + Math.round(x.value).toLocaleString('en-IN') + ')';
  }).join('\n');
}

function RUN_19_BuildDsrItemGroups() {
  try { CacheService.getScriptCache().remove('DSR_IGC_FOUND'); } catch (e) {}
  BNX_IGC_FOUND_ = null;
  Logger.log('Clients: ' + bnxIgcClients_().join(', '));
  var lock = bnxTenantLock_();
  if (!lock.tryLock(30000)) { Logger.log('Another DSR item-group build is running — skipped.'); return; }
  try {
    bnxIgcClients_().forEach(function (cid) {
      try {
        var r = bnxIgcBuild_(cid);
        Logger.log('✅ ' + cid + ' · ' + BNX_IGC_TAB + ' rebuilt in ' + r.db + ' — ' + r.days + ' day(s), ' + Math.round(r.ms / 1000) + ' s\n' + bnxIgcGroupLog_(cid, r.groups));
      } catch (e) { Logger.log('❌ ' + cid + ' · ' + e.message); }
