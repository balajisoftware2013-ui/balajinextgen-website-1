/* item cost per unit: recipe → item master / bar item master cost columns */
function bnxCostRates_(cid){
  var key='costrates_v1_'+cid+'_'+bnxCostGen_(cid)+'_'+(function(){try{return CacheService.getScriptCache().get('itemmetagen_'+cid)||'0';}catch(e){return '0';}})();
  try{var hit=bnxBigCacheGet_(key);if(hit)return JSON.parse(hit);}catch(e){}
  var byId={},byName={},src={};
  function take(sheetName,idKeys,nameKeys,rateKeys,tag){
    try{var sh=bnxClientSheet(cid,sheetName),v=sh.getDataRange().getValues(),h=(v[0]||[]).map(String),ci=h.indexOf('CLIENT_ID');
      var ids=idKeys.map(function(k){return h.indexOf(k);}).filter(function(i){return i>=0;}),nm=nameKeys.map(function(k){return h.indexOf(k);}).filter(function(i){return i>=0;}),rt=rateKeys.map(function(k){return h.indexOf(k);}).filter(function(i){return i>=0;});
      if(!rt.length)return;
      for(var r=1;r<v.length;r++){if(ci>=0&&v[r][ci]&&String(v[r][ci])!==cid)continue;
        var rate=0;for(var j=0;j<rt.length;j++){var x=Number(v[r][rt[j]]);if(x>0){rate=x;break;}}if(!(rate>0))continue;
        ids.forEach(function(i){var k=String(v[r][i]||'').trim();if(k&&!byId[k]){byId[k]=rate;src[k]=tag;}});
        nm.forEach(function(i){var k=String(v[r][i]||'').trim().toLowerCase();if(k&&!byName[k])byName[k]=rate;});}
    }catch(e){}
  }
  /* recipe first: cost of one portion */
  try{var rm=bnxClientSheet(cid,SHEETS.RECIPE_MASTER),v=rm.getDataRange().getValues(),h=(v[0]||[]).map(String),I=function(k){return h.indexOf(k);};
    for(var r=1;r<v.length;r++){var it=String(v[r][I('ITEM_ID')]||'').trim();if(!it)continue;if(I('STATUS')>=0&&/INACTIVE|ARCHIV|DELETED/i.test(String(v[r][I('STATUS')])))continue;
      var per=Number(v[r][I('COST_PER_YIELD')]),tot=Number(v[r][I('TOTAL_COST')]),y=Number(v[r][I('YIELD_QTY')])||1,c=per>0?per:(tot>0?tot/y:0);
      if(c>0&&(!byId[it]||String(v[r][I('STATUS')]).toUpperCase()==='ACTIVE')){byId[it]=c;src[it]='recipe';}}}catch(e){}
  take(SHEETS.ITEM_MASTER,['ITEM_ID','ITEM_CODE'],['ITEM_NAME'],['COST_PRICE','PURCHASE_RATE','PURCHASE_PRICE','LAST_PURCHASE_RATE','COST_RATE'],'item');
  take(SHEETS.BAR_ITEM_MASTER,['ITEM_ID','BAR_ITEM_ID'],['ITEM_NAME'],['COST_PER_SERVING','SERVING_COST','COST_PRICE','PURCHASE_RATE','PURCHASE_PRICE'],'bar');
  var out={byId:byId,byName:byName,src:src};
  try{bnxBigCachePut_(key,JSON.stringify(out),3600);}catch(e){}
  return out;
}

function bnxCostingReport_(session,payload){
  var cid=String(session.CLIENT_ID||''),p=payload||{};
  if(!bnxCostRole_(session))return {success:false,statusCode:403,error:'Costing needs Owner / Manager / Accounts login'};
  var from=bnxCostDate_(p.from)||bnxBusinessDateKey_(),to=bnxCostDate_(p.to)||from;if(from>to){var x0=from;from=to;to=x0;}
  var span=(new Date(to+'T12:00:00Z')-new Date(from+'T12:00:00Z'))/864e5;if(span>186)return {success:false,error:'Choose up to 6 months at a time'};
  var cfg=bnxCostCfg_(cid),basis=p.basis==='purchase'||p.basis==='item'?p.basis:cfg.basis;
  var gen=(function(){try{var c=CacheService.getScriptCache();return (c.get('livegen_'+cid)||'0')+'.'+(c.get('billgen_'+cid)||'0');}catch(e){return '0';}})()+'.'+bnxCostGen_(cid);
  var ck='costrep_v1_'+cid+'_'+from+'_'+to+'_'+basis+'_'+gen;
  if(p.hardRefresh!==true){try{var hit=bnxBigCacheGet_(ck);if(hit){var o=JSON.parse(hit);o.cached=true;return o;}}catch(e){}}
  var out=bnxCostingCompute_(session,cid,from,to,basis,cfg);
