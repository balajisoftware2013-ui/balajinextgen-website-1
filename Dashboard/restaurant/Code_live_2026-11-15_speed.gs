    const d = bnxNormalizeDateKey_(values[r][dateCol]);
    if (!d || d < from || d > to) continue;
    toDelete.push(r + 1);
  }
  bnxDeleteRowsSafe_(sheet, toDelete);
  if (rows && rows.length) {
    const toAppend = rows.map(function (o) { return headers.map(function (h) { return (o[h] === undefined ? '' : o[h]); }); });
    sheet.getRange(sheet.getLastRow() + 1, 1, toAppend.length, headers.length).setValues(toAppend);
  }
}

