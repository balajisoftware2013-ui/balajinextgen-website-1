/* ONE-TIME (run from the editor): event costs already posted as CASH → cash entry VOID, cost moved to payable.
   CL00010: 06-11-2026 DJ ₹30,000 + HOTEL ₹3,500 (DJ Techno). Safe to run twice. */
function RUN_EventCostsToPayable(){
  var cid='CL00010',T=bnxCostRows_(cid,'COST_ENTRY'),t=T.t,pm=t.h.indexOf('PAY_MODE'),cm=t.h.indexOf('CASH_MOVEMENT_ID'),n=0,log=[];
  T.rows.forEach(function(x){
    if(!String(x.EVENT_ID||'').trim()||String(x.PAY_MODE||'').toUpperCase()==='PAYABLE')return;
    bnxCostVoidCash_(cid,x.CASH_MOVEMENT_ID);
    bnxApplySupplierDueDelta_(cid,'',bnxCostPayableId_(x.VENDOR,x.CATEGORY),bnxCostR2_(x.AMOUNT),bnxCostDate_(x.COST_DATE));
    if(pm>=0)t.sh.getRange(x._row,pm+1).setValue('PAYABLE');if(cm>=0)t.sh.getRange(x._row,cm+1).setValue('');
    n++;log.push(x.COST_DATE+' '+x.CATEGORY+' '+x.AMOUNT+' → '+bnxCostPayableId_(x.VENDOR,x.CATEGORY));
  });
  try{bnxCostBump_(cid);}catch(e){}try{bnxInvalidateTodayReportCaches_(cid);}catch(e){}
  Logger.log(n+' event cost(s) moved to payable'+(log.length?':\n'+log.join('\n'):' (nothing to move)'));
}
function bnxCostSaveCost_(session,cid,r,now,user){
  var T=bnxCostRows_(cid,'COST_ENTRY'),t=T.t,id=String(r.COST_ID||'').trim(),cur=id?T.rows.filter(function(x){return String(x.COST_ID)===id;})[0]:null;
  if(id&&!cur)return {success:false,error:'Cost entry not found (deleted on another PC?)'};
  if(r.remove===true){bnxCostVoidCash_(cid,cur.CASH_MOVEMENT_ID);bnxCostPayableUndo_(cid,cur);t.sh.deleteRow(cur._row);return {success:true,data:{removed:id}};}
  var d=bnxCostDate_(r.COST_DATE),amt=bnxCostR2_(r.AMOUNT),cat=String(r.CATEGORY||'OTHER').toUpperCase().replace(/[^A-Z0-9_]/g,'_').slice(0,24),mode=String(r.PAY_MODE||'CASH').toUpperCase().slice(0,12);
  if(!d)return {success:false,error:'Date required'};if(!(amt>0))return {success:false,error:'Amount must be more than 0'};
  /* 2026-11-14 ("event expense all add in payable a/c"): a cost booked against a party / event is owed to the vendor —
     it goes to SUPPLIER_DUES (payable), never into the cash book. Paying it later is a normal supplier payment. */
  var evId=String(r.EVENT_ID||'').trim();
  if(evId){mode='PAYABLE';r.postCash=false;}
  var wantCash=r.postCash===true&&mode==='CASH';
  if(wantCash&&bnxIsBusinessDateClosed_(cid,d)&&!(cur&&cur.CASH_MOVEMENT_ID&&bnxCostDate_(cur.COST_DATE)===d&&bnxCostR2_(cur.AMOUNT)===amt))
    return {success:false,error:'Business date '+d+' is closed — untick "Also take it out of the Cash Book" or reopen the day'};
  if(!id)id='CST'+Utilities.formatDate(new Date(),'Asia/Kolkata','yyMMddHHmmss')+Math.floor(Math.random()*90+10);
  var desc=String(r.DESCRIPTION||'').trim().slice(0,200),ven=String(r.VENDOR||'').trim().slice(0,80),ev=String(r.EVENT_ID||'').trim().slice(0,40);
  var mid=cur?String(cur.CASH_MOVEMENT_ID||''):'';
  var cashSame=cur&&mid&&bnxCostDate_(cur.COST_DATE)===d&&bnxCostR2_(cur.AMOUNT)===amt&&String(cur.CATEGORY)===cat&&String(cur.PAY_MODE||'').toUpperCase()==='CASH';
  if(mid&&(!wantCash||!cashSame)){bnxCostVoidCash_(cid,mid);mid='';}
  if(wantCash&&!mid){
    var cm=bnxSaveCashMovement(session,{direction:'OUT',amount:amt,paymentMode:'CASH',date:d,category:'EXPENSE_'+cat,description:[cat.replace(/_/g,' '),ven,desc].filter(String).join(' · ').slice(0,200),sourceType:'COSTING',sourceId:id,reference:id});
    if(!cm||!cm.success)return {success:false,error:'Cost not saved — Cash Book entry failed: '+((cm&&cm.error)||'unknown')};
    mid=cm.movementId||'';
  }
  bnxCostPayableUndo_(cid,cur);                                   /* old payable amount out … */
  if(mode==='PAYABLE')bnxApplySupplierDueDelta_(cid,'',bnxCostPayableId_(ven,cat),amt,d);   /* … new amount in */
  var o={COST_ID:id,COST_DATE:d,CATEGORY:cat,AMOUNT:amt,EVENT_ID:ev,VENDOR:ven,DESCRIPTION:desc,PAY_MODE:mode,CASH_MOVEMENT_ID:mid,
    CREATED_AT:cur?cur.CREATED_AT:now,CREATED_BY:cur?cur.CREATED_BY:user,UPDATED_AT:now,UPDATED_BY:user};
  var line=t.h.map(function(k){return o[k]!==undefined?o[k]:(cur?cur[k]:'');});
  if(cur)t.sh.getRange(cur._row,1,1,line.length).setValues([line]);else t.sh.getRange(t.sh.getLastRow()+1,1,1,line.length).setValues([line]);
  return {success:true,data:{row:o}};
}
function bnxCostSaveEvent_(cid,r,now,user){
