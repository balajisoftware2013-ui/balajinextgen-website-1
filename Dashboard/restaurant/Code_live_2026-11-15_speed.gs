}

function bnxIgcBuild_(cid) {
  var t0 = Date.now(), ss = bnxIgcOpenDb_(cid);
  var BM = bnxIgcRead_(ss, 'BILL_MASTER'), BI = bnxIgcRead_(ss, 'BILL_ITEMS'), SH = bnxIgcRead_(ss, 'DSR_ITEM_GROUP_DAILY');
  var IM = ss.getSheetByName('ITEM_MASTER') ? bnxIgcRead_(ss, 'ITEM_MASTER') : { h: {}, rows: [] };
  var b = BM.h, it = BI.h, ovr = bnxIgcOverride_(cid), mrpIgnore = bnxIgcMrpIgnore_();
  function g(row, H, k) { return H[k] == null ? '' : row[H[k]]; }

  var imGroup = {};
  IM.rows.forEach(function (r) {
    var gn = bnxIgcName_(g(r, IM.h, 'ITEM_GROUP_NAME') || g(r, IM.h, 'GROUP_NAME'));
    if (!gn) return;
    ['ITEM_ID', 'ITEM_CODE', 'CODE'].forEach(function (k) { var v = bnxIgcName_(g(r, IM.h, k)); if (v) imGroup[v] = gn; });
  });

  /* 2026-11-10 ("DSR food / beverage / liquor MRP not match"): item lines of dishes / bottles that are not in the item master
     (no ITEM_ID, no ITEM_GROUP_NAME — e.g. SAFFRON PANEER TIKKA, MAKAI CHEESE JELAPENO, ROKU BTL, TANQUERY 10 BTL) fell into
     an "UNGROUPED" extra row, so their value never reached Food / Liquor / Liquor MRP (₹38,051 on 31-10, 06-11, 07-11, 09-11).
     Now: (1) the group the same item name has on other bills, (2) a bottle / MRP / spirit name → LIQUOR, (3) anything else → FOOD. */
  var nameGroup = {};
  BI.rows.forEach(function (r) { var gn = bnxIgcName_(g(r, it, 'ITEM_GROUP_NAME')); if (!gn || /^GRP\d+$/.test(gn)) return; var k = bnxIgcName_(g(r, it, 'ITEM_NAME')).replace(/[^A-Z0-9]/g, ''); if (k && !nameGroup[k]) nameGroup[k] = gn; });
  function guessGroup_(itemName) {
    var k = bnxIgcName_(itemName).replace(/[^A-Z0-9]/g, ''); if (k && nameGroup[k]) return nameGroup[k];
    var n = bnxIgcName_(itemName);
    if (/\bBTL\b|\bMRP\b|BOTTLE|\b\d{2,4} ?ML\b|WHISK|VODKA|\bGIN\b|\bRUM\b|BEER|WINE|TEQUILA|SCOTCH|BRANDY|LIQUEUR|TANQUER|GLENLIVET|ROKU|JAMESON|SMIRNOFF|ABSOLUT|BACARDI/.test(n)) return 'LIQUOR';
    return n ? 'FOOD' : 'UNGROUPED';
  }
  var groupsSeen = {}, byBill = {};
  BI.rows.forEach(function (r) {
    var id = String(g(r, it, 'BILL_ID') || ''); if (!id) return;
    var a = bnxIgcNum_(g(r, it, 'QUANTITY')) * bnxIgcNum_(g(r, it, 'DISCOUNTED_RATE'));
    /* 2026-11-10 ("hukka sale not match"): 398 imported lines on 61 PAID bills (note "qty from POS NC column (paid bill)", mostly
       23-10 → 08-11) have DISCOUNTED_RATE 0 but carry their real value in TAXABLE_PER_ITEM. Valued at 0, every item of the bill
       vanished and the whole bill went to "No Item Detail" — HASH FREEZER / liquor / food of those bills never reached their columns.
       Such a line now counts at its taxable value; the bill-level scaling below (items above the bill's pre-tax sale → scaled
       down) still applies the bill's discount, so the groups add up to the bill exactly as before. */
    if (!(a > 0)) { var tpi = bnxIgcNum_(g(r, it, 'TAXABLE_PER_ITEM')); if (tpi > 0 && !(bnxIgcNum_(g(r, it, 'DISCOUNTED_RATE')) > 0)) a = tpi; }
    var grp = bnxIgcName_(g(r, it, 'ITEM_GROUP_NAME'));
    if (!grp || /^GRP\d+$/.test(grp)) grp = imGroup[bnxIgcName_(g(r, it, 'ITEM_ID'))] || imGroup[bnxIgcName_(g(r, it, 'ITEM_CODE'))] || guessGroup_(g(r, it, 'ITEM_NAME'));
    var slot = bnxIgcSlot_(grp, ovr);
    /* 2026-11-14 ("liquor MRP not shown · 11,06,676 / 2,04,078"): Liquor MRP was only a GROUP named MRP, so MRP bottles and cans
       (JAMESON MRP BTL, BUDWISER PREM CAN MRP, KF ULTRA MAX MRP CAN …, all in group LIQUOR) stayed in Liquor and LIQUOR_MRP was 0
       on every day without an owner-sheet figure. A liquor line whose ITEM NAME has the word MRP is now Liquor MRP.
       Checked on Nov-26 bills vs the owner DSR: 1, 2, 3, 4, 5, 8, 10, 11, 13 Nov match to the rupee. */
    if (slot === 'liquor' && /\bMRP\b/.test(bnxIgcName_(g(r, it, 'ITEM_NAME')))) slot = 'mrp';
    var gs = groupsSeen[grp] || (groupsSeen[grp] = { slot: slot || 'OWN', value: 0, rows: 0 }); gs.value += a; gs.rows++;
    var o = byBill[id] || (byBill[id] = { s: 0, g: { liquor: 0, mrp: 0, food: 0, bev: 0, hf: 0 }, x: {} });
    o.s += a;
