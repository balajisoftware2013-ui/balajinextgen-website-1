function bnxIgcOpenDb_(cid) {
  var tries = [];
  function test(id, how) {
    if (!id) return null;
    try {
      var ss = SpreadsheetApp.openById(String(id));
      if (ss.getSheetByName('BILL_MASTER') && ss.getSheetByName('BILL_ITEMS')) return ss;
      tries.push(how + ': no BILL_MASTER/BILL_ITEMS');
    } catch (e) { tries.push(how + ': ' + e.message); }
    return null;
  }
  var ss = null;
  var P = PropertiesService.getScriptProperties();
  ss = ss || test(P.getProperty('DSR_TDB_ID_' + cid), 'property DSR_TDB_ID_' + cid);
  ss = ss || test(BNX_IGC_DB_IDS[cid], 'BNX_IGC_DB_IDS[' + cid + ']');
  try { ss = ss || test(bnxIgcDiscover_().ids[cid], 'discovered id (Drive) for ' + cid); } catch (e) { tries.push('discover: ' + e.message); }
  function viaFn(fn, args) {
    var G = (typeof globalThis !== 'undefined') ? globalThis : this;
    if (ss || typeof G[fn] !== 'function') return;
    try { var r = G[fn].apply(G, args); if (r && typeof r === 'object' && !r.getSheetByName) r = r.id || r.spreadsheetId || r.ID || r.transactionDbId || r.TRANSACTION || ''; ss = test(r, fn + '(' + args.join(',') + ')'); }
    catch (e) { tries.push(fn + ': ' + e.message); }
  }
  [['getClientDbId_', [cid, 'TRANSACTION']], ['rbClientSpreadsheetId_', [cid, 'TRANSACTION']], ['getClientDbId_', [cid]], ['rbClientSpreadsheetId_', [cid]],
   ['getTransactionDbId_', [cid]], ['getClientTransactionDbId_', [cid]], ['getTxnDbId_', [cid]], ['getClientSpreadsheetId_', [cid, 'TRANSACTION']]
  ].forEach(function (x) { viaFn(x[0], x[1]); });
  if (!ss) {
    var all = P.getProperties();
    Object.keys(all).forEach(function (k) {
      if (ss) return;
      var K = k.toUpperCase();
      if (K.indexOf(cid) < 0 || !/TRANS|TXN|TDB/.test(K)) return;
      var m = String(all[k]).match(/[-\w]{30,}/); if (m) ss = test(m[0], 'property ' + k);
    });
  }
  if (!ss) {
    try {
      var fi = DriveApp.getFilesByName(cid + '_TRANSACTION_DB');
      while (!ss && fi.hasNext()) ss = test(fi.next().getId(), 'Drive file ' + cid + '_TRANSACTION_DB');
    } catch (e) { tries.push('Drive search: ' + e.message); }
  }
  if (!ss) throw new Error('TRANSACTION DB for ' + cid + ' not found. Set Script property DSR_TDB_ID_' + cid + ' = <spreadsheet ID> or paste it into BNX_IGC_DB_IDS at the top of this file. Tried: ' + (tries.join(' · ') || 'nothing resolved'));
  return ss;
}

function bnxIgcRead_(ss, name) {
