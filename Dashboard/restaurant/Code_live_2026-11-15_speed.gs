function bnxCostRole_(s){return ['ADMIN','SUPER_ADMIN','SUPER ADMIN','OWNER','MANAGER','ACCOUNTANT','ACCOUNTS','DEVELOPER','STORE_MANAGER','STORE MANAGER','MD','CEO'].indexOf(String(s&&s.ROLE||'').toUpperCase())>=0;}
function bnxCostSheet_(cid,name){
  var ss=bnxPqDb_(cid,'TRANSACTION'),H=BNX_COST_H_[name],sh=ss.getSheetByName(name);
  if(!sh){sh=ss.insertSheet(name);}
  if(sh.getLastRow()<1){sh.getRange(1,1,1,H.length).setValues([H]);try{sh.setFrozenRows(1);sh.getRange(1,2,Math.max(2,sh.getMaxRows()),1).setNumberFormat('@');}catch(e){}}
  var h=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),1)).getValues()[0].map(String),miss=H.filter(function(k){return h.indexOf(k)<0;});
  if(miss.length){sh.getRange(1,h.length+1,1,miss.length).setValues([miss]);h=h.concat(miss);}
  return {sh:sh,h:h};
}
function bnxCostRows_(cid,name){
  var t=bnxCostSheet_(cid,name),n=t.sh.getLastRow(),out=[];
  if(n<2)return {t:t,rows:out};
  t.sh.getRange(2,1,n-1,t.h.length).getValues().forEach(function(v,i){var o={_row:i+2};t.h.forEach(function(k,j){var x=v[j];o[k]=x instanceof Date?(/DATE/.test(k)?bnxNormalizeDateKey_(x):x.toISOString()):x;});out.push(o);});
