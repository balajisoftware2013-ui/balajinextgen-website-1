  var st = /^(PROGRESS|IN_PROGRESS|PREPARING|COOKING)$/.test(want) ? 'COOKING' : want, now = new Date().toISOString(), v = k.values.slice();
  var set = function (n, x) { var c = k.headers.indexOf(n); if (c >= 0) v[c] = x; };
  set('KOT_STATUS', st); set('UPDATED_AT', now); if (st === 'SERVED') set('SERVED_AT', now);
