  }
}

/* =========================================================================
 * 2026-09-20 PRODUCTION PATCH
 * Client-folder Drive upload + AI query + live AI purchase suggestions
 * -------------------------------------------------------------------------
 * Drive rule:
 *   <BNX_CLIENT_DB_ROOT_FOLDER_NAME_>/
 *      <CLIENT_ID - COMPANY_NAME>/
 *         <subPath...>/
 *   This uses the same tenant folder already used by client DB provisioning.
 *   No cross-client file writes are permitted.
 * ========================================================================= */

function bnxSafeDriveSegment_(value) {
  return String(value == null ? '' : value).trim()
    .replace(/[<>:"/\\|?*\x00-\x1F]/g, '_')
    .replace(/\s+/g, ' ')
    .slice(0, 120) || 'General';
}

function bnxResolveClientDriveFolder_(clientId) {
  const row = bnxGetClientRegistryRow_(clientId);
  if (!row) throw new Error('Client ' + clientId + ' not found in CLIENT_DATABASE_REGISTRY');
  return bnxEnsureClientFolder_(row);
}

function bnxGetOrCreateDriveSubPath_(parent, subPath) {
  let folder = parent;
  const parts = Array.isArray(subPath) ? subPath : [];
  parts.forEach(function(part) {
    const name = bnxSafeDriveSegment_(part);
    folder = bnxGetOrCreateDriveFolder_(name, folder);
  });
  return folder;
}

function bnxUploadToClientDrive_(session, payload) {
  const clientId = String(session.CLIENT_ID || payload.clientId || '').trim();
  if (!clientId) return { success:false, message:'Authenticated CLIENT_ID is required' };
  const fileName = bnxSafeDriveSegment_(payload.fileName || ('UPLOAD_' + Date.now()));
  const mimeType = String(payload.mimeType || 'application/octet-stream').trim();
  const raw = String(payload.base64Data || payload.data || '').replace(/^data:[^;]+;base64,/, '');
  if (!raw) return { success:false, message:'base64Data is required' };

  const approxBytes = Math.floor(raw.length * 0.75);
  if (approxBytes > 15 * 1024 * 1024) {
    return { success:false, message:'File too large for direct Apps Script upload (max 15MB)' };
  }

  try {
    const root = bnxResolveClientDriveFolder_(clientId);
    const folder = bnxGetOrCreateDriveSubPath_(root, payload.subPath || []);
    const bytes = Utilities.base64Decode(raw);
    const blob = Utilities.newBlob(bytes, mimeType, fileName);
    const file = folder.createFile(blob);
    const url = 'https://drive.google.com/file/d/' + file.getId() + '/view';
    try { file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW); } catch (shareErr) {}
    return {
      success:true,
      clientId:clientId,
      fileId:file.getId(),
      fileName:file.getName(),
      url:url,
      folderId:folder.getId(),
      folderName:folder.getName(),
      usedSharedAccount:true
    };
  } catch (e) {
    bnxLogError(clientId, 'bnxUploadToClientDrive failed: ' + e.message, {
      fileName:fileName, mimeType:mimeType, subPath:payload.subPath || []
    });
    return { success:false, message:e.message };
  }
}

function bnxGetClientDriveStatus_(session, payload) {
  const clientId = String(session.CLIENT_ID || payload.clientId || '').trim();
  if (!clientId) return { success:false, connected:false, message:'CLIENT_ID required' };
  try {
    const folder = bnxResolveClientDriveFolder_(clientId);
    return { success:true, connected:true, clientId:clientId, folderId:folder.getId(), folderName:folder.getName(), usedSharedAccount:true };
  } catch (e) {
    return { success:false, connected:false, message:e.message };
  }
}

function bnxGetClientDriveFolder_(session, payload) {
  const clientId = String(session.CLIENT_ID || payload.clientId || '').trim();
  try {
    const folder = bnxResolveClientDriveFolder_(clientId);
    return { success:true, clientId:clientId, folderId:folder.getId(),
      folderName:folder.getName(),
      url:'https://drive.google.com/drive/folders/' + folder.getId() };
  } catch (e) {
    return { success:false, message:e.message };
  }
}

/* Versioning is intentionally non-destructive: old invoice files are moved
 * into a Versions subfolder under the same client invoice tree. */
function bnxVersionOldFiles_(session, payload) {
  const clientId = String(session.CLIENT_ID || '').trim();
  const invoiceNo = bnxSafeDriveSegment_(payload.invoiceNo || '');
  if (!invoiceNo) return { success:true, moved:0 };
  try {
    const root = bnxResolveClientDriveFolder_(clientId);
    const piRoot = bnxGetOrCreateDriveSubPath_(root, ['Purchase Invoice']);
    const versionFolder = bnxGetOrCreateDriveSubPath_(piRoot, ['Versions', invoiceNo]);
    let moved = 0;
    const it = piRoot.getFiles();
    while (it.hasNext()) {
      const f = it.next();
      if (f.getId() === versionFolder.getId()) continue;
      if (f.getName().indexOf(invoiceNo) === 0) {
        try { f.moveTo(versionFolder); moved++; } catch (e) {}
      }
    }
    return { success:true, moved:moved, folderId:versionFolder.getId() };
  } catch (e) {
    return { success:false, message:e.message };
  }
}

function bnxAIQuery_(session, payload) {
  const clientId = String(session.CLIENT_ID || '').trim();
  const q = String(payload.query || '').trim();
  if (!q) return { ok:false, success:false, message:'Query is required' };

  const props = PropertiesService.getScriptProperties();
  const provider = String(props.getProperty('BNX_AI_PROVIDER') || 'GEMINI').toUpperCase();
  const apiKey = String(props.getProperty('BNX_AI_API_KEY') || '').trim();
  if (!apiKey) {
    return { ok:false, success:false, code:'AI_NOT_CONFIGURED',
      message:'AI provider is not configured. Set Script Properties BNX_AI_PROVIDER and BNX_AI_API_KEY.' };
  }

  const company = String(payload.company || clientId);
  const page = String(payload.page || 'ERP');
  const role = String(payload.role || session.ROLE || '');

  try {
    let reply = '';
    if (provider === 'OPENAI') {
      const resp = UrlFetchApp.fetch('https://api.openai.com/v1/chat/completions', {
        method:'post', contentType:'application/json',
        headers:{Authorization:'Bearer '+apiKey},
        payload:JSON.stringify({
          model:String(props.getProperty('BNX_AI_MODEL') || 'gpt-4o-mini'),
          temperature:0.2,
          messages:[
            {role:'system',content:'You are Balaji NextGen ERP AI Assistant. Give concise, factual operational answers. Never invent live ERP numbers. Company: '+company+'. Page: '+page+'. Role: '+role+'.'},
            {role:'user',content:q}
          ]
        }), muteHttpExceptions:true
      });
      const j=JSON.parse(resp.getContentText()||'{}');
      reply=j.choices && j.choices[0] && j.choices[0].message ? j.choices[0].message.content : '';
    } else {
      const model=String(props.getProperty('BNX_AI_MODEL') || 'gemini-2.5-flash');
      const url='https://generativelanguage.googleapis.com/v1beta/models/'+encodeURIComponent(model)+':generateContent?key='+encodeURIComponent(apiKey);
      const resp=UrlFetchApp.fetch(url,{
        method:'post',contentType:'application/json',muteHttpExceptions:true,
        payload:JSON.stringify({contents:[{role:'user',parts:[{text:
          'You are Balaji NextGen ERP AI Assistant. Give concise factual operational answers. Never invent live ERP numbers. Company: '+company+'. Page: '+page+'. Role: '+role+'. User: '+q
        }]}],generationConfig:{temperature:0.2,maxOutputTokens:500}})
      });
      const j=JSON.parse(resp.getContentText()||'{}');
      reply=j.candidates && j.candidates[0] && j.candidates[0].content &&
        j.candidates[0].content.parts && j.candidates[0].content.parts[0] ?
        j.candidates[0].content.parts[0].text : '';
    }
    if (!reply) return {ok:false,success:false,message:'AI provider returned no reply'};
    return {ok:true,success:true,reply:String(reply)};
  } catch (e) {
    bnxLogError(clientId,'bnxAIQuery failed: '+e.message,{provider:provider});
    return {ok:false,success:false,message:e.message};
  }
}

/* Live purchase recommendation engine. This is deterministic and auditable:
 * current stock + 90-day outbound consumption + min/max/reorder + latest
 * purchase vendor/cost. If an AI key is configured, the frontend may also
 * ask AI_QUERY for an explanation, but quantities remain rule-based so the
 * system never invents a purchase quantity. */
function bnxGetAIPurchaseSuggestions_(session, payload) {
  const clientId = session.CLIENT_ID;
  try {
    const itemSh = bnxClientSheet(clientId, SHEETS.ITEM_MASTER);
    const vals=itemSh.getDataRange().getValues();
    if (!vals.length) return {success:true,items:[],summary:{urgent:0,plan:0,totalValue:0}};
    const h=vals[0].map(String);
    const rows=vals.slice(1).map(r=>bnxRowToObject(r,h)).filter(x=>String(x.CLIENT_ID||clientId)===clientId);

    const stockMap={};
    try{
      const sh=bnxClientSheet(clientId,SHEETS.STOCK_BALANCE);
      const sv=sh.getDataRange().getValues(), hh=sv[0].map(String);
      sv.slice(1).forEach(r=>{
        const o=bnxRowToObject(r,hh);
        const id=String(o.ITEM_ID||o.item_id||'').trim();
        if(id) stockMap[id]=Number(o.CURRENT_STOCK!=null?o.CURRENT_STOCK:(o.BALANCE||o.STOCK||0))||0;
      });
    }catch(e){}

    const now=new Date();
    const from=new Date(now.getTime()-90*86400000);
    const outMap={}, latestPurchase={};
    try{
      const sh=bnxClientSheet(clientId,SHEETS.STOCK_MOVEMENT);
      const sv=sh.getDataRange().getValues(), hh=sv[0].map(String);
      sv.slice(1).forEach(r=>{
        const o=bnxRowToObject(r,hh);
        const id=String(o.ITEM_ID||'').trim(); if(!id)return;
        const dt=new Date(o.MOVEMENT_DATE||o.DATE||o.CREATED_AT||'');
        const qout=Number(o.QTY_OUT||o.OUT_QTY||0)||0;
        if(qout>0 && (!isNaN(dt) ? dt>=from : true)) outMap[id]=(outMap[id]||0)+qout;
      });
    }catch(e){}

    try{
      const sh=bnxClientSheet(clientId,SHEETS.PURCHASE_INVOICE);
      const pv=sh.getDataRange().getValues(), hh=pv[0].map(String);
      pv.slice(1).forEach(r=>{
        const o=bnxRowToObject(r,hh), id=String(o.ITEM_ID||'').trim();
        if(id) latestPurchase[id]={vendorId:o.SUPPLIER_ID||o.VENDOR_ID||'',rate:Number(o.RATE||o.PURCHASE_RATE||0)||0};
      });
    }catch(e){}

    const result=rows.map(function(it){
      const id=String(it.ITEM_ID||it._id||'').trim(); if(!id)return null;
      const stock=stockMap[id] != null ? stockMap[id] : Number(it.CURRENT_STOCK||it.STOCK||0)||0;
      const min=Number(it.MIN_STOCK||it.REORDER_LEVEL||it.MIN_LEVEL||0)||0;
      const max=Number(it.MAX_STOCK||it.MAX_LEVEL||0)||0;
      const out=Number(outMap[id]||0);
      const daily=out/90;
      const target=max>min ? max : Math.max(min*2, daily*14);
      const qty=Math.max(0,Math.ceil(target-stock));
      const days=daily>0 ? Math.round(stock/daily) : 999;
      const priority=stock<=0?'urgent':(min>0&&stock<=min?'urgent':(days<7?'order':'ok'));
      const rate=Number(it.PURCHASE_PRICE||it.COST_PRICE||latestPurchase[id]?.rate||0)||0;
      return {itemId:id,itemName:it.ITEM_NAME||it.NAME||id,stock,minStock:min,maxStock:max,dailyUse:+daily.toFixed(2),
        daysCover:days,suggestedQty:qty,suggestedValue:+(qty*rate).toFixed(2),
        vendorId:latestPurchase[id]?.vendorId||it.SUPPLIER_ID||'',purchaseRate:rate,priority:priority};
    }).filter(Boolean).filter(x=>x.suggestedQty>0).sort((a,b)=>a.daysCover-b.daysCover);

    const summary={urgent:result.filter(x=>x.priority==='urgent').length,
      plan:result.filter(x=>x.priority==='order').length,
      totalValue:+result.reduce((a,x)=>a+x.suggestedValue,0).toFixed(2)};
    return {success:true,clientId,items:result,summary,generatedAt:new Date().toISOString(),method:'LIVE_RULE_ENGINE'};
  }catch(e){
    bnxLogError(clientId,'bnxGetAIPurchaseSuggestions failed: '+e.message,{});
    return {success:false,message:e.message};
  }
}



