/* ============================================================================
 * RECON FIXER (2026-10-21) — applies the checked corrections from
 * CL00010_TXDB_Reconciliation.xlsx. Paste its 4 tabs into the client's TRANSACTION_DB:
 *   RECON_FIXES, RECON_APPEND_BILL_MASTER, RECON_APPEND_PAYMENT_MASTER, RECON_APPEND_SALES_LEDGER
 * then in the Apps Script editor run  bnxReconDryRun_CL00010()  (changes nothing, logs what WOULD change),
 * and after checking the log run  bnxReconApply_CL00010().
 * Safety: a cell is changed only if it still holds the OLD_VALUE seen in the export (anything edited since is skipped);
 * rows with APPLY != YES are ignored; appended bills are skipped if their BILL_NUMBER / ID already exists, and
 * payment / ledger rows only go in when their bill exists. Every run writes a line to RECON_LOG.
 * ========================================================================== */
function bnxReconDryRun_CL00010() { return bnxApplyReconFixes_('CL00010', true); }
function bnxReconApply_CL00010() { return bnxApplyReconFixes_('CL00010', false); }
function bnxApplyReconFixes_(clientId, dryRun) {
  const lock = bnxTenantLock_(); lock.waitLock(30000);
  const log = []; const t0 = Date.now();
  try {
    const txSs = SpreadsheetApp.openById(bnxGetClientDbIds_(clientId).TRANSACTION);
    const same = function (cur, old) {
      if (old === '' || old == null) return cur === '' || cur == null;
      const a = String(cur == null ? '' : cur).trim(), b = String(old).trim();
      if (a === b) return true;
      const na = Number(a.replace(/,/g, '')), nb = Number(b.replace(/,/g, ''));
      if (a !== '' && b !== '' && isFinite(na) && isFinite(nb) && Math.abs(na - nb) < 0.011) return true;
      return b.length >= 190 && a.indexOf(b) === 0;   /* GST_BREAKUP old values were exported cut at 200 chars */
    };
    /* ---- 1. cell corrections ---- */
    const fx = txSs.getSheetByName('RECON_FIXES');
    if (fx) {
      const v = fx.getDataRange().getValues(), h = v[0].map(String), c = function (n) { return h.indexOf(n); };
      const bySheet = {};
      for (let r = 1; r < v.length; r++) {
        if (String(v[r][c('APPLY')]).toUpperCase() !== 'YES') continue;
        const sh = String(v[r][c('SHEET')]); (bySheet[sh] = bySheet[sh] || []).push(v[r]);
      }
      Object.keys(bySheet).forEach(function (sheetName) {
        const sheet = bnxClientSheet(clientId, sheetName), all = sheet.getDataRange().getValues(), H = all[0].map(String);
        const rows = bySheet[sheetName], keyCol = H.indexOf(String(rows[0][c('KEY_COL')]));
        if (keyCol < 0) { log.push(sheetName + ': key column missing — skipped'); return; }
        const at = {}; for (let r = 1; r < all.length; r++) at[String(all[r][keyCol])] = r;
        const touched = {}; let ok = 0, miss = 0, changed = 0;
        rows.forEach(function (x) {
          const col = H.indexOf(String(x[c('COLUMN')])), r = at[String(x[c('KEY')])];
          if (col < 0 || r == null) { miss++; return; }
          if (!same(all[r][col], x[c('OLD_VALUE')])) { changed++; return; }
          all[r][col] = x[c('NEW_VALUE')]; touched[col] = true; ok++;
        });
        log.push(sheetName + ': ' + ok + ' cell(s) to fix, ' + changed + ' skipped (edited since export), ' + miss + ' not found');
        if (!dryRun) Object.keys(touched).forEach(function (col) {
          col = Number(col); sheet.getRange(2, col + 1, all.length - 1, 1).setValues(all.slice(1).map(function (rw) { return [rw[col]]; }));
        });
      });
    } else log.push('RECON_FIXES tab not found');
    /* ---- 2. new master rows, bills, items, payments, ledger ----
       Bill = duplicate when the same BILL_ID exists, or the same BILL_NUMBER on the same BILL_DATE (Zomato / Swiggy numbers
       restart, so a number alone is not unique). Item lines of a bill that already exists are attached to THAT bill only if it
       has no item lines yet; its payments / ledger rows are never added twice. */
    const dkey = function (v) { return bnxNormalizeDateKey_(v) || String(v || '').slice(0, 10); };
    const mapBill = {}, attachItems = {}, freshBill = {};
    const specs = [
      ['ITEM_MASTER', 'RECON_APPEND_ITEM_MASTER'], ['CUSTOMER_MASTER', 'RECON_APPEND_CUSTOMER_MASTER'],
      ['BILL_MASTER', 'RECON_APPEND_BILL_MASTER'], ['BILL_ITEMS', 'RECON_APPEND_BILL_ITEMS'],
      ['PAYMENT_MASTER', 'RECON_APPEND_PAYMENT_MASTER'], ['SALES_LEDGER', 'RECON_APPEND_SALES_LEDGER'],
      ['DUES_RECEIPT', 'RECON_APPEND_DUES_RECEIPT']];
    specs.forEach(function (spec) {
      const srcSh = txSs.getSheetByName(spec[1]); if (!srcSh) { log.push(spec[1] + ' tab not found'); return; }
      const sv = srcSh.getDataRange().getValues(); if (sv.length < 2) return;
      const SH = sv[0].map(String), target = bnxClientSheet(clientId, spec[0]), tv = target.getDataRange().getValues(), TH = tv[0].map(String);
      const col = function (k) { return TH.indexOf(k); };
      const out = []; let dup = 0, orphan = 0, attached = 0;
      const idKey = TH[0], have = {}; for (let r = 1; r < tv.length; r++) have[String(tv[r][0])] = true;
      if (spec[0] === 'ITEM_MASTER' || spec[0] === 'CUSTOMER_MASTER') {
        const nk = spec[0] === 'ITEM_MASTER' ? 'ITEM_NAME' : 'CUSTOMER_NAME', ni = col(nk), names = {};
        for (let r = 1; r < tv.length; r++) names[String(tv[r][ni] || '').trim().toUpperCase()] = true;
        for (let r = 1; r < sv.length; r++) { const o = {}; SH.forEach(function (k, i) { o[k] = sv[r][i]; });
          if (have[String(o[idKey])] || names[String(o[nk] || '').trim().toUpperCase()]) { dup++; continue; }
          out.push(TH.map(function (k) { return o[k] === undefined ? '' : o[k]; })); }
      } else if (spec[0] === 'BILL_MASTER') {
        const ni = col('BILL_NUMBER'), di = col('BILL_DATE'), byNo = {};
        for (let r = 1; r < tv.length; r++) byNo[String(tv[r][ni]) + '|' + dkey(tv[r][di])] = String(tv[r][0]);
        for (let r = 1; r < sv.length; r++) { const o = {}; SH.forEach(function (k, i) { o[k] = sv[r][i]; });
          const ex = have[String(o.BILL_ID)] ? String(o.BILL_ID) : byNo[String(o.BILL_NUMBER) + '|' + dkey(o.BILL_DATE)];
          if (ex) { dup++; mapBill[String(o.BILL_ID)] = ex; continue; }
          mapBill[String(o.BILL_ID)] = String(o.BILL_ID); freshBill[String(o.BILL_ID)] = true;
          out.push(TH.map(function (k) { return o[k] === undefined ? '' : o[k]; })); }
      } else if (spec[0] === 'BILL_ITEMS') {
        const bi = col('BILL_ID'), withItems = {}; for (let r = 1; r < tv.length; r++) withItems[String(tv[r][bi])] = true;
        for (let r = 1; r < sv.length; r++) { const o = {}; SH.forEach(function (k, i) { o[k] = sv[r][i]; });
          const tgt = mapBill[String(o.BILL_ID)]; if (!tgt) { orphan++; continue; }
          if (have[String(o.BILL_ITEM_ID)]) { dup++; continue; }
          if (!freshBill[String(o.BILL_ID)]) { if (withItems[tgt] && !attachItems[tgt]) { dup++; continue; } attachItems[tgt] = true; o.BILL_ID = tgt; attached++; }
          out.push(TH.map(function (k) { return o[k] === undefined ? '' : o[k]; })); }
      } else if (spec[0] === 'DUES_RECEIPT') {
        /* due receipts from the Hashtag Dues sheet: a duplicate is the same receipt ID or the same source REFERENCE (FY25-27|bill|row|mode) */
        const ri = col('REFERENCE'), refs = {}; for (let r = 1; r < tv.length; r++) { const v = String(tv[r][ri] || '').trim(); if (v) refs[v] = true; }
        for (let r = 1; r < sv.length; r++) { const o = {}; SH.forEach(function (k, i) { o[k] = sv[r][i]; });
          if (!o.DUES_RECEIPT_ID || have[String(o.DUES_RECEIPT_ID)] || (o.REFERENCE && refs[String(o.REFERENCE).trim()])) { dup++; continue; }
          out.push(TH.map(function (k) { return o[k] === undefined ? '' : o[k]; })); }
      } else {
        for (let r = 1; r < sv.length; r++) { const o = {}; SH.forEach(function (k, i) { o[k] = sv[r][i]; });
          if (have[String(o[idKey])]) { dup++; continue; }
          if (!freshBill[String(o.BILL_ID)]) { if (mapBill[String(o.BILL_ID)]) dup++; else orphan++; continue; }
          out.push(TH.map(function (k) { return o[k] === undefined ? '' : o[k]; })); }
      }
      log.push(spec[0] + ': ' + out.length + ' row(s) to add' + (attached ? ' (' + attached + ' item lines for bills that had none)' : '') + ', ' + dup + ' already present, ' + orphan + ' without bill');
      if (!dryRun && out.length) target.getRange(target.getLastRow() + 1, 1, out.length, TH.length).setValues(out);
    });
    if (!dryRun) { try { bnxBillGenBump_(clientId); bnxInvalidateTodayReportCaches_(clientId); } catch (e) {} }
    const line = [new Date(), dryRun ? 'DRY-RUN' : 'APPLIED', log.join(' | '), Math.round((Date.now() - t0) / 1000) + ' s'];
    try { let lg = txSs.getSheetByName('RECON_LOG'); if (!lg) { lg = txSs.insertSheet('RECON_LOG'); lg.appendRow(['AT', 'MODE', 'RESULT', 'TIME']); } lg.appendRow(line); } catch (e) {}
    Logger.log(line.join('  ·  '));
    return { success: true, dryRun: dryRun, log: log };
  } finally { lock.releaseLock(); }
}


/* ============================================================================
 * DSR CROSS-CHECK FIX (2026-10-28) — applies the day-wise check against the Hashtag DSR / FY Dues sheet.
 * Put the two tabs from CL00010_DSR_FIX_2810.xlsx into CL00010_TRANSACTION_DB (same names):
 *   FIX_2810_CELLS  SHEET | KEY_COL | KEY | COLUMN | OLD_VALUE | NEW_VALUE | REASON | APPLY
 *   FIX_2810_ROWS   SHEET | ID_COL  | ID  | ROW_JSON | REASON | APPLY
 *   FIX_2810_DELETE SHEET | ID_COL  | ID  | MATCH_JSON | REASON | APPLY   (second copies of rows written twice)
 * Run RUN_31_DsrFixDryRun() (changes nothing, writes what it WOULD do to FIX_2810_LOG), check, then RUN_31_DsrFixApply().
 * Safe: a cell changes only if it still holds OLD_VALUE (text "1,62,076.00" and number 162076 count as the same value);
 * a row is added only if its ID is not already in the sheet; APPLY must be YES. Re-running changes nothing twice.
 * ========================================================================== */
function RUN_31_DsrFixDryRun() { return bnxDsrFix2810_('CL00010', true); }
function RUN_31_DsrFixApply() { return bnxDsrFix2810_('CL00010', false); }
function bnxDsrFix2810_(clientId, dryRun) {
  var lock = LockService.getScriptLock(); lock.waitLock(30000);
  var log = [], t0 = Date.now();
  try {
    var ss = SpreadsheetApp.openById(bnxGetClientDbIds_(clientId).TRANSACTION);
    var num = function (v) { var n = Number(String(v == null ? '' : v).replace(/[,₹\s]/g, '')); return isFinite(n) ? n : NaN; };
    var same = function (cur, old) {
      var a = String(cur == null ? '' : cur).trim(), b = String(old == null ? '' : old).trim();
      if (a === b) return true;
      var na = num(a), nb = num(b);
      return a !== '' && b !== '' && !isNaN(na) && !isNaN(nb) && Math.abs(na - nb) < 0.011;
    };
    var sheetOf = function (name) { var sh = ss.getSheetByName(name); if (!sh) throw new Error('Sheet ' + name + ' not found in TRANSACTION_DB'); return sh; };
    /* 1. cell corrections */
    var fx = ss.getSheetByName('FIX_2810_CELLS');
    if (fx) {
      var v = fx.getDataRange().getValues(), h = v[0].map(String), c = function (n) { return h.indexOf(n); }, by = {};
      for (var r = 1; r < v.length; r++) { if (String(v[r][c('APPLY')]).toUpperCase() !== 'YES') continue; var nm = String(v[r][c('SHEET')]); (by[nm] = by[nm] || []).push(v[r]); }
      Object.keys(by).forEach(function (name) {
        var sh = sheetOf(name), all = sh.getDataRange().getValues(), H = all[0].map(String), keyCol = H.indexOf(String(by[name][0][c('KEY_COL')]));
        if (keyCol < 0) { log.push(name + ': key column missing — skipped'); return; }
        var at = {}; for (var i = 1; i < all.length; i++) at[String(all[i][keyCol])] = i;
        var touched = {}, ok = 0, moved = 0, miss = 0;
        by[name].forEach(function (x) {
          var col = H.indexOf(String(x[c('COLUMN')])), row = at[String(x[c('KEY')])];
          if (col < 0 || row == null) { miss++; return; }
          var cur = all[row][col], nv = x[c('NEW_VALUE')];
          if (same(cur, nv) && typeof cur === typeof nv) return;            /* already fixed */
          if (!same(cur, x[c('OLD_VALUE')])) { moved++; return; }
          all[row][col] = nv; touched[col] = true; ok++;
        });
        log.push(name + ': ' + ok + ' cell(s) fixed, ' + moved + ' skipped (changed since check), ' + miss + ' not found');
        if (!dryRun) Object.keys(touched).forEach(function (col) { col = Number(col); sh.getRange(2, col + 1, all.length - 1, 1).setValues(all.slice(1).map(function (rw) { return [rw[col]]; })); });
      });
    } else log.push('FIX_2810_CELLS tab not found');
    /* 2. missing rows (credit payment lines, due receipts) */
    var fr = ss.getSheetByName('FIX_2810_ROWS');
    if (fr) {
      var rv = fr.getDataRange().getValues(), rh = rv[0].map(String), rc = function (n) { return rh.indexOf(n); }, rby = {};
      for (var q = 1; q < rv.length; q++) { if (String(rv[q][rc('APPLY')]).toUpperCase() !== 'YES') continue; var sn = String(rv[q][rc('SHEET')]); (rby[sn] = rby[sn] || []).push(rv[q]); }
      Object.keys(rby).forEach(function (name) {
        var sh = sheetOf(name), w = sh.getLastColumn(), TH = sh.getRange(1, 1, 1, w).getValues()[0].map(String), idCol = TH.indexOf(String(rby[name][0][rc('ID_COL')]));
        if (idCol < 0) { log.push(name + ': id column missing — skipped'); return; }
        var have = {}, n = sh.getLastRow() - 1; if (n > 0) sh.getRange(2, idCol + 1, n, 1).getValues().forEach(function (x) { have[String(x[0])] = true; });
        var out = [], dup = 0;
        rby[name].forEach(function (x) {
          var id = String(x[rc('ID')]); if (have[id]) { dup++; return; }
          var o = JSON.parse(String(x[rc('ROW_JSON')])); have[id] = true;
          out.push(TH.map(function (k) { return o[k] === undefined || o[k] === null ? '' : o[k]; }));
        });
        log.push(name + ': ' + out.length + ' row(s) added, ' + dup + ' already present');
        if (!dryRun && out.length) sh.getRange(sh.getLastRow() + 1, 1, out.length, TH.length).setValues(out);
      });
    } else log.push('FIX_2810_ROWS tab not found');
    /* 3. duplicate rows (same ID written twice): a row is deleted only when ID + every MATCH_JSON field are equal,
          and never the last remaining copy of that ID */
    var fd = ss.getSheetByName('FIX_2810_DELETE');
    if (fd) {
      var dv = fd.getDataRange().getValues(), dh = dv[0].map(String), dc = function (n) { return dh.indexOf(n); }, dby = {};
      for (var z = 1; z < dv.length; z++) { if (String(dv[z][dc('APPLY')]).toUpperCase() !== 'YES') continue; var dn = String(dv[z][dc('SHEET')]); (dby[dn] = dby[dn] || []).push(dv[z]); }
      Object.keys(dby).forEach(function (name) {
        var sh = sheetOf(name), all = sh.getDataRange().getValues(), H = all[0].map(String), idCol = H.indexOf(String(dby[name][0][dc('ID_COL')]));
        if (idCol < 0) { log.push(name + ': id column missing — skipped'); return; }
        var count = {}; for (var i = 1; i < all.length; i++) { var k = String(all[i][idCol]); if (k) count[k] = (count[k] || 0) + 1; }
        var kill = {}, nf = 0;
        dby[name].forEach(function (x) {
          var id = String(x[dc('ID')]), m = JSON.parse(String(x[dc('MATCH_JSON')])), hit = -1;
          for (var r = all.length - 1; r >= 1; r--) {
            if (kill[r] || String(all[r][idCol]) !== id) continue;
            var okRow = Object.keys(m).every(function (f) { var ci = H.indexOf(f); return ci >= 0 && same(all[r][ci], m[f]); });
            if (okRow) { hit = r; break; }
          }
          if (hit < 0 || (count[id] || 0) < 2) { nf++; return; }
          kill[hit] = true; count[id]--;
        });
        var rowsDel = Object.keys(kill).map(Number).sort(function (a, b) { return b - a; });
        log.push(name + ': ' + rowsDel.length + ' duplicate row(s) removed, ' + nf + ' not found / already single');
        if (!dryRun && rowsDel.length) {                     /* one write instead of 1,000+ single-row deletes */
          var keep = all.slice(1).filter(function (row, i) { return !kill[i + 1]; });
          sh.getRange(2, 1, keep.length, H.length).setValues(keep);
          sh.deleteRows(keep.length + 2, rowsDel.length);
        }
      });
    }
    if (!dryRun) { try { bnxBillGenBump_(clientId); bnxInvalidateTodayReportCaches_(clientId); bnxLiveGenBump_(clientId); } catch (e) {} }
    var line = [new Date(), dryRun ? 'DRY-RUN' : 'APPLIED', log.join(' | '), Math.round((Date.now() - t0) / 1000) + ' s'];
    try { var lg = ss.getSheetByName('FIX_2810_LOG'); if (!lg) { lg = ss.insertSheet('FIX_2810_LOG'); lg.appendRow(['AT', 'MODE', 'RESULT', 'TIME']); } lg.appendRow(line); } catch (e) {}
    Logger.log(line.join('  ·  '));
    return { success: true, dryRun: dryRun, log: log };
  } finally { lock.releaseLock(); }
}

/* ============================================================================
 * SETTLE_DUE_BILL (2026-10-21) — settle a Pending / DUE / PARTIAL bill.
 *  - credit bill (has a CREDIT payment line, or PAYMENT_STATUS DUE / PARTIAL): the money is a DUE RECEIPT
 *    (DUES_RECEIPT row against the bill) — so the DSR shows it as "Due received", not as a second sale;
 *  - any other unpaid bill: PAYMENT_MASTER + SALES_LEDGER rows for each payment line;
 *  - BILL_MASTER DUE_AMOUNT / PAYMENT_STATUS / PAID_AT are updated; never more than the open amount is accepted.
 * Safe to retry: an already-settled bill answers success with alreadySettled. Script lock held throughout.
 * ========================================================================== */
function bnxSettleDueBill_(session, payload) {
  const clientId = String(session.CLIENT_ID), p = payload || {};
  const lines = (Array.isArray(p.payments) ? p.payments : []).map(function (l) { return { mode: String(l.mode || l.MODE || 'CASH').toUpperCase().trim(), amount: Math.round((Number(l.amount || l.AMOUNT) || 0) * 100) / 100 }; }).filter(function (l) { return l.amount > 0; });
  if (!lines.length) return { success: false, error: 'payments required' };
  const lock = bnxTenantLock_(), held = lock.hasLock();
  try {
    if (!held) lock.waitLock(20000);
    let found = null;
    if (p.billId || p.BILL_ID) found = bnxFindBillRowByIdFast_(clientId, String(p.billId || p.BILL_ID));
    if (!found && (p.billNumber || p.BILL_NUMBER)) {
      const no = String(p.billNumber || p.BILL_NUMBER), sh = bnxClientSheet(clientId, SHEETS.BILL_MASTER);
      const rr = bnxReadFilteredRows_(sh, ['CLIENT_ID', 'BILL_NUMBER'], function (v) { return String(v[0]) === clientId && String(v[1]) === no; });
      const cands = rr.rows.map(function (r) { return bnxRowToObject(r, rr.headers); }).filter(function (b) { return String(b.PAYMENT_STATUS || '').toUpperCase() !== 'PAID' && !/^(CANCELLED|VOID)$/i.test(String(b.BILL_STATUS || '')); });
      if (cands.length > 1) return { success: false, error: 'More than one open bill has number ' + no + ' — settle it from the bill itself (billId).' };
      if (cands.length === 1) found = bnxFindBillRowByIdFast_(clientId, String(cands[0].BILL_ID));
    }
    if (!found) return { success: false, error: 'Bill not found' };
    const bill = found.bill, H = found.headers, sh = found.sheet, row = found.rowNo, billId = String(bill.BILL_ID);
    const st = String(bill.BILL_STATUS || '').toUpperCase(), ps = String(bill.PAYMENT_STATUS || '').toUpperCase();
    if (/^(CANCELLED|VOID)$/.test(st) || ps === 'CANCELLED') return { success: false, error: 'Bill is cancelled' };
    const grand = Math.max(0, Number(bill.GRAND_TOTAL) || 0);
    /* what is still open */
    const pm = bnxClientSheet(clientId, SHEETS.PAYMENT_MASTER);
    const pr = bnxReadFilteredRows_(pm, ['BILL_ID'], function (v) { return String(v[0]) === billId; });
    let paidReal = 0, hasCredit = false;
    pr.rows.forEach(function (r) { const o = bnxRowToObject(r, pr.headers), m = String(o.PAYMENT_MODE || '').toUpperCase();
      if (/^(REFUNDED|REVERSED|VOID|CANCELLED)$/.test(String(o.PAYMENT_STATUS || '').toUpperCase())) return;
      if (m === 'CREDIT' || m === 'DUE') hasCredit = true; else paidReal += Number(o.AMOUNT) || 0; });
    const credit = hasCredit || ps === 'DUE' || ps === 'PARTIAL';
    let open = credit ? bnxBillOutstanding_(bill) : Math.max(0, grand - paidReal);
    open = Math.round(open * 100) / 100;
    if (ps === 'PAID' || open <= 0.004) return { success: true, alreadySettled: true, billId: billId, billNumber: bill.BILL_NUMBER };
    const total = Math.round(lines.reduce(function (a, l) { return a + l.amount; }, 0) * 100) / 100;
    if (total > open + 0.01) return { success: false, error: 'Amount ₹' + total + ' is more than the open ₹' + open };
    const dateKey = String(p.paymentDate || p.businessDate || p.date || bnxBusinessDateKey_()).slice(0, 10);
    const now = new Date(), time = Utilities.formatDate(now, bnxTz_(), 'HH:mm:ss'), who = String(session.FULL_NAME || session.USER_ID || 'CASHIER');
    const modeId = { CASH: 'PMD00001', UPI: 'PMD00002', GPAY: 'PMD00002', CARD: 'PMD00003', CREDIT: 'PMD00008' };
    const stamp = Utilities.formatDate(now, bnxTz_(), 'yyMMddHHmmss') + String(Math.floor(Math.random() * 90 + 10));
    if (credit) {
      lines.forEach(function (l, i) {
        const id = 'SDR' + stamp + '-' + billId.slice(-6) + '-' + (i + 1);
        bnxAppendRow(clientId, SHEETS.DUES_RECEIPT, { DUES_RECEIPT_ID: id, CLIENT_ID: clientId, CUSTOMER_ID: bill.CUSTOMER_ID || '', AMOUNT: l.amount, PAYMENT_MODE: l.mode,
          REFERENCE: 'Bill ' + bill.BILL_NUMBER + ' | ' + billId, RECEIPT_DATE: dateKey, RECEIPT_TIME: time, CREATED_BY: who, CREATED_AT: now.toISOString(), VOUCHER_NO: id,
          CUSTOMER_KEY: bill.CUSTOMER_ID || '', CUSTOMER_NAME: bill.CUSTOMER_NAME || '', ALLOCATED_AMOUNT: l.amount, OPENING_APPLIED: 0, ADVANCE_AMOUNT: 0,
          NARRATION: 'Settled from Bills List against ' + bill.BILL_NUMBER, STATUS: 'VERIFIED' });
      });
    } else {
      lines.forEach(function (l, i) {
        const pid = 'SPY' + stamp + '-' + billId.slice(-6) + '-' + (i + 1);
        bnxAppendRow(clientId, SHEETS.PAYMENT_MASTER, { PAYMENT_ID: pid, CLIENT_ID: clientId, LOCATION_ID: bill.LOCATION_ID || '', BILL_ID: billId, CUSTOMER_ID: bill.CUSTOMER_ID || '',
          PAYMENT_MODE_ID: modeId[l.mode] || '', PAYMENT_MODE: l.mode, AMOUNT: l.amount, PAYMENT_DATE: dateKey, PAYMENT_TIME: time, REFERENCE: 'Settlement ' + bill.BILL_NUMBER,
          PAYMENT_STATUS: 'PAID', CREATED_BY: who, CREATED_AT: now.toISOString() });
        try { bnxAppendRow(clientId, 'SALES_LEDGER', { SALES_LEDGER_ID: 'SSL' + stamp + '-' + billId.slice(-6) + '-' + (i + 1), CLIENT_ID: clientId, LOCATION_ID: bill.LOCATION_ID || '',
          BUSINESS_DATE: dateKey, BILL_ID: billId, BILL_NUMBER: bill.BILL_NUMBER, AMOUNT: l.amount, PAYMENT_MODE: l.mode, CREATED_AT: now, CUSTOMER_ID: bill.CUSTOMER_ID || '', PARTY_NAME: bill.CUSTOMER_NAME || '' }); } catch (e) {}
      });
    }
    const left = Math.max(0, Math.round((open - total) * 100) / 100);
    const set = function (k, v) { const c = H.indexOf(k); if (c >= 0) sh.getRange(row, c + 1).setValue(v); };
    set('DUE_AMOUNT', credit ? left : 0);
    set('PAYMENT_STATUS', left <= 0.01 ? 'PAID' : 'PARTIAL');
    if (left <= 0.01) set('PAID_AT', now);
    try { bnxBillGenBump_(clientId); bnxInvalidateTodayReportCaches_(clientId); CacheService.getScriptCache().removeAll(['custmap_v1_' + clientId]); } catch (e) {}
    try { bnxCreateAuditLog(clientId, 'SETTLE_DUE_BILL', billId, { lines: lines, credit: credit, left: left, by: who }); } catch (e) {}
    return { success: true, billId: billId, billNumber: bill.BILL_NUMBER, settled: total, remaining: left, recordedAs: credit ? 'DUE_RECEIPT' : 'PAYMENT', paymentStatus: left <= 0.01 ? 'PAID' : 'PARTIAL' };
  } catch (e) {
    bnxLogError(clientId, 'bnxSettleDueBill_ failed: ' + e.message, p);
    return { success: false, error: e.message };
  } finally { if (!held) { try { lock.releaseLock(); } catch (e) {} } }
}


/* ============================================================================
 * DASH_FIN (2026-10-22) — dashboard Payment Collection / Receivables for a date range, from the same per-day DSR figures
 * the owner DSR uses (GET_DSR_RANGE). Shape matches the dashboard painter (bnx-dash-fin-20261009).
 * ========================================================================== */
function bnxDashFin_(session, payload) {
  const clientId = String(session.CLIENT_ID), p = payload || {};
  const today = bnxBusinessDateKey_();
  const from = bnxNormalizeDateKey_(p.from || p.FROM_DATE) || today, to = bnxNormalizeDateKey_(p.to || p.TO_DATE) || from;
  const sum = function (byDate) { const t = { cash: 0, upi: 0, card: 0, zomato: 0, swiggy: 0, eazydine: 0, credit: 0, dueCash: 0, dueBank: 0, cn: 0, net: 0 };
    Object.keys(byDate || {}).forEach(function (d) { const x = byDate[d] || {};
      t.cash += +x.cash || 0; t.upi += +x.iciciGpay || 0; t.card += +x.iciciCard || 0; t.zomato += +x.zomato || 0; t.swiggy += +x.swiggy || 0; t.eazydine += +x.eazydine || 0;
      t.credit += +x.guestDueSales || 0; t.dueCash += +x.dueReceivedCash || 0; t.dueBank += +x.dueReceivedIcici || 0; t.cn += +x.guestDuesCN || 0; t.net += +x.netSale || 0; });
    Object.keys(t).forEach(function (k) { t[k] = Math.round(t[k] * 100) / 100; }); return t; };
  try {
    const r1 = bnxGetDsrRange(session, { from: from, to: to });
    if (!r1 || !r1.success) return { success: false, error: (r1 && r1.error) || 'DSR range failed' };
    const t = sum(r1.data && r1.data.byDate);
    /* receivables: current dues = CUSTOMER_DUES; closing at "to" = current − later credit + later receipts + later CN */
    let current = 0, customers = 0;
    try { const cd = bnxGetRows_(clientId, 'CUSTOMER_DUES');
      cd.forEach(function (o) { if (o.CLIENT_ID && String(o.CLIENT_ID) !== clientId) return; const b = Number(String(o.CURRENT_BALANCE == null ? '' : o.CURRENT_BALANCE).replace(/[,₹\s]/g, '')) || 0; if (b > 0.004) { current += b; customers++; }   /* text '1,63,725.00' counted too */ }); } catch (e) {}
    current = Math.round(current * 100) / 100;
    let after = { credit: 0, dueCash: 0, dueBank: 0, cn: 0 };
    if (to < today) { const d1 = new Date(to + 'T00:00:00Z'); d1.setUTCDate(d1.getUTCDate() + 1);
      const r2 = bnxGetDsrRange(session, { from: d1.toISOString().slice(0, 10), to: today }); if (r2 && r2.success) after = sum(r2.data && r2.data.byDate); }
    const closing = Math.round((current - after.credit + after.dueCash + after.dueBank + after.cn) * 100) / 100;
    const opening = Math.round((closing - t.credit + t.dueCash + t.dueBank + t.cn) * 100) / 100;
    let lastReceipt = '', lastReceiptAmt = 0;
    try { const sh = bnxClientSheet(clientId, SHEETS.DUES_RECEIPT); const n = sh.getLastRow();
      if (n > 1) { const h = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String), di = h.indexOf('RECEIPT_DATE'), ai = h.indexOf('AMOUNT');
        if (di >= 0 && ai >= 0) { const start = Math.max(2, n - 400), v = sh.getRange(start, 1, n - start + 1, h.length).getValues();
          v.forEach(function (row) { const k = bnxNormalizeDateKey_(row[di]); if (k && k <= to && k >= lastReceipt) { lastReceipt = k; lastReceiptAmt = Number(row[ai]) || 0; } }); } } } catch (e) {}
    return { success: true, data: { from: from, to: to, source: 'DSR_RANGE',
      pay: { cash: t.cash, upi: t.upi, card: t.card, zomato: t.zomato, swiggy: t.swiggy, eazydine: t.eazydine, credit: t.credit },
      collection: Math.round((t.cash + t.upi + t.card + t.zomato + t.swiggy + t.eazydine) * 100) / 100,
      cash: bnxDashFinCash_(clientId, from, to, t.cash),   /* 2026-10-22: Cash Position from the cash book (CASH_CONTROL + CASH_MOVEMENT) */
      recv: { opening: opening, credit: t.credit, dueCash: t.dueCash, dueBank: t.dueBank, cn: t.cn, closing: closing, current: current, customers: customers, lastReceipt: lastReceipt, lastReceiptAmt: lastReceiptAmt } } };
  } catch (e) { bnxLogError(clientId, 'DASH_FIN failed: ' + e.message, p); return { success: false, error: e.message }; }
}

/* ============================================================================
 * DASH_FIN cash block (2026-10-22, "fix Cash Position") — Opening → Cash sale → Cash due received → transfers / deposit → Closing,
 * read from the owner cash book tabs (CASH_CONTROL = one row per day with opening/closing, CASH_MOVEMENT = the day's lines).
 * Was: cash:null, so the dashboard rebuilt Cash Position from GET_ACCOUNTS_DAY one call PER DAY (This Month = 22 calls) and
 * showed a different figure every time one of them timed out.
 * Rules (checked on CL00010: all 203 cash-book days 01-04-2026 … 20-10-2026 balance to the paisa with these):
 *   signed amount = AMOUNT for DIRECTION IN, −AMOUNT for OUT (a MAIN_CASH_TRANSFER "OUT" with a negative amount = cash brought in)
 *   CASH_SALE → cash sale · DUE_COLLECTION_CASH / DUE_RECEIVED → cash due received (the sync switched names on 15-10-2026)
 *   MAIN_CASH_TRANSFER → main cash in / out · PETTY_CASH_TRANSFER → petty out · BANK_CASH_DEPOSIT → deposit · anything else → other in / out
 *   Amounts stored as text ("1,24,972.00") are read as numbers.
 * ========================================================================== */
function bnxDashFinCash_(clientId, from, to, posCash) {
  try {
    const num = function (v) { if (typeof v === 'number') return isFinite(v) ? v : 0; const n = Number(String(v == null ? '' : v).replace(/[₹,\s]/g, '')); return isFinite(n) ? n : 0; };
    const r2 = function (v) { return Math.round((Number(v) || 0) * 100) / 100; };
    const read = function (name) { try { const sh = bnxClientSheet(clientId, name); const v = sh.getDataRange().getValues(); if (!v || v.length < 2) return { h: [], rows: [] }; return { h: v[0].map(function (x) { return String(x || '').trim().toUpperCase(); }), rows: v.slice(1) }; } catch (e) { return { h: [], rows: [] }; } };
    const cc = read(SHEETS.CASH_CONTROL);
    if (!cc.rows.length) return null;
    const ci = function (k) { return cc.h.indexOf(k); };
    const iCl = ci('CLIENT_ID'), iD = ci('BUSINESS_DATE'), iO = ci('OPENING_CASH'), iC = ci('CLOSING_CASH');
    if (iD < 0 || iO < 0 || iC < 0) return null;
    const days = [];
    cc.rows.forEach(function (row) { if (iCl >= 0 && row[iCl] && String(row[iCl]) !== String(clientId)) return; const d = bnxNormalizeDateKey_(row[iD]); if (d) days.push({ d: d, o: num(row[iO]), c: num(row[iC]) }); });
    if (!days.length) return null;
    days.sort(function (a, b) { return a.d < b.d ? -1 : a.d > b.d ? 1 : 0; });
    const before = days.filter(function (x) { return x.d < from; }), inR = days.filter(function (x) { return x.d >= from && x.d <= to; });
    const opening = inR.length ? inR[0].o : (before.length ? before[before.length - 1].c : 0);
    const upto = days.filter(function (x) { return x.d <= to; });
    const closing = upto.length ? upto[upto.length - 1].c : opening;
    const asOf = upto.length ? upto[upto.length - 1].d : '';
    const out = { opening: r2(opening), cashSale: 0, posCash: r2(posCash), dueCash: 0, mainIn: 0, otherIn: 0, pettyOut: 0, otherOut: 0, mainOut: 0, bankDeposit: 0, closing: r2(closing), asOf: asOf, source: 'CASH_BOOK' };
    const cm = read(SHEETS.CASH_MOVEMENT);
    const mi = function (k) { return cm.h.indexOf(k); };
    const jCl = mi('CLIENT_ID'), jD = mi('DATE'), jDir = mi('DIRECTION'), jCat = mi('CATEGORY'), jA = mi('AMOUNT'), jSt = mi('STATUS'), jSrc = mi('SOURCE_TYPE'), jDesc = mi('DESCRIPTION');
    /* 2026-11-14 ROOT FIX ("Cash book closing differs … by ₹33,500 — a cash-book row is not classified"): on 06-11-2026 the
       Event Costing screen posted DJ ₹30,000 + HOTEL ₹3,500 as cash OUT, while the owner cash book (CASH sheet → rows
       SOURCE_TYPE OWNER_CASH_BOOK, and CASH_CONTROL closing) already settles that day with the ₹50,000 petty-cash transfer.
       Counting both took the money out twice. Rule now: a day that has owner cash-book rows is read ONLY from those rows
       (it is what CASH_CONTROL closing is built from); other rows of that day (costing / manual) are listed in
       out.notInBook for the owner to check, never added. Days without owner rows count every row as before. */
    const ownerDay = {};
    if (jD >= 0 && jSrc >= 0) cm.rows.forEach(function (row) { if (String(row[jSrc] || '').trim().toUpperCase() === 'OWNER_CASH_BOOK') { const d0 = bnxNormalizeDateKey_(row[jD]); if (d0) ownerDay[d0] = 1; } });
    out.notInBook = [];
    if (jD >= 0 && jA >= 0) cm.rows.forEach(function (row) {
      if (jCl >= 0 && row[jCl] && String(row[jCl]) !== String(clientId)) return;
      if (jSt >= 0 && /^(VOID|VOIDED|CANCELLED|DELETED|REVERSED)$/i.test(String(row[jSt] || '').trim())) return;
      const d = bnxNormalizeDateKey_(row[jD]); if (!d || d < from || d > to) return;
      if (ownerDay[d] && String(jSrc >= 0 ? row[jSrc] : '').trim().toUpperCase() !== 'OWNER_CASH_BOOK') {
        if (out.notInBook.length < 50) out.notInBook.push({ date: d, direction: String(jDir >= 0 ? row[jDir] : ''), category: String(jCat >= 0 ? row[jCat] : ''), text: String(jDesc >= 0 ? row[jDesc] : ''), amount: r2(num(row[jA])), source: String(row[jSrc] || '') });
        return;
      }
      const amt = num(row[jA]), dir = String(jDir >= 0 ? row[jDir] : '').trim().toUpperCase(), cat = String(jCat >= 0 ? row[jCat] : '').trim().toUpperCase().replace(/[\s-]+/g, '_');
      const s = dir === 'OUT' ? -amt : amt;
      if (cat === 'CASH_SALE' || cat === 'CASH_SALES') out.cashSale += s;
      else if (/^DUE_(COLLECTION|RECEIVED|RECEIPT)(_CASH)?$/.test(cat)) out.dueCash += s;
      else if (cat === 'MAIN_CASH_TRANSFER') { if (s >= 0) out.mainIn += s; else out.mainOut += -s; }
      else if (cat === 'PETTY_CASH_TRANSFER') { if (s >= 0) out.otherIn += s; else out.pettyOut += -s; }
      else if (cat === 'BANK_CASH_DEPOSIT' || cat === 'CASH_DEPOSIT' || cat === 'BANK_DEPOSIT') { if (s >= 0) out.otherIn += s; else out.bankDeposit += -s; }
      else { if (s >= 0) out.otherIn += s; else out.otherOut += -s; }
    });
    ['cashSale', 'dueCash', 'mainIn', 'otherIn', 'pettyOut', 'otherOut', 'mainOut', 'bankDeposit'].forEach(function (k) { out[k] = r2(out[k]); });
    out.check = r2(out.closing - (out.opening + out.cashSale + out.dueCash + out.mainIn + out.otherIn - out.pettyOut - out.otherOut - out.mainOut - out.bankDeposit));
    return out;
  } catch (e) { try { bnxLogError(clientId, 'DASH_FIN cash block failed: ' + e.message, { from: from, to: to }); } catch (x) {} return null; }
}

/* BILL_PAYMENTS (2026-10-22) — payment lines per bill number for a range: {data:{'HT/..':{m:{CASH:..,UPI:..}}}} */
function bnxBillPayments_(session, payload) {
  const clientId = String(session.CLIENT_ID), p = payload || {};
  const from = bnxNormalizeDateKey_(p.from || p.FROM_DATE), to = bnxNormalizeDateKey_(p.to || p.TO_DATE) || from;
  if (!from) return { success: false, error: 'from required' };
  try {
    const bs = bnxClientSheet(clientId, SHEETS.BILL_MASTER), bv = bnxReadWindow_(bs, ['BILL_DATE'], from, to), bh = bv[0].map(String);
    const bi = bh.indexOf('BILL_ID'), bn = bh.indexOf('BILL_NUMBER'), bd = bh.indexOf('BILL_DATE'), noOf = {};
    for (let r = 1; r < bv.length; r++) { const k = bnxNormalizeDateKey_(bv[r][bd]); if (k && k >= from && k <= to) noOf[String(bv[r][bi])] = String(bv[r][bn]); }
    const ids = {}; Object.keys(noOf).forEach(function (k) { ids[k] = true; });
    const out = {};
    if (Object.keys(ids).length) {
      const pm = bnxClientSheet(clientId, SHEETS.PAYMENT_MASTER);
      const rr = bnxTailFilteredRows_(pm, ['BILL_ID'], function (v) { return ids[String(v[0])] === true; }, { chunk: 4000, ids: ids, emptyChunks: 2 });   /* 2026-11-16 */
      rr.rows.forEach(function (row) { const o = bnxRowToObject(row, rr.headers);
        if (/^(REFUNDED|REVERSED|VOID|CANCELLED)$/.test(String(o.PAYMENT_STATUS || '').toUpperCase())) return;
        // Preserve the actual aggregator tender for bill-list totals. Global normalization
        // groups these as ONLINE for other reports; do not change that contract here.
        const no = noOf[String(o.BILL_ID)], rawMode = String(o.PAYMENT_MODE || '').trim().toUpperCase(),
          m = /^ZOMATO(?:\b|$)/.test(rawMode) ? 'ZOMATO' : /^SWIGGY(?:\b|$)/.test(rawMode) ? 'SWIGGY' : bnxNormalizePaymentMode_(rawMode) || rawMode;
        (out[no] || (out[no] = { m: {} })).m[m] = ((out[no].m[m]) || 0) + (Number(o.AMOUNT) || 0); });
    }
    return { success: true, data: out };
  } catch (e) { return { success: false, error: e.message }; }
}


/* ============================================================================
 * GET_GST_RATEWISE (2026-10-22) — GST rate-wise + summary + day-wise + month-wise from BILL_MASTER.GST_BREAKUP
 * (the POS split: CGST@2.5% / SGST@2.5% / CGST@9% … IGST… cess). Only the date window is read (fast).
