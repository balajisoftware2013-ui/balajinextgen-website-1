function bnxPrintApi_(session,p,action){
 p=p||{};var cid=session.CLIENT_ID;
 if(!cid) return {success:false,error:'Authenticated client required'};
 var lock=null;
 try{
  if(action==='PRINT_QUEUE_CLAIM'&&p.qz===true&&bnxPqAdmin_(session)&&String(p.station||'').trim()&&String(p.station).length<=80&&!p.force){
   try{var fastCache=CacheService.getScriptCache();if(fastCache.get('bnx_pq_empty_v28_'+cid)){fastCache.put('bnx_pq_station_'+cid,String(p.station),60);return {success:true,data:{jobs:[],v:new Date().toISOString()},fast:true};}}catch(cacheError){}
  }
  if(action==='PRINTER_MASTER_GET')return bnxPqMaster_(session,p,false);
  /* SPEED 2026-10-28: the POS station asks every 1.5 s. Look for waiting tickets WITHOUT the lock first;
     only a claim that has something to print takes the (per-restaurant) lock. */
  if(action==='PRINT_QUEUE_CLAIM'&&p.qz===true&&bnxPqAdmin_(session)&&String(p.station||'').trim()&&String(p.station).length<=80){
   try{var pc=CacheService.getScriptCache();pc.put('bnx_pq_station_'+cid,String(p.station),60);
    var psh=bnxPqSheet_(cid),pnr=psh.getLastRow();
    var anyJob=pnr>=2&&!!psh.getRange(2,2,pnr-1,1).createTextFinder('^(WAIT|CLAIMED)$').useRegularExpression(true).matchEntireCell(true).findNext();
    if(!anyJob){pc.put('bnx_pq_empty_v28_'+cid,'1',5);return {success:true,data:{jobs:[],v:new Date().toISOString()},fast:true};}
   }catch(fastErr){}
  }
  if(['PRINTER_MASTER_SAVE','PRINT_QUEUE_ADD','PRINT_QUEUE_CLAIM','PRINT_QUEUE_DONE'].indexOf(action)>=0){
   lock=bnxPrintLock_(cid);if(!lock.tryLock(action==='PRINT_QUEUE_CLAIM'?3000:10000))return {success:false,retryable:true,error:'PRINT_QUEUE_BUSY'};   /* 2026-11-16: own short lock — a running SAVE_ORDER / SAVE_BILL no longer blocks KOT printing */
  }
  if(action==='PRINTER_MASTER_SAVE')return bnxPqMaster_(session,p,true);
  if(['PRINT_QUEUE_CLAIM','PRINT_QUEUE_DONE'].indexOf(action)>=0&&!bnxPqAdmin_(session))return {success:false,statusCode:403,error:'POS station role required'};
  // Validate every incoming job before writing any of the batch.
  if(action==='PRINT_QUEUE_ADD'){
   if(!Array.isArray(p.jobs)||!p.jobs.length||p.jobs.length>12)throw new Error('1–12 print jobs required');
   p.jobs.forEach(function(j){
    if(!j||!/^[-A-Za-z0-9_.:]{1,180}$/.test(j.id||'')||['BILL','KITCHEN','BAR','HUKKA'].indexOf(j.role)<0)throw new Error('Invalid print job ID/role');
    if(!Array.isArray(j.items)||!j.items.length||j.items.length>100)throw new Error('1–100 print items required');
    j.items.forEach(function(i){if(!String(i.name||'').trim()||!(Number(i.qty)>0)||Number(i.qty)>1000)throw new Error('Invalid print item');});
    if(JSON.stringify(j).length>40000)throw new Error('Print job too large');
   });
  }
  var sh=bnxPqSheet_(cid),nr=sh.getLastRow(),now=Date.now(),iso=new Date(now).toISOString();
  function find(id){if(nr<2)return null;var hit=sh.getRange(2,1,nr-1,1).createTextFinder(String(id)).matchEntireCell(true).findNext();return hit?{n:hit.getRow(),v:sh.getRange(hit.getRow(),1,1,8).getValues()[0]}:null;}
  if(action==='PRINT_QUEUE_ADD'){
   /* Read queue IDs once for the whole batch while the existing write lock is held. */
   var rows=[],ids=[],batch={},existing=Object.create(null);
   if(nr>=2)sh.getRange(2,1,nr-1,1).getValues().forEach(function(row){if(row[0]!=null&&row[0]!=='')existing[String(row[0])]=true;});
   p.jobs.forEach(function(j){if(batch[j.id])return;batch[j.id]=true;ids.push(j.id);if(!existing[j.id])rows.push([j.id,'WAIT',j.role,JSON.stringify(j),'','',iso,'']);});
   if(rows.length)sh.getRange(nr+1,1,rows.length,8).setValues(rows);
   try{CacheService.getScriptCache().remove('bnx_pq_empty_v28_'+cid);}catch(cacheError){}
   return {success:true,data:{ids:ids,stationOnline:bnxPqOnline_(cid)}};
  }
  if(action==='PRINT_QUEUE_STATUS'){
   if(!Array.isArray(p.ids)||p.ids.length>100)throw new Error('Up to 100 job IDs required');
   return {success:true,data:{jobs:p.ids.map(function(id){var x=find(id);return x?{id:x.v[0],st:x.v[1],role:x.v[2],err:x.v[7]}:null;}).filter(Boolean)}};
  }
  var station=String(p.station||'').trim();
  if(!station||station.length>80)throw new Error('POS station identity required');
  if(action==='PRINT_QUEUE_CLAIM'){
   if(p.qz!==true)return {success:false,error:'QZ connection required'};
   CacheService.getScriptCache().put('bnx_pq_station_'+cid,station,60);
   var jobs=[],hits=nr<2?[]:sh.getRange(2,2,nr-1,1).createTextFinder('^(WAIT|CLAIMED)$').useRegularExpression(true).matchEntireCell(true).findAll();
   for(var i=0;i<hits.length&&jobs.length<12;i++){
    var rn=hits[i].getRow(),v=sh.getRange(rn,1,1,8).getValues()[0];
    /* 2026-10-29 ("KOT not come"): a ticket claimed by a station that then closed / lost QZ was skipped by every OTHER
       station forever (only the same station name could re-take it). Now any station takes a claim older than 45 s. */
    if(v[1]==='CLAIMED' && now-new Date(v[5]).getTime()<45000)continue;
    var tm=String(v[7]).match(/\[try \d+(?: @([^\]]+))?\]/);
    if(v[1]==='WAIT' && tm){ var fage=now-new Date(v[6]).getTime(); if(fage<15000)continue; if(tm[1]&&tm[1]===station&&fage<90000)continue; }   /* retry after 15 s; the PC that failed waits 90 s so a PC on the restaurant Wi-Fi takes it first */
    var job=JSON.parse(v[3]);v[1]='CLAIMED';v[4]=station;v[5]=iso;v[6]=iso;
    sh.getRange(rn,1,1,8).setValues([v]);jobs.push(job);
   }
   if(!hits.length)try{CacheService.getScriptCache().put('bnx_pq_empty_v28_'+cid,'1',5);}catch(cacheError){}
   return {success:true,data:{jobs:jobs,v:iso}};
  }
  if(action==='PRINT_QUEUE_DONE'){
   if(!Array.isArray(p.results)||p.results.length>100)throw new Error('Up to 100 print results required');
   /* 2026-10-29: one unknown / re-assigned id no longer rejects the whole batch (the other tickets stayed CLAIMED and were
      printed again). A failed print goes back to WAIT for up to 3 tries (printer off for a moment, paper change), then FAIL. */
   var valid=[];p.results.forEach(function(r){var x=r&&find(r.id);if(!x)return;if(x.v[1]!=='DONE'&&r.ok!==true&&String(x.v[4])!==station)return;valid.push({x:x,r:r});});
   valid.forEach(function(z){if(z.x.v[1]==='DONE')return;var v=z.x.v;
