function RUN_20_InstallDsrItemGroupTrigger() {
  ScriptApp.getProjectTriggers().forEach(function (t) { if (t.getHandlerFunction() === 'bnxIgcHourly_') ScriptApp.deleteTrigger(t); });
  ScriptApp.newTrigger('bnxIgcHourly_').timeBased().everyHours(1).create();
  Logger.log('✅ Hourly check installed (' + BNX_IGC_TAB + ') for ' + bnxIgcClients_().join(', ') + ' — rebuilds only when data changed, and at least every ' + BNX_IGC_FORCE_HOURS + ' h');
}
function bnxIgcHourly_() {
  /* 2026-11-15 SPEED ("server slow, request did not start"): this hourly rebuild reads the WHOLE BILL_MASTER + BILL_ITEMS and
     held the GLOBAL script lock the whole time (no client id in a trigger -> getScriptLock). Every bill / KOT / order save needs
     that lock for a moment, so for minutes each hour all saves waited or failed. It now only blocks a second copy of itself. */
  var cache = CacheService.getScriptCache();
  if (cache.get('igc_hourly_running')) return;
  cache.put('igc_hourly_running', '1', 1500);
  var lock = { releaseLock: function () { try { cache.remove('igc_hourly_running'); } catch (e) {} } };
  try {
    var P = PropertiesService.getScriptProperties();
    bnxIgcClients_().forEach(function (cid) {
      try {
        var ss = bnxIgcOpenDb_(cid), last = null;
        try { last = JSON.parse(P.getProperty('DSR_IGC_SIG_' + cid) || 'null'); } catch (e) {}
        var fresh = last && last.sig === bnxIgcSig_(ss) && (Date.now() - last.t) < BNX_IGC_FORCE_HOURS * 3600000;
        if (fresh) return;          /* nothing new since the last build */
        bnxIgcBuild_(cid);
      } catch (e) { console.error('[DSR IGC] ' + cid + ' ' + e.message); }
    });
  } finally { lock.releaseLock(); }
}

