  [[SHEETS.MENU_CARD_ITEMS||'MENU_CARD_ITEMS',false],[SHEETS.BAR_MENU_CARD||'BAR_MENU_CARD',true],[SHEETS.BAR_ITEM_MASTER||'BAR_ITEM_MASTER',true]].forEach(function(t){
    try{var ms=bnxClientSheet(cid,t[0]),mv=ms.getDataRange().getValues(),mh=(mv[0]||[]).map(String),ic=mh.indexOf('ITEM_ID'),cc=mh.indexOf('ITEM_CODE'),ci=mh.indexOf('CLIENT_ID');
