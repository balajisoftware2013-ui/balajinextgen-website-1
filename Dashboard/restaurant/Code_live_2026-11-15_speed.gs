   if(x.active!==false && (!/^\d{1,3}(\.\d{1,3}){3}$/.test(x.ip||'')||String(x.ip).split('.').some(function(n){return +n>255;})))throw new Error('Valid printer IPv4 required');
   if(x.port && (!(+x.port>0)||+x.port>65535))throw new Error('Invalid printer port');
  });
