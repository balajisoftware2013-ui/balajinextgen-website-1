    if (isNC) SL.push({ SALES_LEDGER_ID: P + '-SL-' + s + '-NC', CLIENT_ID: C.CLIENT_ID, LOCATION_ID: C.LOCATION_ID, BUSINESS_DATE: bd.date, BILL_ID: bid, BILL_NUMBER: no, AMOUNT: 0, PAYMENT_MODE: 'NC', CREATED_AT: bd.dt, CUSTOMER_ID: cid, PARTY_NAME: cnm });
    if (!isNC && Math.abs(paid - total) > 0.5) chk.push(no + ': payments ' + bnxi24_R2_(paid) + ' vs total ' + total);
    bnxi24_D.TAX += tamt + sct; bnxi24_D.BILLS += 1; bnxi24_D.NET_SALE += total; bnxi24_D.OTHERS += sc; bnxi24_D.ROUND_OFF += ro;
  });

