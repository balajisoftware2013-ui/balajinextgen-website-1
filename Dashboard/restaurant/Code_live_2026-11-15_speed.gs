/* one-time clean-up of rows already saved with a code (last 30 days): run RUN_34_FixStewardCodes() from the editor */
function RUN_34_FixStewardCodes(){
  var cid='CL00010',out={};
  [['KOT_MASTER',['STARTED_BY','STEWARD_NAME','CREATED_BY'],'KOT_DATE'],['ORDER_MASTER',['STARTED_BY','CREATED_BY'],'ORDER_DATE'],['BILL_MASTER',['CREATED_BY','FINALIZED_BY'],'BILL_DATE']].forEach(function(t){
    try{var sh=bnxClientSheet(cid,t[0]),v=sh.getDataRange().getValues(),h=v[0].map(String),dc=h.indexOf(t[2]),n=0,lo=new Date(Date.now()-30*864e5).toISOString().slice(0,10);
      t[1].forEach(function(col){var c=h.indexOf(col);if(c<0)return;
        for(var r=1;r<v.length;r++){var d=bnxNormalizeDateKey_(v[r][dc]);if(d&&d<lo)continue;var nv=bnxStaffName_(cid,v[r][c]);if(nv!==v[r][c]&&String(nv)!==String(v[r][c])){sh.getRange(r+1,c+1).setValue(nv);n++;}}});
