}
function bnxStaffName_(cid,v){
  var s=String(v==null?'':v).trim();if(!s)return v;
  if(!/^(\d+(\.0+)?|[A-Z]{2,4}\d{2,6})$/i.test(s))return v;            /* already a name */
  var m=bnxStaffNameMap_(cid),k=s.replace(/\.0+$/,'').toUpperCase();
  return m[k]||m[k.replace(/^0+/,'')]||m['USR'+k.padStart(5,'0')]||v;
}
function bnxStaffNamesInPayload_(session,p){
  if(!p||typeof p!=='object')return;var cid=String(session.CLIENT_ID||'');
  ['waiter','steward','captain','waiterName','stewardName','WAITER','STEWARD','STARTED_BY','STEWARD_NAME','CREATED_BY'].forEach(function(k){if(p[k]!=null&&p[k]!=='')p[k]=bnxStaffName_(cid,p[k]);});
  if(p.bill&&typeof p.bill==='object')['waiter','steward','WAITER','STEWARD_NAME'].forEach(function(k){if(p.bill[k])p.bill[k]=bnxStaffName_(cid,p.bill[k]);});
