  if (lr < 2) throw Error('Order not found for this client');
  var h = sh.getRange(1, 1, 1, lc).getValues()[0].map(String), rows = {};
  ['ORDER_ID', 'ORDER_NUMBER', 'ORDER_NO'].forEach(function (n) {
    var c = h.indexOf(n); if (c < 0) return;
    sh.getRange(2, c + 1, lr - 1, 1).createTextFinder(ref).matchEntireCell(true).findAll().forEach(function (x) { rows[x.getRow()] = 1; });
  });
  var list = Object.keys(rows).map(Number).sort(function (a, b) { return b - a; }), ci = h.indexOf('CLIENT_ID'), best = null;
  for (var i = 0; i < list.length; i++) {              // newest first; prefer a still-open order
    var v = sh.getRange(list[i], 1, 1, lc).getValues()[0], o = bnxRowToObject(v, h);
    if (ci >= 0 && o.CLIENT_ID && String(o.CLIENT_ID) !== String(cid)) continue;
    if (String(o.ORDER_ID) !== ref && String(o.ORDER_NUMBER || o.ORDER_NO || '') !== ref) continue;
    var f = { sheet: sh, headers: h, index: list[i], order: o, values: [] }; f.values[list[i] - 1] = v;
