// Purchase invoice, GRN, department issue, transfer and physical adjustment
// must never remain browser-local. Each accepted transaction writes the
// tenant transaction sheet(s), STOCK_MOVEMENT and STOCK_BALANCE atomically.
function bnxInventoryItem_(clientId,itemId,itemName){ return bnxResolveInventoryItem_(clientId,itemId,itemName); }

function bnxSavePurchaseInvoiceRow(session,payload){
  const clientId=session.CLIENT_ID, p=payload||{}, row=p.row||{};
  const id=String(row._id||row.PURCHASE_INVOICE_ID||row.PURCHASE_ID||'').trim();
  if(!id) return {success:false,message:'Purchase invoice ID required'};

  const lock=bnxTenantLock_();
  try{
    lock.waitLock(10000);

    const sh=bnxClientSheet(clientId,SHEETS.PURCHASE_INVOICE);
    const vals=sh.getDataRange().getValues();
    const h=vals[0]||[];
    const idCol=h.indexOf('PURCHASE_INVOICE_ID')>=0?h.indexOf('PURCHASE_INVOICE_ID'):h.indexOf('_id');
    let existing=-1;
    for(let r=1;r<vals.length;r++){
      if(idCol>=0 && String(vals[r][idCol])===id){ existing=r; break; }
    }

    // Capture the previous payable before changing the invoice.
    let old={supplierId:'',locationId:'',amount:0,date:''};
    if(existing>=1){
      const ov=vals[existing];
      const ix=k=>h.indexOf(k);
      old.supplierId=ix('SUPPLIER_ID')>=0?String(ov[ix('SUPPLIER_ID')]||'').trim():'';
      old.locationId=ix('LOCATION_ID')>=0?String(ov[ix('LOCATION_ID')]||'').trim():'';
      old.amount=ix('TOTAL_AMOUNT')>=0?Number(ov[ix('TOTAL_AMOUNT')])||0:0;
      old.date=ix('INVOICE_DATE')>=0?String(ov[ix('INVOICE_DATE')]||'').slice(0,10):'';
    }

    const base={
      PURCHASE_INVOICE_ID:id,
      CLIENT_ID:clientId,
      INVOICE_NO:row.inv_no||row.INVOICE_NO||'',
      INVOICE_DATE:row.inv_date||row.INVOICE_DATE||'',
      SUPPLIER_ID:row.party_id||row.SUPPLIER_ID||'',
      SUPPLIER_NAME:row.party_name||row.SUPPLIER_NAME||'',
      LOCATION_ID:row.wh_id||row.LOCATION_ID||'',
      DUE_DATE:row.due_date||row.DUE_DATE||'',
      TAXABLE_AMOUNT:Number(row.taxable)||0,
      CGST:Number(row.cgst)||0,
      SGST:Number(row.sgst)||0,
      IGST:Number(row.igst)||0,
      OTHER_CHARGES:Number(row.other_charges)||0,
      TOTAL_AMOUNT:Number(row.total)||0,
      STATUS:row.status||'unpaid',
      PAYMENT_STATUS:row.payment_status||row.status||'unpaid',
      ITEMS_JSON:JSON.stringify(Array.isArray(row.items)?row.items:[]),
      UPDATED_AT:new Date().toISOString()
    };

    if(existing>=1){
      const out=vals[existing].slice();
      h.forEach((x,i)=>{ if(base[x]!==undefined) out[i]=base[x]; });
      sh.getRange(existing+1,1,1,out.length).setValues([out]);
    }else{
      if(h.indexOf('CREATED_AT')>=0) base.CREATED_AT=new Date().toISOString();
      bnxAppendRow(clientId,SHEETS.PURCHASE_INVOICE,base);
    }

    // Purchase invoice detail is persisted in PURCHASE_INVOICE_ITEMS.
    // Rebuild the child rows for this invoice atomically under the same lock.
    try{
      const itemSh=bnxClientSheet(clientId,SHEETS.PURCHASE_INVOICE_ITEMS);
      const iv=itemSh.getDataRange().getValues();
      const ih=iv[0]||[];
      const pidCol=ih.indexOf('PURCHASE_INVOICE_ID');
      if(pidCol>=0){
        for(let r=iv.length-1;r>=1;r--){
          if(String(iv[r][pidCol])===id) itemSh.deleteRow(r+1);
        }
      }
      const items=Array.isArray(row.items)?row.items:[];
      for(let i=0;i<items.length;i++){
        const x=items[i]||{};
        const rec={
          PURCHASE_INVOICE_ITEM_ID:generateShortId_(clientId,'PURCHASE_INVOICE_ITEM_ID'),
          PURCHASE_INVOICE_ID:id,
          CLIENT_ID:clientId,
          LOCATION_ID:base.LOCATION_ID,
          ITEM_ID:x.item_id||x.ITEM_ID||'',
          ITEM_NAME:x.item_name||x.ITEM_NAME||'',
          HSN_CODE:x.hsn||x.HSN_CODE||'',
          QUANTITY:Number(x.qty!=null?x.qty:x.QUANTITY)||0,
          UNIT_ID:x.unit_id||x.UNIT_ID||'',
          RATE:Number(x.rate!=null?x.rate:x.RATE)||0,
          DISCOUNT_PCT:Number(x.discount_pct!=null?x.discount_pct:x.DISCOUNT_PCT)||0,
          GST_RATE:Number(x.gst_rate!=null?x.gst_rate:x.GST_RATE)||0,
          TAXABLE_AMOUNT:Number(x.taxable_amount!=null?x.taxable_amount:x.taxable)||0,
          CGST:Number(x.cgst)||0,
          SGST:Number(x.sgst)||0,
          IGST:Number(x.igst)||0,
          TAX_AMOUNT:Number(x.tax_amount!=null?x.tax_amount:((Number(x.cgst)||0)+(Number(x.sgst)||0)+(Number(x.igst)||0)))||0,
          EXTRA_CHARGES:Number(x.extra_charges)||0,
          LINE_TOTAL:Number(x.amount!=null?x.amount:x.LINE_TOTAL)||0,
          TCS_AMOUNT:Number(x.tcs_amount)||0,
          TDS_AMOUNT:Number(x.tds_amount)||0,
          UPDATED_AT:new Date().toISOString()
        };
        bnxAppendRow(clientId,SHEETS.PURCHASE_INVOICE_ITEMS,rec);
      }
    }catch(childErr){
      bnxLogError(clientId,'PURCHASE_INVOICE_ITEMS save failed: '+childErr.message,{purchaseInvoiceId:id});
      throw childErr;
    }

    // Supplier payable: new invoice adds due; edit reverses old and applies new.
    const newSup=String(base.SUPPLIER_ID||'').trim();
    const newLoc=String(base.LOCATION_ID||'').trim();
    const newAmt=Number(base.TOTAL_AMOUNT)||0;
    const newDate=String(base.INVOICE_DATE||bnxBusinessDateKey_(new Date())).slice(0,10);

    if(existing>=1 && old.amount>0 && old.supplierId){
      bnxApplySupplierDueDelta_(clientId,old.locationId,old.supplierId,-old.amount,
        old.date||newDate);
    }
    if(newSup && newAmt>0){
      bnxApplySupplierDueDelta_(clientId,newLoc,newSup,newAmt,newDate);
    }

    try{bnxInvalidateTodayReportCaches_(clientId);}catch(e){}
    return {
      success:true,
      purchaseInvoiceId:id,
      updated:existing>=1,
      itemCount:Array.isArray(row.items)?row.items.length:0
    };
  }catch(e){
    bnxLogError(clientId,'SYNC_PURCHASE_INVOICE_ROW failed: '+e.message,payload||{});
    return {success:false,message:e.message};
  }finally{
    try{lock.releaseLock();}catch(e){}
  }
}

function bnxGetPurchaseInvoices(session,payload){
  /* 2026-11-16: the items sheet is read ONCE (was once per invoice → 858 invoices × 2,389 rows timed out, page showed
     "No records"); dates come back as yyyy-mm-dd (sheet Date objects used to give "Thu Apr 02"); only the item fields
     the pages use are returned. */
  const clientId=session.CLIENT_ID, p=payload||{};
  try{
    const from=String(p.from||'').slice(0,10), to=String(p.to||'').slice(0,10);
    const D=v=>{ if(v instanceof Date && !isNaN(v)) return Utilities.formatDate(v,'Asia/Kolkata','yyyy-MM-dd'); const t=String(v||'').trim(), m=t.match(/^(\d{4})-(\d{2})-(\d{2})/); if(m) return m[0]; const n=t.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})/); return n? n[3]+'-'+('0'+n[2]).slice(-2)+'-'+('0'+n[1]).slice(-2) : t.slice(0,10); };
    const sh=bnxClientSheet(clientId,SHEETS.PURCHASE_INVOICE);
    const vals=sh.getDataRange().getValues(), h=vals[0]||[];
    const byInv={};
    try{
      const ish=bnxClientSheet(clientId,SHEETS.PURCHASE_INVOICE_ITEMS);
      const iv=ish.getDataRange().getValues(), ih=iv[0]||[], I=k=>ih.indexOf(k), pc=I('PURCHASE_INVOICE_ID');
      const pick=['ITEM_ID','ITEM_NAME','HSN_CODE','QUANTITY','UNIT_ID','RATE','DISCOUNT_PCT','GST_RATE','TAXABLE_AMOUNT','CGST','SGST','IGST','TAX_AMOUNT','EXTRA_CHARGES','LINE_TOTAL'].map(k=>[k,I(k)]).filter(x=>x[1]>=0);
      if(pc>=0) for(let j=1;j<iv.length;j++){ const id=String(iv[j][pc]||''); if(!id) continue; const x={}; pick.forEach(([k,c])=>{ x[k]=iv[j][c]; }); (byInv[id]=byInv[id]||[]).push(x); }
    }catch(e){}
    const rows=[];
    for(let r=1;r<vals.length;r++){
      const o=bnxRowToObject(vals[r],h);
      if(!o.PURCHASE_INVOICE_ID) continue;
      if(o.CLIENT_ID && String(o.CLIENT_ID)!==String(clientId)) continue;
      const d=D(o.INVOICE_DATE);
      if(from && d<from) continue;
      if(to && d>to) continue;
      let items=byInv[String(o.PURCHASE_INVOICE_ID)]||[];
      if(!items.length){ try{ const raw=o.ITEMS_JSON; if(raw) items=JSON.parse(raw)||[]; }catch(e){ items=[]; } }
      const ap=String(o.APPROVAL_STATUS||'').trim();
      rows.push({
        _id:String(o.PURCHASE_INVOICE_ID||''), inv_no:String(o.INVOICE_NO||''), party_id:String(o.SUPPLIER_ID||''), party_name:String(o.SUPPLIER_NAME||''),
        inv_date:d, due_date:D(o.DUE_DATE), wh_id:String(o.LOCATION_ID||''),
        taxable:Number(o.TAXABLE_AMOUNT)||0, cgst:Number(o.CGST)||0, sgst:Number(o.SGST)||0, igst:Number(o.IGST)||0,
        other_charges:Number(o.OTHER_CHARGES)||0, total:Number(o.TOTAL_AMOUNT)||0,
        status:String(o.PAYMENT_STATUS||o.STATUS||'unpaid'),
        approval_status: ap ? ap.charAt(0).toUpperCase()+ap.slice(1).toLowerCase() : '',
        notes:String(o.NOTES||''), items:items
      });
    }
    rows.sort((a,b)=>String(b.inv_date).localeCompare(String(a.inv_date)));
    return {success:true,data:rows,count:rows.length};
  }catch(e){
    bnxLogError(clientId,'GET_PURCHASE_INVOICES failed: '+e.message,payload||{});
    return {success:false,message:e.message,data:[]};
  }
}
/* 2026-11-16 GRN register for purchase-module (GOODS_RECEIPT_NOTE + GRN_ITEMS, one row per item like the GRN page) */
function bnxGetGrnRegister_(session,payload){
  const clientId=session.CLIENT_ID, p=payload||{};
  try{
    const D=v=>{ if(v instanceof Date && !isNaN(v)) return Utilities.formatDate(v,'Asia/Kolkata','yyyy-MM-dd'); const t=String(v||''), m=t.match(/^(\d{4})-(\d{2})-(\d{2})/); return m?m[0]:t.slice(0,10); };
    const from=String(p.from||'').slice(0,10), to=String(p.to||'').slice(0,10);
    const rowsOf=n=>{ const v=bnxClientSheet(clientId,n).getDataRange().getValues(), h=(v[0]||[]).map(String); return v.slice(1).map(r=>bnxRowToObject(r,h)); };
    const names={}, sups={};
    try{ rowsOf(SHEETS.RAW_MATERIAL_MASTER).forEach(r=>{ if(r.ITEM_CODE) names[String(r.ITEM_CODE)]={n:String(r.ITEM_NAME||''),u:String(r.UOM||'')}; }); }catch(e){}
    try{ rowsOf(SHEETS.SUPPLIER_MASTER).forEach(r=>{ if(r.SUPPLIER_ID) sups[String(r.SUPPLIER_ID)]=String(r.SUPPLIER_NAME||''); }); }catch(e){}
    const head={};
    rowsOf('GOODS_RECEIPT_NOTE').forEach(g=>{ if(!g.GRN_ID) return; if(g.CLIENT_ID && String(g.CLIENT_ID)!==String(clientId)) return;
      const d=D(g.GRN_DATE); if(from&&d<from) return; if(to&&d>to) return; head[String(g.GRN_ID)]={g:g,d:d}; });
    const out=[];
    rowsOf('GRN_ITEMS').forEach(x=>{ const hd=head[String(x.GRN_ID||'')]; if(!hd) return; const g=hd.g, it=names[String(x.ITEM_ID||'')]||{};
      const q=Number(x.QUANTITY_RECEIVED)||0, rate=Number(x.RATE)||0, vn=sups[String(g.SUPPLIER_ID||'')]||String(g.NOTES||'').replace(/^GRN register import · /,'');
      out.push({id:String(x.GRN_ITEM_ID||x.GRN_ID), grnId:String(g.GRN_ID), no:String(g.GRN_NUMBER||g.GRN_ID), date:hd.d, vendorId:String(g.SUPPLIER_ID||''), vendorName:vn,
        itemId:String(x.ITEM_ID||''), item:it.n||String(x.ITEM_ID||''), unit:String(x.UNIT_ID||it.u||''), received:q, accepted:q, rejected:0, rate:rate, amount:Math.round(q*rate*100)/100,
        godown:String(g.LOCATION_ID||''), status:String(g.STATUS||'RECEIVED')==='RECEIVED'?'Accepted':String(g.STATUS), fromServer:true}); });
    out.sort((a,b)=>a.date<b.date?1:a.date>b.date?-1:(a.no<b.no?1:-1));
    return {success:true,data:out,count:out.length};
  }catch(e){ try{bnxLogError(clientId,'GET_GRN_REGISTER failed: '+e.message,p);}catch(x){} return {success:false,message:e.message,data:[]}; }
}

function bnxDeletePurchaseInvoiceRow(session,payload){
  const clientId=session.CLIENT_ID,id=String((payload||{}).id||'').trim();
  if(!id)return {success:false,message:'Purchase invoice ID required'};

  const lock=bnxTenantLock_();
  try{
    lock.waitLock(10000);

    const sh=bnxClientSheet(clientId,SHEETS.PURCHASE_INVOICE);
    const vals=sh.getDataRange().getValues();
    const h=vals[0]||[];
    const ic=h.indexOf('PURCHASE_INVOICE_ID');
    if(ic<0)return {success:false,message:'PURCHASE_INVOICE_ID column missing'};

    let deleted=null, deletedRow=-1;
    for(let r=1;r<vals.length;r++){
      if(String(vals[r][ic])===id){ deleted=vals[r].slice(); deletedRow=r+1; break; }
    }
    if(!deleted)return {success:true,deleted:false,message:'Invoice already absent'};

    const hc=k=>h.indexOf(k);
    const sup=hc('SUPPLIER_ID')>=0?String(deleted[hc('SUPPLIER_ID')]||'').trim():'';
    const loc=hc('LOCATION_ID')>=0?String(deleted[hc('LOCATION_ID')]||'').trim():'';
    const amt=hc('TOTAL_AMOUNT')>=0?Number(deleted[hc('TOTAL_AMOUNT')])||0:0;
    const dt=hc('INVOICE_DATE')>=0?String(deleted[hc('INVOICE_DATE')]||'').slice(0,10):bnxBusinessDateKey_(new Date());

    // Delete child invoice rows first. They are invoice-detail records, not stock.
    try{
      const itemSh=bnxClientSheet(clientId,SHEETS.PURCHASE_INVOICE_ITEMS);
      const iv=itemSh.getDataRange().getValues(), ih=iv[0]||[], pc=ih.indexOf('PURCHASE_INVOICE_ID');
      if(pc>=0){
        for(let r=iv.length-1;r>=1;r--){
          if(String(iv[r][pc])===id)itemSh.deleteRow(r+1);
        }
      }
    }catch(e){
      bnxLogError(clientId,'PURCHASE_INVOICE_ITEMS delete failed: '+e.message,{purchaseInvoiceId:id});
      throw e;
    }

    sh.deleteRow(deletedRow);

    // Reverse payable exactly once. Never touch STOCK_MOVEMENT here.
    if(sup && amt>0) bnxApplySupplierDueDelta_(clientId,loc,sup,-amt,dt);

    try{bnxInvalidateTodayReportCaches_(clientId);}catch(e){}
    return {success:true,deleted:true,purchaseInvoiceId:id};
  }catch(e){
    bnxLogError(clientId,'DELETE_PURCHASE_INVOICE_ROW failed: '+e.message,{id:id});
    return {success:false,message:e.message};
  }finally{
    try{lock.releaseLock();}catch(e){}
  }
}

function bnxIssueStockToDept(session,payload){ return bnxSaveDeptIssueLive_(session,payload,'ISSUE_STOCK_TO_DEPT'); }
function bnxSaveDeptIssueLive_(session,payload){
