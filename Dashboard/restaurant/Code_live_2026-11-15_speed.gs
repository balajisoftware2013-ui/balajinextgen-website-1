function bnxBillCustomer_(clientId, b) {
  if (b.__cust) return b.__cust;
  let name = String(b.CUSTOMER_NAME || '').trim();
  let mob = String(b.CUSTOMER_MOBILE || b.MOBILE || '').replace(/\.0+$/, '').trim();
  if (!mob) { const m = /Customer mobile:\s*([+\d][\d\s-]{6,})/i.exec(String(b.NOTES || '')); if (m) mob = m[1].replace(/\s+/g, ''); }
  const cid = String(b.CUSTOMER_ID || '').trim();
  if (cid && (!mob || !name || /^(default customer|walk-?in|general customer|sundry consumer)$/i.test(name))) {
    const c = bnxCustomerMap_(clientId)[cid];
    if (c) { if (!mob && c[1]) mob = c[1]; if ((!name || /^(default customer|walk-?in)$/i.test(name)) && c[0] && !/^(default customer|walk-?in)$/i.test(c[0])) name = c[0]; }
  }
  b.__cust = { name: name || 'GENERAL CUSTOMER', mob: mob };
