/* ============================================================================
 * CHANGE_BILL_PAYMENT_MODE (2026-10-29: "settlement: cash settled → change to split, or card → UPI")
 * payload { billNumber, preview:true }                  → { total, status, payments:[{mode,amount}] }
 * payload { billNumber, payments:[{mode,amount}], requestId } → changes ONLY the tender of a PAID bill.
 * Builds the edit from the stored bill + items, so the normal edit flow runs its payment-only path:
 * same bill number, items / totals / stock untouched, PAYMENT_MASTER + SALES_LEDGER + journal rewritten, all-or-nothing.
 * ========================================================================== */
function bnxChangeBillPayMode_(session, payload) {
  const p = payload || {}, cid = String(session.CLIENT_ID), no = String(p.billNumber || p.BILL_NUMBER || p.no || '').trim();
  if (!no) return { success: false, error: 'Bill number required' };
  if (!p.preview && !bnxBillEditRole_(session)) return { success: false, error: 'Changing payment mode needs Manager / Admin login' };
  const f = bnxFindBillRowByNumber_(cid, no);
  if (!f) return { success: false, error: 'Bill ' + no + ' not found' };
  const old = bnxRowToObject(f.values, f.headers), bid = String(old.BILL_ID || '');
  const num = function (v) { const x = Number(String(v == null ? '' : v).replace(/[,₹\s]/g, '')); return Number.isFinite(x) ? x : 0; };
  const r2 = function (v) { return Math.round((Number(v) || 0) * 100) / 100; };
  const total = r2(num(old.GRAND_TOTAL));
  const pays = bnxBillExactRows_(bnxClientSheet(cid, SHEETS.PAYMENT_MASTER), 'BILL_ID', bid).filter(function (x) {
    return String(x.BILL_ID) === bid && !/^(REFUNDED|REVERSED|VOID|CANCELLED)$/i.test(String(x.PAYMENT_STATUS || ''));
  });
  const current = pays.map(function (x) { return { mode: String(x.PAYMENT_MODE || '').toUpperCase(), amount: r2(num(x.AMOUNT)) }; });
  const status = String(old.PAYMENT_STATUS || '').toUpperCase();
  if (p.preview) return { success: true, data: { billNumber: old.BILL_NUMBER, billId: bid, total: total, status: status, billStatus: old.BILL_STATUS, customer: old.CUSTOMER_NAME || '', table: old.TABLE_ID || '', date: bnxNormalizeDateKey_(old.BILL_DATE), payments: current } };
  if (/CANCEL|VOID/i.test(String(old.BILL_STATUS || ''))) return { success: false, error: 'Cancelled bill — payment mode cannot be changed' };
  if (status !== 'PAID') return { success: false, error: 'Bill ' + no + ' is not settled (' + (status || 'open') + '). Settle it first, or collect the due through Due Received.' };
  const lines = (Array.isArray(p.payments) ? p.payments : []).map(function (x) {
    return { mode: String(x.mode || x.MODE || '').trim().toUpperCase(), amount: r2(num(x.amount != null ? x.amount : x.AMOUNT)), reference: String(x.reference || '') };
  }).filter(function (x) { return x.mode && x.amount > 0; });
  if (!lines.length) return { success: false, error: 'Choose a payment mode' };
  if (lines.some(function (x) { return /^(ADVANCE|GUEST ADVANCE)$/.test(x.mode); })) return { success: false, error: 'Guest advance is adjusted through its own settlement — choose another mode' };
  if (lines.some(function (x) { return /^(CREDIT|DUE)$/.test(x.mode); })) return { success: false, error: 'Credit / due cannot be chosen here — use Bill edit so the customer balance is updated' };
  const sum = r2(lines.reduce(function (a, x) { return a + x.amount; }, 0));
  if (Math.abs(sum - total) > 0.01) return { success: false, error: 'Payment lines add up to ₹' + sum + ' but the bill total is ₹' + total };
  const same = current.length === lines.length && current.every(function (c, i) { return c.mode === lines[i].mode && Math.abs(c.amount - lines[i].amount) < 0.01; });
  if (same) return { success: true, unchanged: true, billNo: old.BILL_NUMBER, message: 'Payment mode already ' + lines.map(function (x) { return x.mode; }).join(' + ') };
  const items = bnxBillExactRows_(bnxClientSheet(cid, SHEETS.BILL_ITEMS), 'BILL_ID', bid).filter(function (x) { return String(x.BILL_ID) === bid; });
  if (!items.length) return { success: false, error: 'Bill items not found for ' + no + '; open the bill to check it' };
  const bill = {
    no: old.BILL_NUMBER, originalBillNumber: old.BILL_NUMBER, billId: bid, editExisting: true, paymentOnly: true,
    table: old.TABLE_ID || '', customer: old.CUSTOMER_NAME || '', pax: old.COVERS === '' || old.COVERS == null ? undefined : num(old.COVERS),
    sub: num(old.SUBTOTAL), disc: r2(num(old.ITEM_DISCOUNT) + num(old.BILL_DISCOUNT)), sc: num(old.SERVICE_CHARGE_AMOUNT),
    gst: r2(num(old.TAX_AMOUNT) + num(old.SERVICE_CHARGE_GST_AMOUNT)), total: total, status: 'paid',
    pay: lines.length > 1 ? 'SPLIT' : lines[0].mode, payments: lines,
    itemsDetail: items.map(function (i) { return { ITEM_ID: i.ITEM_ID, name: i.ITEM_NAME, qty: num(i.QUANTITY), rate: num(i.RATE), amt: num(i.LINE_TOTAL),
      discount: num(i.LINE_DISCOUNT), size: i.SIZE || i.SERVING_SIZE || '', remark: i.SPECIAL_INSTRUCTIONS || i.NOTES || '' }; })
  };
  const res = bnxSaveBill(session, { bill: bill, requestId: p.requestId || ('PM-' + bid + '-' + Utilities.getUuid()) });
  if (res && res.success && res.paymentOnly === false) { try { bnxLogError(cid, 'CHANGE_BILL_PAYMENT_MODE ran a full edit for ' + no, {}); } catch (e) {} }
  return res;
}


/* 2026-10-29 ("GST report / Tally audit"): an edited bill was saved with a flat {CGST,SGST} breakup — the per-rate split
   (CGST@2.5% / SGST@2.5% / @9% service charge / @20% tobacco) was lost, so GST reports showed it as "Not split" and Tally
   posted all of its tax at 5%. The edit now keeps the per-rate split: the POS's own gstBreakup when sent, else built from
   its tax rows ("GST @5%" · taxAmt). Flat CGST/SGST/LINES stay for older readers. */
function bnxEditGstBreakup_(b,taxTotal,sc){
  var r2=function(v){return Math.round((Number(v)||0)*100)/100;};
  var out={};
  if(b.gstBreakup&&typeof b.gstBreakup==='object'){Object.keys(b.gstBreakup).forEach(function(k){out[k]=b.gstBreakup[k];});}
  else{
    var split=0;
    (Array.isArray(b.taxRows)?b.taxRows:[]).forEach(function(t){
      var m=String(t&&t.taxName||'').match(/([\d.]+)\s*%/),tax=r2(t&&t.taxAmt);if(!m||!(tax>0))return;
      var rate=Number(m[1]),half=String(Math.round(rate/2*100)/100),c=r2(tax/2),g=r2(tax-c);
      out['CGST@'+half+'%']=r2((out['CGST@'+half+'%']||0)+c);out['SGST@'+half+'%']=r2((out['SGST@'+half+'%']||0)+g);split+=tax;
    });
    if(split>0.004&&Math.abs(split-taxTotal)>1){out={};}            /* rows do not match the bill tax: do not guess */
  }
  out.CGST=r2(taxTotal/2);out.SGST=r2(taxTotal-r2(taxTotal/2));out.IGST=0;
  out.SERVICE_CHARGE=sc.amount;out.SERVICE_CHARGE_GST=sc.gst;out.LINES=b.taxRows||[];
  return out;
}


