   h.forEach(function(k,i){if(Object.prototype.hasOwnProperty.call(obj,k))vals[i]=obj[k];});
   if(row>=0)sh.getRange(row+1,1,1,h.length).setValues([vals]);else sh.appendRow(vals);
  });v=sh.getDataRange().getValues();
 }
 var printers=v.slice(1).filter(function(r){return String(r[ci])===cid&&roles.indexOf(String(r[ri]))>=0;}).map(function(r){var o={};h.forEach(function(k,i){o[k]=r[i];});return {role:String(o.PRINTER_ROLE),ip:String(o.PRINTER_IP||''),label:String(o.PRINTER_LABEL||''),port:Number(o.PORT)||9100,active:! /^(NO|FALSE|0|INACTIVE)$/i.test(String(o.ACTIVE)),categories:String(o.CATEGORIES||'')};});
