  });

  var out = [['BUSINESS_DATE', 'BILLS', 'NET_SALE', 'LIQUOR', 'LIQUOR_MRP', 'FOOD', 'BEVERAGE', 'HUKKA', 'EXTRA_GROUPS', 'GROUPS_JSON', 'OTHERS_SC', 'NO_ITEM_SALE',
    'GROSS_SALE', 'TAX', 'ROUND_OFF', 'SERVICE_CHARGE', 'SC_GST', 'BILL_DISCOUNT', 'NC_BILLS', 'NC_ITEM_VALUE', 'STALE_ITEM_BILLS', 'STALE_ITEM_VALUE',
    'NO_ITEM_BILLS', 'NO_ITEM_FILLED_FROM_SHEET', 'BUILT_AT', 'DISCOUNT']];
  var built = Utilities.formatDate(new Date(), 'Asia/Kolkata', 'yyyy-MM-dd HH:mm');
  Object.keys(days).sort().forEach(function (d) {
    var o = days[d], s = sheet[d], filled = 0;
    if (o.noItem > 0 && s) {
      var miss = { liquor: Math.max(0, s.liquor - o.liquor), food: Math.max(0, s.food - o.food), bev: Math.max(0, s.bev - o.bev), hf: Math.max(0, s.hf - o.hf) };
      var mt = miss.liquor + miss.food + miss.bev + miss.hf;
      if (mt > 0) { Object.keys(miss).forEach(function (k) { o[k] += o.noItem * miss[k] / mt; }); filled = o.noItem; o.noItem = 0; }
    }
    var mrp = o.mrp, liquor = o.liquor;
    /* owner-sheet LIQUOR_MRP (DSR_ITEM_GROUP_DAILY) is the owner's own figure: when the day has one it wins, taken out of total liquor;
       otherwise Liquor MRP = the MRP-named liquor lines above. */
    if (s && s.mrp > 0) { var liqAll = liquor + mrp; mrp = Math.min(s.mrp, liqAll); liquor = liqAll - mrp; }
    var xs = {}, xTot = 0;
    Object.keys(o.x).sort().forEach(function (k) { var v = bnxIgcR2_(o.x[k]); if (Math.abs(v) >= 0.01) { xs[k] = v; xTot += o.x[k]; } });
    var taxAll = o.tax + o.scGst;
    var itemsTot = liquor + mrp + o.food + o.bev + o.hf + xTot + o.noItem;
    var resid = o.net - itemsTot - taxAll;
    var others = o.sc > 0 ? o.sc : (resid > 1 ? resid : 0);
