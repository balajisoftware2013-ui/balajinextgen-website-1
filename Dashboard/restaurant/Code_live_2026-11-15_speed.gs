 if(hour>=6)return day;
 return new Date(Date.parse(day+'T12:00:00Z')-86400000).toISOString().slice(0,10);
}
function RUN_28_Check26OctoberBilling(){return bnx28Repair26_(false);}
function RUN_28_Fix26OctoberBilling(){return bnx28Repair26_(true);}
function bnx28Repair26_(apply){
 const cid='CL00010',target='2026-10-26',lock=bnxTenantLock_();
 if(!lock.tryLock(30000))throw Error('Billing busy. Run again when the current save completes.');
 const updates=[],written=[],billIds={},report={clientId:cid,businessDate:target,apply:apply,bills:[],changes:[],warnings:[]};
 try{
  function read(name){const sh=bnxClientSheet(cid,name),v=sh.getDataRange().getValues(),h=(v[0]||[]).map(String);return {sh:sh,h:h,rows:v.slice(1)};}
  function object(t,row){return bnxRowToObject(row,t.h);}
  function own(o){return !o.CLIENT_ID||String(o.CLIENT_ID)===cid;}
  function queue(t,rowIndex,o,field,value,isTime){
   const c=t.h.indexOf(field);if(c<0)return;
   const before=t.rows[rowIndex][c];let shown=before;
   if(before instanceof Date)shown=Utilities.formatDate(before,'Asia/Kolkata',isTime?'HH:mm:ss':'yyyy-MM-dd');
   // Force times to text even when visually equal; Date time values break API clients.
   if(String(shown==null?'':shown)===String(value)&&!(isTime&&before instanceof Date))return;
   updates.push({sh:t.sh,row:rowIndex+2,col:c+1,old:before,value:value,time:isTime,format:t.sh.getRange(rowIndex+2,c+1).getNumberFormat()});
   report.changes.push({sheet:t.sh.getName(),row:rowIndex+2,field:field,before:String(shown||''),after:value,bill:o.BILL_NUMBER||o.BILL_ID||o.ORDER_ID||''});
  }
