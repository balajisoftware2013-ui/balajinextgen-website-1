    out.push([d, o.bills, bnxIgcR2_(o.net), bnxIgcR2_(liquor), bnxIgcR2_(mrp), bnxIgcR2_(o.food), bnxIgcR2_(o.bev), bnxIgcR2_(o.hf),
      bnxIgcR2_(xTot), Object.keys(xs).length ? JSON.stringify(xs) : '', bnxIgcR2_(others), bnxIgcR2_(o.noItem),
      bnxIgcR2_(gross), bnxIgcR2_(taxAll), bnxIgcR2_(o.net - gross - taxAll), bnxIgcR2_(o.sc), bnxIgcR2_(o.scGst), bnxIgcR2_(o.disc),
      o.ncBills, bnxIgcR2_(o.ncVal), o.staleBills, bnxIgcR2_(o.staleVal), o.noItemBills, bnxIgcR2_(filled), built, bnxIgcR2_(o.disc2)]);
  });

  var sh = ss.getSheetByName(BNX_IGC_TAB) || ss.insertSheet(BNX_IGC_TAB);
  sh.getRange(1, 1, Math.max(out.length, sh.getMaxRows()), 1).setNumberFormat('@');
  sh.getRange(1, 1, out.length, out[0].length).setValues(out);
  var extra = sh.getLastRow() - out.length;
  if (extra > 0) sh.getRange(out.length + 1, 1, extra, sh.getLastColumn()).clearContent();
  sh.setFrozenRows(1);
  try { PropertiesService.getScriptProperties().setProperty('DSR_IGC_SIG_' + cid, JSON.stringify({ sig: bnxIgcSig_(ss), t: Date.now() })); } catch (e) {}
