  var res = {
    dryRun: !!payload.dryRun, mode: REIMPORT ? 'reimport' : 'import', bills: BM.length, imported: BM.map(function (b) { return b.BILL_NUMBER; }), skipped: skipped, conflicts: conflicts, replaced: replace.length, days: days,
    counts: { ORDER_MASTER: OM.length, ORDER_ITEMS: OI.length, BILL_MASTER: BM.length, BILL_ITEMS: BI.length, PAYMENT_MASTER: PAY.length, SALES_LEDGER: SL.length, DSR_DAYS: Object.keys(dsr).length },
    newItems: newItemList.map(function (i) { return i.ITEM_ID + ' ' + i.ITEM_NAME + ' (' + C.GRP[i.ITEM_GROUP_ID] + ')'; }),
    newCustomers: newCus.map(function (c) { return c.CUSTOMER_ID + ' ' + c.CUSTOMER_NAME + (c.PHONE ? ' ' + c.PHONE : ''); }),
    match: matchStat, checks: chk, warnings: warn, written: []
