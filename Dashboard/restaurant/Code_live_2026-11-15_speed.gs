function bnxGetDsrMatrix(session, payload) {
  const clientId = session.CLIENT_ID;
  /* 2026-10-29 ("DSR instant + changes automatically"): the cached month is keyed on the data version — any sale, payment,
     pay-mode change or due receipt saved through the server makes a new key, so a cached answer is never stale and the DSR
     no longer needs force:true (which rebuilt the whole month on every open). Past months 30 min, current month 10 min. */
  var gen=(function(){try{var c=CacheService.getScriptCache();return (c.get('livegen_'+clientId)||'0')+'.'+(c.get('billgen_'+clientId)||'0');}catch(e){return '0';}})();
  const ym=String(payload.year||'')+'-'+String(payload.month||'').padStart(2,'0'),cur=bnxBusinessDateKey_().slice(0,7);
  if(payload&&payload.hardRefresh===true)return bnxGetDsrMatrix_impl_(session,payload);
  const cacheKey = bnxReportCacheKey_('dsrmatrix_mrp30', clientId, payload) + '_' + (payload.year||'') + '_' + (payload.month||'') + '_' + gen;
  try{const hit=bnxBigCacheGet_(cacheKey);if(hit){const o=JSON.parse(hit);o.cached=true;return o;}}catch(e){}
  const res=bnxGetDsrMatrix_impl_(session, payload);
  try{if(res&&res.success)bnxBigCachePut_(cacheKey,JSON.stringify(res),ym<cur?1800:600);}catch(e){}   /* a month is > 100 KB: chunked cache */
  return res;
}

const BNX_DSR_LIQUOR_RE_ = /liquor|alcohol|wine|beer|whisky|whiskey|vodka|rum|gin|tequila|spirit|\bbar\b|imfl|cocktail|\bshots?\b|\bpeg\b|brandy|liqueur|champagne|cognac|feni|toddy|arrack|draught|draft/;
const BNX_DSR_LIQUOR_MRP_RE_ = /liquor\s*mrp|mrp\s*liquor/;
const BNX_DSR_BEVERAGE_RE_ = /beverage|\bdrink|juice|mocktail|soft ?drink|\bsoda\b|\bwater\b|\btea\b|\bcoffee\b|shake|smoothie|lassi|buttermilk|lemonade|\bcola\b/;
const BNX_DSR_HASHFREEZER_RE_ = /hash\s*freezer|hashfreezzer|hukka|hukkah|tobacco|cigarette|cigar|hookah|shisha|\bpaan\b/;
const BNX_DSR_OTHER_RE_ = /\bother(s)?\b|miscellaneous|misc\b|service charge|packing charge|delivery charge/;

function bnxClassifyDsrItem_(groupOrCategory, itemName) {
  const cat = String(groupOrCategory || '').replace(/[_-]+/g,' ').trim().toLowerCase();
  // ADD-ONS is explicitly a FOOD group; do not classify by add-on item name.
  if (/^add ?ons?$/.test(cat) || /\bfood\b|kitchen|bread|bakery|snack|starter|main course|dessert|rice|noodle|meal/.test(cat)) {
    return { isLiquor:false, isLiquorMrp:false, isBeverage:false, isHashFreezer:false, isOther:false, isFood:true };
  }
  if (BNX_DSR_LIQUOR_MRP_RE_.test(cat)) return { isLiquor:false, isLiquorMrp:true, isBeverage:false, isHashFreezer:false, isOther:false, isFood:false };
  // An MRP marker on a liquor item must be checked before the broad LIQUOR group.
  if (BNX_DSR_LIQUOR_RE_.test(cat) && /\bmrp\b/i.test(String(itemName || ''))) return { isLiquor:false, isLiquorMrp:true, isBeverage:false, isHashFreezer:false, isOther:false, isFood:false };
  if (BNX_DSR_LIQUOR_RE_.test(cat)) return { isLiquor:true, isLiquorMrp:false, isBeverage:false, isHashFreezer:false, isOther:false, isFood:false };
  if (BNX_DSR_BEVERAGE_RE_.test(cat)) return { isLiquor:false, isLiquorMrp:false, isBeverage:true, isHashFreezer:false, isOther:false, isFood:false };
  if (BNX_DSR_HASHFREEZER_RE_.test(cat)) return { isLiquor:false, isLiquorMrp:false, isBeverage:false, isHashFreezer:true, isOther:false, isFood:false };
  if (BNX_DSR_OTHER_RE_.test(cat)) return { isLiquor:false, isLiquorMrp:false, isBeverage:false, isHashFreezer:false, isOther:true, isFood:false };
  const name = String(itemName || '').toLowerCase();
  if (BNX_DSR_LIQUOR_MRP_RE_.test(name)) return { isLiquor:false, isLiquorMrp:true, isBeverage:false, isHashFreezer:false, isOther:false, isFood:false };
  if (BNX_DSR_LIQUOR_RE_.test(name)) return { isLiquor:true, isLiquorMrp:false, isBeverage:false, isHashFreezer:false, isOther:false, isFood:false };
  if (BNX_DSR_BEVERAGE_RE_.test(name)) return { isLiquor:false, isLiquorMrp:false, isBeverage:true, isHashFreezer:false, isOther:false, isFood:false };
  if (BNX_DSR_HASHFREEZER_RE_.test(name)) return { isLiquor:false, isLiquorMrp:false, isBeverage:false, isHashFreezer:true, isOther:false, isFood:false };
  if (BNX_DSR_OTHER_RE_.test(name)) return { isLiquor:false, isLiquorMrp:false, isBeverage:false, isHashFreezer:false, isOther:true, isFood:false };
  return { isLiquor:false, isLiquorMrp:false, isBeverage:false, isHashFreezer:false, isOther:false, isFood:true };
}

function bnxGetDsrMatrix_impl_(session, payload) {
  /* 2026-10-21 DSR RULES = the Hashtag DSR sheet (checked against 16-Oct: Liquor 168,770 · Food 50,238 · Beverage 12,781 ·
     Hashfreezer 11,079 · Others 2,727 · Gross 245,596 · Tax 8,073 · Net 253,672 · Discount 11,065 · Guest Due 11,145):
       Net Sale   = bill GRAND_TOTAL (cancelled / void excluded)
       Tax        = GST + service-charge GST            Round Off = ROUND_OFF
       Gross Sale = Net Sale - Tax - Round Off          Others    = service charge
       Item groups = each bill's item lines (BILL_ITEMS) scaled to that bill's after-discount value, so the groups add up to Gross
       Discount   = item + bill discount of chargeable bills (NC bills are not discount)
       Guest Due Sales = CREDIT payment lines of the day (or the outstanding of a DUE bill that has none)
     Was: Gross = GST-taxable value only (tax-free liquor left out), Net = taxable+tax, items before discount, NC counted as discount. */
  const clientId = session.CLIENT_ID;
  const year = Number(payload.year);
  const month = Number(payload.month);
  try {
    const mm = String(month).padStart(2, '0');
    const prefix = year + '-' + mm + '-';
    const byDay = {};
    const daysInMonth = new Date(year, month, 0).getDate();
    for (let d = 1; d <= daysInMonth; d++) {
      const key = String(d).padStart(2, '0');
      byDay[key] = { liquor: 0, liquorMrp: 0, food: 0, beverage: 0, hashFreezer: 0, others: 0, serviceCharge: 0, noItemSale: 0, eazydine: 0, other: 0, grossSale: 0, tax: 0, roundOff: 0, netSale: 0, cash: 0, iciciCard: 0, iciciGpay: 0, guestDueSales: 0, zomato: 0, swiggy: 0, dueReceivedCash: 0, dueReceivedIcici: 0, totalCashCollection: 0, discount: 0, guestDuesCN: 0, bills: 0 };
    }
    const _mLo = prefix + '01', _mHi = prefix + String(daysInMonth).padStart(2,'0'), n2 = function (v) { if(typeof v==='number')return isFinite(v)?v:0; let t=String(v==null?'':v).trim(),neg=/^\(.*\)$/.test(t); t=t.replace(/[₹,\s()]/g,''); const n=Number(t); return isFinite(n)?(neg?-n:n):0; };
    const billSheet = bnxClientSheet(clientId, SHEETS.BILL_MASTER);
    const billValues = bnxReadWindow_(billSheet, ['BUSINESS_DATE','BILL_DATE'], _mLo, _mHi);
    const billHeaders = billValues[0];
    const billDayByBillId = {}, goodsByBill = {}, dueByBill = {};
    for (let r = 1; r < billValues.length; r++) {
      const b = bnxRowToObject(billValues[r], billHeaders);
      if (String(b.CLIENT_ID) !== String(clientId)) continue;
      const billDateKey = bnxNormalizeDateKey_(b.BUSINESS_DATE || b.BILL_DATE);
      if (!billDateKey || !billDateKey.startsWith(prefix)) continue;
      const day = billDateKey.slice(-2);
      if (!byDay[day]) continue;
      const st = String(b.BILL_STATUS || '').toUpperCase(), ps = String(b.PAYMENT_STATUS || '').toUpperCase();
      if (/^(CANCELLED|VOID|VOIDED)$/.test(st) || /^(CANCELLED|VOID)$/.test(ps)) continue;
      const net = n2(b.GRAND_TOTAL), tax = n2(b.TAX_AMOUNT) + n2(b.SERVICE_CHARGE_GST_AMOUNT), ro = n2(b.ROUND_OFF), sc = n2(b.SERVICE_CHARGE_AMOUNT);
      const nc = ps === 'NOT_REQUIRED' || /^(NC|NON_CHARGE|NO_CHARGE|COMPLIMENTARY|NOT_REQUIRED)$/.test(st) || (net === 0 && tax === 0);
      const x = byDay[day];
      x.bills += 1; x.netSale += net; x.tax += tax; x.roundOff += ro; x.grossSale += net - tax - ro; x.others += sc; x.serviceCharge += sc;
      if (!nc) x.discount += n2(b.BILL_DISCOUNT) + n2(b.ITEM_DISCOUNT);
      if (b.BILL_ID) { billDayByBillId[b.BILL_ID] = day; goodsByBill[b.BILL_ID] = Math.max(0, net - tax - ro - sc); if (ps !== 'PAID' && !nc) dueByBill[b.BILL_ID] = bnxBillOutstanding_(b); }
    }
    const creditByBill = {}, paymentModes = {};
    try {const mv=bnxClientSheet(clientId,'PAYMENT_MODE_MASTER').getDataRange().getValues(), mh=mv[0]||[];
      for(let i=1;i<mv.length;i++){const mo=bnxRowToObject(mv[i],mh);if(mo.CLIENT_ID&&String(mo.CLIENT_ID)!==String(clientId))continue;paymentModes[String(mo.PAYMENT_MODE_ID||'')]=mo.MODE_CODE||mo.MODE_NAME||mo.PAYMENT_MODE_NAME||'';}
    }catch(e){}
    function modeText(row){const v=String(row.PAYMENT_MODE||'').trim();return (!v||/^PMD/i.test(v))?String(paymentModes[row.PAYMENT_MODE_ID||v]||v):v;}

    const paySheet = bnxClientSheet(clientId, SHEETS.PAYMENT_MASTER);
    const payValues = bnxReadByIds_(paySheet, 'BILL_ID', Object.keys(billDayByBillId).reduce(function(set,id){set[id]=true;return set;},{}));
    const payHeaders = payValues[0];
    for (let r = 1; r < payValues.length; r++) {
      const p = bnxRowToObject(payValues[r], payHeaders);
      if (String(p.CLIENT_ID) !== String(clientId)) continue;
      const day = billDayByBillId[String(p.BILL_ID || '')];
      if (!day || /DUE.?RECEI|DUE.?COLLECT|OLD.?DUE/i.test(String(p.PAYMENT_TYPE || p.SOURCE || ''))) continue;
      if (!byDay[day]) continue;
      const status = String(p.PAYMENT_STATUS || '').toUpperCase();
      if (status === 'REFUNDED' || status === 'REVERSED' || status === 'VOID' || status === 'CANCELLED') continue;
      const raw = modeText(p).toUpperCase(), mode = bnxNormalizePaymentMode_(modeText(p)), amt = n2(p.AMOUNT);
      if (/^(EAZY|EASY)[ _-]*DINE(?:R)?(?:[ _-]+ONLINE)?$/.test(raw)) byDay[day].eazydine += amt;
      else if (/^ZOMATO(?:\b|$)/.test(raw)) byDay[day].zomato += amt;
      else if (/^SWIGGY(?:\b|$)/.test(raw)) byDay[day].swiggy += amt;
      else if (mode === 'CASH') { byDay[day].cash += amt; byDay[day].totalCashCollection += amt; }
      else if (mode === 'UPI' || raw === 'ONLINE' || raw === 'ONLINE COLLECTION' || raw === 'GPAY' || raw === 'ICICI GPAY') byDay[day].iciciGpay += amt;
      else if (mode === 'CARD' || /CARD/.test(raw)) byDay[day].iciciCard += amt;
      else if (mode === 'CREDIT') { byDay[day].guestDueSales += amt; if (p.BILL_ID) creditByBill[p.BILL_ID] = true; }
      else byDay[day].other += amt;
    }
    Object.keys(dueByBill).forEach(function (id) { if (!creditByBill[id]) { const d = billDayByBillId[id]; if (d && byDay[d]) byDay[d].guestDueSales += dueByBill[id]; } });
    try {
      const catMap = bnxCachedCategoryNameMap_(clientId);
      const imSheet = bnxClientSheet(clientId, SHEETS.ITEM_MASTER);
      const imValues = imSheet.getDataRange().getValues();
      const imHeaders = imValues[0];
      const itemFlagsByName = {};
      for (let r = 1; r < imValues.length; r++) {
        const it = bnxRowToObject(imValues[r], imHeaders);
        if (it.CLIENT_ID !== clientId) continue;
        const catName = String(it.ITEM_GROUP_NAME || it.ITEM_GROUP || it.GROUP_NAME || it.CATEGORY_NAME || it.CATEGORY || catMap.byId[it.CATEGORY_ID] || '').toLowerCase();
        itemFlagsByName[String(it.ITEM_NAME || '').toLowerCase()] = bnxClassifyDsrItem_(catName, it.ITEM_NAME);
      }
      const _ids = {}; Object.keys(billDayByBillId).forEach(function (k) { _ids[String(k)] = true; });
      const biSheet = bnxClientSheet(clientId, SHEETS.BILL_ITEMS);
      const biValues = bnxReadByIds_(biSheet, 'BILL_ID', _ids);
      const biHeaders = biValues[0];
      const lines = {};
      for (let r = 1; r < biValues.length; r++) {
        const it = bnxRowToObject(biValues[r], biHeaders);
        if (!billDayByBillId[it.BILL_ID]) continue;
        const lineGroup = String(it.ITEM_GROUP_NAME || it.ITEM_GROUP || it.GROUP_NAME || it.CATEGORY_NAME || it.CATEGORY || '').toLowerCase();
        const flags = lineGroup ? bnxClassifyDsrItem_(lineGroup, it.ITEM_NAME) : (itemFlagsByName[String(it.ITEM_NAME || '').toLowerCase()] || bnxClassifyDsrItem_('', it.ITEM_NAME));
        const g = (flags && flags.isLiquorMrp) ? 'liquorMrp' : (flags && flags.isLiquor) ? 'liquor' : (flags && flags.isBeverage) ? 'beverage' : (flags && flags.isHashFreezer) ? 'hashFreezer' : (flags && flags.isOther) ? 'others' : 'food';
        const L = lines[it.BILL_ID] || (lines[it.BILL_ID] = {}); L[g] = (L[g] || 0) + n2(it.LINE_TOTAL);
      }
      Object.keys(billDayByBillId).forEach(function (id) {
        const day = billDayByBillId[id], goods = goodsByBill[id] || 0, L = lines[id];
        if (!goods) return;
        if (!L) { byDay[day].noItemSale += goods; return; }             /* no item rows: kept in Food so groups still add up to Gross */
        const sum = Object.keys(L).reduce(function (a, k) { return a + L[k]; }, 0);
        if (sum <= 0) { byDay[day].noItemSale += goods; return; }
        Object.keys(L).forEach(function (k) { byDay[day][k] += goods * L[k] / sum; });
      });
    } catch (e) { throw new Error('Item revenue unavailable: '+e.message); }
    /* exact POS item-group split: DSR_ITEM_GROUP_CALC (built from the POS item export) is used for a day whenever it
       describes the SAME bills (same bill count and net sale) — otherwise the allocation above stays. */
    try {
      const cs = bnxClientSheet(clientId, 'DSR_ITEM_GROUP_CALC');
      const cv = bnxReadWindow_(cs, ['BUSINESS_DATE'], _mLo, _mHi), ch = cv[0];
      for (let r = 1; r < cv.length; r++) {
        const o = bnxRowToObject(cv[r], ch), dk = bnxNormalizeDateKey_(o.BUSINESS_DATE);
        if (!dk || !dk.startsWith(prefix)) continue;
        const x = byDay[dk.slice(-2)]; if (!x || !x.bills) continue;
        if (Math.abs(n2(o.NET_SALE) - x.netSale) > 2 || (n2(o.BILLS) && n2(o.BILLS) !== x.bills)) continue;
        const parts = { liquor: n2(o.LIQUOR), liquorMrp: n2(o.LIQUOR_MRP), food: n2(o.FOOD), beverage: n2(o.BEVERAGE), hashFreezer: n2(o.HUKKA) };
        const goods = Object.keys(parts).reduce(function (a, k) { return a + parts[k]; }, 0);
        if (Math.abs(goods + x.others + n2(o.EXTRA_GROUPS) - x.grossSale) > 5) continue;
        Object.keys(parts).forEach(function (k) { x[k] = parts[k]; });
        x.others += n2(o.EXTRA_GROUPS); x.noItemSale = 0;
      }
    } catch (e) {}
    try {
      const drSheet = bnxClientSheet(clientId, SHEETS.DUES_RECEIPT);
      const drValues = bnxReadWindow_(drSheet, ['RECEIPT_DATE'], _mLo, _mHi);
      const drHeaders = drValues[0];
      for (let r = 1; r < drValues.length; r++) {
        const rec = bnxRowToObject(drValues[r], drHeaders);
        if (rec.CLIENT_ID !== clientId) continue;
        if (/^(CANCELLED|VOID|REVERSED|DELETED)$/i.test(String(rec.STATUS || ''))) continue;
        const receiptDateKey = bnxNormalizeDateKey_(rec.RECEIPT_DATE);
        if (!receiptDateKey || !receiptDateKey.startsWith(prefix)) continue;
        const day = receiptDateKey.slice(-2);
        if (!byDay[day]) continue;
        const mode = modeText(rec).toUpperCase();
        const amt = n2(rec.AMOUNT);
        if (/DISCOUNT|CN|CREDIT NOTE/.test(mode)) byDay[day].guestDuesCN += amt;
        else if (mode === 'CASH') { byDay[day].dueReceivedCash += amt; byDay[day].totalCashCollection += amt; }
        else byDay[day].dueReceivedIcici += amt;
      }
    } catch (e) {}
    Object.keys(byDay).forEach(function (d) { const x = byDay[d];  Object.keys(x).forEach(function (k) { if (typeof x[k] === 'number') x[k] = Math.round(x[k] * 100) / 100; }); });
    return { success: true, data: { byDay, source: 'TRANSACTION_DB', complete: true, version: 'DSR-ATOMIC-20261026' } };
  } catch (error) {
    bnxLogError(clientId, `bnxGetDsrMatrix failed: ${error.message}`, payload);
    return { success: false, error: error.message };
  }
}

function bnxGetDsrYtd(session, payload) {
  const clientId = session.CLIENT_ID;
  if(payload&&(payload.force===true||payload.refresh===true))return bnxGetDsrYtd_impl_(session,payload);
  const cacheKey = 'dsrytd_' + clientId + '_' + (payload.year || '') + '_' + (payload.asOfDate || '');
  return bnxCachedReport_(cacheKey, 20, () => bnxGetDsrYtd_impl_(session, payload));
}
function bnxGetDsrYtd_impl_(session, payload) {
  const clientId = session.CLIENT_ID;
  const year = Number(payload.year);
  const asOfDate = payload.asOfDate || Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'Asia/Kolkata', 'yyyy-MM-dd');
  const asOfKey = bnxNormalizeDateKey_(asOfDate) || Utilities.formatDate(new Date(), Session.getScriptTimeZone() || 'Asia/Kolkata', 'yyyy-MM-dd');
  const asOfYear = Number(asOfKey.slice(0,4));
  const fyStartYear = Number(asOfKey.slice(5,7)) >= 4 ? asOfYear : asOfYear - 1;
  const from = fyStartYear + '-04-01';
  const to = asOfKey;
  try {
    const totals = { liquor: 0, liquorMrp: 0, food: 0, beverage: 0, hashFreezer: 0, others: 0, grossSale: 0, tax: 0, roundOff: 0, netSale: 0, cash: 0, iciciCard: 0, iciciGpay: 0, guestDueSales: 0, zomato: 0, swiggy: 0, dueReceivedCash: 0, dueReceivedIcici: 0, totalCashCollection: 0, discount: 0, guestDuesCN: 0 };

    const billSheet = bnxClientSheet(clientId, SHEETS.BILL_MASTER);
    const billValues = billSheet.getDataRange().getValues();
    const billHeaders = billValues[0];
    const billIdsInRange = {};
    for (let r = 1; r < billValues.length; r++) {
      const b = bnxRowToObject(billValues[r], billHeaders);
      if (b.CLIENT_ID !== clientId) continue;
      const _billDateKey = bnxNormalizeDateKey_(b.BILL_DATE); if (!_billDateKey || _billDateKey < from || _billDateKey > to) continue;
      totals.grossSale += Number(b.TAXABLE_AMOUNT != null && b.TAXABLE_AMOUNT !== '' ? b.TAXABLE_AMOUNT : b.SUBTOTAL) || 0;
      totals.netSale += (Number(b.TAXABLE_AMOUNT != null && b.TAXABLE_AMOUNT !== '' ? b.TAXABLE_AMOUNT : b.SUBTOTAL) || 0) + (Number(b.TAX_AMOUNT) || 0) + (Number(b.ROUND_OFF) || 0);
      totals.tax += Number(b.TAX_AMOUNT) || 0;
      totals.roundOff += Number(b.ROUND_OFF) || 0;
      
      totals.discount += (Number(b.BILL_DISCOUNT) || 0) + (Number(b.ITEM_DISCOUNT) || 0);
      if (String(b.PAYMENT_STATUS).toUpperCase() !== 'PAID') totals.guestDueSales += bnxBillOutstanding_(b);
      if (b.BILL_ID) billIdsInRange[b.BILL_ID] = true;
    }

    const paySheet = bnxClientSheet(clientId, SHEETS.PAYMENT_MASTER);
    const payValues = paySheet.getDataRange().getValues();
    const payHeaders = payValues[0];
    for (let r = 1; r < payValues.length; r++) {
      const p = bnxRowToObject(payValues[r], payHeaders);
      if (p.CLIENT_ID !== clientId) continue;
      const _payDateKey = bnxNormalizeDateKey_(p.PAYMENT_DATE); if (!_payDateKey || _payDateKey < from || _payDateKey > to) continue;
      const status = String(p.PAYMENT_STATUS || '').toUpperCase();
      if (status === 'REFUNDED' || status === 'REVERSED') continue;
      const mode = bnxNormalizePaymentMode_(p.PAYMENT_MODE);
      const amt = Number(p.AMOUNT) || 0;
      if (mode === 'CASH') { totals.cash += amt; totals.totalCashCollection += amt; }
      else if (mode === 'UPI' || mode === 'GPAY' || mode === 'ICICI GPAY') totals.iciciGpay += amt;
      else if (mode === 'CARD') totals.iciciCard += amt;
      else { /* OTHER remains available without forcing it into card */ }
    }

    try {
      const imSheet = bnxClientSheet(clientId, SHEETS.ITEM_MASTER);
      const imValues = imSheet.getDataRange().getValues();
      const imHeaders = imValues[0];
      const catMap = bnxCachedCategoryNameMap_(clientId);
      const itemFlagsByName = {};
      for (let r = 1; r < imValues.length; r++) {
        const it = bnxRowToObject(imValues[r], imHeaders);
        if (it.CLIENT_ID !== clientId) continue;
        const catName = String(it.ITEM_GROUP_NAME || it.ITEM_GROUP || it.GROUP_NAME || it.CATEGORY_NAME || it.CATEGORY || catMap.byId[it.CATEGORY_ID] || '').toLowerCase();
        itemFlagsByName[String(it.ITEM_NAME || '').toLowerCase()] =
          bnxClassifyDsrItem_(catName, it.ITEM_NAME);
      }
      const biSheet = bnxClientSheet(clientId, SHEETS.BILL_ITEMS);
      const biValues = biSheet.getDataRange().getValues();
      const biHeaders = biValues[0];
      for (let r = 1; r < biValues.length; r++) {
        const it = bnxRowToObject(biValues[r], biHeaders);
        if (!billIdsInRange[it.BILL_ID]) continue;
        const amt = Number(it.LINE_TOTAL) || 0;
        const lineGroup = String(it.ITEM_GROUP_NAME || it.ITEM_GROUP || it.GROUP_NAME || it.CATEGORY_NAME || it.CATEGORY || '').toLowerCase();
        const flags = lineGroup ? bnxClassifyDsrItem_(lineGroup, it.ITEM_NAME) : (itemFlagsByName[String(it.ITEM_NAME || '').toLowerCase()] || bnxClassifyDsrItem_('', it.ITEM_NAME));
        if (flags && flags.isLiquorMrp) totals.liquorMrp += amt;
        else if (flags && flags.isLiquor) totals.liquor += amt;
        else if (flags && flags.isBeverage) totals.beverage += amt;
        else if (flags && flags.isHashFreezer) totals.hashFreezer += amt;
        else if (flags && flags.isOther) totals.others += amt;
        else totals.food += amt;
      }
    } catch (e) {}

    try {
      const drSheet = bnxClientSheet(clientId, SHEETS.DUES_RECEIPT);
      const drValues = drSheet.getDataRange().getValues();
      const drHeaders = drValues[0];
      for (let r = 1; r < drValues.length; r++) {
        const rec = bnxRowToObject(drValues[r], drHeaders);
        if (rec.CLIENT_ID !== clientId) continue;
        const _receiptDateKey = bnxNormalizeDateKey_(rec.RECEIPT_DATE); if (!_receiptDateKey || _receiptDateKey < from || _receiptDateKey > to) continue;
        const mode = String(rec.PAYMENT_MODE || 'OTHER').toUpperCase();
        const amt = Number(rec.AMOUNT) || 0;
        if (mode === 'CASH') totals.dueReceivedCash += amt;
        else totals.dueReceivedIcici += amt;
      }
    } catch (e) {}

    return { success: true, data: totals, from, to };
  } catch (error) {
    bnxLogError(clientId, `bnxGetDsrYtd failed: ${error.message}`, payload);
    return { success: false, error: error.message };
  }
}


function bnxMarkAttendance(session, payload) {
  const clientId = session.CLIENT_ID, sessionUserId = session.USER_ID;
  const type = String(payload.attendanceType || '').toUpperCase();
  if (!['IN','OUT'].includes(type)) return { success:false, error:'attendanceType must be IN or OUT' };
  try {
    const sheet = bnxClientSheet(clientId, SHEETS.ATTENDANCE_MASTER);
    const values = sheet.getDataRange().getValues(); const headers = values[0] || [];
    const tz = Session.getScriptTimeZone() || 'Asia/Kolkata'; const now = new Date();
    const date = bnxBusinessDateKey_(now), time = Utilities.formatDate(now, tz, 'HH:mm:ss');
    // Attendance may be marked by the employee themself OR by an authorised
    // manager/admin for a selected employee.  The old code always preferred
    // sessionUserId, so selecting another employee in an attendance screen
    // still marked the logged-in manager.  Prefer an explicit target employee
    // when supplied; otherwise fall back to the logged-in user.
    const targetUserId = payload.employeeUserId || payload.empUserId || payload.userId || payload.EMP_ID || payload.EMPLOYEE_ID || sessionUserId || '';
    const identity = {
      userId: targetUserId,
      loginId: payload.employeeLoginId || payload.loginId || payload.USER_CODE || '',
      fullName: payload.employeeName || payload.fullName || payload.FULL_NAME || '',
      role: payload.employeeRole || payload.role || payload.ROLE || '',
      locationId: payload.locationId || payload.LOCATION_ID || session.LOCATION_ID || ''
    };
    const pick=(obj,names)=>{for(const n of names){if(obj[n]!==undefined&&obj[n]!==null&&obj[n]!=='')return obj[n];}return '';};
    const same=(row)=>{
      const u=bnxRowToObject(row,headers);
      if (u.CLIENT_ID && u.CLIENT_ID !== clientId) return false;
      return (identity.userId && [u.USER_ID,u.EMP_ID,u.EMPLOYEE_ID].some(v=>String(v||'')===String(identity.userId))) ||
             (identity.loginId && [u.USER_CODE,u.LOGIN_ID, u.USERNAME].some(v=>String(v||'').toLowerCase()===String(identity.loginId).toLowerCase())) ||
             (identity.fullName && [u.FULL_NAME,u.EMP_NAME,u.EMPLOYEE_NAME].some(v=>String(v||'').trim().toLowerCase()===String(identity.fullName).trim().toLowerCase()));
    };
    let target=-1, obj=null;
    for(let r=1;r<values.length;r++){
      const o=bnxRowToObject(values[r],headers);
      if((o.ATTENDANCE_DATE||o.DATE)!==date || !same(values[r])) continue;
      const rowLoc=String(o.LOCATION_ID||'').trim();
      if(identity.locationId && rowLoc && rowLoc!==String(identity.locationId).trim()) continue;
      target=r; obj=o; break;
    }
    const data={CLIENT_ID:clientId, LOCATION_ID:identity.locationId || '', ATTENDANCE_ID:generateShortId_(clientId,'ATTENDANCE_ID'), EMP_ID:identity.userId || payload.empId || '', USER_ID:identity.userId || '', USER_CODE:identity.loginId || '', FULL_NAME:identity.fullName || '', ROLE:identity.role || '', ATTENDANCE_DATE:date, STATUS:type==='IN'?'PRESENT':'PRESENT', MARKED_BY:sessionUserId || '', UPDATED_AT:now.toISOString(), CREATED_AT:now.toISOString()};
    data.IN_TIME = type==='IN' ? time : (obj ? pick(obj,['IN_TIME','CHECK_IN']) : '');
    data.OUT_TIME = type==='OUT' ? time : (obj ? pick(obj,['OUT_TIME','CHECK_OUT']) : '');
    if(target>=0){
      headers.forEach((h,c)=>{if(data[h]!==undefined && data[h]!==null && data[h]!=='' || (h==='OUT_TIME'&&type==='OUT') || (h==='IN_TIME'&&type==='IN')) sheet.getRange(target+1,c+1).setValue(data[h]===undefined?'':data[h]);});
    } else { bnxAppendRow(clientId,SHEETS.ATTENDANCE_MASTER,data); }
    bnxCreateAuditLog(clientId,{CLIENT_ID:clientId,USER_ID:sessionUserId,ACTION:'ATTENDANCE_'+type,MODULE:'ATTENDANCE',RECORD_TYPE:'ATTENDANCE',RECORD_ID:data.ATTENDANCE_ID,NEW_VALUE:JSON.stringify(data),TIMESTAMP:now.toISOString()});
    return {success:true,data:{date,time,type},message:'Attendance '+type+' saved'};
  } catch(e){ bnxLogError(clientId,`bnxMarkAttendance failed: ${e.message}`,payload); return {success:false,error:e.message}; }
}

