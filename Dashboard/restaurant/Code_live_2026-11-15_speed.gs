/* ============================== A. CLAIM LIFECYCLE ======================== */
var _bnxClaimMap_ = {};   // requestId -> clientId (execution scoped)

function bnxReleaseClaim_(clientId, requestId, message) {
  try {
    if (!clientId || !requestId) return;
    const c = bnxSyncLogCacheGet_(clientId, requestId);
    if (c && c.status === 'SYNCED') return;            // never undo a success
    let rowIndex = (c && c.rowIndex != null) ? c.rowIndex : null;
    if (rowIndex != null) {
      const sh = bnxClientSheet(clientId, SHEETS.SYNC_LOG);
      const h = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(String);
      const rc = h.indexOf('REQUEST_ID'), sc = h.indexOf('STATUS'), ec = h.indexOf('ERROR_MESSAGE'), uc = h.indexOf('UPDATED_AT');
      const row = rowIndex + 1;
      if (rc >= 0 && String(sh.getRange(row, rc + 1).getValue()) !== String(requestId)) {
        rowIndex = null;                               // row moved/not ours: cache-only release
      } else {
        if (sc >= 0) sh.getRange(row, sc + 1).setValue('FAILED');
        if (ec >= 0) sh.getRange(row, ec + 1).setValue(String(message || '').slice(0, 500));
        if (uc >= 0) sh.getRange(row, uc + 1).setValue(new Date().toISOString());
      }
    }
    bnxSyncLogCachePut_(clientId, requestId, { status: 'FAILED', rowIndex: rowIndex, lastAttempt: 0 });
  } catch (e) { console.warn('[bnxReleaseClaim_] ' + e.message); }
}

function bnxCheckDuplicate(clientId, requestId) {
  if (!requestId) return null;
  const cached = bnxSyncLogCacheGet_(clientId, requestId);
  if (cached) {
    if (cached.status === 'SYNCED') return { transactionId: cached.transactionId, result: cached.result, rowIndex: cached.rowIndex };
    if (cached.status === 'FAILED') return { stale: true, rowIndex: cached.rowIndex };
    const ageMs = Date.now() - (cached.lastAttempt || 0);
    if (ageMs < BNX_CLAIM_STALE_MS) return { transactionId: cached.transactionId, result: cached.result, rowIndex: cached.rowIndex };
    return { stale: true, rowIndex: cached.rowIndex };
  }
  try {
    const sheet = bnxClientSheet(clientId, SHEETS.SYNC_LOG);
    const lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
    if (lastRow < 2 || lastCol < 1) return null;
    const headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(String);
    const reqCol = headers.indexOf('REQUEST_ID');
    if (reqCol === -1) return null;
    const matches = sheet.getRange(2, reqCol + 1, lastRow - 1, 1).createTextFinder(String(requestId)).matchEntireCell(true).findAll();
    if (!matches.length) return null;
    const rowIndex = matches[matches.length - 1].getRow() - 1;
    const obj = bnxRowToObject(sheet.getRange(rowIndex + 1, 1, 1, lastCol).getValues()[0], headers);
    if (obj.STATUS === 'SYNCED') {
      bnxSyncLogCachePut_(clientId, requestId, { status: 'SYNCED', transactionId: obj.TRANSACTION_ID, result: obj.RESULT, rowIndex: rowIndex });
      return { transactionId: obj.TRANSACTION_ID, result: obj.RESULT, rowIndex: rowIndex };
    }
    if (obj.STATUS === 'FAILED') return { stale: true, rowIndex: rowIndex };
    const lastAttempt = obj.LAST_ATTEMPT_AT ? new Date(obj.LAST_ATTEMPT_AT).getTime() : 0;
    bnxSyncLogCachePut_(clientId, requestId, { status: obj.STATUS || 'IN_PROGRESS', transactionId: obj.TRANSACTION_ID, result: obj.RESULT, rowIndex: rowIndex, lastAttempt: lastAttempt });
    if (Date.now() - lastAttempt < BNX_CLAIM_STALE_MS) return { transactionId: obj.TRANSACTION_ID, result: obj.RESULT, rowIndex: rowIndex };
    return { stale: true, rowIndex: rowIndex };
  } catch (error) {
    console.error('[bnxCheckDuplicate]', error);
    return null;
  }
}

function bnxClaimRequest(clientId, requestId, transactionType) {
  if (!requestId) return { claimed: true, existing: null };
  _bnxClaimMap_[requestId] = clientId;
  let result = null, inFlight = null;
  const lock = bnxTenantLock_(), alreadyHeld26=lock.hasLock();
  try {
    if(!alreadyHeld26)lock.waitLock(10000);
    const existing = bnxCheckDuplicate(clientId, requestId);
    if (existing && !existing.stale) {
      if (existing.transactionId) result = { claimed: false, existing: existing };
      else inFlight = existing;                         // another execution is still working on it
    } else if (existing && existing.stale) {
      if (existing.rowIndex != null) {
        const sheet = bnxClientSheet(clientId, SHEETS.SYNC_LOG);
        const h = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0].map(String);
        const ac = h.indexOf('ATTEMPT_COUNT'), lc = h.indexOf('LAST_ATTEMPT_AT'), sc = h.indexOf('STATUS');
        const row = existing.rowIndex + 1;
        if (ac !== -1) sheet.getRange(row, ac + 1).setValue((parseInt(sheet.getRange(row, ac + 1).getValue(), 10) || 1) + 1);
        if (lc !== -1) sheet.getRange(row, lc + 1).setValue(new Date().toISOString());
        if (sc !== -1) sheet.getRange(row, sc + 1).setValue('IN_PROGRESS');
      }
      bnxSyncLogCachePut_(clientId, requestId, { status: 'IN_PROGRESS', rowIndex: existing.rowIndex, lastAttempt: Date.now() });
      result = { claimed: true, existing: null };
    } else {
      const nowIso = new Date().toISOString();
      const idx = bnxAppendRowIndexed_(clientId, SHEETS.SYNC_LOG, {
        REQUEST_ID: requestId, CLIENT_ID: clientId, TRANSACTION_TYPE: transactionType, TRANSACTION_ID: '',
        STATUS: 'IN_PROGRESS', ATTEMPT_COUNT: 1, FIRST_ATTEMPTED_AT: nowIso, LAST_ATTEMPT_AT: nowIso, CREATED_AT: nowIso
      });
      bnxSyncLogCachePut_(clientId, requestId, { status: 'IN_PROGRESS', rowIndex: idx, lastAttempt: Date.now() });
      result = { claimed: true, existing: null };
    }
  } catch (error) {
    console.error('[bnxClaimRequest]', error);
    return {claimed:false,existing:{transactionId:'',busy:true}};
  } finally {
    try { if(!alreadyHeld26)lock.releaseLock(); } catch (e) {}
  }
  if (result) return result;
  // Return immediately; the durable outbox retries the SAME request ID.

  return { claimed: false, existing: { transactionId: '', inProgress: true } };
}

function respondError(statusCode, message, requestId) {
  try {
    if (requestId && statusCode >= 400 && _bnxClaimMap_[requestId]) bnxReleaseClaim_(_bnxClaimMap_[requestId], requestId, message);
  } catch (e) {}
  return { success: false, error: message, statusCode: statusCode, requestId: requestId };
}

/* H. ERROR_LOG: real columns are ERROR_TYPE/ERROR_MESSAGE/REQUEST_BODY (no CONTEXT) */
function bnxLogError(clientId, message, context) {
  try {
    const rid = (context && typeof context === 'object') ? (context.requestId || context.REQUEST_ID || '') : '';
    if (rid) bnxReleaseClaim_(clientId, String(rid), message);
  } catch (e) {}
  try {
    let ctx = '';
    try { ctx = JSON.stringify(context); } catch (e) { ctx = String(context); }
    const entry = {
      ERROR_LOG_ID: generateShortId_(clientId || 'GLOBAL', 'ERROR_LOG_ID'), CLIENT_ID: clientId, ERROR_TYPE: 'BACKEND',
      ERROR_MESSAGE: String(message || '').slice(0, 1000),
      REQUEST_BODY: String(ctx || '').slice(0, 4000), TIMESTAMP: new Date().toISOString()
    };
    if (clientId) bnxAppendRow(clientId, SHEETS.ERROR_LOG, entry);
    else Logger.log('[bnxLogError, no clientId] ' + message + ' ' + ctx);
  } catch (error) {
    console.error('[bnxLogError]', error, message);
  }
}

/* ============================== C. LEDGER SCHEMA + B. BALANCED POSTING ===== */
function bnxEnsureHeaderCols_(sheet, names) {
  const h=bnxOp28Headers_(sheet).map(function(x){return String(x==null?'':x).trim();});
  let last=0, changed=false; h.forEach(function(x,i){if(x)last=i+1;});
  names.forEach(function(n){if(h.indexOf(n)===-1){last++;sheet.getRange(1,last).setValue(n);while(h.length<last)h.push('');h[last-1]=n;changed=true;}});
  if(changed)bnxOp28ForgetHeaders_(sheet);
  return h;
}

function bnxEnsureLedgerSchema_(clientId) {
  const key = 'ledger_schema_v3_' + clientId;
  try { if (CacheService.getScriptCache().get(key) === '1') return; } catch (e) {}
  bnxEnsureHeaderCols_(bnxClientSheet(clientId, SHEETS.LEDGER_ENTRIES), ['LEDGER_ENTRY_ID','JOURNAL_ID','CLIENT_ID','LOCATION_ID','ACCOUNT','ENTRY_DATE','REFERENCE_TYPE','REFERENCE_ID','LEDGER_ID','DESCRIPTION','DEBIT','CREDIT','CREATED_AT']);
  bnxEnsureHeaderCols_(bnxClientSheet(clientId, SHEETS.JOURNAL), ['JOURNAL_ID','CLIENT_ID','LOCATION_ID','JOURNAL_DATE','JOURNAL_TYPE','SOURCE_TYPE','SOURCE_ID','REFERENCE_NUMBER','DESCRIPTION','TOTAL_DEBIT','TOTAL_CREDIT','CREATED_BY','CREATED_AT','ENTRY_DATE','REFERENCE_TYPE','REFERENCE_ID','NARRATION']);
  try { CacheService.getScriptCache().put(key, '1', 21600); } catch (e) {}
}

function bnxLedgerAccountForMode_(clientId, mode) {
  mode = String(mode || 'CASH').trim().toUpperCase() || 'CASH';
  if (mode === 'CASH') return bnxGetOrCreateLedgerAccount_(clientId, 'CASH', 'Cash', 'ASSET');
  return bnxGetOrCreateLedgerAccount_(clientId, 'CASH_' + mode, mode + ' Collections', 'ASSET');
}

function bnxLedgerLine_(clientId, journalId, locationId, account, date, dr, cr, refType, refId, desc, now) {
  return {
    LEDGER_ENTRY_ID: generateShortId_(clientId, 'LEDGER_ENTRY_ID'), CLIENT_ID: clientId, JOURNAL_ID: journalId,
    LOCATION_ID: locationId || '', LEDGER_ID: account, ACCOUNT: account, ENTRY_DATE: date,
    DEBIT: +Number(dr || 0).toFixed(2), CREDIT: +Number(cr || 0).toFixed(2),
    REFERENCE_TYPE: refType, REFERENCE_ID: refId, DESCRIPTION: desc || '', CREATED_AT: now
  };
}

/* Sale posting. Net method: CR Sales(taxable after discount) + CR GST + CR/DR Round-off
   = DR Cash/Bank/Dues(grand).  Balanced by construction; never throws. */
function bnxPostBillToLedger_(clientId, bill, isPaid, payLines) {
  try {
    bnxEnsureLedgerSchema_(clientId);
    const journalId = generateShortId_(clientId, 'JOURNAL_ID');
    const now = new Date().toISOString();
    const salesAcct = bnxGetOrCreateLedgerAccount_(clientId, 'SALES', 'Sales', 'INCOME');
    const gstAcct = bnxGetOrCreateLedgerAccount_(clientId, 'GST_OUTPUT', 'GST Output', 'LIABILITY');
    const roundAcct = bnxGetOrCreateLedgerAccount_(clientId, 'ROUND_OFF', 'Round Off', 'INCOME');
    const duesAcct = bnxGetOrCreateLedgerAccount_(clientId, 'CUSTOMER_DUES', 'Customer Dues', 'ASSET');
    const grand = +Number(bill.GRAND_TOTAL || 0).toFixed(2);
    if (!(grand > 0)) return true;
    const taxable = +Number(bill.TAXABLE_AMOUNT || 0).toFixed(2);
    const tax = +Number(bill.TAX_AMOUNT || 0).toFixed(2);
    const roundOff = +(grand - taxable - tax).toFixed(2);       // plug => always balanced
    const loc = bill.LOCATION_ID || '', date = bill.BILL_DATE, ref = bill.BILL_ID;
    const desc = 'Sale - Bill ' + bill.BILL_NUMBER;
    const lines = [];
    if (taxable) lines.push(bnxLedgerLine_(clientId, journalId, loc, salesAcct, date, 0, taxable, 'BILL', ref, desc, now));
    if (tax) lines.push(bnxLedgerLine_(clientId, journalId, loc, gstAcct, date, 0, tax, 'BILL', ref, desc, now));
    if (roundOff > 0) lines.push(bnxLedgerLine_(clientId, journalId, loc, roundAcct, date, 0, roundOff, 'BILL', ref, desc, now));
    else if (roundOff < 0) lines.push(bnxLedgerLine_(clientId, journalId, loc, roundAcct, date, Math.abs(roundOff), 0, 'BILL', ref, desc, now));
    if (isPaid && payLines && payLines.length) {
      let rem = grand;
      payLines.forEach(function (pl, i) {
        const amt = (i === payLines.length - 1) ? rem : +Math.min(rem, Number(pl.amount) || 0).toFixed(2);
        rem = +(rem - amt).toFixed(2);
        if (amt > 0) lines.push(bnxLedgerLine_(clientId, journalId, loc, bnxLedgerAccountForMode_(clientId, pl.mode), date, amt, 0, 'BILL', ref, desc, now));
      });
    } else {
      const acct = isPaid ? bnxLedgerAccountForMode_(clientId, 'CASH') : duesAcct;
      lines.push(bnxLedgerLine_(clientId, journalId, loc, acct, date, grand, 0, 'BILL', ref, desc, now));
    }
    const totalDr = +lines.reduce(function (s, l) { return s + l.DEBIT; }, 0).toFixed(2);
    const totalCr = +lines.reduce(function (s, l) { return s + l.CREDIT; }, 0).toFixed(2);
    bnxAppendRow(clientId, SHEETS.JOURNAL, {
      JOURNAL_ID: journalId, CLIENT_ID: clientId, LOCATION_ID: loc, JOURNAL_DATE: date, JOURNAL_TYPE: 'SALES',
      SOURCE_TYPE: 'BILL', SOURCE_ID: ref, REFERENCE_NUMBER: bill.BILL_NUMBER, DESCRIPTION: desc,
      TOTAL_DEBIT: totalDr, TOTAL_CREDIT: totalCr, CREATED_BY: bill.CREATED_BY || '', CREATED_AT: now,
      ENTRY_DATE: date, REFERENCE_TYPE: 'BILL', REFERENCE_ID: ref, NARRATION: desc
    });
    bnxAppendRowsBatch_(clientId, SHEETS.LEDGER_ENTRIES, lines);
    return true;
  } catch (e) {
    // The bill itself is already safely stored. Never fail the sale because of the ledger.
    bnxLogError(clientId, 'LEDGER_PENDING bill ' + (bill && bill.BILL_NUMBER) + ': ' + e.message, { billId: bill && bill.BILL_ID });
    return false;
  }
}

function bnxPostPaymentToLedger_(clientId, payment, bill) {
  try {
    bnxEnsureLedgerSchema_(clientId);
    const amount = +Number(payment.AMOUNT || 0).toFixed(2);
    if (!(amount > 0)) return;
    const journalId = generateShortId_(clientId, 'JOURNAL_ID');
    const now = new Date().toISOString();
    const loc = payment.LOCATION_ID || bill.LOCATION_ID || '';
    const modeAcct = bnxLedgerAccountForMode_(clientId, payment.PAYMENT_MODE);
    const duesAcct = bnxGetOrCreateLedgerAccount_(clientId, 'CUSTOMER_DUES', 'Customer Dues', 'ASSET');
    const desc = String(payment.PAYMENT_MODE || 'CASH') + ' receipt - Bill ' + (bill.BILL_NUMBER || bill.BILL_ID);
    bnxAppendRow(clientId, SHEETS.JOURNAL, {
      JOURNAL_ID: journalId, CLIENT_ID: clientId, LOCATION_ID: loc, JOURNAL_DATE: payment.PAYMENT_DATE, JOURNAL_TYPE: 'RECEIPT',
      SOURCE_TYPE: 'PAYMENT', SOURCE_ID: payment.PAYMENT_ID, REFERENCE_NUMBER: bill.BILL_NUMBER || bill.BILL_ID, DESCRIPTION: desc,
      TOTAL_DEBIT: amount, TOTAL_CREDIT: amount, CREATED_BY: payment.CREATED_BY || '', CREATED_AT: now,
      ENTRY_DATE: payment.PAYMENT_DATE, REFERENCE_TYPE: 'PAYMENT', REFERENCE_ID: payment.PAYMENT_ID, NARRATION: desc
    });
    bnxAppendRowsBatch_(clientId, SHEETS.LEDGER_ENTRIES, [
      bnxLedgerLine_(clientId, journalId, loc, modeAcct, payment.PAYMENT_DATE, amount, 0, 'PAYMENT', payment.PAYMENT_ID, desc, now),
      bnxLedgerLine_(clientId, journalId, loc, duesAcct, payment.PAYMENT_DATE, 0, amount, 'PAYMENT', payment.PAYMENT_ID, desc, now)
    ]);
    return journalId;
  } catch (e) {
    bnxLogError(clientId, 'LEDGER_PENDING payment ' + (payment && payment.PAYMENT_ID) + ': ' + e.message, {});
  }
}

function bnxReverseBillLedger_(clientId, bill, userId, nowIso, reason) {
  const billId = bill.BILL_ID;
  if (!billId) return;
  bnxEnsureLedgerSchema_(clientId);
  const jSheet = bnxClientSheet(clientId, SHEETS.JOURNAL);
  const jv = jSheet.getDataRange().getValues(), jh = jv[0] || [];
  let original = null, alreadyReversed = false;
  for (let r = 1; r < jv.length; r++) {
    const j = bnxRowToObject(jv[r], jh);
    if (String(j.CLIENT_ID || '') !== String(clientId)) continue;
    if (String(j.SOURCE_ID || '') !== String(billId)) continue;
    if (String(j.SOURCE_TYPE || '') === 'BILL_VOID') alreadyReversed = true;
    else if (String(j.SOURCE_TYPE || '') === 'BILL' && !original) original = j;
  }
  if (!original || alreadyReversed) return;
  const eSheet = bnxClientSheet(clientId, SHEETS.LEDGER_ENTRIES);
  const ev = eSheet.getDataRange().getValues(), eh = ev[0] || [];
  const orig = [];
  for (let r = 1; r < ev.length; r++) {
    const e = bnxRowToObject(ev[r], eh);
    if (String(e.JOURNAL_ID || '') === String(original.JOURNAL_ID || '')) orig.push(e);
  }
  if (!orig.length) return;
  const jid = generateShortId_(clientId, 'JOURNAL_ID');
  const date = bnxBusinessDateKey_(new Date());
  const totalDr = +orig.reduce(function (s, l) { return s + (Number(l.CREDIT) || 0); }, 0).toFixed(2);
  const totalCr = +orig.reduce(function (s, l) { return s + (Number(l.DEBIT) || 0); }, 0).toFixed(2);
  const desc = 'Void reversal - Bill ' + bill.BILL_NUMBER + (reason ? ' (' + reason + ')' : '');
  bnxAppendRow(clientId, SHEETS.JOURNAL, {
    JOURNAL_ID: jid, CLIENT_ID: clientId, LOCATION_ID: bill.LOCATION_ID || '', JOURNAL_DATE: date, JOURNAL_TYPE: 'SALES_VOID',
    SOURCE_TYPE: 'BILL_VOID', SOURCE_ID: billId, REFERENCE_NUMBER: bill.BILL_NUMBER, DESCRIPTION: desc,
    TOTAL_DEBIT: totalDr, TOTAL_CREDIT: totalCr, CREATED_BY: userId, CREATED_AT: nowIso,
    ENTRY_DATE: date, REFERENCE_TYPE: 'BILL_VOID', REFERENCE_ID: billId, NARRATION: desc
  });
  bnxAppendRowsBatch_(clientId, SHEETS.LEDGER_ENTRIES, orig.map(function (l) {
    return bnxLedgerLine_(clientId, jid, bill.LOCATION_ID || '', l.ACCOUNT || l.LEDGER_ID || '', date,
      Number(l.CREDIT) || 0, Number(l.DEBIT) || 0, 'BILL_VOID', billId, desc, nowIso);
  }));
}

/* ============================== D. SAVE_BILL (split payments, safe claim) == */
function bnxNormalizePayLines_(bill, total, isPaid) {
  if (!isPaid || !(total > 0)) return [];
  const mode0 = String(bill.pay || 'CASH').trim().toUpperCase() || 'CASH';
  const lines = [];
  (Array.isArray(bill.payments) ? bill.payments : []).forEach(function (x) {
    if (!x) return;
    const amt = +Number(x.amount != null ? x.amount : x.AMOUNT).toFixed(2);
    if (!(amt > 0)) return;
    lines.push({ mode: String(x.mode || x.MODE || x.PAYMENT_MODE || 'CASH').trim().toUpperCase() || 'CASH',
      amount: amt, reference: String(x.reference || x.ref || x.REFERENCE || '') });
  });
  if (mode0 === 'SPLIT') {
    const splitSum = Math.round(lines.reduce(function(s,l){return s + l.amount;}, 0) * 100);
    if (lines.length < 2 || splitSum !== Math.round(Number(total) * 100)) throw new Error('Split payment needs at least two payment lines matching the invoice total; no bill was saved.');
    return lines;
  }
  if (lines.length) {
    const sum = +lines.reduce(function (s, l) { return s + l.amount; }, 0).toFixed(2);
    const diff = +(total - sum).toFixed(2);
    if (Math.abs(diff) <= 1) {
      const last = lines[lines.length - 1];
      last.amount = +(last.amount + diff).toFixed(2);
      if (!(last.amount > 0)) lines.pop();
      if (lines.length) return lines;
    }
  }
  if (mode0 === 'SPLIT') throw new Error('Split payment lines must match the invoice total; no bill was saved.');
  return [{ mode: mode0, amount: total, reference: lines.length ? 'SPLIT-TOTAL-MISMATCH' : '' }];
}

function bnxSaveBill(session, payload) {
  const requestId = payload.requestId;
  const bill = payload.bill || {};
  const clientId = session.CLIENT_ID;
  const userId = session.USER_ID;
  // validate BEFORE claiming so a bad payload can never poison the request id
  const validation = bnxValidateBill(bill);
  if (!validation.valid) return respondError(400, validation.errors.join('; '), requestId);
  const claim = bnxClaimRequest(clientId, requestId, TRANSACTION_TYPES.BILL);
  if (!claim.claimed) {
    const existingId = claim.existing && claim.existing.transactionId;
    if (!existingId) return respondError(409, 'Same bill is still being saved - retry in a few seconds', '');
    const existingBill = bnxFindBillById_(clientId, existingId);
    return { success: true, transactionId: existingId, data: existingBill || undefined, message: 'Duplicate request detected - existing bill reused', cached: true };
  }
  try {
    const billId = generateShortId_(clientId, 'BILL_ID');
    const locationId = bnxCapture26Location_(session,payload,bill);
    if (!bill.orderId && bill.orderNo) bill.orderId = bnxResolveOrderIdByRef_(clientId, bill.orderNo, locationId);
    if (!bill.orderId && bill.ORDER_ID) bill.orderId = String(bill.ORDER_ID);
    const allowSplitBill = payload.allowSplitBill === true || bill.allowSplitBill === true || payload.SPLIT_BILL === true;
    if (!allowSplitBill && bill.orderId) {
      const existingOrderBill = bnxFindFinalizedBillByOrder_(clientId, bill.orderId, locationId);
      if (existingOrderBill) {
        try { bnxMarkSynced(clientId, requestId, existingOrderBill.BILL_ID, TRANSACTION_TYPES.BILL); } catch (e) {}
        return { success: true, transactionId: existingOrderBill.BILL_ID, data: existingOrderBill, cached: true, duplicateOrder: true,
          message: 'Order is already billed - existing confirmed invoice reused.' };
      }
    }
    // Distinct authenticated billing actor and order-placement actor; no historical rewrite.
    const billingUserName=String(session.FULL_NAME||session.USER_NAME||session.NAME||session.USERNAME||userId);
    let orderStewards=[];
    const sourceIds=Array.isArray(bill.tableSource&&bill.tableSource.orderIds)?bill.tableSource.orderIds:(bill.orderId?[bill.orderId]:[]);
    if(sourceIds.length){
      const rr=bnxOp38Exact_(bnxClientSheet(clientId,SHEETS.ORDER_MASTER),'ORDER_ID',sourceIds,false);
      rr.rows.forEach(function(row){const o=bnxRowToObject(row,rr.headers);if(String(o.CLIENT_ID)!==String(clientId)||(locationId&&String(o.LOCATION_ID||'')!==locationId))return;
        const who=String(o.CREATED_BY_NAME||o.STEWARD_NAME||o.STARTED_BY||o.CREATED_BY||'').trim();if(who&&orderStewards.indexOf(who)<0)orderStewards.push(who);
      });
    }
    const stewardName=orderStewards.join(' + ')||String(bill.waiter||'');
    const requestedBillDate = bill.billDate || bill.dt || bill.date || '';
    const requestedBillTime = bill.billTime || bill.tm || bill.time || '';
    const clientDt = bnxResolveClientDateTime_(requestedBillDate, requestedBillTime);
    const wallClockNow = bnxNowParts_();
    const now = clientDt || { date: bnxBusinessDateKey_(new Date()), businessDate: bnxBusinessDateKey_(new Date()), time: wallClockNow.time };
    const subtotal = Number(bill.sub) || 0;
    const totalTax = Number(bill.gst) || 0;
    const total = bill.total!=null ? Number(bill.total) : (subtotal + totalTax);
    const billDiscount = Math.max(0, Number(bill.disc) || 0);
    const taxableAfterDiscount = Math.max(0, +(subtotal - billDiscount).toFixed(2));
    const isPaid = !/^pending$/i.test(bill.status || '');
    let customerId = '';
    if (!isPaid && (bill.customer || bill.mob)) customerId = bnxResolveCustomerId_(clientId, bill.customer, bill.mob);
    const salesChannel = bnxNormalizeSalesChannel_(
      bill.salesChannel || bill.orderSource || bill.billType || bill.orderType || bill.ORDER_TYPE || 'DINEIN', bill.billType, bill.orderType);
    const serviceCharge = bnxResolveServiceCharge_(bill);
    const tax = Math.max(0,+(totalTax-serviceCharge.gst).toFixed(2));
    const aggregatorOrderId = String(bill.aggregatorOrderId || bill.platformOrderId || bill.externalOrderId || '').trim();
    const payLines = bnxNormalizePayLines_(bill, total, isPaid);
    const billMaster = {
      BILL_ID: billId, CLIENT_ID: clientId, LOCATION_ID: locationId, ORDER_ID: bill.orderId || '',
      COUNTER_CODE: bnxNormalizeCounterCode_(bill.counterCode || payload.counterCode || 'C1'),
      BILL_NUMBER: bnxGenerateChannelInvoiceNumber_(clientId, locationId,
        bill.salesChannel || bill.orderSource || bill.billType || bill.orderType || bill.ORDER_TYPE || 'DINEIN'),
      BILL_DATE: now.businessDate, BILL_TIME: now.time,
      TABLE_ID: bill.table || '', CUSTOMER_ID: customerId, CUSTOMER_NAME: bill.customer || 'Walk-in',
      BILL_TYPE: String(bill.billType || bill.BILL_TYPE || bill.orderType || bill.ORDER_TYPE || (bill.table ? 'DINEIN' : 'TAKEAWAY')).toUpperCase(),
      SALES_CHANNEL: salesChannel, ORDER_SOURCE: salesChannel,
      AGGREGATOR: (salesChannel === 'ZOMATO' || salesChannel === 'SWIGGY') ? salesChannel : '',
      AGGREGATOR_ORDER_ID: aggregatorOrderId,
      SERVICE_CHARGE_PCT: serviceCharge.pct, SERVICE_CHARGE_AMOUNT: serviceCharge.amount,
      SERVICE_CHARGE_GST_APPLICABLE: serviceCharge.gstApplicable ? 'YES' : 'NO',
      SERVICE_CHARGE_GST_PCT: serviceCharge.gstPct, SERVICE_CHARGE_GST_AMOUNT: serviceCharge.gst,
      COVERS: Number(bill.covers || bill.COVERS || bill.pax || bill.PAX || 1) || 1, SUBTOTAL: subtotal, ITEM_DISCOUNT: 0,
      SUBTOTAL_AFTER_ITEM_DISCOUNT: taxableAfterDiscount, BILL_DISCOUNT: billDiscount, TAXABLE_AMOUNT: taxableAfterDiscount,
      TAX_RATE: taxableAfterDiscount > 0 ? +(tax / taxableAfterDiscount).toFixed(4) : 0, TAX_AMOUNT: tax,
      ROUND_OFF: +(total - (taxableAfterDiscount + serviceCharge.amount + tax + serviceCharge.gst)).toFixed(2), GRAND_TOTAL: total,
      DUE_AMOUNT: isPaid ? 0 : total, BILL_STATUS: 'FINALIZED', PAYMENT_STATUS: isPaid ? 'PAID' : 'DUE',
      GST_BREAKUP: JSON.stringify((bill.gstBreakup && typeof bill.gstBreakup === 'object') ? bill.gstBreakup :
        Object.assign(bnxEditGstBreakup_(bill, Number(totalTax) || 0, { amount: serviceCharge.amount, gst: serviceCharge.gst }),   /* 2026-10-29: per-rate CGST@x% / SGST@x% from the bill's tax rows */
          { SGST: Number(bill.sgst ?? (totalTax / 2)) || 0, CGST: Number(bill.cgst ?? (totalTax / 2)) || 0, IGST: Number(bill.igst ?? 0) || 0 })),
      NOTES: bill.mob ? ('Customer mobile: ' + bill.mob) : '', CREATED_BY: userId, BILLING_USER_ID:userId, BILLING_USER_NAME:billingUserName, STEWARD_NAME:stewardName, ORDER_PLACED_BY:orderStewards.join(' + '),
      CREATED_AT: wallClockNow.iso, FINALIZED_BY: userId, FINALIZED_AT: wallClockNow.iso,
      NC_REASON: bill.ncReason || '', NC_APPROVED_BY: bill.ncApprovedBy || ''
    };
    const actorSheet=bnxClientSheet(clientId,SHEETS.BILL_MASTER),actorHeaders=bnxOp28Headers_(actorSheet),actorFields=['BILLING_USER_ID','BILLING_USER_NAME','STEWARD_NAME','ORDER_PLACED_BY'];
    if(actorFields.some(function(k){return actorHeaders.indexOf(k)<0;})){bnxEnsureHeaderCols_(actorSheet,actorFields);bnxOp28ForgetHeaders_(actorSheet);}
    bnxAppendRow(clientId, SHEETS.BILL_MASTER, billMaster);
    const itemNameMap_ = bnxCachedItemNameMap_(clientId);
    const itemCostMap_ = bnxCachedItemCostMap_(clientId);
    const billItemRows = [], stockMovementRows = [];
    (bill.itemsDetail || []).forEach(function (item, idx) {
      const qty = item.qty || 0, rate = item.rate || 0;
      const lineTotal = item.amt != null ? item.amt : qty * rate;
      const resolvedItemId = String(item.ITEM_ID || item.itemId || '').trim() || itemNameMap_[String(item.name || '').toLowerCase().trim()] || '';
      const lineTaxRate = (item.taxRate != null && item.taxRate !== '') ? Number(item.taxRate) : billMaster.TAX_RATE;
      billItemRows.push({
        BILL_ITEM_ID: generateShortId_(clientId, 'BILL_ITEM_ID'), BILL_ID: billId, ORDER_ITEM_ID: '', ITEM_ID: resolvedItemId,
        SEQUENCE: idx + 1, ITEM_NAME: item.name || '', QUANTITY: qty, UNIT_ID: 'PIECE', RATE: rate,
        LINE_DISCOUNT: Number(item.discount || item.LINE_DISCOUNT || 0) || 0,
        DISCOUNTED_RATE: Number(item.discountedRate || item.DISCOUNTED_RATE || rate) || rate, TAXABLE_PER_ITEM: lineTotal,
        TAX_RATE: lineTaxRate, TAX_PER_ITEM: +(lineTotal * lineTaxRate).toFixed(2), LINE_TOTAL: lineTotal, CREATED_AT: wallClockNow.iso
      });
      stockMovementRows.push({
        STOCK_MOVEMENT_ID: generateShortId_(clientId, 'STOCK_MOVEMENT_ID'), CLIENT_ID: clientId, LOCATION_ID: locationId, ITEM_ID: resolvedItemId,
        MOVEMENT_TYPE: 'SALE', MOVEMENT_DATE: now.businessDate, QUANTITY_IN: 0, QUANTITY_OUT: qty,
        RATE: resolvedItemId ? Number(itemCostMap_[resolvedItemId] || 0) : 0, SOURCE_TYPE: 'BILL', SOURCE_ID: billId,
        CREATED_BY: bill.waiter || userId, CREATED_AT: wallClockNow.iso
      });
    });
    bnxAppendRowsBatch_(clientId, SHEETS.BILL_ITEMS, billItemRows);
    if (payLines.length) {
      const tips = Number(bill.tips) || 0;
      const payRows = payLines.map(function (pl, i) {
        return {
          PAYMENT_ID: generateShortId_(clientId, 'PAYMENT_ID'), CLIENT_ID: clientId, LOCATION_ID: locationId, BILL_ID: billId,
          CUSTOMER_ID: customerId, PAYMENT_MODE_ID: bnxCapture26ModeId_(clientId,pl.mode), PAYMENT_MODE: pl.mode, AMOUNT: pl.amount, PAYMENT_DATE: now.businessDate,
          PAYMENT_TIME: now.time, REFERENCE: pl.reference || '', PAYMENT_STATUS: 'SUCCESS', CREATED_BY: bill.waiter || userId,
          CREATED_AT: wallClockNow.iso, TIPS_AMOUNT: i === 0 ? tips : 0
        };
      });
      bnxAppendRowsBatch_(clientId, SHEETS.PAYMENT_MASTER, payRows);
    }
    if (!isPaid && customerId && total > 0) bnxUpsertCustomerDue_(clientId, customerId, total, now.businessDate, 'BILL');
    bnxAppendRowsBatch_(clientId, SHEETS.STOCK_MOVEMENT, stockMovementRows);
    bnxCreateAuditLog(clientId, {
      CLIENT_ID: clientId, LOCATION_ID: locationId, USER_ID: userId, ACTION: 'CREATE', MODULE: 'POS',
      RECORD_TYPE: 'BILL', RECORD_ID: billId, OLD_VALUE: '{}', NEW_VALUE: JSON.stringify(billMaster),
      REQUEST_ID: requestId, TIMESTAMP: wallClockNow.iso
    });
    const ledgerOk = bnxPostBillToLedger_(clientId, billMaster, isPaid, payLines);   // never throws
    bnxMarkSynced(clientId, requestId, billId, TRANSACTION_TYPES.BILL);
    try { bnxInvalidateTodayReportCaches_(clientId); } catch (e) {}
    return { success: true, transactionId: billId, data: billMaster, ledgerPosted: ledgerOk, paymentLines: payLines.length };
  } catch (error) {
    bnxLogError(clientId, 'bnxSaveBill failed: ' + error.message, { requestId: requestId, bill: bill });
    return respondError(500, error.message, requestId);
  }
}

/* ============================== E. VOID / CHANGE TABLE / DELETE (global) === */
function bnxFindBillRowByNumber_(clientId, billNumber) {
  const sheet = bnxClientSheet(clientId, SHEETS.BILL_MASTER);
  const lastCol = sheet.getLastColumn(), lastRow = sheet.getLastRow();
  if (lastRow < 2 || lastCol < 1) return null;
  const headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(String);
  const noCol = headers.indexOf('BILL_NUMBER'), ciCol = headers.indexOf('CLIENT_ID');
  if (noCol === -1) return null;
  const matches = sheet.getRange(2, noCol + 1, lastRow - 1, 1).createTextFinder(String(billNumber).trim()).matchEntireCell(true).findAll();
  for (let i = matches.length - 1; i >= 0; i--) {
    const rowNo = matches[i].getRow();
    const vals = sheet.getRange(rowNo, 1, 1, lastCol).getValues()[0];
    if (ciCol !== -1 && String(vals[ciCol]) !== String(clientId)) continue;
    return { sheet: sheet, headers: headers, rowNo: rowNo, values: vals };
  }
  return null;
}

/* idempotent: a repeated void never restores stock twice */
function bnxReverseBillStock_(clientId, bill, userId, nowIso) {
  const sh = bnxClientSheet(clientId, SHEETS.STOCK_MOVEMENT), vals = sh.getDataRange().getValues(), h = vals[0] || [];
  const src = h.indexOf('SOURCE_ID'), type = h.indexOf('MOVEMENT_TYPE'), ci = h.indexOf('CLIENT_ID');
  if (src === -1) return { count: 0 };
  const sales = [];
  for (let r = 1; r < vals.length; r++) {
    if (ci !== -1 && String(vals[r][ci]) !== String(clientId)) continue;
    if (String(vals[r][src]) !== String(bill.BILL_ID)) continue;
    const t = type !== -1 ? String(vals[r][type]).toUpperCase() : '';
    if (t === 'VOID_SALE') return { count: 0, alreadyReversed: true };
    if (t === 'SALE') sales.push(bnxRowToObject(vals[r], h));
  }
  const rows = sales.map(function (o) {
    return {
      STOCK_MOVEMENT_ID: generateShortId_(clientId, 'STOCK_MOVEMENT_ID'), CLIENT_ID: clientId, LOCATION_ID: o.LOCATION_ID || bill.LOCATION_ID || '',
      ITEM_ID: o.ITEM_ID || '', MOVEMENT_TYPE: 'VOID_SALE', MOVEMENT_DATE: bill.BILL_DATE || bnxNowParts_().businessDate,
      QUANTITY_IN: Number(o.QUANTITY_OUT) || 0, QUANTITY_OUT: 0, RATE: Number(o.RATE) || 0, SOURCE_TYPE: 'BILL_VOID',
      SOURCE_ID: bill.BILL_ID, CREATED_BY: userId, CREATED_AT: nowIso
    };
  });
  if (rows.length) bnxAppendRowsBatch_(clientId, SHEETS.STOCK_MOVEMENT, rows);
  return { count: rows.length };
}

function bnxVoidBill(session, payload) {
  const clientId = session.CLIENT_ID, userId = session.USER_ID;
  payload = payload || {};
  const role = String(session && session.ROLE || '').trim().toUpperCase();
  const adminDelete = payload.adminDelete === true || String(payload.adminDelete || '').toUpperCase() === 'TRUE' || String(payload.actionMode || '').toUpperCase() === 'DELETE';
  if (adminDelete && ['ADMIN', 'SUPER_ADMIN', 'DEVELOPER'].indexOf(role) === -1)
    return { success: false, error: 'ADMIN_AUTH_REQUIRED', message: 'Only ADMIN, SUPER_ADMIN or DEVELOPER can delete an invoice.' };
  const billNumber = String(payload.billNumber || payload.BILL_NUMBER || '').trim();
  const reason = String(payload.reason || '').trim();
  if (!billNumber) return { success: false, error: 'billNumber is required' };
  const lock = bnxTenantLock_();
  try {
    lock.waitLock(10000);
    const found = bnxFindBillRowByNumber_(clientId, billNumber);
    if (!found) return { success: false, error: 'Bill not found for this client (billNumber: ' + billNumber + ')' };
    const sheet = found.sheet, headers = found.headers, rowNo = found.rowNo;
    const bill = bnxRowToObject(found.values, headers);
    const st = String(bill.BILL_STATUS || '').toUpperCase();
    if (st === 'CANCELLED' || st === 'VOID') return { success: true, billNumber: billNumber, alreadyVoided: true };
    const nowIso = new Date().toISOString();
    // Order matters: every step below is idempotent, and the bill is flagged
    // CANCELLED only after all reversals succeeded, so a failed void can be
    // retried safely and never leaves a cancelled bill with live money/stock.
    const paymentRev = bnxReverseBillPayments_(clientId, bill, userId, nowIso, reason);
    const stockRev = bnxReverseBillStock_(clientId, bill, userId, nowIso);
    bnxReverseBillLedger_(clientId, bill, userId, nowIso, reason);
    const outstanding = Math.max(0, Number(bill.DUE_AMOUNT) || 0);
    if (outstanding > 0 && bill.CUSTOMER_ID) bnxAdjustCustomerDue_(clientId, bill.CUSTOMER_ID, -outstanding, bill.BILL_DATE || bnxNowParts_().businessDate, 'VOID_BILL');
    const set = function (names, val) { names.forEach(function (n) { const c = headers.indexOf(n); if (c !== -1) sheet.getRange(rowNo, c + 1).setValue(val); }); };
    set(['BILL_STATUS'], 'CANCELLED');
    set(['VOID_REASON', 'CANCELLED_REASON'], reason);
    set(['VOIDED_BY', 'CANCELLED_BY'], userId);
    set(['VOIDED_AT', 'CANCELLED_AT'], nowIso);
    set(['DUE_AMOUNT'], 0);
    set(['PAYMENT_STATUS'], 'VOID');
    bnxCreateAuditLog(clientId, {
      CLIENT_ID: clientId, LOCATION_ID: bill.LOCATION_ID || '', USER_ID: userId, ACTION: adminDelete ? 'DELETE_INVOICE' : 'VOID', MODULE: 'BILLING',
      RECORD_TYPE: 'BILL', RECORD_ID: bill.BILL_ID || billNumber,
      OLD_VALUE: JSON.stringify({ BILL_STATUS: bill.BILL_STATUS, PAYMENT_STATUS: bill.PAYMENT_STATUS, GRAND_TOTAL: bill.GRAND_TOTAL }),
      NEW_VALUE: JSON.stringify({ BILL_STATUS: 'CANCELLED', PAYMENT_STATUS: 'VOID', reversedPayments: paymentRev.count, reversedPaymentAmount: paymentRev.total, stockLines: stockRev.count, reason: reason }),
      REASON: reason, TIMESTAMP: nowIso
    });
    try { bnxInvalidateTodayReportCaches_(clientId); } catch (e) {}
    return { success: true, billNumber: billNumber, billId: bill.BILL_ID || '',
      reversedPayments: paymentRev.count, reversedPaymentAmount: paymentRev.total,
      paymentsReversed: paymentRev.count, stockRestored: stockRev.count, dueReversed: outstanding };
  } catch (error) {
    bnxLogError(clientId, 'bnxVoidBill failed: ' + error.message, payload);
    return { success: false, error: error.message };
  } finally { try { lock.releaseLock(); } catch (e) {} }
}

function bnxBillEditRole_(session) {
  return ['ADMIN', 'SUPER_ADMIN', 'DEVELOPER', 'OWNER', 'MANAGER'].indexOf(String(session && session.ROLE || '').trim().toUpperCase()) !== -1;
}

function bnxResolveTableMaster_(clientId, tableRef) {
  const ref = String(tableRef == null ? '' : tableRef).trim();
  if (!ref) return null;
  const sh = bnxClientSheet(clientId, SHEETS.TABLE_MASTER);
  const vals = sh.getDataRange().getValues();
  if (!vals.length) return null;
  const h = vals[0].map(function (v) { return String(v == null ? '' : v).trim(); });
  const idCol = h.indexOf('TABLE_ID'), noCol = h.indexOf('TABLE_NUMBER'), ciCol = h.indexOf('CLIENT_ID'), actCol = h.indexOf('IS_ACTIVE');
  for (let r = 1; r < vals.length; r++) {
    if (ciCol >= 0 && String(vals[r][ciCol] == null ? '' : vals[r][ciCol]).trim() !== String(clientId).trim()) continue;
    const id = idCol >= 0 ? String(vals[r][idCol] == null ? '' : vals[r][idCol]).trim() : '';
    const no = noCol >= 0 ? String(vals[r][noCol] == null ? '' : vals[r][noCol]).trim() : '';
    if (ref !== id && ref.toUpperCase() !== no.toUpperCase()) continue;
    if (actCol >= 0 && ['FALSE', 'NO', '0', 'INACTIVE'].indexOf(String(vals[r][actCol] == null ? '' : vals[r][actCol]).trim().toUpperCase()) !== -1) return null;
    return { id: id || ref, number: no || ref, row: r + 1 };
  }
  return null;
}

function bnxUpdateSingleFieldIfPresent_(sheet, headers, rowNo, field, value) {
  const col = headers.indexOf(field);
  if (col >= 0) sheet.getRange(rowNo, col + 1).setValue(value);
}

function bnxChangeBillTable_(session, payload) {
  payload = payload || {};
  const clientId = String(session && session.CLIENT_ID || '').trim();
  const userId = String(session && session.USER_ID || '').trim();
  if (!clientId) return { success: false, error: 'Authenticated CLIENT_ID required' };
  if (!bnxBillEditRole_(session)) return { success: false, error: 'TABLE_CHANGE_AUTH_REQUIRED', message: 'Only ADMIN, OWNER, MANAGER, SUPER_ADMIN or DEVELOPER can change an issued invoice table.' };
  const billNumber = String(payload.billNumber || payload.BILL_NUMBER || payload.invoiceNo || payload.invoiceNumber || '').trim();
  const requested = String(payload.newTableNo || payload.newTable || payload.tableNo || payload.TABLE_NO || payload.tableId || payload.TABLE_ID || '').trim();
  const reason = String(payload.reason || payload.REASON || 'Table changed after billing').trim();
  if (!billNumber) return { success: false, error: 'billNumber is required' };
  if (!requested) return { success: false, error: 'newTableNo is required' };
  const lock = bnxTenantLock_();
  try {
    lock.waitLock(10000);
    const billSheet = bnxClientSheet(clientId, SHEETS.BILL_MASTER);
    bnxEnsureHeaderCols_(billSheet, ['UPDATED_AT', 'TABLE_CHANGED_BY', 'TABLE_CHANGED_AT', 'TABLE_CHANGE_REASON']);
    const found = bnxFindBillRowByNumber_(clientId, billNumber);
    if (!found) return { success: false, error: 'Bill not found for this client: ' + billNumber };
    const bill = bnxRowToObject(found.values, found.headers);
    const status = String(bill.BILL_STATUS || '').trim().toUpperCase();
    if (status === 'CANCELLED' || status === 'VOID') return { success: false, error: 'Cannot change table of a cancelled/void invoice.' };
    const target = bnxResolveTableMaster_(clientId, requested);
    if (!target) return { success: false, error: 'Target table not found or inactive: ' + requested };
    const oldVal = String(bill.TABLE_ID || '').trim();
    if (oldVal && (oldVal === String(target.id) || oldVal.toUpperCase() === String(target.number).toUpperCase()))
      return { success: true, changed: false, billNumber: billNumber, tableId: target.id, tableNo: target.number, message: 'Invoice is already on this table.' };
    // keep each record in the SAME form it already uses (table id vs table number)
    const memo = {};
    const formFor = function (old) {
      old = String(old == null ? '' : old).trim();
      if (memo[old] !== undefined) return memo[old];
      let v = String(target.number);
      if (old) { const m = bnxResolveTableMaster_(clientId, old); if (m && old === String(m.id) && String(m.id) !== String(m.number)) v = String(target.id); }
      return (memo[old] = v);
    };
    const nowIso = new Date().toISOString();
    const fresh = bnxFindBillRowByNumber_(clientId, billNumber);   // headers now include new audit cols
    const newBillVal = formFor(oldVal);
    bnxUpdateSingleFieldIfPresent_(fresh.sheet, fresh.headers, fresh.rowNo, 'TABLE_ID', newBillVal);
    bnxUpdateSingleFieldIfPresent_(fresh.sheet, fresh.headers, fresh.rowNo, 'UPDATED_AT', nowIso);
    bnxUpdateSingleFieldIfPresent_(fresh.sheet, fresh.headers, fresh.rowNo, 'TABLE_CHANGED_BY', userId);
    bnxUpdateSingleFieldIfPresent_(fresh.sheet, fresh.headers, fresh.rowNo, 'TABLE_CHANGED_AT', nowIso);
    bnxUpdateSingleFieldIfPresent_(fresh.sheet, fresh.headers, fresh.rowNo, 'TABLE_CHANGE_REASON', reason);

    let orderUpdated = false, kotUpdated = 0;
    const orderId = String(bill.ORDER_ID || '').trim();
    if (orderId) {
      try {
        const os = bnxClientSheet(clientId, SHEETS.ORDER_MASTER), ov = os.getDataRange().getValues();
        const oh = ov[0].map(function (v) { return String(v == null ? '' : v).trim(); });
        const idc = oh.indexOf('ORDER_ID'), cic = oh.indexOf('CLIENT_ID'), tc = oh.indexOf('TABLE_ID');
        for (let r = 1; r < ov.length; r++) {
          if (cic >= 0 && String(ov[r][cic] == null ? '' : ov[r][cic]).trim() !== clientId) continue;
          if (idc >= 0 && String(ov[r][idc] == null ? '' : ov[r][idc]).trim() === orderId) {
            bnxUpdateSingleFieldIfPresent_(os, oh, r + 1, 'TABLE_ID', formFor(tc >= 0 ? ov[r][tc] : ''));
            bnxUpdateSingleFieldIfPresent_(os, oh, r + 1, 'UPDATED_AT', nowIso);
            orderUpdated = true; break;
          }
        }
      } catch (e) {}
      try {
        const ks = bnxClientSheet(clientId, SHEETS.KOT_MASTER), kv = ks.getDataRange().getValues();
        const kh = kv[0].map(function (v) { return String(v == null ? '' : v).trim(); });
        const oc = kh.indexOf('ORDER_ID'), cic = kh.indexOf('CLIENT_ID'), tc = kh.indexOf('TABLE_ID');
        for (let r = 1; r < kv.length; r++) {
          if (cic >= 0 && String(kv[r][cic] || '').trim() !== clientId) continue;
          if (oc >= 0 && String(kv[r][oc] || '').trim() === orderId) {
            bnxUpdateSingleFieldIfPresent_(ks, kh, r + 1, 'TABLE_ID', formFor(tc >= 0 ? kv[r][tc] : ''));
            bnxUpdateSingleFieldIfPresent_(ks, kh, r + 1, 'UPDATED_AT', nowIso);
            kotUpdated++;
          }
        }
      } catch (e) {}
    }
    bnxCreateAuditLog(clientId, {
      CLIENT_ID: clientId, LOCATION_ID: bill.LOCATION_ID || '', USER_ID: userId, ACTION: 'CHANGE_TABLE', MODULE: 'BILLING',
      RECORD_TYPE: 'BILL', RECORD_ID: bill.BILL_ID || billNumber,
      OLD_VALUE: JSON.stringify({ BILL_NUMBER: billNumber, TABLE_ID: oldVal }),
      NEW_VALUE: JSON.stringify({ BILL_NUMBER: billNumber, TABLE_ID: newBillVal, TABLE_NUMBER: target.number, ORDER_UPDATED: orderUpdated, KOT_UPDATED: kotUpdated, REASON: reason }),
      REASON: reason, TIMESTAMP: nowIso
    });
    try { bnxInvalidateTodayReportCaches_(clientId); } catch (e) {}
    return { success: true, changed: true, billNumber: billNumber, billId: bill.BILL_ID || '', oldTable: oldVal || '-', newTable: target.number,
      tableId: newBillVal, orderUpdated: orderUpdated, kotUpdated: kotUpdated };
  } catch (e) {
    bnxLogError(clientId, 'bnxChangeBillTable_ failed: ' + e.message, payload || {});
    return { success: false, error: e.message };
  } finally { try { lock.releaseLock(); } catch (e) {} }
}

function bnxDeleteInvoiceAdmin_(session, payload) {
