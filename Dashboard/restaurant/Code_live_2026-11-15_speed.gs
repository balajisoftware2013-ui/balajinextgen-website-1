/* ============================================================================
 * REPAIR 2026-10-29 — items / KOTs of today's orders that were added to an OLD, already billed order with the same
 * POS number (e.g. RD3's order on 29/10 went into ORD00986 = #ORD-1041 of table OD9, 26/10). For the given business date
 * (default today) every ORDER_ITEMS row created that day under a closed / earlier order is moved to a NEW open order of
 * the table its KOT was printed for (KOT_MASTER of that day, nearest time). TABLE_LIVE_STATE gets the new ORDER_ID.
 * Run once from the editor: RUN_33_RepairMergedOrders()   (RUN_33_RepairMergedOrders_Preview() only shows what it would do)
 * or POST {action:'REPAIR_MERGED_ORDERS', date:'2026-10-29', dryRun:true|false} as ADMIN.
 * ========================================================================== */
function bnxRepairMergedOrders_(cid,date,dryRun){
  var tz=Session.getScriptTimeZone()||'Asia/Kolkata',day=bnxNormalizeDateKey_(date||bnxBusinessDateKey_());
  var nextDay=(function(){var x=new Date(day+'T12:00:00Z');x.setUTCDate(x.getUTCDate()+1);return x.toISOString().slice(0,10);})();
  function bizOf(v){if(!v)return '';var d=v instanceof Date?v:new Date(String(v));if(isNaN(d))return '';var ist=new Date(d.getTime()+5.5*3600e3);if(ist.getUTCHours()<6)ist.setUTCDate(ist.getUTCDate()-1);return ist.toISOString().slice(0,10);}
  function tms(v){var d=v instanceof Date?v:new Date(String(v));return isNaN(d)?0:d.getTime();}
  var CLOSED=/^(BILLED|CANCELLED|CANCELED|COMPLETED|CLOSED|SETTLED|PAID|VOID|VOIDED|DELETED|MERGED)$/;
  var om=bnxClientSheet(cid,SHEETS.ORDER_MASTER),ov=om.getDataRange().getValues(),oh=ov[0].map(String),O=function(k){return oh.indexOf(k);};
  var orders={};for(var i=1;i<ov.length;i++){var id=String(ov[i][O('ORDER_ID')]||'');if(id)orders[id]={row:i+1,v:ov[i],status:String(ov[i][O('ORDER_STATUS')]||'').toUpperCase(),date:bnxNormalizeDateKey_(ov[i][O('ORDER_DATE')]),table:String(ov[i][O('TABLE_ID')]||'')};}
  var oi=bnxClientSheet(cid,SHEETS.ORDER_ITEMS),iv=oi.getDataRange().getValues(),ih=iv[0].map(String),I=function(k){return ih.indexOf(k);};
  var km=bnxClientSheet(cid,SHEETS.KOT_MASTER),kv=km.getDataRange().getValues(),kh=kv[0].map(String),K=function(k){return kh.indexOf(k);};
  /* today's items under a closed or earlier order */
  var bad={};
  for(var r=1;r<iv.length;r++){var oid=String(iv[r][I('ORDER_ID')]||''),o=orders[oid];if(!o)continue;
    if(bizOf(iv[r][I('CREATED_AT')])!==day)continue;
    if(!(CLOSED.test(o.status)&&o.date&&o.date<day))continue;   /* ONLY a billed order of an EARLIER day — today's billed orders are normal */
    (bad[oid]=bad[oid]||[]).push({row:r+1,t:tms(iv[r][I('CREATED_AT')]),name:String(iv[r][I('ITEM_NAME')]||'')});}
  var plan=[];
  Object.keys(bad).forEach(function(oid){
    var kots=[];for(var q=1;q<kv.length;q++){if(String(kv[q][K('ORDER_ID')])!==oid)continue;
      /* the KOT's own business date + time first (STARTED_AT can be a copied / wrong value), then STARTED_AT */
      var kd=K('KOT_DATE')>=0?bnxNormalizeDateKey_(kv[q][K('KOT_DATE')]):'',ktm=K('KOT_TIME')>=0?kv[q][K('KOT_TIME')]:'',kt=kv[q][K('STARTED_AT')]||kv[q][K('CREATED_AT')],t0=0;
      if(kd){var hh=ktm instanceof Date?Utilities.formatDate(ktm,tz,'HH:mm:ss'):String(ktm||'').slice(0,8);if(/^\d{1,2}:\d{2}/.test(hh)){var dd=kd;if(Number(hh.split(':')[0])<6){var x2=new Date(kd+'T12:00:00Z');x2.setUTCDate(x2.getUTCDate()+1);dd=x2.toISOString().slice(0,10);}t0=new Date(dd+'T'+(hh.length===5?hh+':00':hh)+'+05:30').getTime();}}
      if(kd?kd!==day:bizOf(kt)!==day)continue;
      kots.push({row:q+1,t:t0||tms(kt),table:String(kv[q][K('TABLE_ID')]||'')});}
    var byTable={};
    bad[oid].forEach(function(it){var best=null;kots.forEach(function(k){if(!best||Math.abs(k.t-it.t)<Math.abs(best.t-it.t))best=k;});
      var tb=best?best.table:'';if(!tb)return;(byTable[tb]=byTable[tb]||{items:[],kots:[]}).items.push(it);});
    kots.forEach(function(k){if(byTable[k.table])byTable[k.table].kots.push(k);});
    Object.keys(byTable).forEach(function(tb){plan.push({fromOrder:oid,fromTable:orders[oid].table,table:tb,items:byTable[tb].items,kots:byTable[tb].kots});});
  });
  /* safety: if the table was already billed AFTER these items were added (billed from the cart), do not reopen it */
  try{var bm=bnxClientSheet(cid,SHEETS.BILL_MASTER),bv=bm.getDataRange().getValues(),bh=bv[0].map(String),B=function(k){return bh.indexOf(k);};
    plan=plan.filter(function(p){var first=p.items.reduce(function(m,x){return x.t&&(!m||x.t<m)?x.t:m;},0);
      for(var b=bv.length-1;b>=1;b--){if(String(bv[b][B('TABLE_ID')]||'').toUpperCase()!==p.table.toUpperCase())continue;if(/CANCEL|VOID|DELET/i.test(String(bv[b][B('BILL_STATUS')]||'')))continue;
        if(bnxNormalizeDateKey_(bv[b][B('BILL_DATE')])!==day)continue;var bt=tms(bv[b][B('FINALIZED_AT')]||bv[b][B('CREATED_AT')]);if(bt&&bt>first)return false;}
      return true;});}catch(e){}
  if(dryRun||!plan.length)return {success:true,data:{date:day,dryRun:!!dryRun,moves:plan.map(function(p){return {from:p.fromOrder+' ('+p.fromTable+')',toTable:p.table,items:p.items.map(function(x){return x.name;}),kots:p.kots.length};})}};
  var lock=bnxTenantLock_(),held=lock.hasLock();if(!held)lock.waitLock(20000);
  try{
    var now=new Date().toISOString(),done=[];
    plan.forEach(function(p){
      var src=orders[p.fromOrder].v,nid=generateShortId_(cid,'ORDER_ID'),row=oh.map(function(k,j){return src[j];});
      var set=function(k,v){var c=O(k);if(c>=0)row[c]=v;};
      set('ORDER_ID',nid);set('TABLE_ID',p.table);set('ORDER_STATUS','NEW');set('ORDER_DATE',day);set('CREATED_AT',now);set('UPDATED_AT',now);
      set('SPECIAL_INSTRUCTIONS','Repaired 29/10: moved from '+p.fromOrder);set('ORDER_TIME',Utilities.formatDate(new Date(p.items[0].t||Date.now()),tz,'HH:mm:ss'));
      om.appendRow(row);
      p.items.forEach(function(it){oi.getRange(it.row,I('ORDER_ID')+1).setValue(nid);});
      p.kots.forEach(function(k){km.getRange(k.row,K('ORDER_ID')+1).setValue(nid);});
      try{var ts=bnxClientSheet(cid,SHEETS.TABLE_LIVE_STATE),tv=ts.getDataRange().getValues(),th=tv[0].map(String),tc=th.indexOf('TABLE_NO'),oc=th.indexOf('ORDER_ID'),uc=th.indexOf('UPDATED_AT');
        for(var x=1;x<tv.length;x++)if(String(tv[x][tc]).toUpperCase()===p.table.toUpperCase()){if(oc>=0)ts.getRange(x+1,oc+1).setValue(nid);if(uc>=0)ts.getRange(x+1,uc+1).setValue(now);}}catch(e){}
      try{bnxCreateAuditLog(cid,{CLIENT_ID:cid,USER_ID:'REPAIR',ACTION:'REPAIR_MERGED_ORDER',MODULE:'POS',RECORD_TYPE:'ORDER',RECORD_ID:nid,OLD_VALUE:p.fromOrder,NEW_VALUE:JSON.stringify({table:p.table,items:p.items.length,kots:p.kots.length}),TIMESTAMP:now});}catch(e){}
      done.push({newOrder:nid,table:p.table,from:p.fromOrder,items:p.items.length,kots:p.kots.length});
    });
    SpreadsheetApp.flush();
    try{bnxInvalidateTodayReportCaches_(cid);}catch(e){}try{bnxLiveGenBump_(cid);}catch(e){}
    return {success:true,data:{date:day,repaired:done}};
  }finally{if(!held)lock.releaseLock();}
}
function bnxRepairMergedOrdersApi_(session,payload){
  if(['ADMIN','SUPER_ADMIN','OWNER','DEVELOPER','MANAGER'].indexOf(String(session.ROLE||'').toUpperCase())<0)return {success:false,statusCode:403,error:'Admin login required'};
  return bnxRepairMergedOrders_(String(session.CLIENT_ID),payload&&payload.date,!(payload&&payload.dryRun===false));
}
function RUN_33_RepairMergedOrders_Preview(){var r=bnxRepairMergedOrders_('CL00010',bnxBusinessDateKey_(),true);Logger.log(JSON.stringify(r,null,1));return r;}
function RUN_33_RepairMergedOrders(){__bnxReqCid_='CL00010';var r=bnxRepairMergedOrders_('CL00010',bnxBusinessDateKey_(),false);Logger.log(JSON.stringify(r,null,1));return r;}

function bnxAutoRepairMerged_(session){
  var cid=String(session.CLIENT_ID||''),day=bnxBusinessDateKey_(),key='mergerepair_v2_'+cid+'_'+day,c=CacheService.getScriptCache();
  if(c.get(key))return;c.put(key,'1',21600);
  var r=bnxRepairMergedOrders_(cid,day,false);
  try{if(r&&r.data&&r.data.repaired&&r.data.repaired.length)bnxLogError(cid,'AUTO REPAIR merged orders: '+JSON.stringify(r.data.repaired),{});}catch(e){}
}


/* STEWARD NAME, NOT USER CODE (2026-10-29: "STARTED_BY pos billing 40 shown"). The POS steward dropdown sometimes sends the
   USER_CODE ("40", "USR00040") as waiter; KOT_MASTER / ORDER_MASTER STARTED_BY and bills then showed "40". Any code that matches
   a user in USER_MASTER is replaced by that user's name before saving. Cached 1 h. */
function bnxStaffNameMap_(cid){
  var key='staffnames_v1_'+cid,c=CacheService.getScriptCache();
  try{var hit=c.get(key);if(hit)return JSON.parse(hit);}catch(e){}
  var map={};
  try{var sh=bnxClientSheet(cid,SHEETS.USER_MASTER),v=sh.getDataRange().getValues(),h=(v[0]||[]).map(function(x){return String(x).trim().toUpperCase();});
    var ci=h.indexOf('CLIENT_ID'),codes=['USER_CODE','USER_ID','LOGIN_ID','EMP_CODE','EMPLOYEE_CODE','STAFF_CODE','STAFF_ID','CODE'].map(function(k){return h.indexOf(k);}).filter(function(i){return i>=0;});
    var names=['FULL_NAME','NAME','USER_NAME','STAFF_NAME','DISPLAY_NAME','EMPLOYEE_NAME'].map(function(k){return h.indexOf(k);}).filter(function(i){return i>=0;});
    for(var r=1;r<v.length;r++){if(ci>=0&&v[r][ci]&&String(v[r][ci])!==cid)continue;
      var nm='';for(var j=0;j<names.length;j++){var x=String(v[r][names[j]]||'').trim();if(x){nm=x;break;}}if(!nm)continue;
      codes.forEach(function(i){var k=String(v[r][i]==null?'':v[r][i]).trim().replace(/\.0$/,'');if(k&&!map[k.toUpperCase()])map[k.toUpperCase()]=nm;});}
  }catch(e){}
  try{c.put(key,JSON.stringify(map),3600);}catch(e){}
