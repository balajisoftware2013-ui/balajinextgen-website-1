 *    read-only list). Reply = { success:true, data:[ {BUSINESS_DATE:'yyyy-MM-dd', BILLS, NET_SALE, LIQUOR, LIQUOR_MRP, FOOD,
 *    BEVERAGE, HUKKA, OTHERS_SC, GROSS_SALE, TAX, ROUND_OFF, DISCOUNT, …} ] } — the shape dsr-client already expects.
 *    Cached 10 min (the tab changes only when the DSR is rebuilt); payload.force = true skips the cache.
 *
 *  Then: Deploy > Manage deployments > edit > New version.
 * ===================================================================================================== */
function bnxReadDsrItemGroupCalc_(session, payload) {
  var clientId = session && session.CLIENT_ID;
  if (!clientId) return { success: false, error: 'Authenticated CLIENT_ID required' };
  var key = 'dsr_igc_rows_v1_' + clientId, force = !!(payload && payload.force);
  if (!force) {
