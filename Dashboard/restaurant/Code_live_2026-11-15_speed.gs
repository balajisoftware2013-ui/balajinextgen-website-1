  SH.rows.forEach(function (r) {
    var d = bnxIgcDay_(g(r, SH.h, 'BUSINESS_DATE')); if (!d) return;
    sheet[d] = { liquor: bnxIgcNum_(g(r, SH.h, 'LIQUOR')), mrp: mrpIgnore[d] ? 0 : bnxIgcNum_(g(r, SH.h, 'LIQUOR_MRP')), food: bnxIgcNum_(g(r, SH.h, 'FOOD')),
      bev: bnxIgcNum_(g(r, SH.h, 'BEVERAGE')), hf: bnxIgcNum_(g(r, SH.h, 'HUKKA')) };
  });

  var days = {};
  BM.rows.forEach(function (r) {
    var id = String(g(r, b, 'BILL_ID') || ''); if (!id) return;
    var st = String(g(r, b, 'BILL_STATUS') || '').toUpperCase();
    if (/CANCEL|VOID|DELETED/.test(st)) return;
    var d = bnxIgcDay_(g(r, b, 'BILL_DATE') || g(r, b, 'BUSINESS_DATE')); if (!d) return;
    var o = days[d] || (days[d] = { bills: 0, ncBills: 0, ncVal: 0, staleBills: 0, staleVal: 0, noItemBills: 0, noItem: 0,
      liquor: 0, mrp: 0, food: 0, bev: 0, hf: 0, x: {}, net: 0, tax: 0, sc: 0, scGst: 0, disc: 0, disc2: 0 });
    o.bills++;
    var net = bnxIgcNum_(g(r, b, 'GRAND_TOTAL')), tax = bnxIgcNum_(g(r, b, 'TAX_AMOUNT')), rnd = bnxIgcNum_(g(r, b, 'ROUND_OFF'));
    var sc = bnxIgcNum_(g(r, b, 'SERVICE_CHARGE_AMOUNT')), scg = bnxIgcNum_(g(r, b, 'SERVICE_CHARGE_GST_AMOUNT'));
    var items = byBill[id];
    if (!(net > 0)) { if (items && items.s > 0) { o.ncBills++; o.ncVal += items.s; } return; }
    var pre = net - tax - scg - rnd - sc;
    if (items && items.s > pre + 1 && scg > 0 && sc > 0) {
      var preB = net - tax - sc;
