/* SPEED 2026-10-29 ("bill save click delay — save and print fast"): SAVE_BILL of a table re-read the table's open orders,
   bills and order items (3 sheet reads) that GET_TABLE_BILL_CONTEXT had read a moment before when the bill was loaded.
   The answer is now kept per table and per write generation (any order / KOT / bill / payment saved anywhere makes a new key),
   so the save re-uses it when nothing changed in between — and recomputes it the moment anything did. */
(function(){
  var base=bnxTableBillContext_;
  bnxTableBillContext_=function(s,p){
    p=p||{};var cid=String(s&&s.CLIENT_ID||''),tbl=String(p.table||p.TABLE_ID||'').trim().toUpperCase().replace(/^T-/,'');
    if(!cid||!tbl)return base.apply(this,arguments);
    var gen='0';try{var c=CacheService.getScriptCache();gen=(c.get('livegen_'+cid)||'0')+'.'+(c.get('billgen_'+cid)||'0');}catch(e){}
    var key='tbctx_v1_'+cid+'_'+String(s.LOCATION_ID||p.LOCATION_ID||'')+'_'+tbl+'_'+(p.view===true?'v':'s')+'_'+gen;
    try{var hit=CacheService.getScriptCache().get(key);if(hit)return JSON.parse(hit);}catch(e){}
    var r=base.apply(this,arguments);
    try{if(r&&r.success){var t=JSON.stringify(r);if(t.length<95000)CacheService.getScriptCache().put(key,t,120);}}catch(e){}
