  const cols = keys.map(function (k) { return headers.indexOf(k); });
  if(!keys.length||cols.some(function(i){return i<0;}))throw new Error('Report replacement requires existing match columns');
  const want = keys.map(function (k) { return bnxCellKey_(matchObj[k]); });
