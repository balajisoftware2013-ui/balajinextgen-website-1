    }
    var bd = bnxIgcNum_(g(r, b, 'BILL_DISCOUNT')), idc = bnxIgcNum_(g(r, b, 'ITEM_DISCOUNT'));
    o.net += net; o.tax += tax; o.sc += sc; o.scGst += scg; o.disc += bd;
    o.disc2 += Math.max(bd, idc);          /* billed bills only; max() so a discount stored on both fields is not counted twice */
