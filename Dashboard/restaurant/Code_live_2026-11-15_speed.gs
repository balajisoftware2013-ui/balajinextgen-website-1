/** Normalize sheet time values. Blank/invalid values remain blank, never fake midnight. */
function bnxBillTimeText_(value, timezone) {
  if (value === null || value === undefined || value === '') return '';
  if (value instanceof Date) return isNaN(value.getTime()) ? '' : Utilities.formatDate(value, timezone || Session.getScriptTimeZone() || 'Asia/Kolkata', 'HH:mm:ss');
  if (typeof value === 'number') {
    if (!isFinite(value) || value < 0 || value >= 1) return '';
    var seconds = Math.round(value * 86400) % 86400;
    return [Math.floor(seconds / 3600), Math.floor(seconds / 60) % 60, seconds % 60].map(function(n){return ('0'+n).slice(-2);}).join(':');
  }
  var m = String(value).trim().match(/^(\d{1,2}):(\d{2})(?::(\d{2}))?\s*(AM|PM)?$/i);
  if (!m) return '';
  var h=Number(m[1]), minute=Number(m[2]), second=Number(m[3] || 0), ap=(m[4] || '').toUpperCase();
  if (minute > 59 || second > 59 || (ap ? h < 1 || h > 12 : h > 23)) return '';
  if (ap) h=h%12+(ap==='PM'?12:0);
  return [h,minute,second].map(function(n){return ('0'+n).slice(-2);}).join(':');
}

