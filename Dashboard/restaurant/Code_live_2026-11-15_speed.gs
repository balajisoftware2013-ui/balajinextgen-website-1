/* payable account of an event cost: the vendor, else the cost type (e.g. PAYABLE-DJ) */
function bnxCostPayableId_(vendor,cat){return 'PAYABLE-'+String(vendor||cat||'EVENT').toUpperCase().replace(/[^A-Z0-9]+/g,'_').replace(/^_|_$/g,'').slice(0,40);}
function bnxCostPayableUndo_(cid,cur){
  if(!cur||String(cur.PAY_MODE||'').toUpperCase()!=='PAYABLE')return;
  var a=bnxCostR2_(cur.AMOUNT);if(a>0)bnxApplySupplierDueDelta_(cid,'',bnxCostPayableId_(cur.VENDOR,cur.CATEGORY),-a,bnxCostDate_(cur.COST_DATE)||bnxBusinessDateKey_(new Date()));
