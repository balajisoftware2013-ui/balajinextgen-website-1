// Mobile save + KOT + POS queue in one authenticated SAVE_ORDER request.
function bnxSaveOrder(session,payload){
 payload=payload||{};
 const parts=payload.mobileKotParts;
 if(!payload.stewardApp||!Array.isArray(parts)||!parts.length)return bnxSaveOrderBase_(session,payload);
 const items=payload.items||[],seen=new Set();
 if(parts.length>3)return {success:false,error:'Invalid station split'};
 for(const part of parts){
  if(!part||['KITCHEN','BAR','HUKKA'].indexOf(part.type)<0||!Array.isArray(part.indices)||!part.indices.length)return {success:false,error:'Invalid station split'};
  for(const i of part.indices){if(!Number.isInteger(i)||i<0||i>=items.length||seen.has(i))return {success:false,error:'Invalid station item index'};seen.add(i);}
 }
 if(seen.size!==items.length)return {success:false,error:'Station split must contain each order item exactly once'};
 const r=bnxSaveOrderBase_(session,payload);
 if(!r||r.success!==true)return r;
 const d=r.data||{},orderNo=String(d.ORDER_NUMBER||d.ORDER_NO||'');
 if(!orderNo)return r;
 const sync={success:true,count:0,failed:0,tickets:[],queued:false};
 for(const part of parts){
  try{
   const si=part.indices.map(i=>items[i]);
   const req=Object.assign({},payload,{requestId:'KOT-'+orderNo+'-'+part.type,orderNo:orderNo,ORDER_ID:d.ORDER_ID||r.transactionId,
    table:payload.tableId||payload.TABLE_ID||'',kotSource:'STEWARD',kotType:part.type,STATION:part.type,PRINT_TO:part.type,items:si});
   const k=bnxSaveKOT(session,req),no=k&&(k.kotNumber||(k.data&&k.data.KOT_NUMBER));
   if(!k||k.success!==true||!no)throw new Error(k&&k.error||'KOT save not confirmed');
   const ticket={type:part.type,kotNumber:no,transactionId:k.transactionId};
   if(payload.mobilePrintRoute!=='NATIVE'){
    const job={id:['K',session.CLIENT_ID,no,part.type,'1',''].join('-').replace(/[^A-Za-z0-9_.:-]/g,''),role:part.type,
     kotNo:no,orderNo:orderNo,table:req.table,waiter:payload.waiter||payload.steward||'',covers:payload.covers||'',splitIndex:1,splitTotal:1,
     customerName:payload.customerName||'',remarks:payload.remarks||'',from:'STEWARD',reprint:false,
     items:si.map(i=>({name:i.name||i.ITEM_NAME||i.itemName||'Item',qty:Number(i.qty||i.QUANTITY)||0,size:i.size||i.SIZE||'',note:i.SPECIAL_INSTRUCTIONS||i.itemRemark||i.remarks||i.note||''}))};
    const q=bnxPrintApi_(session,{jobs:[job]},'PRINT_QUEUE_ADD');
    if(!q||q.success!==true)throw new Error(q&&q.error||'Print queue not confirmed');
    ticket.queueAccepted=true;
   }
   sync.tickets.push(ticket);sync.count++;
  }catch(e){sync.success=false;sync.failed++;}
 }
 sync.queued=sync.success&&payload.mobilePrintRoute!=='NATIVE';
 r.mobileKotSync=sync;return r;
}
// Recover authoritative numbers on an idempotent replay without reading the entire sheet.
function bnxSavedRecordById_(clientId,sheetName,idField,id){
 const sh=bnxClientSheet(clientId,sheetName),w=sh.getLastColumn(),last=sh.getLastRow();
 if(!w||last<2)return null;
 const h=sh.getRange(1,1,1,w).getValues()[0].map(String),col=h.indexOf(idField),ci=h.indexOf('CLIENT_ID');
 if(col<0)return null;
 const hits=sh.getRange(2,col+1,last-1,1).createTextFinder(String(id)).matchEntireCell(true).findAll();
 for(let i=hits.length-1;i>=0;i--){const v=sh.getRange(hits[i].getRow(),1,1,w).getValues()[0];
  if(ci>=0&&String(v[ci])!==String(clientId))continue;
  const o={};h.forEach((k,j)=>{o[k]=v[j];});return o;
 }return null;
}
// appendRow retains atomic append behavior across concurrent devices.
function bnxAppendPreparedRow_(sheet,headers,rowObject){
 const row=headers.map(header=>{const v=header==='BILL_TIME'?bnxBillTimeText_(rowObject[header],sheet.getParent().getSpreadsheetTimeZone()):bnxMoneyCell_(header,rowObject[header]);return v==null?'':v;});
 sheet.appendRow(row);
}
