  const name = String(payload.name || payload.itemName || payload.ITEM_NAME || '').trim();
  const category = String(payload.category || payload.CATEGORY_NAME || payload.CATEGORY || '').trim();
  const price = Number(payload.price != null ? payload.price : (payload.salePrice != null ? payload.salePrice : payload.SELLING_RATE));
  const isBar = payload.isBar === true || ['true','1','yes','y'].includes(String(payload.isBar ?? payload.IS_BAR ?? '').trim().toLowerCase()) || String(payload.menuType||payload.MENU_TYPE||'').toUpperCase()==='BAR';
  if (!name) return { success:false, error:'Item name is required' };
  if (!Number.isFinite(price) || price <= 0) return { success:false, error:'Selling price must be greater than 0' };
  /* 2026-10-29 ("item edit not working"): SAVE_MENU_ITEM only CREATED items — editing an existing item answered
     "Item already exists" and nothing was saved. An item sent with its ITEM_ID / ITEM_CODE is now UPDATED in place
     (Item Master + POS menu card + bar menu), so the dashboard and the steward menu show the new name / price / group at once. */
  try { const up = bnxUpdateMenuItem_(session, payload, name, category, price, isBar); if (up) return up; }
  catch (upErr) { bnxLogError(clientId, 'bnxUpdateMenuItem_ failed: ' + upErr.message, payload); return { success:false, error:upErr.message }; }
  try {
    const sheet = bnxClientSheet(clientId, SHEETS.ITEM_MASTER);
    const values = sheet.getDataRange().getValues();
    const headers = values[0] || [];
    const nameCol = headers.indexOf('ITEM_NAME');
    const ciCol = headers.indexOf('CLIENT_ID');
    for (let r=1;r<values.length;r++) {
      if (ciCol>=0 && String(values[r][ciCol])!==String(clientId)) continue;
      if (nameCol>=0 && String(values[r][nameCol]||'').trim().toLowerCase()===name.toLowerCase()) {
        return {success:false,error:'Item already exists: '+name,duplicate:true,id:values[r][headers.indexOf('ITEM_ID')]||''};
      }
    }
    const catMap=bnxCachedCategoryNameMap_(clientId);
    const unitMap=bnxCachedUnitNameMap_(clientId);
    const taxMap=bnxCachedTaxRateMap_(clientId);
    const categoryId=category ? bnxResolveCategoryId_(clientId,category,catMap) : '';
    const unitName=String(payload.unit||payload.UNIT_NAME||payload.UNIT||'NOS').trim();
    const unitId=unitName ? bnxResolveUnitId_(clientId,unitName,unitMap) : '';
    const gst=Number(payload.gst != null ? payload.gst : (payload.GST_RATE != null ? payload.GST_RATE : payload.taxRate));
    const taxId=Number.isFinite(gst) && gst>=0 ? bnxResolveTaxId_(clientId,gst,taxMap) : '';
    const itemId=generateShortId_(clientId,'ITEM_ID');
    const rowObj={
      ITEM_ID:itemId, CLIENT_ID:clientId, ITEM_NAME:name,
      // CATEGORY FIX: persist BOTH the normalized CATEGORY_ID and the human
      // readable CATEGORY_NAME. Older builds saved only CATEGORY_ID, so the
      // Item Master appeared to lose the selected category after reload.
      CATEGORY_ID:categoryId, CATEGORY_NAME:category, CATEGORY:category, MENU_CATEGORY:category,
      UNIT_ID:unitId,
      ITEM_CODE:String(payload.itemCode||payload.ITEM_CODE||itemId).trim(), PURCHASE_RATE:Number(payload.costPrice)||0, SELLING_RATE:price, TAX_ID:taxId,
      HSN_CODE:String(payload.hsn||payload.HSN_CODE||'').trim(), ICON:String(payload.icon||payload.ICON||'').trim(),
      IS_ACTIVE:payload.avail===false || String(payload.avail).toLowerCase()==='false' ? false : true,
      IS_BAR:isBar, ITEM_GROUP_ID:String(payload.itemGroupId||payload.ITEM_GROUP_ID||'').trim(),
      ITEM_GROUP_NAME:String(payload.itemGroupName||payload.ITEM_GROUP_NAME||'').trim(),
      MENU_TYPE:isBar?'BAR':'RESTAURANT', MENU_ACTIVE:true, MENU_SECTION:category,
      CREATED_BY:userId||'', CREATED_AT:new Date().toISOString()
    };
    rowObj.VEG_NONVEG=isBar?'':String(payload.veg||payload.VEG_NONVEG||'').trim();
    // FINAL PRINT ROUTING: only two kitchen-production stations are used.
    // Never persist the old intermediate label 'Kitchen (Printer 2)'.
    const requestedPrintTo=String(payload.printTo||payload.PRINT_TO||'').trim().toUpperCase();
    rowObj.PRINT_TO=isBar?'BAR':(requestedPrintTo==='BAR'?'BAR':'KITCHEN');
    rowObj.PRINT_STATION=rowObj.PRINT_TO;
    rowObj.AVAILABILITY_STATUS=payload.avail===false || String(payload.avail).toLowerCase()==='false' ? 'unavailable' : 'available';
    const out=headers.map(h=>rowObj[h]!==undefined?rowObj[h]:'');
    sheet.getRange(sheet.getLastRow()+1,1,1,headers.length).setValues([out]);

    // Publish to the authoritative POS card at the same time as ITEM_MASTER.
    let publishedId=itemId;
    if(isBar){
      const bsheet=bnxClientSheet(clientId,SHEETS.BAR_ITEM_MASTER);
      const bh=bsheet.getDataRange().getValues(); const headersB=bh[0]||[];
      const barItemId=generateShortId_(clientId,'BAR_ITEM_ID');
      const bObj={BAR_ITEM_ID:barItemId,CLIENT_ID:clientId,ITEM_ID:itemId,BAR_CATEGORY:category,PRINT_TO:'BAR',PRINT_STATION:'BAR',SERVING_UOM:unitName,SERVING_SIZE:String(payload.servingSize||'').trim(),SELLING_PRICE:price,TAX_ID:taxId,STATUS:'ACTIVE',CREATED_AT:new Date().toISOString(),UPDATED_AT:new Date().toISOString(),IS_ACTIVE:true,FAVOURITE:false,POPULAR:false,AVAILABILITY_STATUS:rowObj.AVAILABILITY_STATUS,MENU_TYPE:'BAR'};
      bsheet.getRange(bsheet.getLastRow()+1,1,1,headersB.length).setValues([headersB.map(h=>bObj[h]!==undefined?bObj[h]:'')]);
      const c=bnxClientSheet(clientId,SHEETS.BAR_MENU_CARD); const ch=c.getDataRange().getValues(); const headersC=ch[0]||[];
      const cObj={CLIENT_ID:clientId,CATEGORY_ID:categoryId,CATEGORY_NAME:category,CATEGORY:category,MENU_CATEGORY:category,MENU_SECTION:category,ITEM_NAME:name,SERVING_PRICE:price,BOTTLE_PRICE:'',SOURCE_PAGE:'',SOURCE_FILE:'POS',ITEM_ID:itemId,ITEM_GROUP_ID:String(payload.itemGroupId||payload.ITEM_GROUP_ID||'').trim(),ITEM_GROUP_NAME:String(payload.itemGroupName||payload.ITEM_GROUP_NAME||'').trim(),TAX_ID:taxId,IS_BAR:true,IS_ACTIVE:true,NOTES:'POS Add',AVAILABILITY_STATUS:rowObj.AVAILABILITY_STATUS,FAVOURITE:false,POPULAR:false,MENU_TYPE:'BAR'};
      c.getRange(c.getLastRow()+1,1,1,headersC.length).setValues([headersC.map(h=>cObj[h]!==undefined?cObj[h]:'')]);
      publishedId=barItemId;
    }else{
      const c=bnxClientSheet(clientId,SHEETS.MENU_CARD_ITEMS); const ch=c.getDataRange().getValues(); const headersC=ch[0]||[];
      const cObj={CLIENT_ID:clientId,MENU_ITEM_NAME:name,ITEM_NAME:name,PRICE:price,MENU_SECTION:category,CATEGORY:category,MENU_CATEGORY:category,CATEGORY_ID:categoryId,CATEGORY_NAME:category,VEG_TYPE:String(payload.veg||'').trim(),SOURCE:'POS',ITEM_ID:itemId,ITEM_CODE:rowObj.ITEM_CODE,PRINT_TO:'KITCHEN',PRINT_STATION:'KITCHEN',ITEM_GROUP_ID:String(payload.itemGroupId||payload.ITEM_GROUP_ID||'').trim(),ITEM_GROUP_NAME:String(payload.itemGroupName||payload.ITEM_GROUP_NAME||'').trim(),AVAILABILITY_STATUS:rowObj.AVAILABILITY_STATUS,FAVOURITE:false,POPULAR:false,MENU_TYPE:'RESTAURANT'};
      c.getRange(c.getLastRow()+1,1,1,headersC.length).setValues([headersC.map(h=>cObj[h]!==undefined?cObj[h]:'')]);
    }
    bnxInvalidateMasterCache_(clientId);
    try { CacheService.getScriptCache().remove('posmenu_v2_'+clientId); } catch(e) {}
    bnxCreateAuditLog(clientId,{CLIENT_ID:clientId,USER_ID:userId,ACTION:'CREATE',MODULE:'MENU',RECORD_TYPE:isBar?'BAR_MENU_ITEM':'MENU_ITEM',RECORD_ID:itemId,NEW_VALUE:JSON.stringify(rowObj),TIMESTAMP:new Date().toISOString()});
    return {success:true,id:itemId,publishedId,data:{ITEM_ID:itemId,ITEM_NAME:name,CATEGORY_ID:categoryId,CATEGORY_NAME:category,SELLING_RATE:price,GST_RATE:Number.isFinite(gst)?gst:0,IS_BAR:isBar,MENU_TYPE:isBar?'BAR':'RESTAURANT'}};
  } catch(error) {
    bnxLogError(clientId,`bnxSaveMenuItem failed: ${error.message}`,payload);
    return {success:false,error:error.message};
  }
}

/* ============================================================================
 * FINAL MENU IMAGE STORAGE — client-scoped Google Drive
 * Frontend sends a compressed data URL. This handler stores one image file
 * under BALAJI_NEXTGEN_CLIENT_ITEM_IMAGES/<CLIENT_ID>/ and writes the public
 * viewer URL into any image column that exists in ITEM_MASTER and the menu-card
 * tables. No other client's rows can be touched because the session CLIENT_ID
 * is authoritative.
 * ========================================================================== */
function bnxSaveMenuItemImage_(session, payload) {
  const clientId=String(session && session.CLIENT_ID || '').trim();
  const userId=String(session && session.USER_ID || '').trim();
  if(!clientId) return {success:false,error:'Client session is required'};
  const p=payload||{};
  const itemId=String(p.itemId||p.ITEM_ID||'').trim();
  const itemCode=String(p.itemCode||p.ITEM_CODE||'').trim();
  const dataUrl=String(p.imageData||p.dataUrl||p.imageUrl||'').trim();
  if(!itemId && !itemCode) return {success:false,error:'ITEM_ID or ITEM_CODE is required'};
  if(!dataUrl) return {success:false,error:'Image data is required'};
  try{
    const sh=bnxClientSheet(clientId,SHEETS.ITEM_MASTER);
    const vals=sh.getDataRange().getValues();
    const h=vals[0]||[];
    const idc=h.indexOf('ITEM_ID'), codec=h.indexOf('ITEM_CODE'), namec=h.indexOf('ITEM_NAME');
    let row=-1;
    for(let r=1;r<vals.length;r++){
      if(itemId && idc>=0 && String(vals[r][idc]||'').trim()===itemId){row=r;break;}
      if(!itemId && itemCode && codec>=0 && String(vals[r][codec]||'').trim().toUpperCase()===itemCode.toUpperCase()){row=r;break;}
    }
    /* 2026-10-29 ("image upload failed"): POS quick-add items live only in the menu card — look there (and by name) too */
    const pname=String(p.name||p.itemName||'').trim().toLowerCase();
    if(row<0&&pname&&namec>=0){for(let r=1;r<vals.length;r++){if(String(vals[r][namec]||'').trim().toLowerCase()===pname){row=r;break;}}}
    let cardOnly=null;
    if(row<0){
      [['MENU_CARD_ITEMS',['ITEM_ID','ITEM_CODE'],['MENU_ITEM_NAME','ITEM_NAME']],['BAR_MENU_CARD',['ITEM_ID','BAR_ITEM_ID'],['ITEM_NAME']]].some(function(t){
        try{const ms=bnxClientSheet(clientId,t[0]),mv=ms.getDataRange().getValues(),mh=mv[0]||[];
          for(let r=1;r<mv.length;r++){const ids=t[1].map(function(k){const c=mh.indexOf(k);return c>=0?String(mv[r][c]||'').trim():'';}),nm=t[2].map(function(k){const c=mh.indexOf(k);return c>=0?String(mv[r][c]||'').trim():'';}).filter(Boolean)[0]||'';
            if((itemId&&ids.indexOf(itemId)>=0)||(itemCode&&ids.map(function(x){return x.toUpperCase();}).indexOf(itemCode.toUpperCase())>=0)||(pname&&nm.toLowerCase()===pname)){cardOnly={id:ids.filter(Boolean)[0]||itemId||itemCode,name:nm||p.name||'Item'};return true;}}
        }catch(e){}return false;});
      if(!cardOnly) return {success:false,error:'Item not found — save the item first, then add its photo'};
    }
    const actualId=cardOnly?cardOnly.id:(idc>=0?String(vals[row][idc]||'').trim():itemId);
    const itemName=cardOnly?cardOnly.name:(namec>=0?String(vals[row][namec]||'Item').trim():'Item');

    let viewerUrl=dataUrl;
    let fileId='';
    if(/^data:image\//i.test(dataUrl)){
      const m=dataUrl.match(/^data:(image\/[a-z0-9.+-]+);base64,(.+)$/i);
      if(!m) return {success:false,error:'Invalid image data'};
      const mime=m[1].toLowerCase();
      const bytes=Utilities.base64Decode(m[2]);
      if(bytes.length>1200000) return {success:false,error:'Compressed image is still above 1.2 MB'};
      const rootName='BALAJI_NEXTGEN_CLIENT_ITEM_IMAGES';
      let rootIt=DriveApp.getFoldersByName(rootName);
      const root=rootIt.hasNext()?rootIt.next():DriveApp.createFolder(rootName);
      let cf=root.getFoldersByName(clientId);
      const folder=cf.hasNext()?cf.next():root.createFolder(clientId);
      const ext=mime.indexOf('webp')>=0?'webp':(mime.indexOf('png')>=0?'png':'jpg');
      const safeId=(actualId||itemCode||'ITEM').replace(/[^A-Za-z0-9_-]/g,'_');
      const safeName=itemName.replace(/[^A-Za-z0-9._-]/g,'_').slice(0,70);
      const fileName=safeId+'_'+safeName+'_POS.'+ext;
      // Replace the same item's prior POS image instead of accumulating
      // hundreds of orphan image files on repeated client updates.
      const old=folder.getFilesByName(fileName);
      while(old.hasNext()){try{old.next().setTrashed(true);}catch(e){}}
      const blob=Utilities.newBlob(bytes,mime,fileName);
      const file=folder.createFile(blob);
      try{file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);}catch(e){/* Workspace policy may forbid public links; keep the file and return its Drive URL. */}
      fileId=file.getId();
      viewerUrl='https://lh3.googleusercontent.com/d/'+encodeURIComponent(fileId);   /* 2026-10-29: uc?export=view is often blocked in <img>; this link shows in the POS and steward menus */
    }

    // Update whichever image columns are actually present. This keeps the
    // handler compatible with old and new client DB schemas.
    const imageCols=['IMAGE_URL','ITEM_IMAGE','PRODUCT_IMAGE_URL','IMAGE'];
    let changed=0;
    imageCols.forEach(col=>{
      const c=h.indexOf(col); if(c>=0&&row>=0){sh.getRange(row+1,c+1).setValue(viewerUrl);changed++;}
    });
    // If ITEM_MASTER has no image column, the Drive file is still returned;
    // menu-card tables below can carry it where supported.
    [['MENU_CARD_ITEMS','ITEM_ID'],['BAR_MENU_CARD','ITEM_ID']].forEach(pair=>{
      try{
        const ms=bnxClientSheet(clientId,pair[0]), mv=ms.getDataRange().getValues(), mh=mv[0]||[], mic=mh.indexOf(pair[1]);
        if(mic<0)return;
        const mcc=mh.indexOf('ITEM_CODE'),mbc=mh.indexOf('BAR_ITEM_ID');
        for(let r=1;r<mv.length;r++) if(String(mv[r][mic]||'').trim()===actualId||(mcc>=0&&itemCode&&String(mv[r][mcc]||'').trim().toUpperCase()===itemCode.toUpperCase())||(mbc>=0&&String(mv[r][mbc]||'').trim()===actualId)){
          ['IMAGE_URL','ITEM_IMAGE','PRODUCT_IMAGE_URL','IMAGE'].forEach(col=>{const c=mh.indexOf(col);if(c>=0)ms.getRange(r+1,c+1).setValue(viewerUrl);});
        }
      }catch(e){}
    });
    try{bnxInvalidateMasterCache_(clientId);CacheService.getScriptCache().remove('posmenu_v2_'+clientId);}catch(e){}
    try{bnxCreateAuditLog(clientId,{CLIENT_ID:clientId,USER_ID:userId,ACTION:'UPDATE',MODULE:'MENU',RECORD_TYPE:'ITEM_IMAGE',RECORD_ID:actualId,NEW_VALUE:JSON.stringify({url:viewerUrl,fileId:fileId}),TIMESTAMP:new Date().toISOString()});}catch(e){}
    return {success:true,itemId:actualId,imageUrl:viewerUrl,driveFileId:fileId,columnsUpdated:changed};
  }catch(error){
    bnxLogError(clientId,'SAVE_MENU_ITEM_IMAGE failed: '+error.message,payload);
    return {success:false,error:error.message};
  }
}

function bnxImportMenuItems(session, payload) {
  const clientId = session.CLIENT_ID;
  const items = payload.items || [];
  if (!items.length) return { success: false, message: 'No items to import' };
  try {
    const catMap = bnxCachedCategoryNameMap_(clientId);
    const unitMap = bnxCachedUnitNameMap_(clientId);
    const taxMap = bnxCachedTaxRateMap_(clientId);
    const sheet = bnxClientSheet(clientId, SHEETS.ITEM_MASTER);
    const values = sheet.getDataRange().getValues();
    const headers = values[0];
    const nameCol = headers.indexOf('ITEM_NAME');
    const ciCol = headers.indexOf('CLIENT_ID');
    const existingNames = new Set();
    for (let r = 1; r < values.length; r++) { if (ciCol !== -1 && values[r][ciCol] !== clientId) continue; existingNames.add(String(values[r][nameCol] || '').toLowerCase()); }
    let imported = 0, skipped = 0;
    const rowsToAppend = [];
    items.forEach(item => {
      const key = String(item.name || '').toLowerCase();
      if (!key || existingNames.has(key)) { skipped++; return; }
      existingNames.add(key);
      const categoryId = bnxResolveCategoryId_(clientId, item.category, catMap);
      const unitId = item.unit ? bnxResolveUnitId_(clientId, item.unit, unitMap) : '';
      const taxId = item.taxRate != null && item.taxRate !== '' ? bnxResolveTaxId_(clientId, item.taxRate, taxMap) : '';
      const v3Row = { ITEM_ID: generateShortId_(clientId, 'ITEM_ID'), CLIENT_ID: clientId, ITEM_NAME: item.name, CATEGORY_ID: categoryId, UNIT_ID: unitId, PURCHASE_RATE: item.costPrice || 0, SELLING_RATE: item.salePrice || 0, TAX_ID: taxId, IS_ACTIVE: (item.status || 'Active') === 'Active', CREATED_AT: new Date().toISOString() };
      rowsToAppend.push(headers.map(h => v3Row[h] !== undefined ? v3Row[h] : ''));
      imported++;
    });
    if (rowsToAppend.length) sheet.getRange(sheet.getLastRow() + 1, 1, rowsToAppend.length, headers.length).setValues(rowsToAppend);
    if (imported > 0) bnxInvalidateMasterCache_(clientId);
    return { success: true, data: { imported, skipped } };
  } catch (error) {
    bnxLogError(clientId, `bnxImportMenuItems failed: ${error.message}`, payload);
    return { success: false, message: error.message };
  }
}

const KOT_STATUS_MAP_IN_ = { pending: 'PRINTED', cooking: 'COOKING', ready: 'READY', served: 'SERVED', cancelled: 'CANCELLED' };

function bnxUpdateKotStatus(session, payload) {
  const clientId = session.CLIENT_ID;
  const userId = session.USER_ID;
  const kotId = payload.kotId || payload.KOT_ID || '';
  const rawStatus = String(payload.status || '').toLowerCase();
  const newStatus = KOT_STATUS_MAP_IN_[rawStatus] || String(payload.status || '').toUpperCase();
  if (!kotId || !newStatus) return { success: false, error: 'kotId and status are required' };
  try {
    const sheet = bnxClientSheet(clientId, SHEETS.KOT_MASTER);
    const values = sheet.getDataRange().getValues();
    const headers = values[0];
    const ciCol = headers.indexOf('CLIENT_ID');
    const idCol = headers.indexOf('KOT_ID');
    const noCol = headers.indexOf('KOT_NUMBER');
    const statusCol = headers.indexOf('KOT_STATUS');
    const updatedCol = headers.indexOf('UPDATED_AT');
    const servedCol = headers.indexOf('SERVED_AT');
    for (let r = 1; r < values.length; r++) {
      if (ciCol !== -1 && values[r][ciCol] !== clientId) continue;
      const matches = (idCol !== -1 && values[r][idCol] === kotId) || (noCol !== -1 && values[r][noCol] === kotId);
      if (!matches) continue;
      if (statusCol !== -1) sheet.getRange(r + 1, statusCol + 1).setValue(newStatus);
      if (updatedCol !== -1) sheet.getRange(r + 1, updatedCol + 1).setValue(new Date().toISOString());
      if (newStatus === 'SERVED' && servedCol !== -1) sheet.getRange(r + 1, servedCol + 1).setValue(new Date().toISOString());
      bnxCreateAuditLog(clientId, { CLIENT_ID: clientId, USER_ID: userId, ACTION: 'UPDATE', MODULE: 'KITCHEN', RECORD_TYPE: 'KOT', RECORD_ID: (idCol !== -1 ? values[r][idCol] : kotId), OLD_VALUE: '{}', NEW_VALUE: JSON.stringify({ KOT_STATUS: newStatus }), TIMESTAMP: new Date().toISOString() });
      return { success: true, kotId: (idCol !== -1 ? values[r][idCol] : kotId), status: newStatus };
    }
    return { success: false, error: 'KOT not found for this client (kotId: ' + kotId + ')' };
  } catch (error) {
    bnxLogError(clientId, `bnxUpdateKotStatus failed: ${error.message}`, payload);
    return { success: false, error: error.message };
  }
}


function bnxUpdateOrderStatusBefore26_(session, payload) {
  const clientId = session.CLIENT_ID;
  const userId = session.USER_ID;
  const orderId = payload.orderId || payload.ORDER_ID || payload.ORDER_NUMBER || '';
  const newStatus = String(payload.status || '').toUpperCase();
  if (!orderId || !newStatus) return { success: false, error: 'orderId and status are required' };
  try {
    const sheet = bnxClientSheet(clientId, SHEETS.ORDER_MASTER);
    const values = sheet.getDataRange().getValues();
    const headers = values[0];
    const ciCol = headers.indexOf('CLIENT_ID');
    const idCol = headers.indexOf('ORDER_ID');
    const noCol = headers.indexOf('ORDER_NUMBER');
    const statusCol = headers.indexOf('ORDER_STATUS');
    const notesCol = headers.indexOf('SPECIAL_INSTRUCTIONS');
    const updatedCol = headers.indexOf('UPDATED_AT');
    for (let r = 1; r < values.length; r++) {
      if (ciCol !== -1 && values[r][ciCol] !== clientId) continue;
      const matches = (noCol !== -1 && values[r][noCol] === orderId) || (idCol !== -1 && values[r][idCol] === orderId);
      if (!matches) continue;
      if (statusCol !== -1) sheet.getRange(r + 1, statusCol + 1).setValue(newStatus);
      if (payload.remarks && notesCol !== -1) sheet.getRange(r + 1, notesCol + 1).setValue(String(payload.remarks));
      if (updatedCol !== -1) sheet.getRange(r + 1, updatedCol + 1).setValue(new Date().toISOString());
      bnxCreateAuditLog(clientId, { CLIENT_ID: clientId, USER_ID: userId, ACTION: 'UPDATE', MODULE: 'STEWARD', RECORD_TYPE: 'ORDER', RECORD_ID: (idCol !== -1 ? values[r][idCol] : orderId), OLD_VALUE: '{}', NEW_VALUE: JSON.stringify({ ORDER_STATUS: newStatus, remarks: payload.remarks || '' }), TIMESTAMP: new Date().toISOString() });
      return { success: true, orderId: (idCol !== -1 ? values[r][idCol] : orderId), status: newStatus };
    }
    return { success: false, error: 'Order not found for this client (orderId: ' + orderId + ')' };
  } catch (error) {
    bnxLogError(clientId, `bnxUpdateOrderStatus failed: ${error.message}`, payload);
    return { success: false, error: error.message };
  }
}

function bnxResolveCustomerId_(clientId, name, mobile) {
  const cleanMobile = String(mobile || '').replace(/\D/g, '');
  const cleanName = String(name || '').trim();
  if (!cleanMobile && !cleanName) return '';
  try {
    const sheet = bnxClientSheet(clientId, SHEETS.CUSTOMER_MASTER);
    const values = sheet.getDataRange().getValues();
    const headers = values[0];
    for (let r = 1; r < values.length; r++) {
      const row = bnxRowToObject(values[r], headers);
      if (row.CLIENT_ID !== clientId) continue;
      if (cleanMobile && String(row.PHONE || '').replace(/\D/g, '') === cleanMobile) return row.CUSTOMER_ID;
      if (!cleanMobile && cleanName && String(row.CUSTOMER_NAME || '').toLowerCase() === cleanName.toLowerCase()) return row.CUSTOMER_ID;
    }
    const newId = generateShortId_(clientId, 'CUSTOMER_ID');
    bnxAppendRow(clientId, SHEETS.CUSTOMER_MASTER, { CUSTOMER_ID: newId, CLIENT_ID: clientId, CUSTOMER_NAME: cleanName || 'Customer', PHONE: cleanMobile, CUSTOMER_TYPE: 'Individual', IS_ACTIVE: true, CREATED_AT: new Date().toISOString() });
    return newId;
  } catch (error) { console.warn('[bnxResolveCustomerId_] ' + error.message); return ''; }
}

function bnxUpsertCustomerDue_(clientId, customerId, amount, dateStr, txnType) {
  const sheet = bnxClientSheet(clientId, SHEETS.CUSTOMER_DUES);
  const values = sheet.getDataRange().getValues();
  const headers = values[0];
  const ciCol = headers.indexOf('CLIENT_ID');
  const custCol = headers.indexOf('CUSTOMER_ID');
  const balCol = headers.indexOf('CURRENT_BALANCE');
  const lastDateCol = headers.indexOf('LAST_TRANSACTION_DATE');
  const lastTypeCol = headers.indexOf('LAST_TRANSACTION_TYPE');
  const updatedCol = headers.indexOf('UPDATED_AT');
  for (let r = 1; r < values.length; r++) {
    if (values[r][ciCol] === clientId && values[r][custCol] === customerId) {
      const current = parseFloat(values[r][balCol]) || 0;
      sheet.getRange(r + 1, balCol + 1).setValue(current + amount);
      if (lastDateCol !== -1) sheet.getRange(r + 1, lastDateCol + 1).setValue(dateStr);
      if (lastTypeCol !== -1) sheet.getRange(r + 1, lastTypeCol + 1).setValue(txnType);
      if (updatedCol !== -1) sheet.getRange(r + 1, updatedCol + 1).setValue(new Date().toISOString());
      return;
    }
  }
  bnxAppendRow(clientId, SHEETS.CUSTOMER_DUES, { CUSTOMER_DUES_ID: generateShortId_(clientId, 'CUSTOMER_DUES_ID'), CLIENT_ID: clientId, CUSTOMER_ID: customerId, OPENING_BALANCE: 0, CURRENT_BALANCE: amount, LAST_TRANSACTION_DATE: dateStr, LAST_TRANSACTION_TYPE: txnType, STATUS: 'Active', UPDATED_AT: new Date().toISOString() });
}



/**
 * SAVE_CREDIT_CUSTOMER — live customer master editor.
 * Group mapping is stored on CUSTOMER_MASTER so GET_DUE_COLLECTION,
 * Party-wise, Group-wise and Bill-wise views all resolve the same mapping.
 * Existing financial balances are not changed by a group-only edit.
 */
function bnxSaveCreditCustomer(session, payload) {
  const clientId = session.CLIENT_ID;
  const userId = session.USER_ID;
  const role = String(session && session.ROLE || '').trim().toUpperCase();
  if (!['ADMIN','SUPER_ADMIN','DEVELOPER','OWNER','MANAGER','ACCOUNTANT'].includes(role)) {
    return { success:false, error:'NOT_AUTHORIZED', message:'You are not authorized to edit credit customers.' };
  }
  payload = payload || {};
  const name = String(payload.name || payload.customerName || '').trim();
  if (!name) return { success:false, error:'CUSTOMER_NAME_REQUIRED' };
  const phone = String(payload.phone || payload.mobile || '').trim();
  const type = String(payload.type || 'Individual').trim() || 'Individual';
  const gstin = String(payload.gstin || '').trim().toUpperCase();
  const groupId = String(payload.groupId || '').trim();
  const groupName = String(payload.groupName || '').trim();
  const requestedId = String(payload.customerId || '').trim();
  try {
    const sh = bnxClientSheet(clientId, SHEETS.CUSTOMER_MASTER);
    let vals = sh.getDataRange().getValues();
    let headers = vals[0] || [];
    const ensureCol = field => {
      let i = headers.indexOf(field);
      if (i === -1) {
        sh.getRange(1, headers.length + 1).setValue(field);
        headers.push(field); i = headers.length - 1;
      }
      return i;
    };
    const idCol=ensureCol('CUSTOMER_ID'), clientCol=ensureCol('CLIENT_ID'), nameCol=ensureCol('CUSTOMER_NAME');
    const phoneCol=ensureCol('PHONE'), typeCol=ensureCol('CUSTOMER_TYPE'), gstCol=ensureCol('GSTIN');
    const limitCol=ensureCol('CREDIT_LIMIT'), daysCol=ensureCol('CREDIT_DAYS');
    const gidCol=ensureCol('CUSTOMER_GROUP_ID'), gnCol=ensureCol('CUSTOMER_GROUP_NAME');
    const activeCol=ensureCol('IS_ACTIVE'), updatedCol=ensureCol('UPDATED_AT');
    vals = sh.getDataRange().getValues();
    /* PASS #83: customer rename must never create/leave a duplicate party.
       If customerId is supplied, reject a rename to another existing
       CUSTOMER_NAME (case/space insensitive). This keeps all historical
       CUSTOMER_ID/DUE/ledger links on one party. */
    for (let rr = 1; rr < vals.length; rr++) {
      if (String(vals[rr][clientCol] || '') !== clientId) continue;
      const existingId = String(vals[rr][idCol] || '').trim();
      const existingName = String(vals[rr][nameCol] || '').trim();
      if (requestedId && existingId !== requestedId && existingName.toLowerCase() === name.toLowerCase()) {
        return { success:false, error:'DUPLICATE_CUSTOMER_NAME', message:'Another customer already uses this name. Edit that customer instead.' };
      }
    }
    let foundRow = -1;
    for (let r=1;r<vals.length;r++) {
      if (String(vals[r][clientCol] || '') !== clientId) continue;
      if (requestedId && String(vals[r][idCol] || '') === requestedId) { foundRow=r+1; break; }
      if (!requestedId && String(vals[r][nameCol] || '').trim().toLowerCase() === name.toLowerCase() &&
          (!phone || String(vals[r][phoneCol] || '').replace(/\D/g,'') === phone.replace(/\D/g,''))) { foundRow=r+1; break; }
    }
    const now = new Date().toISOString();
    if (foundRow === -1) {
      const newId = requestedId || generateShortId_(clientId, 'CUSTOMER_ID');
      const row = new Array(headers.length).fill('');
      row[idCol]=newId; row[clientCol]=clientId; row[nameCol]=name; row[phoneCol]=phone;
      row[typeCol]=type; row[gstCol]=gstin; row[gidCol]=groupId; row[gnCol]=groupName || (groupId || '');
      row[activeCol]=true; row[updatedCol]=now;
      if (limitCol>=0) row[limitCol]=Number(payload.creditLimit || 0) || 0;
      if (daysCol>=0) row[daysCol]=Number(payload.creditDays || 0) || 0;
      sh.getRange(sh.getLastRow()+1,1,1,row.length).setValues([row]);
      if (Number(payload.openingBalance || 0) > 0) {
        bnxUpsertCustomerDue_(clientId, newId, Number(payload.openingBalance), String(payload.openingDate || bnxNowParts_().businessDate), 'OPENING');
      }
      return { success:true, customerId:newId, created:true, groupId, groupName:groupName || (groupId || 'Unmapped') };
    }
    const set=(col,val)=>{ if(col>=0) sh.getRange(foundRow,col+1).setValue(val); };
    set(nameCol,name); set(phoneCol,phone); set(typeCol,type); set(gstCol,gstin);
    set(gidCol,groupId); set(gnCol,groupName || (groupId || ''));
    if (payload.creditLimit !== undefined) set(limitCol,Number(payload.creditLimit)||0);
    if (payload.creditDays !== undefined) set(daysCol,Number(payload.creditDays)||0);
    set(activeCol,true); set(updatedCol,now);
    /* LIVE FIX: when an existing customer's Opening Balance is edited, persist
       the delta to CUSTOMER_DUES as well. Group/name edits must not alter money,
       but an explicitly supplied opening balance is a real financial change. */
    if (payload.openingBalance !== undefined && payload.openingBalance !== null && String(payload.openingBalance).trim() !== '') {
      const newOpening = Number(payload.openingBalance) || 0;
      const dueSh = bnxClientSheet(clientId, SHEETS.CUSTOMER_DUES);
      const dv = dueSh.getDataRange().getValues();
      const dh = dv[0] || [];
      const dc = dh.indexOf('CUSTOMER_ID'), dclient = dh.indexOf('CLIENT_ID');
      const dop = dh.indexOf('OPENING_BALANCE'), dcb = dh.indexOf('CURRENT_BALANCE');
      let dueRow = -1;
      for (let rr=1; rr<dv.length; rr++) {
        if (String(dv[rr][dclient]||'')===clientId && String(dv[rr][dc]||'')===String(vals[foundRow-1][idCol]||requestedId)) { dueRow=rr+1; break; }
      }
      if (dueRow > 0 && dop >= 0 && dcb >= 0) {
        const oldOpening = Number(dv[dueRow-1][dop]) || 0;
        const currentBal = Number(dv[dueRow-1][dcb]) || 0;
        const delta = newOpening - oldOpening;
        dueSh.getRange(dueRow,dop+1).setValue(newOpening);
        dueSh.getRange(dueRow,dcb+1).setValue(currentBal + delta);
        if (dh.indexOf('LAST_TRANSACTION_DATE')>=0) dueSh.getRange(dueRow,dh.indexOf('LAST_TRANSACTION_DATE')+1).setValue(String(payload.openingDate || bnxNowParts_().businessDate));
        if (dh.indexOf('LAST_TRANSACTION_TYPE')>=0) dueSh.getRange(dueRow,dh.indexOf('LAST_TRANSACTION_TYPE')+1).setValue('OPENING_EDIT');
        if (dh.indexOf('UPDATED_AT')>=0) dueSh.getRange(dueRow,dh.indexOf('UPDATED_AT')+1).setValue(now);
      } else if (newOpening !== 0) {
        bnxUpsertCustomerDue_(clientId, String(vals[foundRow-1][idCol]||requestedId), newOpening, String(payload.openingDate || bnxNowParts_().businessDate), 'OPENING');
      }
    }
    try { bnxCreateAuditLog(clientId,{CLIENT_ID:clientId,USER_ID:userId,ACTION:'UPDATE',MODULE:'CUSTOMER_CREDIT',RECORD_TYPE:'CUSTOMER',RECORD_ID:String(vals[foundRow-1][idCol]||requestedId),OLD_VALUE:JSON.stringify({CUSTOMER_NAME:vals[foundRow-1][nameCol]||'',PHONE:vals[foundRow-1][phoneCol]||'',CUSTOMER_GROUP_ID:vals[foundRow-1][gidCol]||'',CUSTOMER_GROUP_NAME:vals[foundRow-1][gnCol]||''}),NEW_VALUE:JSON.stringify({CUSTOMER_NAME:name,PHONE:phone,CUSTOMER_GROUP_ID:groupId,CUSTOMER_GROUP_NAME:groupName}),TIMESTAMP:now}); } catch(e) {}
    return { success:true, customerId:String(vals[foundRow-1][idCol]||requestedId), created:false, groupId, groupName:groupName || (groupId || 'Unmapped') };
  } catch (e) {
    bnxLogError(clientId, 'bnxSaveCreditCustomer failed: ' + e.message, payload);
    return { success:false, error:e.message };
  }
}


/* DUES 2026-10-22: open (DUE) bills grouped by party — feeds Customer Credit (Old balance / Bills due / ageing buckets)
   and the Due Collection Swift list (GET_OUTSTANDING_BILLS). Cached per bill generation for 5 min. */
/* 2026-11-16 (RUN_DueTiming: each BILL_MASTER column read costs ~2.5 s in this file; reading 10 columns = 33 s).
   Due bills are kept in a 2-hour index (row → bill no, date, customer, total, status). Each call reads only TWO columns:
   DUE_AMOUNT (who still owes, always fresh) and BILL_ID (proves every indexed row is still the same bill — archive,
   deletes or sorting are detected). Only bills that are new to the index are read (one row each, or a column block when
   there are many). Same bills, same amounts as before; ~5 s instead of ~35 s. */
function bnxDueBillCols_(sh,clientId){
  const lastRow=sh.getLastRow(), lastCol=sh.getLastColumn();
  const headers=sh.getRange(1,1,1,lastCol).getValues()[0].map(function(h){ return String(h==null?'':h); });
  if(lastRow<2) return {headers:headers,rows:[]};
  const n=lastRow-1, di=headers.indexOf('DUE_AMOUNT'), bi=headers.indexOf('BILL_ID'), ci=headers.indexOf('CLIENT_ID');
  if(di<0||bi<0) throw new Error('BILL_MASTER needs DUE_AMOUNT and BILL_ID');
  const want=['CLIENT_ID','BILL_STATUS','BILL_NUMBER','BUSINESS_DATE','BILL_DATE','CUSTOMER_ID','CUSTOMER_NAME','GRAND_TOTAL'].map(function(x){ return headers.indexOf(x); }).filter(function(i){ return i>=0; });
  const dueCol=sh.getRange(2,di+1,n,1).getValues(), idCol=sh.getRange(2,bi+1,n,1).getValues();
  const hits=[]; for(let r=0;r<n;r++){ if((parseFloat(String(dueCol[r][0]).replace(/[,₹\s]/g,''))||0)>0.009) hits.push(r); }
  const key='dueidx_v2_'+clientId, sig=want.join(',');
  let idx=null; try{ idx=JSON.parse(bnxBigCacheGet_(key)||'null'); }catch(e){ idx=null; }
  if(!idx||idx.sig!==sig||!idx.rows) idx={sig:sig,rows:{}};
  const cell=function(v){ return v instanceof Date ? Utilities.formatDate(v,bnxTz_(),'yyyy-MM-dd') : v; };
  const missing=hits.filter(function(r){ const o=idx.rows[r]; return !o||String(o.id)!==String(idCol[r][0]); });
  if(missing.length>8){
    const lo=missing[0], hi=missing[missing.length-1], m=hi-lo+1;
    missing.forEach(function(r){ idx.rows[r]={id:idCol[r][0]}; });
    want.forEach(function(i){ const vals=sh.getRange(2+lo,i+1,m,1).getValues(); missing.forEach(function(r){ idx.rows[r][i]=cell(vals[r-lo][0]); }); });
  } else {
    missing.forEach(function(r){ const v=sh.getRange(r+2,1,1,lastCol).getValues()[0], o={id:idCol[r][0]}; want.forEach(function(i){ o[i]=cell(v[i]); }); idx.rows[r]=o; });
  }
  const keep={}; hits.forEach(function(r){ keep[r]=idx.rows[r]; }); idx.rows=keep;
  try{ bnxBigCachePut_(key,JSON.stringify(idx),7200); }catch(e){}
  const rows=[];
  hits.forEach(function(r){ const o=idx.rows[r]; if(!o) return; const row=new Array(lastCol).fill('');
    Object.keys(o).forEach(function(k){ if(k!=='id') row[+k]=o[k]; }); row[bi]=idCol[r][0]; row[di]=dueCol[r][0];
    if(ci>=0&&String(row[ci])!==String(clientId)) return; rows.push(row); });
  return {headers:headers,rows:rows};
}
function bnxDueBillsByParty_(clientId){
  const key='duebills_v1_'+clientId+'_'+bnxBillGen_(clientId);
  try{ const hit=bnxBigCacheGet_(key); if(hit) return JSON.parse(hit); }catch(e){}
  const out={bills:[]};
  try{
    const sh=bnxClientSheet(clientId,SHEETS.BILL_MASTER);
    /* 2026-11-16 SPEED (traffic report: GET_DUE_COLLECTION avg 207 s). Credit bills are spread over the whole year, so the
       generic filtered reader found > 40 separate row groups and read the WHOLE BILL_MASTER (13,000 rows x 52 columns).
       Only the 10 columns the dues list uses are read now (about 5x less data). Same bills, same figures. */
    const read=bnxDueBillCols_(sh,clientId);
    read.rows.forEach(function(r){
      const b=bnxRowToObject(r,read.headers);
      if(String(b.BILL_STATUS||'').toUpperCase()==='CANCELLED') return;
      const due=parseFloat(String(b.DUE_AMOUNT).replace(/[,₹\s]/g,''))||0; if(due<=0.009) return;
      out.bills.push({billId:String(b.BILL_ID||''),billNo:String(b.BILL_NUMBER||''),date:bnxNormalizeDateKey_(b.BUSINESS_DATE||b.BILL_DATE),
        customerId:String(b.CUSTOMER_ID||'').trim().toUpperCase(),customer:String(b.CUSTOMER_NAME||'').trim(),billAmount:parseFloat(b.GRAND_TOTAL)||0,due:+due.toFixed(2)});
    });
  }catch(e){ out.error=e.message; }
  try{ bnxBigCachePut_(key,JSON.stringify(out),300); }catch(e){}
  return out;
}
function bnxAgeBucket_(days){ return days<=30?'d0_30':days<=60?'d31_60':days<=90?'d61_90':'d90p'; }
function bnxDaysSince_(ymd,today){ if(!/^\d{4}-\d{2}-\d{2}$/.test(String(ymd||''))) return 0; return Math.max(0,Math.floor((today-new Date(ymd+'T00:00:00'))/86400000)); }
function bnxGetOutstandingBills_(session,payload){
  const r=bnxGetDueCollection(session,payload||{});
  if(!r||!r.success) return r;
  const rows=[];
  (r.data.__bills||[]).forEach(function(b){ rows.push(b); });
  (r.data.customers||[]).forEach(function(c){ if(c.openingRemaining>0.009) rows.push({billId:'OPEN-'+c.customerId,billNo:'OPENING',isOpening:true,customerId:c.customerId,customer:c.customer,date:String(c.lastBillDate||'').slice(0,10),billAmount:c.openingRemaining,due:c.openingRemaining,adjusted:0}); });
  return {success:true,data:{rows:rows,total:+rows.reduce(function(s,x){return s+(+x.due||0);},0).toFixed(2)}};
}
function bnxGetDueCollection(session, payload) {
  const clientId = session.CLIENT_ID;
  const period = bnxResolveDateRange_(payload || {});
  try {
    const duesSheet = bnxClientSheet(clientId, SHEETS.CUSTOMER_DUES);
    const duesValues = duesSheet.getDataRange().getValues();
    const duesHeaders = duesValues[0];
    const custSheet = bnxClientSheet(clientId, SHEETS.CUSTOMER_MASTER);
    const custValues = custSheet.getDataRange().getValues();
    const custHeaders = custValues[0];
    const custById = {};
    for (let r = 1; r < custValues.length; r++) { const c = bnxRowToObject(custValues[r], custHeaders); custById[c.CUSTOMER_ID] = c; }
    const today = new Date();
    const rows = [];
    let totalOutstanding = 0; let overdue30 = 0;
    const dueB = bnxDueBillsByParty_(clientId), byCust = {}, nameToId = {};
    for (const id in custById) { const nm = String(custById[id].CUSTOMER_NAME || '').trim().toUpperCase().replace(/\s+/g, ' '); if (nm && !nameToId[nm]) nameToId[nm] = String(id).toUpperCase(); }
    (dueB.bills || []).forEach(function (b) {
      let id = /^CUS\d+$/i.test(b.customerId) ? b.customerId : (nameToId[String(b.customer || '').toUpperCase().replace(/\s+/g, ' ')] || '');
      if (!id) return;
      b.customerId = id; (byCust[id] = byCust[id] || []).push(b);
    });
    const aging = { d0_30: 0, d31_60: 0, d61_90: 0, d90p: 0 };
    for (let r = 1; r < duesValues.length; r++) {
      const d = bnxRowToObject(duesValues[r], duesHeaders);
      if (d.CLIENT_ID !== clientId) continue;
      const balance = Number(String(d.CURRENT_BALANCE == null ? '' : d.CURRENT_BALANCE).replace(/[,₹\s]/g, '')) || 0;
      if (balance <= 0) continue;
      const cust = custById[d.CUSTOMER_ID] || {};
      const lastDate = d.LAST_TRANSACTION_DATE ? new Date(d.LAST_TRANSACTION_DATE) : today;
      const overdueDays = Math.max(0, Math.floor((today - lastDate) / 86400000));
      totalOutstanding += balance;
      if (overdueDays >= 30) overdue30 += balance;
      const groupId = String(
        cust.CUSTOMER_GROUP_ID || cust.GROUP_ID || cust.CUSTOMER_GROUP || cust.PARTY_GROUP_ID || ''
      ).trim();
      const groupName = String(
        cust.CUSTOMER_GROUP_NAME || cust.GROUP_NAME || cust.CUSTOMER_GROUP_NAME || cust.PARTY_GROUP_NAME || ''
      ).trim();
      rows.push({
        customerId: d.CUSTOMER_ID,
        customer: cust.CUSTOMER_NAME || 'Unknown',
        phone: cust.PHONE || '',
        gstin: cust.GSTIN || cust.GST_NO || cust.GST_NUMBER || '',
        type: cust.CUSTOMER_TYPE || 'Individual',
        groupId: groupId,
        groupName: groupName || (groupId ? groupId : 'Unmapped'),
        outstanding: balance,
        lastBillDate: d.LAST_TRANSACTION_DATE || '',
        overdueDays: overdueDays
      });
      (function (c) {
        const bl = (byCust[String(d.CUSTOMER_ID || '').toUpperCase()] || []).slice().sort(function (a, b) { return String(a.date).localeCompare(String(b.date)); });
        let billsSum = bl.reduce(function (s, x) { return s + x.due; }, 0);
        const ag = { d0_30: 0, d31_60: 0, d61_90: 0, d90p: 0 };
        /* bills due can never exceed the ledger balance: newest bills count first, the rest is old balance */
        let left = Math.min(balance, billsSum), oldest = 0;
        for (let i = bl.length - 1; i >= 0 && left > 0.009; i--) { const a = Math.min(left, bl[i].due), days = bnxDaysSince_(bl[i].date, today); ag[bnxAgeBucket_(days)] += a; left -= a; oldest = Math.max(oldest, days); }
        c.billsDue = +Math.min(balance, billsSum).toFixed(2);
        c.openingRemaining = +Math.max(0, balance - c.billsDue).toFixed(2);
        c.openBills = bl.length;
        if (c.openingRemaining > 0.009) { ag[bnxAgeBucket_(overdueDays)] += c.openingRemaining; oldest = Math.max(oldest, overdueDays); }
        c.overdueDays = oldest || overdueDays;
        Object.keys(ag).forEach(function (k) { ag[k] = +ag[k].toFixed(2); aging[k] += ag[k]; });
        c.aging = ag;
      })(rows[rows.length - 1]);
    }
    let receivedToday = 0, paymentsToday = 0;
    try {
      const recSheet = bnxClientSheet(clientId, SHEETS.DUES_RECEIPT);
      const recValues = recSheet.getDataRange().getValues();
      const recHeaders = recValues[0];
      for (let r = 1; r < recValues.length; r++) {
        const rec = bnxRowToObject(recValues[r], recHeaders);
        if (rec.CLIENT_ID !== clientId) continue;
        const rd=bnxNormalizeDateKey_(rec.RECEIPT_DATE);
        if (!rd || rd < period.from || rd > period.to) continue;
        const mode = String(rec.PAYMENT_MODE || '').toUpperCase();
        const state = String(rec.STATUS || rec.RECEIPT_STATUS || '').toUpperCase();
        if (/DISCOUNT|CREDIT.?NOTE|^CN$/.test(mode) || /CANCEL|VOID|DELET|REVERSED|REJECT/.test(state)) continue;
        const amount = Number(String(rec.AMOUNT == null ? '' : rec.AMOUNT).replace(/[,₹\s]/g, '')) || 0;
        if (amount > 0) { receivedToday += amount; paymentsToday++; }
      }
    } catch (e) {}
    const groupTotals = {};
    /* Include mapped groups from CUSTOMER_MASTER even when their current
       outstanding is zero. This keeps the Edit Customer group selector usable
       instead of making groups disappear merely because they are fully paid. */
    for (let r = 1; r < custValues.length; r++) {
      const c = bnxRowToObject(custValues[r], custHeaders);
      if (String(c.CLIENT_ID || '') !== clientId) continue;
      if (c.IS_ACTIVE === false || String(c.IS_ACTIVE).toUpperCase() === 'FALSE') continue;
      const gid = String(c.CUSTOMER_GROUP_ID || c.GROUP_ID || c.CUSTOMER_GROUP || c.PARTY_GROUP_ID || '').trim();
      const name = String(c.CUSTOMER_GROUP_NAME || c.GROUP_NAME || c.PARTY_GROUP_NAME || '').trim();
      if (!gid && !name) continue;
      const key = gid || name;
      if (!groupTotals[key]) groupTotals[key] = {groupId:gid, groupName:name || gid, customerCount:0, outstanding:0, overdue30Plus:0};
    }
    rows.forEach(c => {
      const gid = String(c.groupId || '').trim();
      const key = gid || '__UNMAPPED__';
      const name = c.groupName || (gid || 'Unmapped');
      if (!groupTotals[key]) {
        groupTotals[key] = {
          groupId: gid,
          groupName: name,
          customerCount: 0,
          outstanding: 0,
          overdue30Plus: 0
        };
      }
      groupTotals[key].customerCount++;
      groupTotals[key].outstanding += Number(c.outstanding) || 0;
      if (Number(c.overdueDays) >= 30) groupTotals[key].overdue30Plus += Number(c.outstanding) || 0;
    });
    const groups = Object.values(groupTotals)
      .map(g => {
        g.outstanding = Number(g.outstanding.toFixed(2));
        g.overdue30Plus = Number(g.overdue30Plus.toFixed(2));
        return g;
      })
      .sort((a,b) => b.outstanding - a.outstanding || String(a.groupName).localeCompare(String(b.groupName)));

    return {
      success: true,
      data: {
        totalOutstanding,
        receivedToday,
        receivedInPeriod:receivedToday,
        periodFrom:period.from,
        periodTo:period.to,
        netOutstanding: totalOutstanding,
        paymentsToday,
        overdue30Plus: +rows.reduce(function (s, c) { return s + (c.aging ? c.aging.d31_60 + c.aging.d61_90 + c.aging.d90p : (c.overdueDays >= 30 ? c.outstanding : 0)); }, 0).toFixed(2),
        activeCustomers: rows.length,
        aging: { d0_30: +aging.d0_30.toFixed(2), d31_60: +aging.d31_60.toFixed(2), d61_90: +aging.d61_90.toFixed(2), d90p: +aging.d90p.toFixed(2) },
        __bills: (dueB.bills || []),
        customers: rows,
        groups: groups,
        groupMappingAvailable: groups.some(g => g.groupId || g.groupName !== 'Unmapped')
      }
    };
  } catch (error) {
    bnxLogError(clientId, `bnxGetDueCollection failed: ${error.message}`, payload);
    return { success: false, error: error.message };
  }
}

function bnxSaveDuesReceipt(session, payload) {
  const clientId = session.CLIENT_ID;
  const userId = session.USER_ID;
  const dates=['receiptDate','RECEIPT_DATE','date','paymentDate','businessDate'].map(function(k){return payload[k];}).filter(function(v){return v!=null&&String(v).trim()!=='';}).map(bnxNormalizeDateKey_);
  if(!dates.length||dates.some(function(d){return !/^\d{4}-\d{2}-\d{2}$/.test(d)||d!==dates[0];}))return {success:false,statusCode:400,error:'Select one valid receipt date; conflicting receipt dates are not allowed.'};
  const receiptDate=dates[0];
  if(bnxIsBusinessDateClosed_(clientId,receiptDate))return {success:false,statusCode:409,error:'Receipt business date '+receiptDate+' is closed.'};
  const customerId = payload.customerId || '';
