        let m = ph >= 0 ? String(v[r][ph] == null ? '' : v[r][ph]).replace(/\.0+$/, '').replace(/\D/g, '') : '';
        map[k] = [nm >= 0 ? String(v[r][nm] || '').trim() : '', m.length >= 10 ? m : ''];
      }
