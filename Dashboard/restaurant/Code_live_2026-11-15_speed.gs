    const activeOrdersRes = bnxGetActiveOrders(session, {});
    const activeOrders = (activeOrdersRes && activeOrdersRes.success) ? activeOrdersRes.data.orders : [];
    const hourlyChart = Object.keys(hourlyMap).sort().map(h => ({
