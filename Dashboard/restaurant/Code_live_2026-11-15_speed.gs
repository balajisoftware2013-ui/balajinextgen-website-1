/* ============================================================================
 * CATEGORY MASTER PERSISTENCE FIX — 2026-09-17
 * Explicit category CRUD helper. Existing SAVE_MASTER remains supported.
 * This guarantees a category selected/created by a client is written to
 * CATEGORY_MASTER with CATEGORY_ID + CATEGORY_NAME + CLIENT_ID, and avoids
 * duplicate names differing only by case/whitespace.
 * ========================================================================== */
function bnxSaveCategoryMaster_(session, payload) {
  const clientId = String(session && session.CLIENT_ID || '').trim();
  const userId = String(session && session.USER_ID || '').trim();
  if (!clientId) return {success:false,error:'Client session is required'};
  const p = payload || {};
  const name = String(p.categoryName || p.CATEGORY_NAME || p.name || p.NAME || p.category || '').trim();
  if (!name) return {success:false,error:'Category name is required'};
  try {
    const sh = bnxClientSheet(clientId, SHEETS.CATEGORY_MASTER);
    const values = sh.getDataRange().getValues();
    const headers = values[0] || [];
    const idCol = headers.indexOf('CATEGORY_ID');
    const nameCol = headers.indexOf('CATEGORY_NAME');
    const clientCol = headers.indexOf('CLIENT_ID');
    const activeCol = headers.indexOf('IS_ACTIVE');
    const wantedId = String(p.CATEGORY_ID || p.categoryId || p.id || '').trim();
    let target = -1;
    for (let r=1; r<values.length; r++) {
      if (clientCol>=0 && String(values[r][clientCol]||'').trim() !== clientId) continue;
      const existingName = nameCol>=0 ? String(values[r][nameCol]||'').trim() : '';
      const existingId = idCol>=0 ? String(values[r][idCol]||'').trim() : '';
      if ((wantedId && existingId===wantedId) || (!wantedId && existingName.toLowerCase()===name.toLowerCase())) {
        target = r; break;
      }
    }
    const id = target>=0 && idCol>=0 ? String(values[target][idCol]||'').trim() : (wantedId || generateShortId_(clientId,'CATEGORY_ID'));
    const row = target>=0 ? values[target].slice() : headers.map(function(){return '';});
    if (idCol>=0) row[idCol]=id;
    if (nameCol>=0) row[nameCol]=name;
    if (clientCol>=0) row[clientCol]=clientId;
    if (activeCol>=0) row[activeCol]=true;
    const updCol=headers.indexOf('UPDATED_AT'); if(updCol>=0) row[updCol]=new Date().toISOString();
    const createdCol=headers.indexOf('CREATED_AT'); if(target<0 && createdCol>=0) row[createdCol]=new Date().toISOString();
    if (target>=0) sh.getRange(target+1,1,1,headers.length).setValues([row]);
    else sh.getRange(sh.getLastRow()+1,1,1,headers.length).setValues([row]);
    bnxInvalidateMasterCache_(clientId);
    try { CacheService.getScriptCache().remove('posmenu_v2_'+clientId); } catch(e) {}
    try { bnxCreateAuditLog(clientId,{CLIENT_ID:clientId,USER_ID:userId,ACTION:target>=0?'UPDATE':'CREATE',MODULE:'MASTER',RECORD_TYPE:'CATEGORY',RECORD_ID:id,NEW_VALUE:JSON.stringify({CATEGORY_ID:id,CATEGORY_NAME:name}),TIMESTAMP:new Date().toISOString()}); } catch(e) {}
    return {success:true,id:id,categoryId:id,categoryName:name,updated:target>=0};
  } catch(e) {
    bnxLogError(clientId,'SAVE_CATEGORY_MASTER failed: '+e.message,p);
    return {success:false,error:e.message};
  }
}

