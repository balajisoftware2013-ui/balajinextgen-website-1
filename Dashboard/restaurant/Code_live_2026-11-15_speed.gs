    Object.keys(obj).forEach(function(k){var c=head.indexOf(k);if(c<0||obj[k]===undefined)return;if(String(vals[c])!==String(obj[k])){vals[c]=obj[k];touched=true;}});
    if(touched){sheet.getRange(rowNo,1,1,head.length).setValues([vals]);changed++;}}
