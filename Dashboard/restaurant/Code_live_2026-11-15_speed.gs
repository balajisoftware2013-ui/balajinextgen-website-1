function bnxBankTxnRole_(s){return ['ADMIN','SUPER_ADMIN','OWNER','MANAGER','ACCOUNTANT','ACCOUNTS','DEVELOPER','CASHIER'].indexOf(String(s.ROLE||'').toUpperCase())>=0;}
function bnxBankTxnImport_(session,payload){
  var cid=String(session.CLIENT_ID||''),p=payload||{},rows=Array.isArray(p.rows)?p.rows:[];
  if(!bnxBankTxnRole_(session))return {success:false,statusCode:403,error:'Import needs Manager / Accounts login'};
  if(!rows.length)return {success:false,error:'No transactions in the file'};
  if(rows.length>20000)return {success:false,error:'Max 20,000 rows per import — split the file'};
  var lock=bnxTenantLock_();if(!lock.tryLock(20000))return {success:false,retryable:true,error:'Busy — retry the import'};
  try{
    var sh=bnxBankTxnSheet_(cid),n=sh.getLastRow(),seen={};
    if(n>=2)sh.getRange(2,1,n-1,1).getValues().forEach(function(r){seen[String(r[0])]=1;});
    var now=new Date().toISOString(),add=[],skip=0,bad=0;
    rows.forEach(function(r){
      var key=String(r.key||'').slice(0,120),d=bnxNormalizeDateKey_(r.date),cr=Math.round((Number(r.credit)||0)*100)/100,dr=Math.round((Number(r.debit)||0)*100)/100;
      if(!key||!d||(!cr&&!dr)){bad++;return;}
      if(seen[key]){skip++;return;}seen[key]=1;
      var md=r.mapDate?bnxNormalizeDateKey_(r.mapDate):'';
      add.push([key,String(r.account||'').slice(0,80),d,String(r.narration||'').slice(0,300),cr,dr,String(r.mode||'OTHER').toUpperCase().slice(0,20),md||'',md?String(r.mode||'').toUpperCase().slice(0,20):'',md?'AUTO':'',String(r.ref||'').slice(0,100),String(p.file||'').slice(0,120),now,String(session.USER_ID||''),now,String(session.USER_ID||'')]);
    });
    for(var i=0;i<add.length;i+=2000){var part=add.slice(i,i+2000);sh.getRange(sh.getLastRow()+1,1,part.length,BNX_BANK_TXN_HEADERS_.length).setValues(part);}
    try{CacheService.getScriptCache().put('banktxn_gen_'+cid,String(Date.now()),21600);}catch(e){}
    return {success:true,data:{added:add.length,duplicates:skip,invalid:bad}};
  }finally{lock.releaseLock();}
}
function bnxBankTxnList_(session,payload){
  var cid=String(session.CLIENT_ID||''),p=payload||{},from=bnxNormalizeDateKey_(p.from||p.FROM_DATE),to=bnxNormalizeDateKey_(p.to||p.TO_DATE)||from;
  if(!from)return {success:false,error:'from date required'};
  var sh=bnxBankTxnSheet_(cid),n=sh.getLastRow();if(n<2)return {success:true,data:{rows:[]}};
  var shift=function(k,d){var x=new Date(k+'T12:00:00Z');x.setUTCDate(x.getUTCDate()+d);return x.toISOString().slice(0,10);};
  var lo=shift(from,-10),hi=shift(to,10),out=[];
  sh.getRange(2,1,n-1,BNX_BANK_TXN_HEADERS_.length).getValues().forEach(function(v){
    var d=bnxNormalizeDateKey_(v[2]),md=v[7]?bnxNormalizeDateKey_(v[7]):'';
    if(!((d>=lo&&d<=hi)||(md&&md>=from&&md<=to)))return;
    out.push({key:String(v[0]),account:v[1],date:d,narration:v[3],credit:Number(v[4])||0,debit:Number(v[5])||0,mode:v[6],mapDate:md,mapMode:v[8],status:v[9],note:v[10],file:v[11]});
  });
  return {success:true,data:{rows:out,from:from,to:to}};
}
function bnxBankTxnMap_(session,payload){
  var cid=String(session.CLIENT_ID||''),maps=Array.isArray(payload&&payload.maps)?payload.maps:[];
  if(!bnxBankTxnRole_(session))return {success:false,statusCode:403,error:'Mapping needs Manager / Accounts login'};
  if(!maps.length)return {success:false,error:'Nothing to map'};
  if(maps.length>3000)return {success:false,error:'Max 3,000 changes at once'};
  var lock=bnxTenantLock_();if(!lock.tryLock(15000))return {success:false,retryable:true,error:'Busy — retry'};
  try{
    var sh=bnxBankTxnSheet_(cid),n=sh.getLastRow();if(n<2)return {success:false,error:'No transactions imported yet'};
    var keys=sh.getRange(2,1,n-1,1).getValues().map(function(r){return String(r[0]);}),at={};keys.forEach(function(k,i){at[k]=i+2;});
    var now=new Date().toISOString(),done=0,missing=0;
    maps.forEach(function(m){var row=at[String(m.key||'')];if(!row){missing++;return;}
      var md=m.mapDate?bnxNormalizeDateKey_(m.mapDate):'',st=String(m.status||(md?'MAPPED':'')).toUpperCase().slice(0,12);
      sh.getRange(row,8,1,4).setValues([[md||'',md?String(m.mapMode||'').toUpperCase().slice(0,20):'',st,String(m.note==null?'':m.note).slice(0,100)]]);
      sh.getRange(row,15,1,2).setValues([[now,String(session.USER_ID||'')]]);done++;});
    return {success:true,data:{updated:done,missing:missing}};
  }finally{lock.releaseLock();}
