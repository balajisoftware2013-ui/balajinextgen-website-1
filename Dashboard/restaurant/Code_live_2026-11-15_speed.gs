   // Backup must succeed before the first cell changes. Dates include type information for recovery.
   const backup={clientId:cid,target:target,createdAt:new Date().toISOString(),cells:updates.map(function(u){return {spreadsheetId:u.sh.getParent().getId(),sheet:u.sh.getName(),row:u.row,col:u.col,value:u.old instanceof Date?u.old.toISOString():u.old,isDate:u.old instanceof Date,format:u.format};})};
   const file=DriveApp.createFile('BNX_26Oct_Billing_Backup_'+Date.now()+'.json',JSON.stringify(backup),MimeType.PLAIN_TEXT);report.backupUrl=file.getUrl();
   updates.forEach(function(u){written.push(u);const cell=u.sh.getRange(u.row,u.col);if(u.time)cell.setNumberFormat('@');cell.setValue(u.value);});
   SpreadsheetApp.flush();bnxBillGenBump_(cid);try{bnxInvalidateTodayReportCaches_(cid);}catch(e){}
  }
