  };
})();

/* ============================================================================
 * GET_BILL_ITEMS_DAY (2026-11-14) — every item line of the bills of one business day, grouped by bill number.
 * Bills List "View" used one GET_BILL_FOR_REPRINT per bill (≈10 s each on a busy server) → "Loading items & rates…".
 * Reads only the BILL_ID / BILL_DATE columns to find the day's bills, then only the BILL_ITEMS rows of those bills
 * (they sit together because rows are appended in time order). Cached 10 min per day (cleared by any bill write).
 * payload: { date: 'yyyy-MM-dd' }  →  { success, data: { date, bills: { '<BILL_NUMBER>': [items…] } } }
 * ========================================================================== */
function bnxGetBillItemsDay_(session, payload) {
  var cid = session.CLIENT_ID, day = bnxNormalizeDateKey_((payload || {}).date || '');
  if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) return { success: false, error: 'date (yyyy-MM-dd) required' };
  var key = 'billitems_day_' + cid + '_' + bnxBillGen_(cid) + '_' + day;
  try { var c = CacheService.getScriptCache().get(key); if (c) { var o = JSON.parse(c); o.cached = true; return o; } } catch (e) {}
  try {
    var bm = bnxClientSheet(cid, SHEETS.BILL_MASTER), bi = bnxClientSheet(cid, SHEETS.BILL_ITEMS);
    var mw = bm.getLastColumn(), mn = bm.getLastRow();
    var mh = bm.getRange(1, 1, 1, mw).getValues()[0].map(String);
    var cId = mh.indexOf('BILL_ID'), cNo = mh.indexOf('BILL_NUMBER'), cDt = mh.indexOf('BILL_DATE'), cCl = mh.indexOf('CLIENT_ID');
    if (cId < 0 || cNo < 0 || cDt < 0) return { success: false, error: 'BILL_MASTER headers missing' };
    var noOf = {};
    if (mn >= 2) {
      var lo = Math.min(cId, cNo, cDt, cCl < 0 ? cId : cCl), hi = Math.max(cId, cNo, cDt, cCl < 0 ? cId : cCl);
      /* 2026-11-16: read from the bottom until the day is passed (was the whole sheet) */
      var mv = bnxTailFilteredRows_(bm, [mh[cDt]],
        function (v) { return bnxNormalizeDateKey_(v[0]) === day; }, { noRows: true, chunk: 2000, older: function (v) { var d = bnxNormalizeDateKey_(v[0]); return !/^\d{4}-\d{2}-\d{2}$/.test(d) || d < day; } }).hitRows || [];
      mv = mv.length ? (function (rs) { var a = rs[0], b = rs[rs.length - 1], blk = bm.getRange(a, lo + 1, b - a + 1, hi - lo + 1).getValues(), want = {}; rs.forEach(function (x) { want[x] = 1; }); return blk.filter(function (_, k) { return want[a + k]; }); })(mv) : [];
      for (var i = 0; i < mv.length; i++) {
        var r = mv[i];
        if (cCl >= 0 && r[cCl - lo] && String(r[cCl - lo]) !== String(cid)) continue;
        if (bnxNormalizeDateKey_(r[cDt - lo]) === day && r[cId - lo]) noOf[String(r[cId - lo])] = String(r[cNo - lo]);
      }
    }
    var out = { success: true, data: { date: day, bills: {} } };
    var ids = Object.keys(noOf);
    if (ids.length && bi.getLastRow() >= 2) {
      var iw = bi.getLastColumn(), ih = bi.getRange(1, 1, 1, iw).getValues()[0].map(String), iId = ih.indexOf('BILL_ID');
      if (iId < 0) return { success: false, error: 'BILL_ITEMS: BILL_ID header missing' };
      var idw = {}; ids.forEach(function (x) { idw[x] = true; });
      var rows = (bnxTailFilteredRows_(bi, ['BILL_ID'], function (v) { return !!noOf[String(v[0])]; }, { noRows: true, chunk: 4000, ids: idw, emptyChunks: 2 }).hitRows || []).slice();   /* 2026-11-16 */
      var blocks = [];
      rows.forEach(function (rn) { var l = blocks[blocks.length - 1]; if (l && rn === l.s + l.n) l.n++; else blocks.push({ s: rn, n: 1 }); });
      blocks.forEach(function (b) {
        bi.getRange(b.s, 1, b.n, iw).getValues().forEach(function (row) {
          var it = bnxRowToObject(row, ih), no = noOf[String(it.BILL_ID)];
          if (!no) return;
          (out.data.bills[no] = out.data.bills[no] || []).push({
            name: it.ITEM_NAME, itemName: it.ITEM_NAME, qty: Number(it.QUANTITY) || 0, rate: Number(it.RATE) || 0,
            amount: Number(it.LINE_TOTAL) || 0, amt: Number(it.LINE_TOTAL) || 0,
            discount: Number(it.LINE_DISCOUNT != null && it.LINE_DISCOUNT !== '' ? it.LINE_DISCOUNT : (it.DISCOUNT_AMOUNT || it.ITEM_DISCOUNT)) || 0,
            taxRate: Number(it.TAX_RATE) || 0, taxPerItem: Number(it.TAX_PER_ITEM) || 0, itemId: it.ITEM_ID || '',
            note: it.NOTES || it.SPECIAL_INSTRUCTIONS || '', ITEM_GROUP_NAME: it.ITEM_GROUP_NAME || '', CATEGORY: it.CATEGORY || ''
          });
        });
      });
    }
    try { var j2 = JSON.stringify(out); if (j2.length < 95000) CacheService.getScriptCache().put(key, j2, 600); } catch (e) {}
    return out;
  } catch (e) { return { success: false, error: e.message }; }
}

/* ============================================================================
 * KOT_FAST_START (2026-11-14) — steward "Send KOT" prints in 1-3 s instead of 8-15 s, with REAL server KOT numbers.
 *  1. The phone sends the same payload as SAVE_ORDER (same requestId) BEFORE the order save.
 *  2. This reserves exactly one KOT number per station part (same counter, same format), remembers them for this
 *     requestId (6 h cache + script property), and — when the POS print station is online and the phone does not print
 *     itself — queues the KOT print jobs at once (same job IDs SAVE_ORDER uses, so they are never printed twice).
 *  3. SAVE_ORDER then saves the order with these numbers (bnxKotFastApply_). Calling KOT_FAST_START again with the same
 *     requestId returns the SAME numbers. If SAVE_ORDER already ran for this requestId, nothing new is reserved. No gaps.
 * ========================================================================== */
function bnxKotFastKey_(cid, rid) { return 'kotfast_' + cid + '_' + String(rid).replace(/[^A-Za-z0-9_-]/g, '').slice(0, 80); }
function bnxKotFastGet_(cid, rid) {
  var k = bnxKotFastKey_(cid, rid), v = null;
  try { v = CacheService.getScriptCache().get(k); } catch (e) {}
  if (!v) try { v = PropertiesService.getScriptProperties().getProperty(k); } catch (e) {}
  try { return v ? JSON.parse(v) : null; } catch (e) { return null; }
}
function bnxKotFastPut_(cid, rid, map, cacheOnly) {
  var k = bnxKotFastKey_(cid, rid), j = JSON.stringify(map);
  try { CacheService.getScriptCache().put(k, j, 21600); } catch (e) {}
  if (!cacheOnly) try { PropertiesService.getScriptProperties().setProperty(k, j); bnxKotFastPurge_(false); } catch (e) {}
}
/* 2026-11-16: the fast-KOT numbers were ALSO kept as one Script property per order and never removed. Script properties
   hold ~500 KB in total for the WHOLE project (tokens, WhatsApp setup, archive ids…); at 3000 orders a day the store
   fills in 1-2 days and every setProperty starts failing. Now the property is removed once the order is saved, and
   anything older than 12 h is purged (checked at most every 10 min). Run RUN_KotFastPurge once now to clear the backlog. */
function bnxKotFastDrop_(cid, rid) { try { PropertiesService.getScriptProperties().deleteProperty(bnxKotFastKey_(cid, rid)); } catch (e) {} }
function bnxKotFastPurge_(force) {
  try {
    var C = CacheService.getScriptCache(); if (!force && C.get('kotfast_purge_at')) return 0; C.put('kotfast_purge_at', '1', 600);
  } catch (e) {}
  var P = PropertiesService.getScriptProperties(), all = P.getProperties(), cut = Date.now() - 12 * 3600000, n = 0;
  Object.keys(all).forEach(function (k) {
    if (k.indexOf('kotfast_') !== 0) return;
    var at = 0; try { at = new Date(JSON.parse(all[k]).at).getTime() || 0; } catch (e) {}
    if (force || !at || at < cut) { try { P.deleteProperty(k); n++; } catch (e) {} }
  });
  return n;
}
function RUN_KotFastPurge() { var n = bnxKotFastPurge_(true); Logger.log('Removed ' + n + ' old fast-KOT entries from Script properties.'); }
/* SAVE_ORDER: copy the fast-start numbers onto the parts (the phone may have sent them already) */
function bnxKotFastApply_(session, payload) {
  try {
    if (!payload || !payload.requestId || !Array.isArray(payload.mobileKotParts)) return;
    var cid = session.CLIENT_ID, ctr = bnxCounterLock_(cid), map;
    /* 2026-11-16: when the phone gave up waiting for KOT_FAST_START (it may still be running), the save and the late fast
       start must not BOTH reserve numbers (two different KOT numbers = two kitchen tickets). Under the counter lock the
       save either takes the fast numbers or leaves a 'saving' mark that makes a late fast start step aside. */
    if (ctr) ctr.enter(20000);
    try {
      map = bnxKotFastGet_(cid, payload.requestId);
      if (!map || !map.numbers) { bnxKotFastPut_(cid, payload.requestId, { saving: true, at: new Date().toISOString() }, true); return; }
    } finally { if (ctr) ctr.exit(); }
    payload.mobileKotParts.forEach(function (p) { if (p && !p.kotNumber && map.numbers[p.type]) p.kotNumber = map.numbers[p.type]; });
  } catch (e) {}
}
function bnxKotFastStart_(session, payload) {
  payload = payload || {};
  var cid = session.CLIENT_ID, rid = String(payload.requestId || ''), parts = payload.mobileKotParts, items = payload.items || [];
  if (!rid) return { success: false, error: 'requestId required' };
  if (!Array.isArray(parts) || !parts.length || parts.length > 3) return { success: false, error: 'Invalid station split' };
  var seen = {};
  for (var i = 0; i < parts.length; i++) {
    var pt = parts[i];
    if (!pt || ['KITCHEN', 'BAR', 'HUKKA'].indexOf(pt.type) < 0 || seen[pt.type] || !Array.isArray(pt.indices) || !pt.indices.length) return { success: false, error: 'Invalid station split' };
    seen[pt.type] = 1;
    for (var j = 0; j < pt.indices.length; j++) { var ix = pt.indices[j]; if (!(ix >= 0 && ix < items.length && ix === Math.floor(ix))) return { success: false, error: 'Invalid station item index' }; }
  }
  var map = bnxKotFastGet_(cid, rid);
  if (!map) {
    /* the order is already saved (outbox retry) → its numbers came from SAVE_ORDER; reserve nothing */
    try { if (bnxSyncLogCacheGet_(cid, rid)) return { success: false, error: 'ORDER_ALREADY_SAVED', alreadySaved: true }; } catch (e) {}
    /* 2026-11-16 FAST PRINT: only the short counter lock — no longer waits 8-18 s behind other SAVE_ORDER / SAVE_BILL */
    var ctr = bnxCounterLock_(cid); ctr.enter(20000);
    try {
      map = bnxKotFastGet_(cid, rid);
      if (!map) {
        var range = bnxReserveNumberBatch_(cid, 'KOT_NUMBER', parts.length, true), n = range.from, nums = {};
        parts.forEach(function (p) { nums[p.type] = range.prefix + String(n++).padStart(range.padLength, '0'); });
        map = { numbers: nums, at: new Date().toISOString() };
        bnxKotFastPut_(cid, rid, map);
      }
    } finally { ctr.exit(); }
  }
  if (map && map.saving) return { success: false, error: 'ORDER_BEING_SAVED', alreadySaved: true };   /* SAVE_ORDER got there first: it reserves + prints */
  var native = payload.mobilePrintRoute === 'NATIVE', online = false, queued = false;
  if (!native) {
    try { online = bnxPqOnline_(cid); } catch (e) { online = false; }
    if (online) {
      var jobs = parts.map(function (p) {
        var no = map.numbers[p.type];
        return { id: ['K', cid, no, p.type, '1', ''].join('-').replace(/[^A-Za-z0-9_.:-]/g, ''), role: p.type, kotNo: no, orderNo: '',
          table: payload.tableId || payload.TABLE_ID || '', waiter: payload.waiter || payload.steward || '', covers: payload.covers || '', splitIndex: 1, splitTotal: 1,
          customerName: payload.customerName || '', remarks: payload.remarks || '', from: 'STEWARD', reprint: false,
          items: p.indices.map(function (ix) { var it = items[ix] || {}; return { name: it.name || it.ITEM_NAME || it.itemName || 'Item', qty: Number(it.qty || it.QUANTITY) || 0,
            size: it.size || it.SIZE || '', note: it.SPECIAL_INSTRUCTIONS || it.itemRemark || it.remarks || it.note || '' }; }) };
      });
      try { var q = bnxPrintApi_(session, { jobs: jobs }, 'PRINT_QUEUE_ADD'); queued = !!(q && q.success === true); } catch (e) { queued = false; }
    }
  }
  return { success: true, numbers: map.numbers, queued: queued, stationOnline: online, requestId: rid };
}

/* ============================================================================
 * RUN_FixCustomerIds (2026-11-14, "two different shown": Customer Credit ₹41,97,873 vs ageing / owner ₹43,03,565)
 * ROOT CAUSE: the 28-10-2026 dues sync created 9 credit customers with a broken ID —
 *   • 6 got an ID that already belonged to another customer (CUS00172 ROUNAK + SHUBHAM DAKSH, CUS00174, 175, 176, 177, 182)
 *   • 3 got NO ID (RAHUL/ABHINAV ₹11,488 · PPRATIK/ DAGAPUR ₹84,454 · ABHISEK/ ATISH ₹9,750 = ₹1,05,692)
 *   The Customer Credit total skips rows without an ID, and a shared ID merges two people.
 * FIX (run once from the editor, safe to run again): every second customer on a shared ID and every customer without
 * an ID gets its own new CUS number in CUSTOMER_MASTER, and the same customer (matched by ID + name) is updated in
 * CUSTOMER_DUES, CUSTOMER_DUES_BILLWISE, DUES_RECEIPT, BILL_MASTER, SALES_LEDGER and PAYMENT_MASTER. Nothing else changes.
 * ========================================================================== */
function RUN_FixCustomerIds() {
  var cid = 'CL00010', nm = function (v) { return String(v || '').trim().replace(/\s+/g, ' ').toUpperCase(); };
  var sheet = function (n) { try { return bnxClientSheet(cid, n); } catch (e) { return null; } };
  var cm = sheet('CUSTOMER_MASTER'); if (!cm) throw new Error('CUSTOMER_MASTER not found');
  var mv = cm.getDataRange().getValues(), mh = mv[0].map(function (x) { return String(x).trim().toUpperCase(); });
  var mI = mh.indexOf('CUSTOMER_ID'), mN = mh.indexOf('CUSTOMER_NAME');
  var max = 0, seen = {}, byName = {}, remap = [], log = [];
  mv.slice(1).forEach(function (r) { var m = String(r[mI] || '').match(/^CUS(\d+)$/); if (m) max = Math.max(max, Number(m[1])); });
  var next = function () { max++; return 'CUS' + String(max).padStart(5, '0'); };
  /* 1. CUSTOMER_MASTER: second customer on a shared ID → new ID */
  for (var i = 1; i < mv.length; i++) {
    var id = String(mv[i][mI] || '').trim(), n = nm(mv[i][mN]); if (!n) continue;
    if (id && !seen[id]) { seen[id] = n; byName[n] = byName[n] || id; continue; }
    if (id && seen[id] === n) continue;                                   /* same person listed twice: leave */
    var nid = next(); cm.getRange(i + 1, mI + 1).setValue(nid);
    remap.push({ old: id, name: n, id: nid }); byName[n] = nid; log.push('MASTER ' + (id || '(no id)') + ' ' + n + ' → ' + nid);
  }
  var idFor = function (old, name) {
    var n = nm(name); if (!n) return '';
    for (var k = 0; k < remap.length; k++) if (remap[k].old === old && remap[k].name === n) return remap[k].id;
    if (!old && noId[n]) return byName[n] || '';   /* only the dues customers that had no ID — never walk-in bills */
    return '';
  };
  var noId = {};
  /* 2. transaction sheets: same ID + same name → new ID; no ID → ID by name (new master row when unknown) */
  var masterAdd = function (name) {
    var nid = next(), row = mh.map(function (h) { return h === 'CUSTOMER_ID' ? nid : h === 'CUSTOMER_NAME' ? name : h === 'CLIENT_ID' ? cid : h === 'IS_ACTIVE' ? true : h === 'CUSTOMER_TYPE' ? 'Individual' : h === 'CREATED_AT' || h === 'UPDATED_AT' ? new Date() : h === 'SOURCE' ? 'ID_FIX' : ''; });
    cm.appendRow(row); byName[nm(name)] = nid; log.push('MASTER new ' + name + ' → ' + nid); return nid;
  };
  [['CUSTOMER_DUES', 'CUSTOMER_NAME', true], ['CUSTOMER_DUES_BILLWISE', 'PARTY', false], ['DUES_RECEIPT', 'CUSTOMER_NAME', false],
   ['BILL_MASTER', 'CUSTOMER_NAME', false], ['SALES_LEDGER', 'CUSTOMER_NAME', false], ['PAYMENT_MASTER', 'CUSTOMER_NAME', false]].forEach(function (t) {
    var sh = sheet(t[0]); if (!sh || sh.getLastRow() < 2) return;
    var h = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0].map(function (x) { return String(x).trim().toUpperCase(); });
    var cI = h.indexOf('CUSTOMER_ID'), nI = h.indexOf(t[1]); if (cI < 0 || nI < 0) return;
    var n = sh.getLastRow() - 1, ids = sh.getRange(2, cI + 1, n, 1).getValues(), names = sh.getRange(2, nI + 1, n, 1).getValues(), ch = 0;
    for (var r = 0; r < n; r++) {
      var old = String(ids[r][0] || '').trim(), nmv = names[r][0]; if (!nm(nmv)) continue;
      if (!old && t[2]) noId[nm(nmv)] = 1;
      var nid = idFor(old, nmv);
      if (!nid && !old && t[2]) nid = masterAdd(nm(nmv));                 /* dues row with no ID: customer needs one */
      if (nid && nid !== old) { ids[r][0] = nid; ch++; }
    }
    if (ch) { sh.getRange(2, cI + 1, n, 1).setValues(ids); log.push(t[0] + ': ' + ch + ' row(s)'); }
  });
  try { CacheService.getScriptCache().removeAll(['dues_' + cid, 'duesasof_v1_' + cid]); } catch (e) {}
  try { bnxLiveGenBump_(cid); } catch (e) {}
  Logger.log((log.length ? log.join('\n') : 'Nothing to fix — every customer has its own ID.') + '\nOpen Customer Credit → total must be ₹43,03,565.');
}

/* 2026-11-16 RUN_LockWho — who keeps the restaurant lock busy. Watches it for 60 s (every 2 s) and lists every hold
   longer than 5 s from the last 6 h: time · action · seconds. Changes nothing. Edit LOCKWHO_CID for another client. */
var LOCKWHO_CID = 'CL00010';
function RUN_LockWho() {
  var c = CacheService.getScriptCache(), keys = ['bnxtl_v1_' + LOCKWHO_CID, 'bnxctr_v1_' + LOCKWHO_CID, 'bnxpql_v1_' + LOCKWHO_CID], L = [];
  var names = { 0: 'SAVE lock', 1: 'COUNTER lock', 2: 'PRINT lock' };
  L.push('═══ Holds longer than 5 s (latest first, last 6 h) ═══');
  keys.forEach(function (k, i) { var ls = []; try { ls = JSON.parse(c.get('bnxtl_slow_' + k) || '[]'); } catch (e) {}
    L.push(names[i] + ': ' + (ls.length ? '' : 'none'));
    ls.forEach(function (x) { L.push('   ' + x[0] + '  ' + x[1] + '  ' + x[2] + ' s'); }); });
  L.push('', '═══ Live, every 2 s for 60 s ═══');
  for (var n = 0; n < 30; n++) {
    var row = keys.map(function (k, i) { var v = c.get(k); if (!v) return names[i] + ': free'; var p = v.split('|'); return names[i] + ': ' + (p[1] || '?') + ' ' + (p[2] ? Math.round((Date.now() - Number(p[2])) / 1000) + ' s' : ''); });
    L.push(Utilities.formatDate(new Date(), 'Asia/Kolkata', 'HH:mm:ss') + '  ' + row.join('  |  '));
    Utilities.sleep(2000);
  }
  Logger.log('\n' + L.join('\n'));
}

/* 2026-11-16 RUN_SPEED_2_RemoveRowColourRules — speed check: reading ONE column of BILL_MASTER took 16.5 s.
   Every tab of the TRANSACTION DB carries a conditional-format rule =MOD(ROW(),2)=0 over its whole data range
   (BILL_ITEMS 2 million cells, ORDER_ITEMS 1.1 million, BILL_MASTER 0.7 million) plus a filter over the whole range.
   Sheets re-evaluates that formula rule on every change, which slows every read and every save.
   This removes ONLY rules whose formula is MOD(ROW(),2)=0 (the zebra colour) and the filter on each tab, for the
   TRANSACTION and MASTER DB of each client below. No values, no other rules, no formats are touched.
   Run once after service. Safe to run again. */
var SPEED2_CLIENTS = ['CL00010', 'CL00011'];
function RUN_SPEED_2_RemoveRowColourRules() {
  var L = [];
  SPEED2_CLIENTS.forEach(function (cid) {
    var ids = {}; try { ids = bnxGetClientDbIds_(cid) || {}; } catch (e) {}
    var P = PropertiesService.getScriptProperties();
    var list = [['TRANSACTION', ids.TRANSACTION || P.getProperty('CRM_TRANSACTIONS_ID_' + cid) || P.getProperty('TRANSACTION_DB_ID_' + cid)], ['MASTER', ids.MASTER || P.getProperty('MASTER_DB_ID_' + cid)]];
    list.forEach(function (d) {
      if (!d[1]) { L.push(cid + ' ' + d[0] + ': id not found'); return; }
      var ss; try { ss = SpreadsheetApp.openById(d[1]); } catch (e) { L.push(cid + ' ' + d[0] + ': cannot open ' + e.message); return; }
      var rules = 0, filters = 0;
      ss.getSheets().forEach(function (sh) {
        try {
          var cf = sh.getConditionalFormatRules(), keep = cf.filter(function (r) {
            var b = r.getBooleanCondition(); if (!b) return true;
            var v = (b.getCriteriaValues() || []).join(' ').replace(/\s+/g, '').toUpperCase();
            return !/^=?MOD\(ROW\(\),2\)=[01]$/.test(v);
          });
          if (keep.length !== cf.length) { rules += cf.length - keep.length; sh.setConditionalFormatRules(keep); }
          var f = sh.getFilter(); if (f) { f.remove(); filters++; }
        } catch (e) { L.push('  ' + sh.getName() + ': ' + e.message); }
      });
      L.push(cid + ' ' + d[0] + ' (' + ss.getName() + '): removed ' + rules + ' zebra rules, ' + filters + ' filters on ' + ss.getSheets().length + ' tabs');
    });
  });
  Logger.log('\n' + L.join('\n') + '\nNow run RUN_SPEED_1_Check again (after service) and compare "Read BILL_DATE column".');
}

