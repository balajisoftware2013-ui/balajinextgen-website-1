    let ordersPlaced = 0;
    const orderTypeCounts = { DINEIN:0, TAKEAWAY:0, DELIVERY:0, OTHER:0 };
    try {
      const orderSheet = bnxClientSheet(clientId, SHEETS.ORDER_MASTER);
