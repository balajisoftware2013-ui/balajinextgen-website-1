function bnxNormalizeDateKey_(value) {
  if (value === null || value === undefined || value === '') return '';
  if (value instanceof Date) {
    return isNaN(value.getTime()) ? '' : Utilities.formatDate(value, bnxTz_(), 'yyyy-MM-dd');
  }
  const s = String(value).trim();
  if (!s) return '';
  // fast path: already yyyy-MM-dd[...]
  if (s.length >= 10 && s.charCodeAt(4) === 45 && s.charCodeAt(7) === 45) {
    const m0 = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
    if (m0) return m0[1] + '-' + (m0[2].length === 1 ? '0' + m0[2] : m0[2]) + '-' + (m0[3].length === 1 ? '0' + m0[3] : m0[3]);
  }
  let m = s.match(/^(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})(?:[ T].*)?$/);
  if (m) return m[1] + '-' + String(Number(m[2])).padStart(2, '0') + '-' + String(Number(m[3])).padStart(2, '0');
  m = s.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{4})(?:[ T].*)?$/);
  if (m) return m[3] + '-' + String(Number(m[2])).padStart(2, '0') + '-' + String(Number(m[1])).padStart(2, '0');
  return s;
}

