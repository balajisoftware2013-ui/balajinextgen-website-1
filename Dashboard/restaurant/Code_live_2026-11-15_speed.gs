/* ===== 2026-10-29 DSR CLIENT SUPPORT ===================================================================================== */
function bnxRdSwiftTab_(session,tab){
  var cid=String(session.CLIENT_ID||''),ss=bnxPqDb_(cid,'TRANSACTION'),want=String(tab).trim().toLowerCase().replace(/[^a-z]/g,'');
  var sh=ss.getSheetByName(tab);
  if(!sh){var all=ss.getSheets();for(var i=0;i<all.length;i++){if(all[i].getName().toLowerCase().replace(/[^a-z]/g,'')===want){sh=all[i];break;}}}
  if(!sh)return {success:false,error:'Sheet '+tab+' not found in the transaction database'};
  var lr=sh.getLastRow(),lc=sh.getLastColumn();if(lr<1||lc<1)return {success:true,data:[],tab:sh.getName()};
  var key='rdswift_v2_'+cid+'_'+want+'_'+lr+'_'+lc;   /* v2: old cache held the shifted times */
  try{var hit=bnxBigCacheGet_(key);if(hit)return JSON.parse(hit);}catch(e){}
  /* 2026-11-14 ROOT FIX ("Swift transaction time 13.5 h ahead"): a sheet cell holds the wall-clock time in the SPREADSHEET's
     time zone (this TRANSACTION DB = America/Los_Angeles). It was printed in the SCRIPT time zone (Asia/Kolkata), so
     22-10 23:59 showed as 23-10 13:29 (PST→IST = +13 h 30). Print it in the sheet's own zone = exactly what the cell shows. */
  var tz=ss.getSpreadsheetTimeZone()||Session.getScriptTimeZone()||'Asia/Kolkata';
  var v=sh.getRange(1,1,lr,lc).getValues().map(function(r){return r.map(function(x){return x instanceof Date?Utilities.formatDate(x,tz,'yyyy-MM-dd HH:mm:ss'):x;});});
  while(v.length&&v[v.length-1].every(function(x){return x===''||x==null;}))v.pop();
  var out={success:true,data:v,tab:sh.getName(),rows:v.length};
  try{bnxBigCachePut_(key,JSON.stringify(out),3600);}catch(e){}   /* 2026-11-14: 10 min → 1 h (RD_FETCH_SHEET 306 s); key has row + column count, so a new import refreshes it at once */
  return out;
}
/* DATED GUEST DUES for the DSR ("opening / month opening / closing outstanding sometimes shown, sometimes not").
   closing(D) = current balance − Σ DSR dues movement of the days after D; opening(D) = closing(D) − movement(D);
   monthOpening = closing(end of previous month); yearOpening = closing(31 Mar). Cached until the next posting. */
function bnxDuesAsOf_(session,ds,current){
  var cid=String(session.CLIENT_ID),today=bnxBusinessDateKey_();
  if(!/^\d{4}-\d{2}-\d{2}$/.test(ds)||!Number.isFinite(current))return {};
  if(ds>today)ds=today;
  var key='duesasof_v1_'+cid+'_'+(function(){try{return CacheService.getScriptCache().get('livegen_'+cid)||'0';}catch(e){return '0';}})()+'_'+ds;
  try{var hit=CacheService.getScriptCache().get(key);if(hit)return JSON.parse(hit);}catch(e){}
  var fyStart=(Number(ds.slice(0,4))-(Number(ds.slice(5,7))<4?1:0))+'-04-01';
  var net={},y=Number(fyStart.slice(0,4)),m=4,ty=Number(today.slice(0,4)),tm=Number(today.slice(5,7));
  for(var guard=0;guard<30&&(y<ty||(y===ty&&m<=tm));guard++){
    var res=bnxGetDsrMatrix(session,{year:y,month:m});
    if(!res||!res.success||!res.data||!res.data.byDay)throw new Error('DSR month '+y+'-'+m+' unavailable');
    var mm=String(m).padStart(2,'0');
    Object.keys(res.data.byDay).forEach(function(d){var x=res.data.byDay[d]||{};net[y+'-'+mm+'-'+String(d).padStart(2,'0')]=(Number(x.guestDueSales)||0)-(Number(x.dueReceivedCash)||0)-(Number(x.dueReceivedIcici)||0)-(Number(x.guestDuesCN)||0);});
    if(++m>12){m=1;y++;}
  }
  var days=Object.keys(net).sort();
  function closingAt(d){var t=current;days.forEach(function(k){if(k>d&&k<=today)t-=net[k];});return Math.round(t*100)/100;}
  var prevMonthEnd=(function(){var x=new Date(ds.slice(0,8)+'01T12:00:00Z');x.setUTCDate(0);return x.toISOString().slice(0,10);})();
  var fyEnd=(function(){var x=new Date(fyStart+'T12:00:00Z');x.setUTCDate(0);return x.toISOString().slice(0,10);})();
  var closing=closingAt(ds),out={asOfDate:ds,outstandingAsOf:closing,openingAsOf:Math.round((closing-(net[ds]||0))*100)/100,
    monthOpening:closingAt(prevMonthEnd),yearOpening:closingAt(fyEnd),dayNet:Math.round((net[ds]||0)*100)/100,asOfMethod:'rollback'};
  try{CacheService.getScriptCache().put(key,JSON.stringify(out),600);}catch(e){}
  return out;
}


