  if(!bnxBankTxnRole_(session))return {success:false,statusCode:403,error:'Mapping needs Manager / Accounts / Cashier login'};
  if(!list.length)return {success:false,error:'Nothing to save'};
  if(list.length>5000)return {success:false,error:'Max 5,000 changes at once'};
  var lock=bnxTenantLock_();if(!lock.tryLock(15000))return {success:false,retryable:true,error:'Busy — retry'};
  try{
    var sh=bnxSwiftMapSheet_(cid),n=sh.getLastRow(),W=BNX_SWIFT_MAP_HEADERS_.length;
    var vals=n>=2?sh.getRange(2,1,n-1,W).getValues():[],at={};vals.forEach(function(v,i){at[String(v[0])]=i;});
    var now=new Date().toISOString(),user=String(session.USER_ID||''),add=[],upd=0,del={},bad=0;
    list.forEach(function(r){
      var key=String(r.key||'').trim().slice(0,140);if(!key){bad++;return;}
      if(r.remove===true){if(at[key]!==undefined)del[at[key]]=1;return;}
      var to=String(r.to||'').toUpperCase().replace(/[^A-Z]/g,'').slice(0,12),d=r.date?bnxNormalizeDateKey_(r.date):'';
      if(to&&['POS','DUE','EXCL','REVIEW','BANK','FEE'].indexOf(to)<0){bad++;return;}
      var row=[key,to,d||'',String(r.payer==null?'':r.payer).trim().slice(0,80),String(r.status==null?'':r.status).trim().slice(0,30),String(r.note==null?'':r.note).slice(0,200),
        String(r.mode||'').toUpperCase().slice(0,12),Math.round((Number(r.amount)||0)*100)/100,String(r.txnDate||'').slice(0,19),String(r.ref||'').slice(0,80),String(r.source||'').toUpperCase().slice(0,12),now,user];
      if(at[key]!==undefined){vals[at[key]]=row;upd++;}else{at[key]=vals.length+add.length;add.push(row);}
    });
    if(upd)sh.getRange(2,1,vals.length,W).setValues(vals);
    for(var i=0;i<add.length;i+=2000){var part=add.slice(i,i+2000);sh.getRange(sh.getLastRow()+1,1,part.length,W).setValues(part);}
    var dk=Object.keys(del).map(Number).sort(function(a,b){return b-a;});dk.forEach(function(i){sh.deleteRow(i+2);});
    try{CacheService.getScriptCache().put('swiftmap_gen_'+cid,String(Date.now()),21600);}catch(e){}
    return {success:true,data:{added:add.length,updated:upd,removed:dk.length,invalid:bad,at:now}};
  }finally{lock.releaseLock();}
}


/* ============================================================================
 * COSTING & PROFIT (2026-10-29: "today all cost or any event or party can cost add … profit can check or bills profit …
 * electric meter reading daily … singer / event / DJ / hotel / travelling cost … proper costing every party or every day").
 * TRANSACTION DB sheets (created on first use): COST_ENTRY · EVENT_MASTER · METER_READING. Settings: script property.
 *   COSTING_REPORT {from,to,basis?}  → day P&L, party / event P&L, bill profit, cost lines, meter readings
 *   COSTING_LIST   {from,to}         → events / meters / costs only (dialogs)
 *   COSTING_SAVE   {kind:'cost'|'event'|'meter'|'cfg', row|cfg}
 * Item cost of a bill line: recipe cost per portion → item purchase / cost rate (Item Master, Bar item master) → estimate % of the
 * line (⚙️ food % / bar %) → none (counted and shown as "no cost rate").
 * ========================================================================== */
var BNX_COST_H_={
  COST_ENTRY:['COST_ID','COST_DATE','CATEGORY','AMOUNT','EVENT_ID','VENDOR','DESCRIPTION','PAY_MODE','CASH_MOVEMENT_ID','CREATED_AT','CREATED_BY','UPDATED_AT','UPDATED_BY'],
  EVENT_MASTER:['EVENT_ID','EVENT_DATE','EVENT_NAME','EVENT_TYPE','PARTY_NAME','CONTACT','GUESTS','PACKAGE_AMOUNT','ADVANCE','TABLES','BILL_NOS','NOTE','CREATED_AT','CREATED_BY','UPDATED_AT','UPDATED_BY'],
  METER_READING:['READ_DATE','METER','OPEN_READING','CLOSE_READING','UNITS','RATE','COST','UPDATED_AT','UPDATED_BY']
