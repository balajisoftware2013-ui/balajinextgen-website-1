function bnxCostingSave_(session,payload){
  var cid=String(session.CLIENT_ID||''),p=payload||{},kind=String(p.kind||''),user=String(session.USER_ID||''),now=new Date().toISOString();
  if(!bnxCostRole_(session))return {success:false,statusCode:403,error:'Costing needs Owner / Manager / Accounts login'};
  if(kind==='cfg'){
    var c=p.cfg||{},cur=bnxCostCfg_(cid);
    var n={foodPct:Math.max(0,Math.min(100,Number(c.foodPct)||0)),barPct:Math.max(0,Math.min(100,Number(c.barPct)||0)),unitRate:Math.max(0,Number(c.unitRate)||cur.unitRate||0),
      meters:(Array.isArray(c.meters)?c.meters:String(c.meters||'').split(',')).map(function(x){return String(x).trim().slice(0,30);}).filter(String).slice(0,12),basis:c.basis==='purchase'?'purchase':'item'};
    if(!n.meters.length)n.meters=['Main'];
    PropertiesService.getScriptProperties().setProperty('costing_cfg_'+cid,JSON.stringify(n));bnxCostBump_(cid);
    return {success:true,data:{cfg:n}};
  }
  var lock=bnxTenantLock_();if(!lock.tryLock(15000))return {success:false,retryable:true,error:'Busy — retry'};
  try{
    var r=p.row||{},res;
