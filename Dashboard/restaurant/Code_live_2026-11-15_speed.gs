 }catch(e){
  for(let i=written.length-1;i>=0;i--){const u=written[i];try{u.sh.getRange(u.row,u.col).setNumberFormat(u.format).setValue(u.old);}catch(re){Logger.log('Restore required: '+u.sh.getName()+' row '+u.row+' col '+u.col);}}
  throw e;
 }finally{lock.releaseLock();}
}


/* =====================================================================================================
 * PATCH 2026-10-27 — SAVE / EDIT / PRINT AUDIT FIX          (Balaji NextGen ERP V2_CORE, CL00010)
 * INSTALL: paste this whole block at the VERY END of Code.gs (after the 2026-10-27 "RUN_28" block).
 *          Nothing earlier is edited. Then Deploy > Manage deployments > edit > New version.
 *          Optional one-time: run RUN_29_InstallPrintQueuePruneTrigger once.
 *
 * Every override below is an assignment (X = function...) so it replaces the earlier definition
 * after all earlier wrappers have loaded. All earlier behaviour that is not listed is unchanged.
 *
 *  F1  UPDATE_ORDER_STATUS rejected PROGRESS / BILLED / NC / CONFIRMED / ACCEPTED ("Unsupported order status").
 *      The KDS, steward app and billing flow send exactly these -> every call failed and sat in the retry outbox.
 *      Also: steward sends the KOT number as orderId -> "Order not found". Now resolved through KOT_MASTER.
 *      KOT_MASTER.KOT_STATUS is now updated too (KDS/Chef screens showed old status after reload).
 *  F2  Order edit / cancel / status each read the WHOLE ORDER_MASTER (12k rows) and WHOLE ORDER_ITEMS (49k rows),
 *      twice (find + table refresh). Now exact-key lookups only.
 *  F3  Steward order with 3 stations did 3 separate PRINT_QUEUE_ADD calls (3 lock + sheet opens). Now one call.
 *      Print actions are exempt from the business-day lock. BNX_PRINT_QUEUE can be pruned (it only ever grew).
 *  F4  Payments written as 'PAID' (settlement, imports) were invisible to payment sums and to VOID reversal
 *      (code only counted 'SUCCESS'): over-payment possible, void left money live. Now both counted.
 *  F5  Bill edit: scanned whole LEDGER_ENTRIES + DUES_RECEIPT, looked the bill up by reading all of BILL_MASTER,
 *      and let an edit through after a credit bill had been settled (reference 'Bill NO | ID' was not matched).
 *  F6  Report caches never hit: the cache key included requestId / sessionToken, which differ on every call.
 *  F7  BATCH_EXECUTE sent each sub-action's fields inside "data", so every handler saw an empty payload.
 * ===================================================================================================== */

/* ---------- shared ---------- */
var BNX_P27_STATUS_OK_ = /^(NEW|OPEN|RUNNING|KOT_PRINTED|PENDING|PROGRESS|IN_PROGRESS|COOKING|PREPARING|CONFIRMED|ACCEPTED|READY|SERVED|BILLED|NC|COMPLETED|CANCELLED|CANCELED)$/;
BNX_ORDER_OPEN_NOT_ = /^(COMPLETED|CANCELLED|CANCELED|BILLED|VOID|VOIDED|SETTLED|PAID|CLOSED|NC)$/i;
bnxOrder26Closed_ = function (o) { return /^(BILLED|CANCELLED|CANCELED|COMPLETED|CLOSED|SETTLED|PAID|VOID|NC)$/.test(String(o && o.ORDER_STATUS || '').toUpperCase()); };

function bnxP27Locked_(fn) {
  return function () {
    var lock = bnxTenantLock_(), held = lock.hasLock();
    if (!held && !lock.tryLock(10000)) return { success: false, statusCode: 503, retryable: true, error: 'Another order change is saving; retry the same request' };
    try { return fn.apply(this, arguments); } finally { if (!held) { try { lock.releaseLock(); } catch (e) {} } }
  };
}

/* ---------- F2: exact-key order lookup (was: full ORDER_MASTER read) ---------- */
function bnxP27Find_(session, p) {
  var ref = String(p.orderId || p.ORDER_ID || p.orderNumber || p.ORDER_NUMBER || p.orderNo || '').trim();
  if (!ref) throw Error('orderId is required');
