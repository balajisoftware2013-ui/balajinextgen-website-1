  if (!nums.length) return;
  const dataRows = lastRow - 1;
  if (nums.length >= dataRows) {                                    // everything goes: never ask Sheets to delete all non-frozen rows
    sheet.getRange(2, 1, dataRows, Math.max(1, sheet.getLastColumn())).clearContent();
    return;
  }
  let i = 0;
  while (i < nums.length) {
    const start = nums[i];
    let cnt = 1;
    while (i + cnt < nums.length && nums[i + cnt] === start - cnt) cnt++;
    sheet.deleteRows(start - cnt + 1, cnt);
    i += cnt;
  }
}

function bnxCellKey_(v) {
