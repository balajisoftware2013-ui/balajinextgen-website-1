  if (replace.length) { var rm = bnxi24_removeImported_(tdb, replace); res.written.push(rm.msg); res.written.push(bnxi24_writeDsr_(tdb, rm.dsr)); }

  /* write — masters first so every ITEM_ID / CUSTOMER_ID exists before the bills */
  if (newItemList.length) res.written.push('MASTER ' + bnxi24_appendRows_(mdb, 'ITEM_MASTER', 'ITEM_ID', newItemList));
  if (newCus.length) res.written.push('MASTER ' + bnxi24_appendRows_(mdb, 'CUSTOMER_MASTER', 'CUSTOMER_ID', newCus));
  [['ORDER_MASTER', 'ORDER_ID', OM], ['ORDER_ITEMS', 'ORDER_ITEM_ID', OI], ['BILL_MASTER', 'BILL_ID', BM], ['BILL_ITEMS', 'BILL_ITEM_ID', BI],
   ['PAYMENT_MASTER', 'PAYMENT_ID', PAY], ['SALES_LEDGER', 'SALES_LEDGER_ID', SL]].forEach(function (x) { res.written.push(bnxi24_appendRows_(tdb, x[0], x[1], x[2])); });
  res.written.push(bnxi24_writeDsr_(tdb, dsr));
  SpreadsheetApp.flush();
  return res;
}

/* DSR_ITEM_GROUP_DAILY: add to an existing bnxi24_day row, else append a new one */
function bnxi24_writeDsr_(ss, dsr) {
  var t = bnxi24_readSheet_(ss, 'DSR_ITEM_GROUP_DAILY', 'BUSINESS_DATE');
  if (!t) return 'DSR_ITEM_GROUP_DAILY: sheet not found (skipped)';
  var tz = ss.getSpreadsheetTimeZone(), idx = {}, upd = 0, add = [];
  t.rows.forEach(function (r, i) {
    var v = r.BUSINESS_DATE; var k = v instanceof Date ? Utilities.formatDate(v, tz, 'yyyy-MM-dd') : String(v).trim();
    var m = k.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})$/); if (m) k = m[3] + '-' + bnxi24_pad_(m[2], 2) + '-' + bnxi24_pad_(m[1], 2);
    if (k) idx[k] = i;
  });
  var F = ['BEVERAGE', 'FOOD', 'HUKKA', 'LIQUOR', 'TAX', 'BILLS', 'NET_SALE', 'CASH', 'CARD', 'ONLINE', 'CREDIT', 'OTHERS', 'ROUND_OFF', 'LIQUOR_MRP'];
  Object.keys(dsr).sort().forEach(function (d) {
    var x = dsr[d];
    if (idx[d] !== undefined) {
      var row = t.hr + 1 + idx[d], cur = t.rows[idx[d]];
      F.concat(['ITEM_SALES_TOTAL']).forEach(function (f) {
        var c = t.hdr.indexOf(f); if (c < 0) return;
        var add_ = f === 'ITEM_SALES_TOTAL' ? x.BEVERAGE + x.FOOD + x.HUKKA + x.LIQUOR : x[f];
        t.sh.getRange(row, c + 1).setValue(bnxi24_R2_(bnxi24_N_(cur[f]) + add_));
      });
      upd++;
    } else {
      var o = { BUSINESS_DATE: d, ITEM_SALES_TOTAL: bnxi24_R2_(x.BEVERAGE + x.FOOD + x.HUKKA + x.LIQUOR) };
      F.forEach(function (f) { o[f] = bnxi24_R2_(x[f]); });
      add.push(o);
    }
  });
  if (add.length) bnxi24_appendRows_(ss, 'DSR_ITEM_GROUP_DAILY', 'BUSINESS_DATE', add);
  return 'DSR_ITEM_GROUP_DAILY: +' + add.length + ' bnxi24_day(s), ' + upd + ' updated';
}

/* delete every row that belongs to the given imported BILL_IDs; returns the negative DSR delta */
function bnxi24_removeImported_(ss, billIds) {
  var tz = ss.getSpreadsheetTimeZone(), B = {}, dsr = {}, dateOf = {}, orderIds = {}, msg = [];
  billIds.forEach(function (id) { B[id] = 1; });
  function bnxi24_day(v) { return v instanceof Date ? Utilities.formatDate(v, tz, 'yyyy-MM-dd') : String(v).slice(0, 10); }
  function bnxi24_D(d) { return dsr[d] = dsr[d] || { BEVERAGE: 0, FOOD: 0, HUKKA: 0, LIQUOR: 0, TAX: 0, BILLS: 0, NET_SALE: 0, CASH: 0, CARD: 0, ONLINE: 0, CREDIT: 0, OTHERS: 0, ROUND_OFF: 0, LIQUOR_MRP: 0 }; }
  var bm = bnxi24_readSheet_(ss, 'BILL_MASTER', 'BILL_ID', ['BILL_ID', 'ORDER_ID', 'BILL_DATE', 'TAX_AMOUNT', 'SERVICE_CHARGE_GST_AMOUNT', 'GRAND_TOTAL', 'SERVICE_CHARGE_AMOUNT', 'ROUND_OFF']);
  bm.rows.forEach(function (r) {
    if (!B[r.BILL_ID]) return; var d = bnxi24_day(r.BILL_DATE), x = bnxi24_D(d); dateOf[r.BILL_ID] = d; if (r.ORDER_ID) orderIds[r.ORDER_ID] = 1;
    x.TAX -= bnxi24_N_(r.TAX_AMOUNT) + bnxi24_N_(r.SERVICE_CHARGE_GST_AMOUNT); x.BILLS -= 1; x.NET_SALE -= bnxi24_N_(r.GRAND_TOTAL); x.OTHERS -= bnxi24_N_(r.SERVICE_CHARGE_AMOUNT); x.ROUND_OFF -= bnxi24_N_(r.ROUND_OFF);
  });
  var bi = bnxi24_readSheet_(ss, 'BILL_ITEMS', 'BILL_ITEM_ID', ['BILL_ID', 'TAXABLE_PER_ITEM', 'ITEM_GROUP_NAME', 'ITEM_NAME', 'CATEGORY']);
  bi.rows.forEach(function (r) {
    if (!B[r.BILL_ID] || !dateOf[r.BILL_ID]) return; var x = bnxi24_D(dateOf[r.BILL_ID]), g = String(r.ITEM_GROUP_NAME || 'FOOD').toUpperCase(); if (g === 'TOBACCO') g = 'HUKKA';
    var v = bnxi24_N_(r.TAXABLE_PER_ITEM); x[g] = (x[g] || 0) - v;
    if (g === 'LIQUOR' && (/\bMRP\b|\bBTL\b/i.test(String(r.ITEM_NAME)) || r.CATEGORY === 'SALES LIQUOR')) x.LIQUOR_MRP -= v;
  });
  var pm = bnxi24_readSheet_(ss, 'PAYMENT_MASTER', 'PAYMENT_ID', ['BILL_ID', 'PAYMENT_MODE', 'AMOUNT']);
  pm.rows.forEach(function (r) {
    if (!B[r.BILL_ID] || !dateOf[r.BILL_ID]) return; var m = String(r.PAYMENT_MODE).toUpperCase(), k = m === 'UPI' ? 'ONLINE' : m;
    if (bnxi24_D(dateOf[r.BILL_ID])[k] !== undefined) dsr[dateOf[r.BILL_ID]][k] -= bnxi24_N_(r.AMOUNT);
  });
  [['ORDER_MASTER', 'ORDER_ID', 'ORDER_ID', orderIds], ['ORDER_ITEMS', 'ORDER_ITEM_ID', 'ORDER_ID', orderIds], ['BILL_MASTER', 'BILL_ID', 'BILL_ID', B],
   ['BILL_ITEMS', 'BILL_ITEM_ID', 'BILL_ID', B], ['PAYMENT_MASTER', 'PAYMENT_ID', 'BILL_ID', B], ['SALES_LEDGER', 'SALES_LEDGER_ID', 'BILL_ID', B]].forEach(function (x) {
    msg.push(x[0] + ' -' + bnxi24_deleteWhere_(ss, x[0], x[1], x[2], x[3]));
  });
  return { dsr: dsr, msg: 'Re-import removed old copy: ' + msg.join(', ') };
}
function bnxi24_deleteWhere_(ss, name, keyHeader, col, set) {
  var t = bnxi24_readSheet_(ss, name, keyHeader, [col]); if (!t) return 0;
  var rows = [];
  t.rows.forEach(function (r, i) { if (set[String(r[bnxi24_H_(col)])]) rows.push(t.hr + 1 + i); });
  for (var i = rows.length - 1; i >= 0;) {           // delete bottom-up in contiguous blocks
    var end = rows[i], start = end;
    while (i > 0 && rows[i - 1] === start - 1) { i--; start--; }
    t.sh.deleteRows(start, end - start + 1); i--;
  }
  return rows.length;
}

/* Client asset sync 2026-10-25. Private Drive JSON; tenant comes only from verified session.
 * Integrated in doPost: do not install another copy of this handler.
 */
function bnxAssetSyncV25_(session,p,action){
  var ver='BNX_ClientAssets v25',lock=null;
  try{
    var cid=String(session&&session.CLIENT_ID||'').trim();
    if(!cid)throw new Error('Verified client session required');
    if(action==='SAVE_CLIENT_ASSETS'&&['ADMIN','SUPER_ADMIN','OWNER','MANAGER','DEVELOPER'].indexOf(String(session.ROLE||'').toUpperCase())<0)
      return {success:false,ver:ver,error:'Asset settings require an administrator'};
    p=p||{};
    var props=PropertiesService.getScriptProperties(),prefix='BNX_ASSETS_V25_'+encodeURIComponent(cid)+'_',keys=['LOGO','BANNER','UPI','ITEMIMGS'];
    function read(key){
      var id=props.getProperty(prefix+key);if(!id)return null;
      var doc=JSON.parse(DriveApp.getFileById(id).getBlob().getDataAsString('UTF-8'));
      if(doc.clientId!==cid||doc.key!==key)throw new Error('Asset tenant mismatch');
      return doc;
    }
    if(action==='GET_CLIENT_ASSETS'){
      /* 2026-11-14 SPEED ROOT FIX ("GET_CLIENT_ASSETS 959 s server time", avg response 46 s): every call downloaded all 4 asset
         files from Drive (logo / banner / UPI QR as base64 images, item-photo map — MBs) just to compare their updatedAt with
         what the dashboard already has. The stamp is now kept in a script property (+_AT): when the dashboard's copy is current
         the answer is "unchanged" with NO Drive read. Small documents are also cached 6 h. Legacy files are read once to learn
         their stamp. */
      var data={},cache=CacheService.getScriptCache();
      keys.forEach(function(key){
        if(!props.getProperty(prefix+key))return;
        var at=props.getProperty(prefix+key+'_AT');
        if(at&&p.have&&String(p.have[key])===at){data[key]={unchanged:true,updatedAt:at};return;}
        var hit=at?cache.get('ca25_'+cid+'_'+key+'_'+at):null;
        if(hit){try{data[key]=JSON.parse(hit);return;}catch(e){}}
        var doc=read(key);if(!doc)return;
        if(at!==doc.updatedAt){try{props.setProperty(prefix+key+'_AT',doc.updatedAt);}catch(e){}}
        data[key]=p.have&&String(p.have[key])===doc.updatedAt?{unchanged:true,updatedAt:doc.updatedAt}:Object.assign({},doc.value,{updatedAt:doc.updatedAt});
        if(!data[key].unchanged){try{var txt=JSON.stringify(data[key]);if(txt.length<90000)cache.put('ca25_'+cid+'_'+key+'_'+doc.updatedAt,txt,21600);}catch(e){}}
      });return {success:true,ver:ver,data:data};
    }
    if(action!=='SAVE_CLIENT_ASSETS')throw new Error('Unsupported asset action');
    var changes={},remove=Array.isArray(p.remove)?p.remove:[];
    remove.forEach(function(key){if(keys.indexOf(key)<0)throw new Error('Invalid asset key');});
    function image(v){v=String(v||'');if(v&&!/^data:image\/(png|jpeg|jpg|webp|gif);base64,[A-Za-z0-9+/=\r\n]+$/.test(v))throw new Error('Use a PNG, JPEG, WEBP or GIF image');if(v.length>6000000)throw new Error('Image exceeds 6 MB encoded limit');return v;}
    ['logo','banner'].forEach(function(k){if(p[k])changes[k.toUpperCase()]={dataUrl:image(p[k].dataUrl)};});
    if(p.upi){var u=p.upi,meta={};['vpa','pn','tr','mc'].forEach(function(k){meta[k]=String(u[k]||'').slice(0,250);});
      if(meta.vpa&&!/^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$/.test(meta.vpa))throw new Error('Invalid UPI ID');
      ['enabled','onInvoice','onEstimate'].forEach(function(k){meta[k]=u[k]!==false;});meta.posMode=u.posMode==='native'?'native':'image';
      changes.UPI={meta:meta,dataUrl:image(u.img)};
    }
    if(p.itemimgs){var patch=p.itemimgs.patch;if(!patch||typeof patch!=='object'||Array.isArray(patch))throw new Error('Invalid item image patch');
      Object.keys(patch).forEach(function(k){if(!k||k.length>300||['__proto__','constructor','prototype'].indexOf(k)>=0||!/^https:\/\//i.test(String(patch[k])))throw new Error('Invalid item image link');});
    }
    if(!Object.keys(changes).length&&!p.itemimgs&&!remove.length)throw new Error('No assets supplied');
    lock=bnxTenantLock_();if(!lock.tryLock(10000)){lock=null;return {success:false,ver:ver,error:'Asset save busy; retry',retryable:true};}
    if(p.itemimgs){var old=read('ITEMIMGS'),map=old&&old.value&&old.value.json?JSON.parse(old.value.json):{};
      Object.keys(p.itemimgs.patch).forEach(function(k){map[k]=String(p.itemimgs.patch[k]);});changes.ITEMIMGS={json:JSON.stringify(map)};}
    var saved={},removed=[];
    remove.forEach(function(key){if(changes[key])throw new Error('Cannot save and remove the same asset');});
    var folderKey=prefix+'FOLDER',folderId=props.getProperty(folderKey),folder;
    if(Object.keys(changes).length){
      folder=folderId?DriveApp.getFolderById(folderId):DriveApp.createFolder('BNX_CLIENT_ASSETS_'+cid);
      if(!folderId)props.setProperty(folderKey,folder.getId());
    }
    Object.keys(changes).forEach(function(key){var stamp=new Date().toISOString(),body=JSON.stringify({clientId:cid,key:key,updatedAt:stamp,value:changes[key]});
      if(body.length>6500000)throw new Error('Asset payload too large');
      var id=props.getProperty(prefix+key);
      if(id){var previous=read(key);DriveApp.getFileById(id).setContent(body);}
      else {var file=folder.createFile(key+'.json',body,MimeType.PLAIN_TEXT);props.setProperty(prefix+key,file.getId());}
      saved[key]=stamp;try{props.setProperty(prefix+key+'_AT',stamp);}catch(e){}   /* 2026-11-14: stamp for the no-Drive GET */
    });
    // Removing the index does not destroy the stored file, allowing manual recovery.
    remove.forEach(function(key){props.deleteProperty(prefix+key);try{props.deleteProperty(prefix+key+'_AT');}catch(e){}removed.push(key);});
    return {success:true,ver:ver,saved:saved,removed:removed};
  }catch(e){return {success:false,ver:ver,error:String(e&&e.message||e)};}
  finally{if(lock)lock.releaseLock();}
}

// Selected receipt date only. CREATED_AT is never used as the received date.
function bnxGetDueReceiptPeriodFast_(session, payload) {
  const clientId = String(session.CLIENT_ID || ''), p = payload || {};
  const from = bnxNormalizeDateKey_(p.from || p.FROM_DATE), to = bnxNormalizeDateKey_(p.to || p.TO_DATE) || from;
  if (!from || !to || from > to) return {success:false,error:'Select a valid receipt period'};
  try {
    const drSheet = bnxClientSheet(clientId, SHEETS.DUES_RECEIPT), drTz = drSheet.getParent().getSpreadsheetTimeZone() || Session.getScriptTimeZone();   /* 2026-11-14: sheet zone, not script zone (times were 13.5 h off) */
    const values = bnxReadWindow_(drSheet,['RECEIPT_DATE'],from,to);
    const headers = values[0] || [], dateCol = headers.indexOf('RECEIPT_DATE');
    if (dateCol < 0) return {success:false,error:'DUES_RECEIPT is missing RECEIPT_DATE'};
    const rows = [];
    for (let i = 1; i < values.length; i++) {
      const date = bnxNormalizeDateKey_(values[i][dateCol]);
      if (!date || date < from || date > to) continue;
      const o = bnxRowToObject(values[i], headers);
      if (o.CLIENT_ID && String(o.CLIENT_ID) !== clientId) continue;
      if (/CANCEL|VOID|DELET|REVERSE|FAILED/i.test(String(o.STATUS || ''))) continue;
      o.RECEIPT_DATE = date;
      Object.keys(o).forEach(function(k){if(o[k] instanceof Date)o[k]=Utilities.formatDate(o[k],drTz,'yyyy-MM-dd HH:mm:ss');});
      rows.push(o);
    }
    return {success:true,data:{rows:rows,totalCount:rows.length,hasMore:false,from:from,to:to}};
  } catch (e) {return {success:false,error:e.message};}
}

// Batch only the prepared order/KOT item rows. Lock covers the append range allocation and write only.
