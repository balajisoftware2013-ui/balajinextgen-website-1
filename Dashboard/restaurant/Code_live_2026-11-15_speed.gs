    return { success: false, error: 'ADMIN_AUTH_REQUIRED', message: 'Only ADMIN, SUPER_ADMIN or DEVELOPER can delete an invoice.' };
  const billNumber = String(payload.billNumber || payload.BILL_NUMBER || payload.invoiceNo || payload.invoiceNumber || '').trim();
  const confirmNumber = String(payload.confirmBillNumber || payload.confirmInvoiceNumber || payload.confirm || '').trim();
  const reason = String(payload.reason || payload.REASON || '').trim();
  if (!billNumber) return { success: false, error: 'billNumber is required' };
  if (!confirmNumber || confirmNumber !== billNumber) return { success: false, error: 'INVOICE_CONFIRMATION_REQUIRED', message: 'Enter the exact invoice number to confirm deletion.' };
  if (!reason) return { success: false, error: 'DELETE_REASON_REQUIRED', message: 'Deletion reason is required.' };
  return bnxVoidBill(session, { billNumber: billNumber, reason: reason, adminDelete: true, confirmBillNumber: confirmNumber, actionMode: 'DELETE' });
}

