   if(!o.BILL_ID){report.warnings.push('Bill row '+(i+2)+' has no BILL_ID');return;}
   billIds[String(o.BILL_ID)]={stamp:d.getTime(),bill:o};
   report.bills.push({id:o.BILL_ID,no:o.BILL_NUMBER,total:o.GRAND_TOTAL});
   queue(bm,i,o,'BILL_DATE',target,false);queue(bm,i,o,'BILL_TIME',Utilities.formatDate(d,'Asia/Kolkata','HH:mm:ss'),true);
  });
  const pay=read(SHEETS.PAYMENT_MASTER);
  pay.rows.forEach(function(row,i){const o=object(pay,row),b=billIds[String(o.BILL_ID)],d=bnx28Stamp_(o.CREATED_AT);
   if(!own(o)||!b||!d||Math.abs(d.getTime()-b.stamp)>120000||/settlement|due.*rece|collection/i.test(String(o.REFERENCE||'')))return;
   queue(pay,i,o,'PAYMENT_DATE',target,false);queue(pay,i,o,'PAYMENT_TIME',Utilities.formatDate(d,'Asia/Kolkata','HH:mm:ss'),true);
  });
  const sl=read(SHEETS.SALES_LEDGER||'SALES_LEDGER');
  sl.rows.forEach(function(row,i){const o=object(sl,row);if(own(o)&&billIds[String(o.BILL_ID)])queue(sl,i,o,'BUSINESS_DATE',target,false);});
  [{name:SHEETS.ORDER_MASTER,date:'ORDER_DATE',time:'ORDER_TIME'},{name:SHEETS.KOT_MASTER||'KOT_MASTER',date:'KOT_DATE',time:'KOT_TIME'}].forEach(function(cfg){
   const t=read(cfg.name);t.rows.forEach(function(row,i){const o=object(t,row),d=bnx28Stamp_(o.CREATED_AT);if(!own(o)||!d||bnx28BusinessDay_(d)!==target)return;
    queue(t,i,o,cfg.date,target,false);queue(t,i,o,cfg.time,Utilities.formatDate(d,'Asia/Kolkata','HH:mm:ss'),true);
   });
  });
