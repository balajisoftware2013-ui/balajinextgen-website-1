    const cols=['CLIENT_ID'].concat(dateCols,keys,special,p.source==='items'?['BILL_ID']:[]).filter(function(v,i,a){return a.indexOf(v)===i;});
    function val(v,k){return v[cols.indexOf(k)];}
    const rr=bnxReadFilteredRows_(sh,cols,function(v){
      if(String(v[0])!==cid)return false;
      if(bills&&!bills[String(val(v,'BILL_ID'))])return false;
      if(dateCols.length){let d='';for(let i=0;i<dateCols.length&&!d;i++)d=bnxNormalizeDateKey_(val(v,dateCols[i]));if(!d||d<range.from||d>range.to)return false;}
      if(p.source==='bills'){
        const status=String(val(v,'BILL_STATUS')||'').toUpperCase(),pay=String(val(v,'PAYMENT_STATUS')||'').toUpperCase();
        if(p.report==='cancelled-bills'&&!/^(CANCELLED|VOID)$/.test(status))return false;
        if(p.report==='nc-report'&&!/^(NC|NON_CHARGE|NO_CHARGE|COMPLIMENTARY|NOT_REQUIRED)$/.test(status)&&pay!=='NOT_REQUIRED')return false;
        if(p.report==='discount'&&!((Number(val(v,'ITEM_DISCOUNT'))||0)+(Number(val(v,'BILL_DISCOUNT'))||0)>0))return false;
        if(p.report==='parcel'&&!/TAKEAWAY|PARCEL|DELIVERY/i.test(String(val(v,'BILL_TYPE')||'')))return false;
      }
      return keys.every(function(k){return String(val(v,k)).trim().toUpperCase()===String(filters[k]).trim().toUpperCase();});
    });
    const offset=Math.max(0,Math.floor(Number(p.offset)||0)),limit=Math.min(100,Math.max(1,Math.floor(Number(p.limit)||50)));
    const rows=rr.rows.slice(offset,offset+limit).map(function(r){const o=bnxRowToObject(r,rr.headers);if(bills){const b=bills[String(o.BILL_ID)];o.BILL_NUMBER=b.BILL_NUMBER;o.BUSINESS_DATE=b.BUSINESS_DATE||b.BILL_DATE;}return o;});
    return {success:true,data:{source:p.source,sheet:cfg[0],from:range.from,to:range.to,filters:filters,rows:rows,total:rr.rows.length,offset:offset,limit:limit,hasMore:offset+rows.length<rr.rows.length}};
  }catch(e){return {success:false,error:e.message};}
}
/* Exact-key server-side lookups avoid transferring the entire item table for one reprint. */
function bnxBillExactRows_(sheet,column,value){
 const n=sheet.getLastRow(),w=sheet.getLastColumn();
 if(!n||!w)return [];
 const h=sheet.getRange(1,1,1,w).getValues()[0].map(String),c=h.indexOf(column);
 if(c<0)throw new Error(sheet.getName()+': '+column+' header missing');
 if(n<2)return [];
 const hits=sheet.getRange(2,c+1,n-1,1).createTextFinder(String(value)).matchEntireCell(true).findAll();
 const rowNos=hits.map(x=>x.getRow()).sort((a,b)=>a-b),blocks=[];
 rowNos.forEach(r=>{const last=blocks[blocks.length-1];if(last&&r===last.start+last.count)last.count++;else blocks.push({start:r,count:1});});
 const out=[];blocks.forEach(block=>sheet.getRange(block.start,1,block.count,w).getValues().forEach(row=>out.push(bnxRowToObject(row,h))));
 return out;
}
function bnxGetBillForReprint(session,payload){
 const cid=session.CLIENT_ID,p=payload||{},id=String(p.billId||p.BILL_ID||''),no=String(p.billNumber||p.BILL_NUMBER||'');
 if(!id&&!no)return {success:false,error:'billNumber or billId required'};
 try{
  const found=bnxBillExactRows_(bnxClientSheet(cid,SHEETS.BILL_MASTER),id?'BILL_ID':'BILL_NUMBER',id||no).filter(b=>String(b.CLIENT_ID)===String(cid));
  if(found.length!==1)return {success:false,error:found.length?'Duplicate bill reference: reconcile before opening.':'Bill not found'};
  const bill=found[0];bill.BILLING_USER_NAME=String(bill.BILLING_USER_NAME||'Not recorded');bill.BILL_TIME=bnxBillTimeText_(bill.BILL_TIME);bill.BILL_DATE=bnxNormalizeDateKey_(bill.BILL_DATE);
  if(bill.BUSINESS_DATE)bill.BUSINESS_DATE=bnxNormalizeDateKey_(bill.BUSINESS_DATE);
  function children(name){return bnxBillExactRows_(bnxClientSheet(cid,name),'BILL_ID',bill.BILL_ID).filter(row=>!row.CLIENT_ID||String(row.CLIENT_ID)===String(cid));}
  const items=children(SHEETS.BILL_ITEMS).map(i=>Object.assign({},i,{
   name:i.ITEM_NAME,qty:Number(i.QUANTITY)||0,rate:Number(i.RATE)||0,amount:Number(i.LINE_TOTAL)||0,
   discount:Number(i.LINE_DISCOUNT??i.DISCOUNT_AMOUNT??i.ITEM_DISCOUNT)||0,
   taxRate:Number(i.TAX_RATE)||0,taxPerItem:Number(i.TAX_PER_ITEM)||0,
   size:i.SIZE||i.SERVING_SIZE||'',note:i.NOTES||i.SPECIAL_INSTRUCTIONS||'',itemId:i.ITEM_ID||''
  }));
  if(!items.length&&Number(bill.GRAND_TOTAL)>0)return {success:false,error:'BILL_ITEMS_MISSING',message:'Saved bill has no item rows. Restore original bill details before reprinting.',billNumber:bill.BILL_NUMBER};
  const payments=children(SHEETS.PAYMENT_MASTER).map(i=>Object.assign({},i,{mode:i.PAYMENT_MODE,amount:Number(i.AMOUNT)||0,status:i.PAYMENT_STATUS||i.STATUS||''}));
  return {success:true,data:{bill,items,payments}};
 }catch(e){return {success:false,error:e.message};}
}

/* ============================================================================
 * STAY-LOGIN-TILL-LOGOUT + FAST SESSION (2026-10-21)
 * ----------------------------------------------------------------------------
 * ROOT CAUSES of "Session expired / log in again" while the user never logged out:
 *  1. bnxVerifySessionUncached_ returned null for ANY exception ("Service Spreadsheets
 *     failed while accessing document", quota, lock) -> doPost answered 401 "Invalid or
 *     expired session" for a perfectly valid login. Now: exception = SERVER_BUSY (retry),
 *     and the last good verification (6 h) is used while Sheets is unavailable.
 *  2. USER_MASTER keeps ONE token per user. Logging in on a second device/tab (PC + phone,
 *     dashboard + steward app) overwrote it and silently killed the first device.
 *     Every verified token is now remembered (Script Properties) and stays valid until
 *     LOGOUT_SESSION, the user is disabled/blocked, or the user's SESSION cell is cleared.
 *  3. The 60 s cache forced a full USER_MASTER scan + schema check every minute per device.
 *     Now 10 min (revocation is immediate through LOGOUT_SESSION).
 * This block is declared LAST, so it replaces the earlier bnxVerifySession definitions.
 * ========================================================================== */
var BNX_SESS_CACHE_S_ = 600, BNX_SESS_GOOD_S_ = 21600, BNX_TOK_PREFIX_ = 'bnxtok_', BNX_TOK_MAX_ = 400, BNX_TOK_IDLE_MS_ = 60 * 86400000;

function bnxVerifySession(sessionToken, clientId) {
  const token = String(sessionToken || '').trim();
  const requested = String(clientId || '').trim();
  if (!token) return null;
  const cache = CacheService.getScriptCache();
  try { if (cache.get('sessrev_' + token)) return null; } catch (e) {}
  const key = 'sess_v2_' + token + '_' + requested;
  try { const c = cache.get(key); if (c) { const s = JSON.parse(c); s.timestamp = Date.now(); return s; } } catch (e) {}
  const r = bnxVerifySessionCore_(token, requested);
  if (r.session) {
    const j = JSON.stringify(r.session);
    try { cache.put(key, j, BNX_SESS_CACHE_S_); cache.put('sessgood_v2_' + token + '_' + requested, j, BNX_SESS_GOOD_S_); } catch (e) {}
    bnxRememberToken_(token, r.session, r.remembered);
    return r.session;
  }
  if (r.transient) {
    try { const g = cache.get('sessgood_v2_' + token + '_' + requested); if (g) { const s = JSON.parse(g); s.timestamp = Date.now(); s.FROM_LAST_GOOD = true; return s; } } catch (e) {}
    return { __transient: true, error: r.error || 'transient' };
  }
  return null;
}
/* kept for any older caller */
function bnxVerifySessionUncached_(sessionToken, clientId) {
  const r = bnxVerifySessionCore_(String(sessionToken || '').trim(), String(clientId || '').trim());
  return r.session || null;
}

/* -> {session} valid | {invalid:true} | {transient:true,error} */
function bnxVerifySessionCore_(token, requestedClient) {
  const UUID_PATTERN = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
  if (!UUID_PATTERN.test(token)) return { invalid: true };
  let values;
  try {
    const sh = SpreadsheetApp.openById(CLIENT_MASTER_DB_ID).getSheetByName('USER_MASTER');
    if (!sh) return { transient: true, error: 'USER_MASTER not reachable' };
    values = sh.getDataRange().getValues();
  } catch (e) {
    console.error('[AUTH] USER_MASTER read failed (treated as busy, login kept): ' + e.message);
    return { transient: true, error: e.message };
  }
  if (!values || !values.length) return { transient: true, error: 'USER_MASTER empty' };
  const headers = values[0].map(function (h) { return String(h || '').trim().toUpperCase(); });
  const idx = function () { for (let i = 0; i < arguments.length; i++) { const p = headers.indexOf(String(arguments[i]).toUpperCase()); if (p >= 0) return p; } return -1; };
  const C = { session: idx('SESSION', 'SESSION_TOKEN', 'ERP_SESSION'), client: idx('CLIENT_ID'), user: idx('USER_ID', 'EMP_ID'), role: idx('ROLE', 'USER_ROLE'),
    name: idx('FULL_NAME', 'NAME'), status: idx('STATUS'), web: idx('WEB_ACCESS') };
  if (C.client < 0) return { invalid: true };

  /* legacy deployments whose USER_MASTER has no session column */
  if (C.session < 0) {
    if (!requestedClient) return { invalid: true };
    try {
      const dbIds = bnxSessionDbIds_(requestedClient);
      return { session: { CLIENT_ID: requestedClient, USER_ID: token, ROLE: 'STAFF', IS_GLOBAL_ADMIN: false, DB_IDS: dbIds, timestamp: Date.now() } };
    } catch (e) { return { transient: true, error: e.message }; }
  }

  let row = null, remembered = false;
  for (let r = 1; r < values.length; r++) { if (String(values[r][C.session] || '').trim() === token) { row = values[r]; break; } }
  if (!row) {
    /* token was replaced by a newer login on another device -> still valid until logout */
    const mem = bnxRecallToken_(token);
    if (!mem) return { invalid: true };
    for (let r = 1; r < values.length; r++) {
      const v = values[r];
      if (String(v[C.client] || '').trim() !== mem.c) continue;
      if (C.user >= 0 && String(v[C.user] || '').trim() !== mem.u) continue;
      row = v; break;
    }
    if (!row) return { invalid: true };
    if (!String(row[C.session] || '').trim()) { bnxForgetToken_(token); return { invalid: true }; }   /* SESSION cell cleared = logged out */
    remembered = true;
  }
  const rowClient = String(row[C.client] || '').trim();
  if (!rowClient) return { invalid: true };
  const status = C.status >= 0 ? String(row[C.status] || 'ACTIVE').trim().toUpperCase() : 'ACTIVE';
  if (status && ['ACTIVE', 'YES', 'ENABLED'].indexOf(status) === -1) { bnxForgetToken_(token); return { invalid: true }; }
  const web = C.web >= 0 ? String(row[C.web] || 'YES').trim().toUpperCase() : 'YES';
  if (['NO', 'FALSE', 'BLOCKED', 'DISABLED'].indexOf(web) !== -1) { bnxForgetToken_(token); return { invalid: true }; }
  const role = C.role >= 0 ? String(row[C.role] || 'STAFF').trim().toUpperCase() : 'STAFF';
  const isGlobalAdmin = role === 'SUPER_ADMIN' || role === 'DEVELOPER';
  if (requestedClient && requestedClient !== rowClient && !isGlobalAdmin) return { invalid: true };
  let effectiveClient = rowClient;
  try {
    if (isGlobalAdmin && requestedClient && requestedClient !== rowClient) {
      if (!bnxGetClientRegistryRow_(requestedClient)) return { invalid: true };
      effectiveClient = requestedClient;
    }
    const dbIds = bnxSessionDbIds_(effectiveClient);
    return { remembered: remembered, session: { CLIENT_ID: effectiveClient, AUTH_CLIENT_ID: rowClient, USER_ID: C.user >= 0 ? String(row[C.user] || '').trim() : '',
      ROLE: role, FULL_NAME: C.name >= 0 ? String(row[C.name] || '').trim() : '', IS_GLOBAL_ADMIN: isGlobalAdmin, DB_IDS: dbIds, timestamp: Date.now() } };
  } catch (e) {
    console.error('[AUTH] client routing failed (treated as busy, login kept): ' + e.message);
    return { transient: true, error: e.message };
  }
}
function bnxSessionDbIds_(clientId) {
  let dbIds;
  try { dbIds = bnxGetClientDbIds_(clientId); }
  catch (routeErr) { dbIds = bnxEnsureClientDatabasesProvisioned_(clientId).databases; }
  try { bnxEnsureClientSchema_(clientId); } catch (schemaErr) { console.error('[TENANT AUTO-REPAIR] ' + clientId + ': ' + schemaErr.message); }
  return dbIds;
}

/* ---- remembered tokens (Script Properties: survives cache eviction and redeploys) ---- */
function bnxRecallToken_(token) {
  try { const v = PropertiesService.getScriptProperties().getProperty(BNX_TOK_PREFIX_ + token); return v ? JSON.parse(v) : null; } catch (e) { return null; }
}
function bnxRememberToken_(token, s, wasRemembered) {
  try {
    const cache = CacheService.getScriptCache(), mark = 'tokseen_' + token;
    if (cache.get(mark)) return;                                   /* at most one write per token per 6 h */
    cache.put(mark, '1', 21600);
    const props = PropertiesService.getScriptProperties();
    props.setProperty(BNX_TOK_PREFIX_ + token, JSON.stringify({ u: String(s.USER_ID || ''), c: String(s.AUTH_CLIENT_ID || s.CLIENT_ID || ''), t: Date.now() }));
    if (Math.random() < 0.05) bnxPruneTokens_(props);
  } catch (e) {}
}
function bnxForgetToken_(token) {
  try { PropertiesService.getScriptProperties().deleteProperty(BNX_TOK_PREFIX_ + token); } catch (e) {}
}
function bnxPruneTokens_(props) {
  try {
    const all = props.getProperties(), now = Date.now(), list = [];
    Object.keys(all).forEach(function (k) { if (k.indexOf(BNX_TOK_PREFIX_) !== 0) return; let t = 0; try { t = JSON.parse(all[k]).t || 0; } catch (e) {} list.push([k, t]); });
    list.sort(function (a, b) { return b[1] - a[1]; });
    list.forEach(function (e, i) { if (i >= BNX_TOK_MAX_ || now - e[1] > BNX_TOK_IDLE_MS_) props.deleteProperty(e[0]); });
  } catch (e) {}
}
/* explicit logout from any app: the token stops working immediately */
function bnxLogoutSession_(sessionToken) {
  const token = String(sessionToken || '').trim();
  if (!token) return { success: true };
  try { CacheService.getScriptCache().put('sessrev_' + token, '1', 21600); } catch (e) {}
  bnxForgetToken_(token);
  return { success: true, loggedOut: true };
}


/* ============================================================================
 * GET_TABLE_FLOOR (2026-10-21) — the router called bnxGetTableFloor_ but the
 * function was not in this build: every call threw "bnxGetTableFloor_ is not
 * defined" (live console), so Table Management / POS table picker fell back to
 * slow secondary reads on every refresh. Light read: TABLE_MASTER + the small
 * TABLE_LIVE_STATE tab + only 4 columns of ORDER_MASTER for the last 2 days.
 * ========================================================================== */
function bnxGetTableFloor_(session, payload) {
  const clientId = String(session.CLIENT_ID);
  try {
    const tm = bnxClientSheet(clientId, SHEETS.TABLE_MASTER || 'TABLE_MASTER').getDataRange().getValues();
    const th = (tm[0] || []).map(function (h) { return String(h || '').trim(); });
    const live = {};
    try {
      const lv = bnxClientSheet(clientId, SHEETS.TABLE_LIVE_STATE || 'TABLE_LIVE_STATE').getDataRange().getValues();
      const lh = (lv[0] || []).map(function (h) { return String(h || '').trim(); });
      for (let r = 1; r < lv.length; r++) {
        const o = bnxRowToObject(lv[r], lh);
        if (o.CLIENT_ID && String(o.CLIENT_ID) !== clientId) continue;
        const k = String(o.TABLE_NO || '').trim().toUpperCase(); if (k) live[k] = o;
      }
    } catch (e) {}
    const running = {}, openIdsByTable = {};let activeReadOk=false;
    try {
      const osh = bnxClientSheet(clientId, SHEETS.ORDER_MASTER);
      const rr = bnxReadFilteredRows_(osh, ['CLIENT_ID', 'ORDER_STATUS'], function (v) {
        if (String(v[0]) !== clientId) return false;
        return !/^(COMPLETED|CANCELLED|CANCELED|VOID|VOIDED|SETTLED|PAID|CLOSED|BILLED|NC)$/i.test(String(v[1] || '').trim());
      });
      activeReadOk=true;
      rr.rows.forEach(function (row) {
        const o = bnxRowToObject(row, rr.headers), k = String(o.TABLE_ID || '').trim().toUpperCase(); if (!k) return;
        const prev = running[k];
        if (!prev || String(o.CREATED_AT || '') > String(prev.CREATED_AT || '')) running[k] = o;
        if (o.ORDER_ID) (openIdsByTable[k] || (openIdsByTable[k] = [])).push(String(o.ORDER_ID));
      });
    } catch (e) {}
    /* 2026-10-28 ("table management: bill amount AND taxable value"): running orders' item lines, read by exact order ID
       only (open orders = a few rows). amount = sum of LINE_TOTAL (incl. GST), taxable = qty x rate - line discount. */
    const valueByOrder = {};
    try {
      const oids = {}; Object.keys(openIdsByTable).forEach(function (k) { openIdsByTable[k].forEach(function (id) { oids[id] = true; }); });
      if (Object.keys(oids).length) {
        const iv = bnxOp38Ids_(bnxClientSheet(clientId, SHEETS.ORDER_ITEMS), 'ORDER_ID', oids), ih = iv[0] || [];
        for (let r = 1; r < iv.length; r++) {
          const it = bnxRowToObject(iv[r], ih);
          if (/CANCEL|VOID/i.test(String(it.ITEM_STATUS || ''))) continue;
          const n = function (v) { return Number(String(v == null ? '' : v).replace(/,/g, '')) || 0; };
          const q = n(it.QUANTITY), rate = n(it.RATE), disc = n(it.LINE_DISCOUNT), tx = Math.max(0, q * rate - disc);
          const v = valueByOrder[String(it.ORDER_ID)] || (valueByOrder[String(it.ORDER_ID)] = { amount: 0, taxable: 0 });
          v.taxable += tx; v.amount += n(it.LINE_TOTAL) || tx;
        }
      }
    } catch (e) {}
    const tables = [];
    for (let r = 1; r < tm.length; r++) {
      const t = bnxRowToObject(tm[r], th);
      if (t.CLIENT_ID && String(t.CLIENT_ID) !== clientId) continue;
      if (['FALSE', 'NO', '0', 'INACTIVE'].indexOf(String(t.IS_ACTIVE == null ? '' : t.IS_ACTIVE).trim().toUpperCase()) !== -1) continue;
      const no = String(t.TABLE_NUMBER || t.TABLE_ID || '').trim(); if (!no) continue;
      const key = no.toUpperCase(), lsr = live[key] || live[String(t.TABLE_ID || '').toUpperCase()] || {}, ord = running[key] || running[String(t.TABLE_ID || '').toUpperCase()] || null;
      const tv = { amount: 0, taxable: 0 }; (openIdsByTable[key] || openIdsByTable[String(t.TABLE_ID || '').toUpperCase()] || []).forEach(function (id) { const v = valueByOrder[id]; if (v) { tv.amount += v.amount; tv.taxable += v.taxable; } });
      let status = String(lsr.STATUS || '').trim().toUpperCase() || 'AVAILABLE';
      if (ord) status = 'RUNNING';
      else if (activeReadOk && /^(OCCUPIED|RUNNING|BILLED)$/.test(status)) status = 'AVAILABLE';   /* stale live-state row with no open order */
      tables.push({
        id: t.TABLE_ID, tableNo: no, displayName: no, section: t.SECTION || 'General', tableType: t.SECTION || '',
        pax: Number(t.CAPACITY) || 4, minSpend: Number(t.MIN_SPEND) || 0, status: status,
        guests: Number((ord && ord.PAX) || lsr.COVERS) || 0,
        amount: tv.amount > 0 ? Math.round(tv.amount * 100) / 100 : (Number(String(lsr.BILL_AMOUNT == null ? '' : lsr.BILL_AMOUNT).replace(/,/g, '')) || 0),
        taxable: Math.round(tv.taxable * 100) / 100,
        openedAt: String((ord && ord.CREATED_AT) || lsr.START_TIME || ''), orderId: String((ord && ord.ORDER_ID) || lsr.ORDER_ID || ''),
        orderNo: String((ord && ord.ORDER_NUMBER) || ''), serverVerifiedOpen:!!ord,
        openedBusinessDate:ord?bnxNormalizeDateKey_(ord.BUSINESS_DATE||ord.ORDER_DATE):'',
        stewardId:String((ord&&(ord.STEWARD_ID||ord.CREATED_BY_ID))||lsr.STEWARD_ID||''),stewardLogin:String((ord&&ord.CREATED_BY_LOGIN)||lsr.STEWARD_CODE||''),captainId:String(lsr.CAPTAIN_ID||''),captainLogin:String(lsr.CAPTAIN_CODE||''), captain: String((ord && ord.CAPTAIN_NAME) || lsr.CAPTAIN_NAME || ''),
        steward: String((ord && (ord.STEWARD_NAME || ord.STARTED_BY)) || lsr.STEWARD_NAME || '')
      });
    }
    return { success: true, data: { tables: tables, count: tables.length, at: new Date().toISOString() } };
  } catch (e) {
    bnxLogError(clientId, 'bnxGetTableFloor_ failed: ' + e.message, payload || {});
    return { success: false, error: e.message };
  }
}


/* ---- windowed readers (2026-10-21): [headers, ...rows] like getDataRange().getValues(),
   but only rows whose date (first present column of dateCols) is within lo..hi.
   Falls back to the full read if the sheet lacks the columns, so nothing is ever lost. */
function bnxReadWindow_(sheet, dateCols, lo, hi) {
  try {
    const w = sheet.getLastColumn(); if (!w) return [[]];
    const h = sheet.getRange(1, 1, 1, w).getValues()[0].map(function (x) { return String(x == null ? '' : x).trim(); });
    const cols = (dateCols || []).filter(function (c) { return h.indexOf(c) >= 0; });
    if (!cols.length) return sheet.getDataRange().getValues();
    const dk = function (v) { let d = ''; for (let i = 0; i < v.length && !d; i++) d = bnxNormalizeDateKey_(v[i]); return d; };
    const tst = function (v) { const d = dk(v); return !!d && (!lo || d >= lo) && (!hi || d <= hi); };
    /* 2026-11-16: a window with a start date reads from the bottom (recent rows are at the bottom) */
    const rr = lo ? bnxTailFilteredRows_(sheet, cols, tst, { chunk: 2000, older: function (v) { const d = dk(v); return !/^\d{4}-\d{2}-\d{2}$/.test(d) || d < lo; } })
                  : bnxReadFilteredRows_(sheet, cols, tst);
    return [rr.headers].concat(rr.rows);
  } catch (e) { console.warn('[bnxReadWindow_] full read fallback: ' + e.message); return sheet.getDataRange().getValues(); }
}
function bnxReadByIds_(sheet, idCol, idSet) {
  try {
    const keys = Object.keys(idSet || {}); const w = sheet.getLastColumn();
    if (!w) return [[]];
    const h = sheet.getRange(1, 1, 1, w).getValues()[0].map(function (x) { return String(x == null ? '' : x).trim(); });
    if (!keys.length) return [h];
    if (h.indexOf(idCol) < 0) return sheet.getDataRange().getValues();
    const t = function (v) { return idSet[String(v[0])] === true; };
    const rr = keys.length <= 1500 ? bnxTailFilteredRows_(sheet, [idCol], t, { chunk: 4000, ids: idSet, emptyChunks: 2 }) : bnxReadFilteredRows_(sheet, [idCol], t);   /* 2026-11-16 */
    return [rr.headers].concat(rr.rows);
  } catch (e) { console.warn('[bnxReadByIds_] full read fallback: ' + e.message); return sheet.getDataRange().getValues(); }
}


/* ---- steward / user code -> USER_MASTER FULL_NAME (2026-10-21) ------------------------------
   Bills store CREATED_BY = the steward dropdown value (USERNAME like STF344) or the cashier USER_ID,
   so Bills List / Staff Performance showed codes instead of names. Cached 10 min, bumped on staff edits. */
function bnxStaffGen_(clientId) { try { return CacheService.getScriptCache().get('staffgen_' + clientId) || '0'; } catch (e) { return '0'; } }
