/* ------------------------ filtered column-first reader ---------------------- */
/* Reads only the columns named in colNames, finds the rows where test(values)
   is true, then reads just those rows (merged into runs). Falls back to one full
   read when the hits are scattered. Returns { headers, rows } -- rows are raw
   arrays, exactly like getValues(), already re-checked with test(). */
function bnxReadFilteredRows_(sheet, colNames, test) {
  const lastRow = sheet.getLastRow(), lastCol = sheet.getLastColumn();
  const headers = lastCol > 0 ? sheet.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h == null ? '' : h); }) : [];
  if (lastRow < 2 || lastCol < 1) return { headers: headers, rows: [] };
  const n = lastRow - 1;
  const idx = colNames.map(function (c) { return headers.indexOf(c); });
  if (idx.some(function (i) { return i < 0; })) {
    throw new Error('Missing filter column: '+colNames.filter(function(c){return headers.indexOf(c)<0;}).join(', '));
  }
  const cols = idx.map(function (i) { return sheet.getRange(2, i + 1, n, 1).getValues(); });
  const hit = [];
  for (let i = 0; i < n; i++) {
    const v = new Array(cols.length);
    for (let c = 0; c < cols.length; c++) v[c] = cols[c][i][0];
    if (test(v)) hit.push(i + 2);
  }
  if (!hit.length) return { headers: headers, rows: [] };
  const runs = [];
  let s = hit[0], e = hit[0];
  for (let k = 1; k < hit.length; k++) {
    if (hit[k] - e <= 8) e = hit[k];
    else { runs.push([s, e]); s = hit[k]; e = hit[k]; }
  }
  runs.push([s, e]);
  let candidate = [];
  if (runs.length > 40) {
    const all = sheet.getRange(2, 1, n, lastCol).getValues();
    hit.forEach(function (rn) { candidate.push(all[rn - 2]); });
    return { headers: headers, rows: candidate };
  }
  const rows = [];
  runs.forEach(function (r) {
    const vals = sheet.getRange(r[0], 1, r[1] - r[0] + 1, lastCol).getValues();
    for (let j = 0; j < vals.length; j++) {
      const row = vals[j];
      const v = idx.map(function (i) { return row[i]; });
      if (test(v)) rows.push(row);                   // drop the gap rows pulled in by merging
    }
  });
  return { headers: headers, rows: rows };
}

