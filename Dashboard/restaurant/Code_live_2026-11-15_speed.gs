        var o2={ITEM_NAME:name,MENU_ITEM_NAME:name,PRICE:price,SERVING_PRICE:price,SELLING_PRICE:price,AVAILABILITY_STATUS:availTxt,IS_ACTIVE:avail,UPDATED_AT:now};
