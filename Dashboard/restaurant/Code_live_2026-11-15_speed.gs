  } finally { lock.releaseLock(); }
}
function RUN_21_ListItemGroups() { RUN_19_BuildDsrItemGroups(); }

/* 2026-11-10 ("hukka sale not match"): one-time repair of BILL_ITEMS lines written with DISCOUNTED_RATE 0 on PAID bills
   (note "qty from POS NC column (paid bill)"). Sets DISCOUNTED_RATE = TAXABLE_PER_ITEM / QUANTITY on exactly those lines.
   RUN_22_PreviewZeroRateLines → only lists what would change (writes nothing).
   RUN_23_RepairZeroRateLines  → writes the fix, then rebuilds the DSR item groups. */
function bnxZeroRateScan_(cid, apply) {
  var ss = bnxIgcOpenDb_(cid), sh = ss.getSheetByName('BILL_ITEMS'), bmSh = ss.getSheetByName('BILL_MASTER');
  var v = sh.getDataRange().getValues(), h = {}; v[0].forEach(function (k, i) { h[String(k).trim().toUpperCase()] = i; });
  var need = ['BILL_ID', 'QUANTITY', 'DISCOUNTED_RATE', 'TAXABLE_PER_ITEM', 'NOTES'];
  need.forEach(function (k) { if (h[k] == null) throw new Error('BILL_ITEMS: column ' + k + ' missing'); });
  var bv = bmSh.getDataRange().getValues(), bh = {}; bv[0].forEach(function (k, i) { bh[String(k).trim().toUpperCase()] = i; });
  var paid = {}; bv.slice(1).forEach(function (r) { var st = String(r[bh.BILL_STATUS] || '').toUpperCase(); if (!/CANCEL|VOID|DELETED/.test(st) && bnxIgcNum_(r[bh.GRAND_TOTAL]) > 0) paid[String(r[bh.BILL_ID])] = 1; });
  var hits = [];
  for (var i = 1; i < v.length; i++) {
    var r = v[i], q = bnxIgcNum_(r[h.QUANTITY]), dr = bnxIgcNum_(r[h.DISCOUNTED_RATE]), tx = bnxIgcNum_(r[h.TAXABLE_PER_ITEM]);
    if (q > 0 && !(dr > 0) && tx > 0 && paid[String(r[h.BILL_ID])] && /NC column \(paid bill\)/i.test(String(r[h.NOTES] || ''))) hits.push({ row: i + 1, rate: Math.round(tx / q * 100) / 100, name: r[h.ITEM_NAME] });
  }
  if (apply && hits.length) {
    var col = h.DISCOUNTED_RATE + 1;
    hits.forEach(function (x) { sh.getRange(x.row, col).setValue(x.rate); });
  }
  return hits;
}
/* 2026-11-10 (cross-check FY DSR vs TRANSACTION_DB): 31 big bills (₹1 lakh+, total ₹82,77,570) have GRAND_TOTAL written as TEXT
   with Indian commas ("4,30,500.00"); also TAXABLE_AMOUNT ×2, DUE_AMOUNT ×1. Number("4,30,500.00") = NaN → 0, so every server
   total that reads these cells with Number() (dashboard summary, sales reports) silently drops those bills.
   RUN_24_PreviewTextMoney → lists them (writes nothing) · RUN_25_RepairTextMoney → writes them back as real numbers. */
var BNX_MONEY_COLS_ = { BILL_MASTER: ['SUBTOTAL','ITEM_DISCOUNT','SUBTOTAL_AFTER_ITEM_DISCOUNT','BILL_DISCOUNT','TAXABLE_AMOUNT','TAX_AMOUNT','ROUND_OFF','GRAND_TOTAL','DUE_AMOUNT','SERVICE_CHARGE_AMOUNT','SERVICE_CHARGE_GST_AMOUNT'],
  BILL_ITEMS: ['QUANTITY','RATE','LINE_DISCOUNT','DISCOUNTED_RATE','TAXABLE_PER_ITEM','TAX_PER_ITEM','LINE_TOTAL'], PAYMENT_MASTER: ['AMOUNT'], SALES_LEDGER: ['AMOUNT'] };
function bnxTextMoneyScan_(cid, apply) {
