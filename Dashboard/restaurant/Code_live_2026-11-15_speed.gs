  if (lr < 2 || !ref) return null;
  var h = sh.getRange(1, 1, 1, lc).getValues()[0].map(String), rows = {}, ci = h.indexOf('CLIENT_ID');
  ['KOT_NUMBER', 'KOT_ID'].forEach(function (n) {
    var c = h.indexOf(n); if (c < 0) return;
    sh.getRange(2, c + 1, lr - 1, 1).createTextFinder(ref).matchEntireCell(true).findAll().forEach(function (x) { rows[x.getRow()] = 1; });
  });
  var list = Object.keys(rows).map(Number).sort(function (a, b) { return b - a; });
  for (var i = 0; i < list.length; i++) {
    var v = sh.getRange(list[i], 1, 1, lc).getValues()[0], o = bnxRowToObject(v, h);
    if (ci >= 0 && o.CLIENT_ID && String(o.CLIENT_ID) !== String(cid)) continue;
    if (String(o.KOT_NUMBER) !== ref && String(o.KOT_ID) !== ref) continue;
    return { sheet: sh, headers: h, row: list[i], values: v, obj: o };
  }
