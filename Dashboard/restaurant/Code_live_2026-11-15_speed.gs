function bnxPqMaster_(s,p,save){
 var cid=s.CLIENT_ID,ss=bnxPqDb_(cid,'MASTER'),sh=ss.getSheetByName('CLIENT_PRINTER_MASTER');
 if(!sh)throw new Error('CLIENT_PRINTER_MASTER missing in client master');
 var v=sh.getDataRange().getValues(),h=v[0].map(String),ix=function(k){var i=h.indexOf(k);if(i<0)throw new Error('Printer header missing: '+k);return i;};
 var ci=ix('CLIENT_ID'),ri=ix('PRINTER_ROLE'),ip=ix('PRINTER_IP'),roles=['BILL','KITCHEN','BAR','HUKKA'];
