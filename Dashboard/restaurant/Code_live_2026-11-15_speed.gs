    var lr = sh.getLastRow(), lc = sh.getLastColumn();
    if (lr < 2 || lc < 1) return { success: true, data: [] };
    var v = sh.getRange(1, 1, lr, lc).getValues(), h = v[0].map(function (x) { return String(x == null ? '' : x).trim(); });
    var iDate = h.indexOf('BUSINESS_DATE'); if (iDate < 0) return { success: false, error: 'DSR_ITEM_GROUP_CALC has no BUSINESS_DATE column' };
    var byDay = {};
    for (var r = 1; r < v.length; r++) {
