}


/* ---- bill-list cache helpers (2026-10-21) ---------------------------------------------------- */
function bnxBillGen_(clientId) { try { return CacheService.getScriptCache().get('billgen_' + clientId) || '0'; } catch (e) { return '0'; } }
function bnxBillGenBump_(clientId) { try { CacheService.getScriptCache().put('billgen_' + clientId, String(Date.now()), 21600); } catch (e) {} }
/* CacheService values are limited to 100 KB: large answers are split into parts */
function bnxBigCachePut_(key, text, ttl) {
  try {
    const c = CacheService.getScriptCache(), PART = 90000, n = Math.ceil(text.length / PART);
    if (n > 30) return;
    const o = {}; o[key] = 'P' + n;
    for (let i = 0; i < n; i++) o[key + '_p' + i] = text.slice(i * PART, (i + 1) * PART);
    c.putAll(o, ttl);
  } catch (e) {}
}
function bnxBigCacheGet_(key) {
  try {
    const c = CacheService.getScriptCache(), head = c.get(key); if (!head || head.charAt(0) !== 'P') return null;
    const n = Number(head.slice(1)), keys = []; for (let i = 0; i < n; i++) keys.push(key + '_p' + i);
    const got = c.getAll(keys); let out = '';
    for (let i = 0; i < n; i++) { const v = got[key + '_p' + i]; if (v == null) return null; out += v; }
    return out;
  } catch (e) { return null; }
}


/* View / Reprint detail (2026-10-21): same authoritative read as GET_BILL_FOR_REPRINT, cached 10 min per bill
