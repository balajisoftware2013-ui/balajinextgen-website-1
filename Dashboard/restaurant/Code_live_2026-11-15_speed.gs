  return out;
}
function bnxCostingCompute_(session,cid,from,to,basis,cfg){
  var tz=Session.getScriptTimeZone()||'Asia/Kolkata',r2=bnxCostR2_,num=function(v){var n=Number(String(v==null?'':v).replace(/[,₹\s]/g,''));return isFinite(n)?n:0;};
  var days={},dayList=[];
  for(var d=new Date(from+'T12:00:00Z');d<=new Date(to+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+1)){var k=d.toISOString().slice(0,10);
    days[k]={date:k,bills:0,covers:0,gross:0,tax:0,net:0,goodsCost:0,itemCost:0,purchases:0,petty:0,cashExp:0,manual:0,eventCost:0,units:0,power:0,meterCost:0,ncBills:0,ncCost:0,totalCost:0,profit:0,margin:0};dayList.push(k);}
  /* ---- bills ---- */
  /* 2026-11-15 SPEED ("Working out costs… never ends"): read only the bills of the period and only their lines — was the whole BILL_MASTER + BILL_ITEMS history every time */
  var bm=bnxClientSheet(cid,SHEETS.BILL_MASTER),bv=bnxReadWindow_(bm,['BILL_DATE'],from,to),bh=(bv[0]||[]).map(String),B=function(k){return bh.indexOf(k);};
