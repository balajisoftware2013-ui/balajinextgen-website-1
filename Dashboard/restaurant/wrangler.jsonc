// BALAJI NEXTGEN website on Cloudflare (Worker "balajinextgen-website-1", built from this GitHub repo) — 2026-11-14
// Only https://www.balajinextgen.in/wa-webhook runs _worker.js (WhatsApp webhook relay).
// Every other address is served straight from the files, exactly as before.
{
  "name": "balajinextgen-website-1",
  "main": "_worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/wa-webhook", "/wa-webhook/"]
  }
}
